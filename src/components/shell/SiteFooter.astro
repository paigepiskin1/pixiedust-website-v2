---
// Site footer. Columns are curated rather than generated: the grouping is an
// editorial decision (which tool belongs under Create, which section under
// Learn) that a generated list cannot make. Section links point at the real
// category URLs, so renaming a section in the admin only needs the slug
// updating here.
interface Props {
  /** Signed-in visitors do not need the "Start creating" sign-up push. */
  signedIn?: boolean;
}
const { signedIn = false } = Astro.props;

// No App Store listing is configured yet. The iPhone entries render only once
// this is set — a footer link that goes nowhere is worse than one that is
// absent, and inventing a URL would be worse still.
const IPHONE_APP_URL: string | null = null;

const columns: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    title: "Create",
    links: [
      { label: "All tools", href: "/" },
      { label: "AI Photoshoots", href: "/shoots" },
      { label: "AI Video", href: "/video" },
      { label: "Motion Transfer", href: "/motion" },
      { label: "Beauty Studio", href: "/beauty" },
      { label: "Hair Studio", href: "/hair" },
      { label: "Fashion Try-On", href: "/fashion" },
      // The sidebar routes Tattoo Studio to /avatar; /tattoo does not exist.
      { label: "Tattoo Studio", href: "/avatar" },
    ],
  },
  {
    title: "Explore",
    links: [
      { label: "Made with PixyDust", href: "/made-with-pixydust" },
      { label: "Presets", href: "/presets" },
      { label: "AR effects archive", href: "/ar-effects" },
      ...(IPHONE_APP_URL ? [{ label: "iPhone app", href: IPHONE_APP_URL, external: true }] : []),
    ],
  },
  {
    title: "Learn",
    links: [
      { label: "Getting started", href: "/support/getting-started" },
      { label: "Tutorials", href: "/tutorials" },
      { label: "Blog", href: "/blog" },
      { label: "Workflow guides", href: "/workflow-guides" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About PixyDust", href: "/about" },
      { label: "Case studies", href: "/case-studies" },
      { label: "Press and media", href: "/press" },
      { label: "Brand assets", href: "/brand" },
      { label: "Contact", href: "mailto:hello@pixydust.com", external: true },
    ],
  },
  {
    title: "Get help",
    links: [
      { label: "Help center", href: "/support" },
      { label: "Pricing and credits", href: "/credits" },
      { label: "FAQs", href: "/support" },
      { label: "Contact support", href: "/feedback" },
      { label: "Feedback", href: "/feedback" },
    ],
  },
];

// Same handles as the sameAs set in Base.astro — these must stay in step or
// the structured data and the visible links disagree.
const socials = [
  { name: "Instagram", href: "https://www.instagram.com/PixyDustAI", icon: "instagram" },
  { name: "YouTube", href: "https://www.youtube.com/@PixyDustAI", icon: "youtube" },
  { name: "TikTok", href: "https://www.tiktok.com/@PixyDustAI", icon: "tiktok" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/PixyDustAI", icon: "linkedin" },
];

const ICONS: Record<string, string> = {
  instagram:
    '<rect x="2.5" y="2.5" width="13" height="13" rx="4"/><circle cx="9" cy="9" r="3.2"/><circle cx="13.2" cy="4.8" r="0.9" fill="currentColor" stroke="none"/>',
  youtube:
    '<rect x="1.5" y="4" width="15" height="10" rx="3"/><path d="M7.4 6.8v4.4L11.4 9z" fill="currentColor" stroke="none"/>',
  tiktok:
    '<path d="M10.6 2.2v8.3a2.7 2.7 0 1 1-2.2-2.65"/><path d="M10.6 2.2c.3 1.7 1.5 2.9 3.2 3.1"/>',
  linkedin:
    '<rect x="2.5" y="2.5" width="13" height="13" rx="2.5"/><path d="M6 7.6v5M6 5.3v.1M9 12.6V9.9a1.7 1.7 0 0 1 3.4 0v2.7"/>',
};

const year = new Date().getFullYear();
---

<footer style="border-top:0.5px solid var(--pd-hairline);background:var(--pd-bg);">
  <div class="mx-auto w-full" style="max-width:1480px;padding:40px 28px 24px;">
    <!-- Brand + calls to action -->
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <a href="/" class="flex items-center gap-1" style="text-decoration:none;">
          <span class="font-display font-semibold text-ink" style="font-size:26px;letter-spacing:-0.9px;">PixyDust</span>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="margin-top:-10px;">
            <path d="M8 1.6l1.5 4.3 4.3 1.5-4.3 1.5L8 13.2 6.5 8.9 2.2 7.4l4.3-1.5z" fill="var(--pd-lilac)" />
          </svg>
        </a>
        <p class="mt-1 text-ink-3" style="font-size:12.5px;">Imagine. Create. Captivate.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a href={signedIn ? "/" : "/auth/sign-in"} class="inline-flex items-center gap-2 rounded-xl font-semibold"
          style="padding:11px 18px;font-size:13px;color:#fff;text-decoration:none;background:linear-gradient(115deg,#7C3AED,#EC4899);">
          {signedIn ? "Open the studio" : "Start creating"}
          <svg width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6h7M6.5 3l3 3-3 3"/></svg>
        </a>
        {IPHONE_APP_URL && (
          <a href={IPHONE_APP_URL} target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 rounded-xl font-semibold text-ink"
            style="padding:11px 18px;font-size:13px;text-decoration:none;border:0.5px solid var(--pd-hairline3);background:transparent;">
            <svg width="13" height="13" viewBox="0 0 14 18" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="1" y="1" width="12" height="16" rx="2.5"/><path d="M5.6 14.2h2.8"/></svg>
            Get the iPhone app
          </a>
        )}
      </div>
    </div>

    <hr style="margin:28px 0;border:0;border-top:0.5px solid var(--pd-hairline);" />

    <!-- Link columns -->
    <nav class="pd-foot-cols grid gap-x-6 gap-y-8">
      {columns.map((col) => (
        <div>
          <h3 class="font-display font-semibold text-ink" style="font-size:14.5px;letter-spacing:-0.2px;">{col.title}</h3>
          <ul style="list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:9px;">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="pd-foot-link"
                  {...(l.external ? { target: l.href.startsWith("mailto:") ? undefined : "_blank", rel: "noopener" } : {})}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <hr style="margin:28px 0 18px;border:0;border-top:0.5px solid var(--pd-hairline);" />

    <!-- Legal + social -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <span class="text-ink-4" style="font-size:11.5px;">© {year} PixyDust, LLC. All rights reserved.</span>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <div class="flex items-center gap-2.5">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="pd-foot-social">
              <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <Fragment set:html={ICONS[s.icon]} />
              </svg>
            </a>
          ))}
        </div>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1.5" style="font-size:11.5px;">
          <a href="/legal/terms" class="pd-foot-link">Terms</a>
          <a href="/legal/privacy" class="pd-foot-link">Privacy</a>
          <a href="/legal/acceptable-use" class="pd-foot-link">Acceptable Use</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Five columns on desktop, two on a phone — five 120px columns would wrap
     into unreadable ribbons long before the breakpoint. */
  .pd-foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 640px) { .pd-foot-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .pd-foot-cols { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  .pd-foot-link {
    color: var(--pd-ink3); font-size: 12.5px; text-decoration: none; line-height: 1.4;
    transition: color 0.15s ease;
  }
  .pd-foot-link:hover { color: var(--pd-ink); }

  .pd-foot-social {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 9px; color: var(--pd-ink3);
    border: 0.5px solid var(--pd-hairline2); transition: color 0.15s ease, border-color 0.15s ease;
  }
  .pd-foot-social:hover { color: var(--pd-ink); border-color: var(--pd-hairline3); }
</style>

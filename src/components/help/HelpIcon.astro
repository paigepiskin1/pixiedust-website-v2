---
// Inline SVG icons for the Help Center. 16x16 viewBox, stroke inherits color.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 16 } = Astro.props;

const paths: Record<string, string> = {
  rocket:
    '<path d="M6 10c-1.5.5-2.5 2-2.5 3.5C5 13.5 6.5 12.5 7 11"/><path d="M8.5 11.5 4.5 7.5c.5-3 3-5.5 6.5-6 .5 3.5-2 6-5 6.5z"/><circle cx="9.5" cy="6.5" r="1"/>',
  coin:
    '<circle cx="8" cy="8" r="6"/><path d="M8 4.5v7M6.2 6.2h2.6a1.3 1.3 0 0 1 0 2.6H6.5h2.3a1.3 1.3 0 0 1 0 2.6H6.2"/>',
  card:
    '<rect x="2" y="4" width="12" height="8" rx="1.5"/><path d="M2 6.5h12"/><path d="M4.5 9.5h3"/>',
  refund:
    '<path d="M3 8a5 5 0 1 1 1.6 3.7"/><path d="M3 5v3h3"/>',
  grid:
    '<rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="9" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="2.5" y="9" width="4.5" height="4.5" rx="1"/><rect x="9" y="9" width="4.5" height="4.5" rx="1"/>',
  cube:
    '<path d="M8 2 3 4.7v6.6L8 14l5-2.7V4.7z"/><path d="M3 4.7 8 7.4l5-2.7"/><path d="M8 7.4V14"/>',
  bug:
    '<rect x="5" y="5.5" width="6" height="7" rx="3"/><path d="M5 8H2.5M11 8h2.5M5 11H3M11 11h2M6 5.5 5 3.5M10 5.5 11 3.5M8 5.5v-2"/>',
  user:
    '<circle cx="8" cy="5.5" r="2.5"/><path d="M3.5 13a4.5 4.5 0 0 1 9 0"/>',
  gift:
    '<rect x="2.5" y="6" width="11" height="3" rx="0.6"/><path d="M3.5 9v4.5h9V9M8 6v7.5"/><path d="M8 6S6.8 3.5 5.3 4C4 4.4 4.6 6 6 6zM8 6s1.2-2.5 2.7-2C12 4.4 11.4 6 10 6z"/>',
  search:
    '<circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/>',
  arrow: '<path d="M3 8h9M9 5l3 3-3 3"/>',
  chevron: '<path d="M6 3.5 10.5 8 6 12.5"/>',
  book:
    '<path d="M8 4c-1.2-1-3-1.3-5-1v9c2-.3 3.8 0 5 1 1.2-1 3-1.3 5-1V3c-2-.3-3.8 0-5 1z"/><path d="M8 4v10"/>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name] ?? paths.book}
/>

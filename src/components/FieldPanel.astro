---
/**
 * Shared template field panel — renders the exact same inputs used in the
 * studio. Accepts an optional `fields` prop (server-side) OR can be
 * initialized from JS via `window.pdInitFieldPanel(root, fields)` for
 * dynamic use (admin editor test panel).
 *
 * Usage (server-side, studio):
 *   <FieldPanel fields={template.fields} />
 *
 * Usage (dynamic / admin test panel):
 *   <div id="my-panel"></div>
 *   window.pdInitFieldPanel(document.getElementById('my-panel'), parsedFields);
 *   const vals = window.pdCollectFieldValues(document.getElementById('my-panel'));
 */
import type { TemplateField } from "../lib/templates";

interface Props {
  fields?: TemplateField[];
  id?: string;
}

const { fields = [], id } = Astro.props;

function formatAccept(accept: string) {
  return accept.replace(/image\//g, "").replace(/video\//g, "").replace(/,\s*/g, ", ").toUpperCase();
}
---

<div class="pd-field-panel flex flex-col gap-4" id={id}>
  {fields.map((f) => (
    f.type === "file" ? (
      <div class="block">
        <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">{f.label}{f.required ? " *" : ""}</span>
        <div class="pd-file-wrap" data-fieldkey={f.key} data-multiple={f.multiple ? "true" : undefined} data-max={f.multiple ? String(f.max ?? 4) : undefined} data-register-portrait={f.registerPortrait ? "true" : undefined} data-default={f.default != null && f.default !== "" ? JSON.stringify(f.default) : undefined}>
          <div class="pd-upload-zone relative flex w-full cursor-pointer flex-col items-center gap-1 rounded-xl text-center" style="padding:18px 14px;background:var(--pd-bg);border:1px dashed var(--pd-hairline2);transition:border-color 0.15s,background 0.15s;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-ink3)" stroke-width="1.4" stroke-linecap="round"><path d="M10 13V7M7 10l3-3 3 3"/><rect x="3" y="3" width="14" height="14" rx="3"/></svg>
            <span style="font-size:12px;color:var(--pd-ink3);pointer-events:none;">Click or drag to upload</span>
            {f.accept && <span style="font-size:10.5px;color:var(--pd-ink4);pointer-events:none;">{formatAccept(f.accept)} · {f.multiple ? (<span class="pd-file-max">up to {f.max ?? 4} files</span>) : "1 file max"}</span>}
            <input data-field={f.key} type="file" accept={f.accept} multiple={f.multiple || undefined} class="absolute inset-0 cursor-pointer opacity-0" style="z-index:1;" />
          </div>
          {f.multiple ? (
            <div class="pd-multi-previews" style="display:none;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>
          ) : (
            <div class="pd-file-preview overflow-hidden rounded-xl" style="display:none;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);margin-top:4px;">
              <img class="pd-preview-img block" style="max-height:300px;max-width:100%;width:100%;height:auto;object-fit:contain;margin:0 auto;background:var(--pd-bg3);" alt="" />
              <div class="flex items-center justify-between gap-2" style="padding:7px 10px;border-top:0.5px solid var(--pd-hairline);">
                <span class="pd-preview-status truncate" style="font-size:11px;color:var(--pd-ink3);"></span>
                <button type="button" class="pd-file-clear flex shrink-0 items-center justify-center rounded-full" style="width:20px;height:20px;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink3);font-size:10px;cursor:pointer;" aria-label="Remove">✕</button>
              </div>
            </div>
          )}
          <div class="pd-upload-error" style="display:none;margin-top:8px;padding:8px 10px;border-radius:10px;background:color-mix(in srgb,var(--pd-pink) 12%,transparent);border:0.5px solid color-mix(in srgb,var(--pd-pink) 40%,transparent);color:var(--pd-pink);font-size:12px;line-height:1.35;"></div>
        </div>
        {f.help && <span class="mt-1 block text-ink-4" style="font-size:11px;">{f.help}</span>}
      </div>
    ) : (
      <label class="block">
        <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">{f.label}{f.required ? " *" : ""}</span>
        {f.type === "textarea" ? (
          <textarea data-field={f.key} data-mention-from={f.mentionFrom || undefined} data-mention-label={f.mentionLabel || undefined} rows="3" placeholder={f.placeholder} class="w-full rounded-xl text-ink outline-none" style="padding:11px 13px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:13.5px;line-height:1.5;resize:vertical;">{String(f.default ?? "")}</textarea>
        ) : f.type === "select" && (f.options ?? []).some((o) => (o as any).image) ? (
          <>
            <input type="hidden" data-field={f.key} value={String(f.default ?? f.options?.[0]?.value ?? "")} />
            <div class="pd-opt-cards" style="display:grid;grid-template-columns:repeat(auto-fill,140px);gap:8px;justify-content:start;">
              {(f.options ?? []).map((o) => {
                const active = String(f.default ?? f.options?.[0]?.value ?? "") === o.value;
                return (
                  <button type="button" class="pd-opt-card" data-val={o.value} data-active={active ? "true" : "false"} style={`display:flex;flex-direction:column;gap:6px;padding:6px;border-radius:12px;cursor:pointer;text-align:left;transition:border-color 120ms,background 120ms;background:${active ? "color-mix(in srgb,var(--pd-lilac) 8%,var(--pd-bg))" : "var(--pd-bg)"};border:1px solid ${active ? "var(--pd-lilac)" : "var(--pd-hairline2)"};`}>
                    {(o as any).image && <img src={(o as any).image} alt={o.label} loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:8px;display:block;background:var(--pd-bg2);" />}
                    <span style="font-size:12px;font-weight:500;color:var(--pd-ink);padding:0 2px 2px;line-height:1.25;">{o.label}</span>
                  </button>
                );
              })}
            </div>
          </>
        ) : f.type === "select" && (f as any).ui === "dropdown" ? (
          <select data-field={f.key} class="w-full rounded-xl text-ink outline-none" style="padding:11px 13px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:13.5px;">
            {(f.options ?? []).map((o) => <option value={o.value} selected={o.value === String(f.default ?? f.options?.[0]?.value ?? "")}>{o.label}</option>)}
          </select>
        ) : f.type === "select" ? (
          <>
            <input type="hidden" data-field={f.key} value={String(f.default ?? f.options?.[0]?.value ?? "")} />
            <div class="pd-opt-segs" style="display:flex;flex-wrap:wrap;gap:6px;">
              {(f.options ?? []).map((o) => {
                const active = String(f.default ?? f.options?.[0]?.value ?? "") === o.value;
                return (
                  <button
                    type="button"
                    class="pd-opt-seg"
                    data-val={o.value}
                    data-active={active ? "true" : "false"}
                    style={`flex:1 1 140px;padding:10px 12px;border-radius:12px;cursor:pointer;text-align:left;font-size:12.5px;font-weight:500;line-height:1.35;transition:border-color 120ms,background 120ms,color 120ms;background:${active ? "var(--pd-ink)" : "var(--pd-bg)"};color:${active ? "var(--pd-bg)" : "var(--pd-ink)"};border:0.5px solid ${active ? "transparent" : "var(--pd-hairline2)"};`}
                  >{o.label}</button>
                );
              })}
            </div>
          </>
        ) : f.type === "number" ? (
          <input data-field={f.key} type="number" min={f.min} max={f.max} step={f.step} value={f.default as number | undefined} class="w-full rounded-xl text-ink outline-none" style="padding:11px 13px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:13.5px;" />
        ) : (
          <input data-field={f.key} type={f.type === "url" ? "url" : f.type === "email" ? "email" : "text"} placeholder={f.placeholder} value={String(f.default ?? "")} class="w-full rounded-xl text-ink outline-none" style="padding:11px 13px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:13.5px;" />
        )}
        {f.help && <span class="mt-1 block text-ink-4" style="font-size:11px;">{f.help}</span>}
      </label>
    )
  ))}
</div>

<script>
/**
 * Shared field panel runtime — uploaded file URLs, drag-and-drop, previews.
 * Exposed globally so admin editor can call it dynamically.
 *
 * window.pdInitFieldPanel(root: HTMLElement, fileUrls: Record) → void
 *   Wires all file inputs in `root`. fileUrls is written to on upload.
 *
 * window.pdRenderFields(container: HTMLElement, fields: any[]) → void
 *   Dynamically generates field HTML into container (for JS-only use).
 *
 * window.pdCollectFieldValues(root: HTMLElement, fileUrls: Record) → Record
 *   Returns all current field values (text + uploaded file URLs).
 */

// ── HTML generator (used by admin editor to re-render dynamically) ────────────
(window as any).pdRenderFields = function(container: HTMLElement, fields: any[]) {
  if (!Array.isArray(fields) || !fields.length) {
    container.innerHTML = '<div style="font-size:12px;color:var(--pd-ink3);">No fields defined yet — edit fields_json above and they\'ll appear here.</div>';
    return;
  }
  const S = "padding:11px 13px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);border-radius:12px;font-size:13.5px;color:var(--pd-ink);outline:none;width:100%;box-sizing:border-box;";
  container.innerHTML = fields.map((f: any) => {
    const key = String(f.key ?? "");
    const label = String(f.label ?? key);
    const type = String(f.type ?? "text");
    const ph = String(f.placeholder ?? "");
    const def = f.default != null ? String(f.default) : "";
    const help = f.help ? `<span style="display:block;margin-top:4px;font-size:11px;color:var(--pd-ink4);">${escHtml(f.help)}</span>` : "";

    if (type === "file") {
      const isMulti = !!f.multiple;
      const maxFiles = Number(f.max ?? 4);
      const accept = String(f.accept ?? "");
      const acceptLabel = accept ? accept.replace(/image\//g,"").replace(/video\//g,"").replace(/,\s*/g,", ").toUpperCase() : "";
      return `<div>
        <span style="display:block;margin-bottom:6px;font-size:12.5px;font-weight:500;color:var(--pd-ink);">${escHtml(label)}${f.required?" *":""}</span>
        <div class="pd-file-wrap" data-fieldkey="${key}"${isMulti?` data-multiple="true" data-max="${maxFiles}"`:""}${f.registerPortrait?` data-register-portrait="true"`:""}${f.default!=null&&f.default!==""?` data-default="${escAttr(JSON.stringify(f.default))}"`:""}>
          <div class="pd-upload-zone" style="position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;padding:18px 14px;background:var(--pd-bg);border:1px dashed var(--pd-hairline2);border-radius:12px;cursor:pointer;text-align:center;transition:border-color .15s,background .15s;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-ink3)" stroke-width="1.4" stroke-linecap="round"><path d="M10 13V7M7 10l3-3 3 3"/><rect x="3" y="3" width="14" height="14" rx="3"/></svg>
            <span style="font-size:12px;color:var(--pd-ink3);pointer-events:none;">Click or drag to upload</span>
            ${accept?`<span style="font-size:10.5px;color:var(--pd-ink4);pointer-events:none;">${acceptLabel} · ${isMulti?`up to ${maxFiles} files`:"1 file max"}</span>`:""}
            <input data-field="${key}" type="file"${accept?` accept="${accept}"`:""}${isMulti?" multiple":""} style="position:absolute;inset:0;opacity:0;cursor:pointer;z-index:1;" />
          </div>
          ${isMulti
            ? `<div class="pd-multi-previews" style="display:none;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>`
            : `<div class="pd-file-preview" style="display:none;overflow:hidden;border-radius:12px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);margin-top:4px;">
                <img class="pd-preview-img" style="display:block;max-width:100%;width:100%;height:auto;max-height:300px;object-fit:contain;margin:0 auto;background:var(--pd-bg3);" alt="" />
                <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 10px;border-top:0.5px solid var(--pd-hairline);">
                  <span class="pd-preview-status" style="font-size:11px;color:var(--pd-ink3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
                  <button type="button" class="pd-file-clear" style="flex-shrink:0;width:20px;height:20px;border-radius:50%;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink3);font-size:10px;cursor:pointer;line-height:1;">✕</button>
                </div>
              </div>`
          }
          <div class="pd-upload-error" style="display:none;margin-top:8px;padding:8px 10px;border-radius:10px;background:color-mix(in srgb,var(--pd-pink) 12%,transparent);border:0.5px solid color-mix(in srgb,var(--pd-pink) 40%,transparent);color:var(--pd-pink);font-size:12px;line-height:1.35;"></div>
        </div>
        ${help}
      </div>`;
    }

    let input = "";
    if (type === "textarea") {
      const mf = f.mentionFrom ? ` data-mention-from="${escAttr(String(f.mentionFrom))}"${f.mentionLabel ? ` data-mention-label="${escAttr(String(f.mentionLabel))}"` : ""}` : "";
      input = `<textarea data-field="${key}"${mf} rows="3" placeholder="${escAttr(ph)}" style="${S}line-height:1.5;resize:vertical;">${escHtml(def)}</textarea>`;
    } else if (type === "select" && Array.isArray(f.options) && f.options.some((o: any) => o && o.image)) {
      const current = def || String(f.options[0]?.value ?? "");
      const cards = f.options.map((o: any) => {
        const val = String(o.value ?? o);
        const on = val === current;
        return `<button type="button" class="pd-opt-card" data-val="${escAttr(val)}" data-active="${on?"true":"false"}" style="display:flex;flex-direction:column;gap:6px;padding:6px;border-radius:12px;cursor:pointer;text-align:left;transition:border-color 120ms,background 120ms;background:${on?"color-mix(in srgb,var(--pd-lilac) 8%,var(--pd-bg))":"var(--pd-bg)"};border:1px solid ${on?"var(--pd-lilac)":"var(--pd-hairline2)"};">
          ${o.image?`<img src="${escAttr(String(o.image))}" alt="${escAttr(String(o.label??val))}" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:8px;display:block;background:var(--pd-bg2);" />`:""}
          <span style="font-size:12px;font-weight:500;color:var(--pd-ink);padding:0 2px 2px;line-height:1.25;">${escHtml(String(o.label??val))}</span>
        </button>`;
      }).join("");
      input = `<input type="hidden" data-field="${key}" value="${escAttr(current)}" /><div class="pd-opt-cards" style="display:grid;grid-template-columns:repeat(auto-fill,140px);gap:8px;justify-content:start;">${cards}</div>`;
    } else if (type === "select" && Array.isArray(f.options) && f.ui === "dropdown") {
      const current = def || String(f.options[0]?.value ?? f.options[0] ?? "");
      const opts = f.options.map((o: any) => `<option value="${escAttr(String(o.value??o))}"${String(o.value??o)===current?" selected":""}>${escHtml(String(o.label??o.value??o))}</option>`).join("");
      input = `<select data-field="${key}" style="${S}">${opts}</select>`;
    } else if (type === "select" && Array.isArray(f.options)) {
      const current = def || String(f.options[0]?.value ?? f.options[0] ?? "");
      const segs = f.options.map((o: any) => {
        const val = String(o.value ?? o);
        const on = val === current;
        return `<button type="button" class="pd-opt-seg" data-val="${escAttr(val)}" data-active="${on?"true":"false"}" style="flex:1 1 140px;padding:10px 12px;border-radius:12px;cursor:pointer;text-align:left;font-size:12.5px;font-weight:500;line-height:1.35;transition:border-color 120ms,background 120ms,color 120ms;background:${on?"var(--pd-ink)":"var(--pd-bg)"};color:${on?"var(--pd-bg)":"var(--pd-ink)"};border:0.5px solid ${on?"transparent":"var(--pd-hairline2)"};">${escHtml(String(o.label??val))}</button>`;
      }).join("");
      input = `<input type="hidden" data-field="${key}" value="${escAttr(current)}" /><div class="pd-opt-segs" style="display:flex;flex-wrap:wrap;gap:6px;">${segs}</div>`;
    } else if (type === "number") {
      input = `<input data-field="${key}" type="number"${f.min!=null?` min="${f.min}"`:""}${f.max!=null?` max="${f.max}"`:""}${f.step!=null?` step="${f.step}"`:""}  value="${escAttr(def)}" style="${S}" />`;
    } else {
      const t = type === "url" ? "url" : type === "email" ? "email" : "text";
      input = `<input data-field="${key}" type="${t}" placeholder="${escAttr(ph)}" value="${escAttr(def)}" style="${S}" />`;
    }
    return `<label style="display:block;">
      <span style="display:block;margin-bottom:6px;font-size:12.5px;font-weight:500;color:var(--pd-ink);">${escHtml(label)}${f.required?" *":""}</span>
      ${input}${help}
    </label>`;
  }).join("");
};

function escHtml(s: string) { return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function escAttr(s: string) { return s.replace(/"/g,"&quot;").replace(/'/g,"&#39;"); }

// ── File upload wiring ────────────────────────────────────────────────────────
(window as any).pdInitFieldPanel = function(root: HTMLElement, fileUrls: Record<string, any>) {
  // Avoid double-binding when Astro re-executes scripts or a page calls init twice.
  if ((root as any)._pdFieldPanelReady) return;
  (root as any)._pdFieldPanelReady = true;
  (root as any)._pdFileUrls = fileUrls;
  // Track in-flight uploads on the panel element so callers (e.g. the studio
  // Generate button) can avoid submitting before files finish uploading.
  (root as any)._pdUploading = Number((root as any)._pdUploading) || 0;
  const bump = (n: number) => {
    (root as any)._pdUploading = Math.max(0, (Number((root as any)._pdUploading) || 0) + n);
  };

  async function handleUpload(file: File, key: string,
    zone: HTMLElement|null, preview: HTMLElement|null,
    previewImg: HTMLImageElement|null, status: HTMLElement|null,
    errorEl: HTMLElement|null
  ) {
    const localUrl = URL.createObjectURL(file);
    // Videos can't preview in an <img> — swap in a <video> for video uploads.
    const isVideo = /^video\//.test(file.type);
    let mediaEl: HTMLImageElement | HTMLVideoElement | null = previewImg;
    if (isVideo && preview) {
      let v = preview.querySelector<HTMLVideoElement>("video.pd-preview-vid");
      if (!v) {
        v = document.createElement("video");
        v.className = "pd-preview-vid";
        v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true;
        v.setAttribute("style", "display:block;width:100%;max-height:220px;object-fit:cover;");
        if (previewImg) { previewImg.style.display = "none"; previewImg.parentElement?.insertBefore(v, previewImg); }
        else preview.insertBefore(v, preview.firstChild);
      }
      v.style.display = "block";
      mediaEl = v;
    } else if (previewImg) {
      previewImg.style.display = "block";
    }
    if (mediaEl) mediaEl.src = localUrl;
    if (zone) zone.style.display = "none";
    if (preview) { preview.classList.remove("hidden"); preview.style.display = "block"; }
    if (status) { status.textContent = "Uploading…"; status.style.color = "var(--pd-ink3)"; }
    if (errorEl) { errorEl.style.display = "none"; errorEl.textContent = ""; }
    const fd = new FormData();
    fd.append("file", file);
    bump(1);
    // Restore the upload box so a failed/timed-out upload is never a dead end.
    // Surface the error on a always-visible banner (the preview status is hidden
    // when we restore the zone — that made failures look like the photo "vanished").
    const restoreZone = (msg: string) => {
      delete fileUrls[key];
      URL.revokeObjectURL(localUrl);
      if (preview) preview.style.display = "none";
      if (zone) zone.style.display = "";
      if (status) { status.textContent = msg; status.style.color = "var(--pd-pink)"; }
      if (errorEl) { errorEl.textContent = msg; errorEl.style.display = "block"; }
      (root as any)._pdUploadError = msg; // surfaced by the caller if needed
    };
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 90000); // never hang forever
    try {
      const r = await fetch("/api/upload", { method: "POST", body: fd, signal: ctrl.signal });
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.url) {
        fileUrls[key] = d.url;
        // Keep the local blob on screen until the hosted URL paints — swapping
        // immediately + revoking the blob made successful uploads look blank
        // when the CDN was slow or briefly unavailable.
        const hosted = String(d.url);
        if (mediaEl) {
          const swap = () => {
            if (mediaEl) mediaEl.src = hosted;
            URL.revokeObjectURL(localUrl);
          };
          if (mediaEl instanceof HTMLImageElement) {
            const probe = new Image();
            probe.onload = swap;
            probe.onerror = () => {
              // Hosted URL failed to load — keep the local preview so the photo
              // doesn't disappear; generate still has the CDN url in fileUrls.
              URL.revokeObjectURL(localUrl);
            };
            probe.src = hosted;
          } else {
            swap();
          }
        } else {
          URL.revokeObjectURL(localUrl);
        }
        if (status) { status.textContent = "✓ Uploaded"; status.style.color = "var(--pd-mint)"; }
        if (errorEl) { errorEl.style.display = "none"; errorEl.textContent = ""; }
      } else {
        const msg = d.error || "Upload failed — try another file.";
        // Auth failures are the most common "photo vanished" report.
        restoreZone(r.status === 401 ? "Sign in to upload your photo." : msg);
      }
    } catch (err) {
      restoreZone((err as Error)?.name === "AbortError" ? "Upload timed out — try a smaller file." : "Upload failed — try again.");
    } finally {
      clearTimeout(timer);
      bump(-1);
    }
  }

  root.querySelectorAll<HTMLInputElement>('input[type="file"][data-field]').forEach((el) => {
    const key = el.dataset.field!;
    const wrap = el.closest(".pd-file-wrap") as HTMLElement|null;
    const isMulti = wrap?.dataset.multiple === "true";
    // `maxFiles` is mutable so callers can raise/lower the cap at runtime (e.g. the
    // studio switching between models with different reference limits).
    let maxFiles = Number(wrap?.dataset.max ?? 4);
    const zone = wrap?.querySelector<HTMLElement>(".pd-upload-zone");

    if (isMulti) {
      const thumbsEl = wrap?.querySelector<HTMLElement>(".pd-multi-previews");
      const registerPortrait = wrap?.dataset.registerPortrait === "true";
      let urls: string[] = [];
      // Maps a displayed (CDN) URL → the value sent to the model. For portrait
      // fields that's the `asset://` id from the Portrait Library; otherwise the
      // URL itself. Lets thumbnails show the real image while generation uses the
      // registered asset id.
      const valueByUrl = new Map<string, string>();

      function syncZone() {
        if (zone) zone.style.display = urls.length >= maxFiles ? "none" : "";
        if (thumbsEl) thumbsEl.style.display = urls.length > 0 ? "flex" : "none";
        fileUrls[key] = urls.length > 0 ? urls.map((u) => valueByUrl.get(u) ?? u) : [];
      }

      // Register one hosted CDN url to the Portrait Library, storing the returned
      // asset:// id as the field value and badging the thumb if it couldn't be
      // saved. Shared by fresh uploads and by "reuse" (which re-registers so a
      // stale asset id from a past generation is never submitted).
      async function registerPortraitFor(url: string, thumb: HTMLElement) {
        bump(1);
        let portrait = false;
        let reason = "";
        try {
          const rr = await fetch("/api/byteplus/portrait", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ url }) });
          const rd = await rr.json().catch(() => ({}));
          if (rr.ok && rd && typeof rd.ref === "string") valueByUrl.set(url, rd.ref);
          portrait = !!(rr.ok && rd && rd.active === true);
          reason = rd && typeof rd.reason === "string" ? rd.reason : "";
        } catch { /* keep the raw URL as the value */ }
        finally { bump(-1); }
        if (!portrait) {
          const busy = reason === "pool_full" || reason === "timeout" || reason === "error";
          const badge = document.createElement("div");
          badge.textContent = "!";
          badge.title =
            reason === "copyright"
              ? "This image looks like copyrighted or watermarked content (e.g. a downloaded/celebrity photo or one with a site watermark), so it can't be registered as a portrait. Use your own photo without watermarks."
              : busy
              ? "Couldn't save this as a portrait right now — the portrait service was busy. Remove and re-upload it in a moment to try again."
              : "Couldn't be saved as a portrait, so it'll be used as-is. That's fine for objects/scenes; if it's a real person, generation may block it — try re-uploading, or use a clearer, front-facing photo.";
          badge.style.cssText = "position:absolute;bottom:3px;left:3px;width:15px;height:15px;border-radius:50%;background:var(--pd-amber);color:#0a0a0b;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:help;z-index:2;";
          thumb.appendChild(badge);
        }
      }

      async function addFile(file: File) {
        if (urls.length >= maxFiles) return;
        const thumb = document.createElement("div");
        thumb.style.cssText = "position:relative;width:70px;height:70px;border-radius:10px;overflow:hidden;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);flex-shrink:0;";
        const img = document.createElement("img");
        img.style.cssText = "width:100%;height:100%;object-fit:cover;";
        img.src = URL.createObjectURL(file);
        const spinner = document.createElement("div");
        spinner.style.cssText = "position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);font-size:9px;color:#fff;";
        spinner.textContent = "↑";
        thumb.appendChild(img); thumb.appendChild(spinner);
        thumbsEl?.appendChild(thumb);
        if (thumbsEl) thumbsEl.style.display = "flex";

        const fd = new FormData(); fd.append("file", file);
        bump(1);
        try {
          const r = await fetch("/api/upload", { method: "POST", body: fd });
          const d = await r.json();
          if (r.ok) {
            const blobSrc = img.src;
            urls.push(d.url);
            img.src = d.url;
            URL.revokeObjectURL(blobSrc);
            const x = document.createElement("button");
            x.type = "button"; x.textContent = "✕";
            x.style.cssText = "position:absolute;top:3px;right:3px;width:16px;height:16px;border-radius:50%;background:rgba(0,0,0,0.65);color:#fff;font-size:9px;border:none;cursor:pointer;line-height:1;";
            x.addEventListener("click", () => { urls = urls.filter(u => u !== d.url); valueByUrl.delete(d.url); thumb.remove(); syncZone(); });
            thumb.appendChild(x);
            // Register real people to the Portrait Library now (spread out per
            // upload) so generation can use them and stays fast. bump() keeps the
            // Generate button waiting until this finishes.
            // Register real people to the Portrait Library now (spread out per
            // upload) so generation can use them and stays fast.
            if (registerPortrait) {
              spinner.textContent = "⋯";
              await registerPortraitFor(d.url, thumb);
            }
            spinner.remove();
          } else { thumb.remove(); }
        } catch { thumb.remove(); }
        finally { bump(-1); }
        syncZone();
      }

      const hl  = () => { if (zone) { zone.style.borderColor="var(--pd-lilac)"; zone.style.background="color-mix(in srgb,var(--pd-lilac) 6%,var(--pd-bg))"; }};
      const uhl = () => { if (zone) { zone.style.borderColor=""; zone.style.background=""; }};
      let dc = 0;
      el.addEventListener("dragenter", e => { e.preventDefault(); if(++dc===1) hl(); });
      el.addEventListener("dragleave", () => { if(--dc===0) uhl(); });
      el.addEventListener("dragover",  e => e.preventDefault());
      el.addEventListener("drop", async e => { e.preventDefault(); dc=0; uhl(); for(const f of Array.from((e as DragEvent).dataTransfer?.files??[]).slice(0,maxFiles-urls.length)) await addFile(f); });
      el.addEventListener("change", async () => { const files=Array.from(el.files??[]).slice(0,maxFiles-urls.length); el.value=""; for(const f of files) await addFile(f); });

      // Render a thumb for an already-hosted URL (preloaded reference images).
      function addExisting(url: string) {
        if (!url || urls.length >= maxFiles) return;
        const thumb = document.createElement("div");
        thumb.style.cssText = "position:relative;width:70px;height:70px;border-radius:10px;overflow:hidden;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);flex-shrink:0;";
        const img = document.createElement("img");
        img.style.cssText = "width:100%;height:100%;object-fit:cover;";
        img.src = url;
        const x = document.createElement("button");
        x.type = "button"; x.textContent = "✕";
        x.style.cssText = "position:absolute;top:3px;right:3px;width:16px;height:16px;border-radius:50%;background:rgba(0,0,0,0.65);color:#fff;font-size:9px;border:none;cursor:pointer;line-height:1;";
        x.addEventListener("click", () => { urls = urls.filter(u => u !== url); thumb.remove(); syncZone(); });
        thumb.appendChild(img); thumb.appendChild(x);
        thumbsEl?.appendChild(thumb);
        urls.push(url);
      }
      // Preload reference images from the field's default.
      try {
        const def = wrap?.dataset.default ? JSON.parse(wrap.dataset.default) : null;
        const arr = Array.isArray(def) ? def : def ? [def] : [];
        for (const u of arr.slice(0, maxFiles)) addExisting(String(u));
      } catch { /* ignore bad default */ }

      // Let external code (e.g. the studio model switcher) change the cap at
      // runtime: relabel, trim any now-excess uploads, and re-sync the dropzone.
      (wrap as any)._pdApplyMax = (n: number) => {
        maxFiles = Number(n) || maxFiles;
        if (wrap) wrap.dataset.max = String(maxFiles);
        const lbl = wrap?.querySelector<HTMLElement>(".pd-file-max");
        if (lbl) lbl.textContent = `up to ${maxFiles} files`;
        while (urls.length > maxFiles) { urls.pop(); thumbsEl?.lastElementChild?.remove(); }
        syncZone();
      };

      // Replace the current uploads with a given set (used by "Reuse" on a past
      // result): items carry a `display` URL (thumbnail) and the model `value`
      // (asset:// id or raw URL) to submit with.
      (wrap as any)._pdSetReferences = (items: { display: string; value?: string }[]) => {
        urls = [];
        valueByUrl.clear();
        if (thumbsEl) thumbsEl.innerHTML = "";
        for (const it of (Array.isArray(items) ? items : []).slice(0, maxFiles)) {
          const disp = it && it.display;
          if (!disp) continue;
          const thumb = document.createElement("div");
          thumb.style.cssText = "position:relative;width:70px;height:70px;border-radius:10px;overflow:hidden;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);flex-shrink:0;";
          const img = document.createElement("img");
          img.style.cssText = "width:100%;height:100%;object-fit:cover;";
          img.src = disp;
          const x = document.createElement("button");
          x.type = "button"; x.textContent = "✕";
          x.style.cssText = "position:absolute;top:3px;right:3px;width:16px;height:16px;border-radius:50%;background:rgba(0,0,0,0.65);color:#fff;font-size:9px;border:none;cursor:pointer;line-height:1;";
          x.addEventListener("click", () => { urls = urls.filter((u) => u !== disp); valueByUrl.delete(disp); thumb.remove(); syncZone(); });
          thumb.appendChild(img); thumb.appendChild(x);
          thumbsEl?.appendChild(thumb);
          urls.push(disp);
          if (it.value && it.value !== disp) valueByUrl.set(disp, it.value);
        }
        syncZone();
      };

      // Load a set of hosted CDN urls as references and (for portrait fields)
      // re-register each so a fresh asset:// id is used — this powers "Reuse"
      // from the gallery, where the original asset id may have expired. Keeps the
      // Generate button waiting (via bump) until every registration settles.
      (wrap as any)._pdLoadReferences = async (list: string[]) => {
        urls = [];
        valueByUrl.clear();
        if (thumbsEl) thumbsEl.innerHTML = "";
        syncZone();
        for (const raw of Array.isArray(list) ? list : []) {
          if (urls.length >= maxFiles) break;
          const url = String(raw || "");
          if (!/^https?:\/\//i.test(url)) continue; // skip asset:// / non-displayable
          const thumb = document.createElement("div");
          thumb.style.cssText = "position:relative;width:70px;height:70px;border-radius:10px;overflow:hidden;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);flex-shrink:0;";
          const img = document.createElement("img");
          img.style.cssText = "width:100%;height:100%;object-fit:cover;";
          img.src = url;
          const x = document.createElement("button");
          x.type = "button"; x.textContent = "✕";
          x.style.cssText = "position:absolute;top:3px;right:3px;width:16px;height:16px;border-radius:50%;background:rgba(0,0,0,0.65);color:#fff;font-size:9px;border:none;cursor:pointer;line-height:1;";
          x.addEventListener("click", () => { urls = urls.filter((u) => u !== url); valueByUrl.delete(url); thumb.remove(); syncZone(); });
          thumb.appendChild(img); thumb.appendChild(x);
          thumbsEl?.appendChild(thumb);
          urls.push(url);
          syncZone();
          if (registerPortrait) {
            const spinner = document.createElement("div");
            spinner.style.cssText = "position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);font-size:9px;color:#fff;";
            spinner.textContent = "⋯";
            thumb.appendChild(spinner);
            await registerPortraitFor(url, thumb);
            spinner.remove();
          }
          syncZone();
        }
        syncZone();
      };

      // Re-register references whose portrait asset was consumed by a finished
      // generation (the server deletes those on completion). Called before a
      // subsequent Generate so a fresh, live asset:// is submitted instead of a
      // deleted one. Only touches the given display URLs.
      (wrap as any)._pdReregister = async (displays: string[]) => {
        if (!registerPortrait || !thumbsEl) return;
        const set = new Set(Array.isArray(displays) ? displays : []);
        for (const thumb of Array.from(thumbsEl.children) as HTMLElement[]) {
          const img = thumb.querySelector("img");
          const url = img?.src;
          if (!url || !set.has(url)) continue;
          thumb.querySelectorAll("div").forEach((d) => { if (d.textContent === "!") d.remove(); });
          const spinner = document.createElement("div");
          spinner.style.cssText = "position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);font-size:9px;color:#fff;";
          spinner.textContent = "⋯";
          thumb.appendChild(spinner);
          await registerPortraitFor(url, thumb);
          spinner.remove();
          syncZone();
        }
      };

      syncZone();
      return;
    }

    // Single-file
    const preview    = wrap?.querySelector<HTMLElement>(".pd-file-preview");
    const previewImg = wrap?.querySelector<HTMLImageElement>(".pd-preview-img");
    const status     = wrap?.querySelector<HTMLElement>(".pd-preview-status");
    const clearBtn   = wrap?.querySelector<HTMLElement>(".pd-file-clear");
    const errorEl    = wrap?.querySelector<HTMLElement>(".pd-upload-error") ?? null;

    el.addEventListener("change", async () => { const f=el.files?.[0]; if(f) await handleUpload(f, key, zone??null, preview??null, previewImg??null, status??null, errorEl); });
    let dc2 = 0;
    const hl2  = () => { if(zone){zone.style.borderColor="var(--pd-lilac)";zone.style.background="color-mix(in srgb,var(--pd-lilac) 6%,var(--pd-bg))";} };
    const uhl2 = () => { if(zone){zone.style.borderColor="";zone.style.background="";} };
    el.addEventListener("dragenter", e=>{e.preventDefault();if(++dc2===1)hl2();});
    el.addEventListener("dragleave",  ()=>{if(--dc2===0)uhl2();});
    el.addEventListener("dragover",   e=>e.preventDefault());
    el.addEventListener("drop", async e=>{e.preventDefault();dc2=0;uhl2();const f=(e as DragEvent).dataTransfer?.files?.[0];if(f)await handleUpload(f,key,zone??null,preview??null,previewImg??null,status??null,errorEl);});
    clearBtn?.addEventListener("click",()=>{
      delete fileUrls[key];
      el.value="";
      if(previewImg)previewImg.src="";
      if(preview)preview.style.display="none";
      if(zone)zone.style.display="";
      if(errorEl){errorEl.style.display="none";errorEl.textContent="";}
    });

    // Preload a reference image from the field's default.
    try {
      const def = wrap?.dataset.default ? JSON.parse(wrap.dataset.default) : null;
      const url = Array.isArray(def) ? def[0] : def;
      if (url) {
        fileUrls[key] = String(url);
        if (previewImg) previewImg.src = String(url);
        if (preview) { preview.classList.remove("hidden"); preview.style.display = "block"; }
        if (zone) zone.style.display = "none";
        if (status) { status.textContent = "Reference image (replace if you like)"; status.style.color = "var(--pd-ink3)"; }
      }
    } catch { /* ignore bad default */ }
  });

  // Thumbnail-card option groups (a <select> whose options carry images). Clicks
  // update the sibling hidden input so pdCollectFieldValues picks up the value.
  root.querySelectorAll<HTMLElement>(".pd-opt-cards").forEach((group) => {
    const hidden = group.parentElement?.querySelector<HTMLInputElement>('input[type="hidden"][data-field]');
    const cards = Array.from(group.querySelectorAll<HTMLElement>(".pd-opt-card"));
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (hidden) hidden.value = card.dataset.val ?? "";
        cards.forEach((c) => {
          const on = c === card;
          c.dataset.active = on ? "true" : "false";
          c.style.borderColor = on ? "var(--pd-lilac)" : "var(--pd-hairline2)";
          c.style.background = on ? "color-mix(in srgb,var(--pd-lilac) 8%,var(--pd-bg))" : "var(--pd-bg)";
        });
      });
    });
  });

  // Segmented button option groups (plain select fields rendered as buttons).
  root.querySelectorAll<HTMLElement>(".pd-opt-segs").forEach((group) => {
    const hidden = group.parentElement?.querySelector<HTMLInputElement>('input[type="hidden"][data-field]');
    const segs = Array.from(group.querySelectorAll<HTMLElement>(".pd-opt-seg"));
    segs.forEach((seg) => {
      seg.addEventListener("click", () => {
        if (hidden) {
          hidden.value = seg.dataset.val ?? "";
          hidden.dispatchEvent(new Event("change", { bubbles: true }));
        }
        segs.forEach((s) => {
          const on = s === seg;
          s.dataset.active = on ? "true" : "false";
          s.style.background = on ? "var(--pd-ink)" : "var(--pd-bg)";
          s.style.color = on ? "var(--pd-bg)" : "var(--pd-ink)";
          s.style.borderColor = on ? "transparent" : "var(--pd-hairline2)";
        });
      });
    });
  });

  // ── @-mention autocomplete ────────────────────────────────────────────────
  // A textarea with data-mention-from="<fileKey>" gets an @-picker that inserts
  // @Image1, @Image2, … for the images uploaded in that multi-file field (in
  // upload order). Lets users "call" a reference into the prompt by typing @.
  function setupMention(textarea: HTMLTextAreaElement) {
    const fromKey = textarea.dataset.mentionFrom;
    if (!fromKey) return;
    const label = textarea.dataset.mentionLabel || "Image";
    const wrap = textarea.parentElement as HTMLElement | null;
    if (!wrap) return;
    if (getComputedStyle(wrap).position === "static") wrap.style.position = "relative";

    const menu = document.createElement("div");
    menu.className = "pd-mention-menu";
    menu.style.cssText =
      "display:none;position:absolute;z-index:60;max-height:220px;overflow-y:auto;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);border-radius:12px;box-shadow:0 14px 34px rgba(0,0,0,0.45);padding:5px;";
    wrap.appendChild(menu);

    let items: { el: HTMLElement; tag: string }[] = [];
    let active = -1;

    const urls = (): string[] => {
      const v = (fileUrls as Record<string, unknown>)[fromKey];
      if (Array.isArray(v)) return v.filter((u): u is string => typeof u === "string" && u.length > 0);
      return typeof v === "string" && v ? [v] : [];
    };

    // The active @-token immediately before the caret (if any).
    const token = (): { at: number; end: number; query: string } | null => {
      const pos = textarea.selectionStart ?? 0;
      const pre = textarea.value.slice(0, pos);
      const m = /(^|[^\w@])@(\w*)$/.exec(pre);
      if (!m) return null;
      return { at: pos - m[2].length - 1, end: pos, query: m[2] };
    };

    const place = () => {
      menu.style.top = textarea.offsetTop + textarea.offsetHeight + 4 + "px";
      menu.style.left = textarea.offsetLeft + "px";
      menu.style.width = textarea.offsetWidth + "px";
    };
    const hide = () => { menu.style.display = "none"; active = -1; };
    const setActive = (i: number) => {
      active = i;
      items.forEach((it, j) => {
        it.el.style.background = j === i ? "color-mix(in srgb,var(--pd-lilac) 16%,transparent)" : "transparent";
      });
    };
    const choose = (tag: string) => {
      const t = token();
      if (!t) { hide(); return; }
      const before = textarea.value.slice(0, t.at);
      const after = textarea.value.slice(t.end);
      const ins = "@" + tag + " ";
      textarea.value = before + ins + after;
      const caret = (before + ins).length;
      textarea.setSelectionRange(caret, caret);
      textarea.dispatchEvent(new Event("input", { bubbles: true }));
      hide();
      textarea.focus();
    };
    const update = () => {
      const t = token();
      const list = urls();
      if (!t || list.length === 0) { hide(); return; }
      const q = t.query.toLowerCase();
      const opts = list
        .map((url, i) => ({ url, tag: `${label}${i + 1}`, n: i + 1 }))
        .filter((o) => !q || o.tag.toLowerCase().includes(q) || String(o.n) === q);
      if (!opts.length) { hide(); return; }
      menu.innerHTML = "";
      items = opts.map((o) => {
        const b = document.createElement("button");
        b.type = "button";
        b.style.cssText =
          "display:flex;align-items:center;gap:9px;width:100%;padding:6px 7px;border-radius:9px;cursor:pointer;background:transparent;border:none;text-align:left;color:var(--pd-ink);";
        b.innerHTML =
          `<span style="width:34px;height:34px;border-radius:7px;overflow:hidden;flex:none;background:var(--pd-bg3);display:block;">` +
          `<img src="${o.url}" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" /></span>` +
          `<span style="font-size:13px;font-weight:600;">@${o.tag}</span>`;
        b.addEventListener("mousedown", (e) => { e.preventDefault(); choose(o.tag); });
        menu.appendChild(b);
        return { el: b, tag: o.tag };
      });
      items.forEach((it, i) => it.el.addEventListener("mouseenter", () => setActive(i)));
      place();
      menu.style.display = "block";
      setActive(0);
    };

    textarea.addEventListener("input", update);
    textarea.addEventListener("click", update);
    textarea.addEventListener("keyup", (e) => {
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) update();
    });
    textarea.addEventListener("keydown", (e) => {
      if (menu.style.display === "none") return;
      if (e.key === "ArrowDown") { e.preventDefault(); if (items.length) setActive((active + 1) % items.length); }
      else if (e.key === "ArrowUp") { e.preventDefault(); if (items.length) setActive((active - 1 + items.length) % items.length); }
      else if (e.key === "Enter" || e.key === "Tab") { if (items.length && active >= 0) { e.preventDefault(); choose(items[active].tag); } }
      else if (e.key === "Escape") { e.preventDefault(); hide(); }
    });
    textarea.addEventListener("blur", () => setTimeout(hide, 150));
  }
  root.querySelectorAll<HTMLTextAreaElement>("textarea[data-field][data-mention-from]").forEach(setupMention);
};

// ── Collect all field values ──────────────────────────────────────────────────
(window as any).pdCollectFieldValues = function(root: HTMLElement, fileUrls: Record<string, any>): Record<string, any> {
  const out: Record<string, any> = {};
  root.querySelectorAll<HTMLElement>("[data-field]").forEach((el) => {
    const key = (el as HTMLInputElement).dataset.field!;
    if ((el as HTMLInputElement).type === "file") {
      if (fileUrls[key] != null) out[key] = fileUrls[key];
      return;
    }
    out[key] = (el as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value;
  });
  return out;
};

// Auto-init any .pd-field-panel already in the DOM (server-rendered, e.g. studio)
document.querySelectorAll<HTMLElement>(".pd-field-panel[id]").forEach((panel) => {
  const fileUrls: Record<string, any> = {};
  (panel as any)._pdFileUrls = fileUrls;
  (window as any).pdInitFieldPanel(panel, fileUrls);
});
</script>

---
// First-visit welcome modal for logged-out visitors — mini signup tease that
// routes to /auth/sign-in?mode=signup. Left panel cycles through product covers.
export interface WelcomeSlide {
  type: "image" | "video";
  url: string;
  kicker: string;
  title: string;
}

interface Props {
  slides?: WelcomeSlide[];
}

const fallbackSlides: WelcomeSlide[] = [
  {
    type: "image",
    url: "https://pixiecdn.b-cdn.net/uploads/ry1mTnFZgZYzASRGD2N0A6TbW5k1/460b0afa-5fb6-49bc-b181-a817c1702406.png",
    kicker: "Presets",
    title: "100+ HD filters\nin one tap.",
  },
  {
    type: "image",
    url: "https://pixiecdn.b-cdn.net/gen_d80b0323-9f76-44ee-bb08-a6aed948e196_1784030343604.png",
    kicker: "Hair color",
    title: "Try every shade\nbefore you commit.",
  },
  {
    type: "video",
    url: "https://pixiecdn.b-cdn.net/uploads/ry1mTnFZgZYzASRGD2N0A6TbW5k1/f6aaf3b6-c283-4204-85f9-26efbc5951ea.mp4",
    kicker: "Makeup",
    title: "Glow-up looks\nin seconds.",
  },
  {
    type: "video",
    url: "https://pixiecdn.b-cdn.net/uploads/ry1mTnFZgZYzASRGD2N0A6TbW5k1/eb9f7e39-8980-4d2b-90b3-acfd64a8fff0.mp4",
    kicker: "Video",
    title: "Motion that\nstops the scroll.",
  },
];

const slides = (Astro.props.slides?.length ? Astro.props.slides : fallbackSlides).filter((s) => !!s.url);
---

<div
  id="pd-welcome"
  class="pd-welcome"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="pd-welcome-title"
  style="position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(6,6,8,0.72);backdrop-filter:blur(14px);"
>
  <div
    class="pd-welcome-card"
    style="position:relative;width:min(920px,100%);max-height:min(88vh,720px);overflow:hidden;border-radius:22px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg2);box-shadow:0 40px 100px rgba(0,0,0,0.55);display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,0.95fr);"
  >
    <button
      type="button"
      id="pd-welcome-close"
      aria-label="Close"
      style="position:absolute;top:12px;right:12px;z-index:2;width:34px;height:34px;border-radius:999px;border:0.5px solid rgba(255,255,255,0.18);background:rgba(10,10,11,0.45);color:#fff;cursor:pointer;font-size:18px;line-height:1;backdrop-filter:blur(8px);"
    >×</button>

    <div class="pd-welcome-media" style="position:relative;min-height:220px;overflow:hidden;background:var(--pd-bg3);">
      {
        slides.map((sl, idx) => (
          <div
            class="pd-welcome-slide absolute inset-0 transition-opacity duration-[700ms]"
            data-idx={idx}
            data-kicker={sl.kicker}
            data-title={sl.title.replace(/\n/g, "<br>")}
            style={`opacity:${idx === 0 ? 1 : 0};`}
          >
            {sl.type === "video" ? (
              <video
                class="pd-welcome-video absolute inset-0 h-full w-full object-cover"
                src={sl.url}
                muted
                loop
                playsinline
                preload={idx === 0 ? "auto" : "metadata"}
              />
            ) : (
              <img class="absolute inset-0 h-full w-full object-cover" src={sl.url} alt={sl.kicker} />
            )}
          </div>
        ))
      }
      <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.08) 45%, rgba(0,0,0,0.72) 100%);pointer-events:none;"></div>
      <div style="position:absolute;left:18px;top:16px;display:flex;align-items:center;gap:8px;z-index:1;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="11" stroke="#fff" stroke-width="1.4"></circle>
          <circle cx="12" cy="12" r="5.5" fill="#fff"></circle>
          <circle cx="12" cy="12" r="2" fill="rgba(10,10,11,0.9)"></circle>
        </svg>
        <span class="font-display font-semibold text-white" style="font-size:15px;letter-spacing:-0.35px;">PixieDust</span>
      </div>
      <div style="position:absolute;left:18px;right:18px;bottom:16px;z-index:1;">
        <div id="pd-welcome-kicker" class="font-mono uppercase" style="font-size:9.5px;color:rgba(255,255,255,0.7);letter-spacing:1.1px;">{slides[0]?.kicker}</div>
        <div id="pd-welcome-slide-title" class="font-display font-medium text-white" style="margin-top:6px;font-size:22px;letter-spacing:-0.55px;line-height:1.05;" set:html={slides[0]?.title.replace(/\n/g, "<br>") ?? ""} />
        <div id="pd-welcome-pips" class="mt-3 flex gap-1.5">
          {
            slides.map((_, idx) => (
              <button
                type="button"
                class="pd-welcome-pip"
                data-idx={idx}
                aria-label={`Slide ${idx + 1}`}
                style={`width:${idx === 0 ? 20 : 6}px;height:6px;border-radius:6px;border:none;cursor:pointer;padding:0;background:${idx === 0 ? "#fff" : "rgba(255,255,255,0.35)"};transition:width 280ms;`}
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="pd-welcome-body" style="padding:28px 26px 24px;display:flex;flex-direction:column;justify-content:center;">
      <div class="font-mono font-semibold uppercase" style="font-size:10px;color:var(--pd-lilac);letter-spacing:1.1px;">Sign up · 5 free credits</div>
      <h2 id="pd-welcome-title" class="font-display font-medium text-ink" style="margin-top:8px;font-size:clamp(24px,3.4vw,30px);letter-spacing:-0.8px;line-height:1.08;">
        Glow up your pics and vids with 100+ HD Filters
      </h2>
      <p class="text-ink-3" style="margin-top:10px;font-size:13.5px;line-height:1.5;letter-spacing:-0.1px;">
        Pro-level editing tools for photos and videos, free to join. Try it out with 5 free credits!
      </p>

      <div style="margin-top:18px;display:flex;flex-direction:column;gap:8px;">
        <a
          id="pd-welcome-cta"
          href="/auth/sign-in?mode=signup"
          class="rounded-[11px] font-bold text-center"
          style="padding:13px 16px;font-size:14px;background:var(--pd-lilac);color:#0A0A0B;text-decoration:none;"
        >Start creating free</a>
        <button
          type="button"
          id="pd-welcome-later"
          class="rounded-[11px] font-semibold"
          style="padding:11px 16px;font-size:13px;background:transparent;border:0.5px solid var(--pd-hairline2);color:var(--pd-ink2);cursor:pointer;"
        >Maybe later</button>
      </div>

      <p class="font-mono" style="margin-top:14px;font-size:10px;color:var(--pd-ink4);letter-spacing:0.3px;">
        Already have an account?
        <a href="/auth/sign-in?mode=login" id="pd-welcome-login" style="color:var(--pd-ink3);">Sign in</a>
      </p>
    </div>
  </div>
</div>

<style>
  @media (max-width: 760px) {
    .pd-welcome-card {
      grid-template-columns: 1fr !important;
      max-height: min(92vh, 780px) !important;
      overflow: auto !important;
    }
    .pd-welcome-media {
      min-height: 190px !important;
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "pd-welcome-seen";
    var host = document.getElementById("pd-welcome");
    if (!host) return;
    if (localStorage.getItem(KEY)) return;
    var path = location.pathname || "";
    if (path.indexOf("/auth") === 0 || path.indexOf("/admin") === 0) return;

    var slides = Array.prototype.slice.call(host.querySelectorAll(".pd-welcome-slide"));
    var pips = Array.prototype.slice.call(host.querySelectorAll(".pd-welcome-pip"));
    var kickerEl = document.getElementById("pd-welcome-kicker");
    var titleEl = document.getElementById("pd-welcome-slide-title");
    var cur = 0;
    var timer = null;
    var shown = false;

    function playActive() {
      slides.forEach(function (sl, i) {
        var v = sl.querySelector("video");
        if (!v) return;
        if (i === cur) {
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        } else {
          try { v.pause(); } catch (e) {}
        }
      });
    }

    function go(i) {
      if (!slides.length) return;
      cur = (i + slides.length) % slides.length;
      slides.forEach(function (sl, idx) {
        sl.style.opacity = idx === cur ? "1" : "0";
      });
      pips.forEach(function (pip, idx) {
        pip.style.width = idx === cur ? "20px" : "6px";
        pip.style.background = idx === cur ? "#fff" : "rgba(255,255,255,0.35)";
      });
      var active = slides[cur];
      if (kickerEl) kickerEl.textContent = active.getAttribute("data-kicker") || "";
      if (titleEl) titleEl.innerHTML = active.getAttribute("data-title") || "";
      playActive();
    }

    function startRotate() {
      stopRotate();
      if (slides.length < 2) return;
      timer = setInterval(function () { go(cur + 1); }, 3200);
    }
    function stopRotate() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    pips.forEach(function (pip) {
      pip.addEventListener("click", function () {
        go(Number(pip.getAttribute("data-idx")) || 0);
        startRotate();
      });
    });

    function markSeen() {
      try { localStorage.setItem(KEY, "1"); } catch (e) {}
    }
    function hide() {
      stopRotate();
      host.style.display = "none";
      host.hidden = true;
      document.documentElement.style.removeProperty("overflow");
      slides.forEach(function (sl) {
        var v = sl.querySelector("video");
        if (v) try { v.pause(); } catch (e) {}
      });
    }
    function show() {
      if (shown) return;
      if (document.documentElement.getAttribute("data-auth") === "in") return;
      if (localStorage.getItem(KEY)) return;
      shown = true;
      host.hidden = false;
      host.style.display = "flex";
      document.documentElement.style.overflow = "hidden";
      go(0);
      startRotate();
    }
    function dismiss() {
      markSeen();
      hide();
    }

    document.getElementById("pd-welcome-close")?.addEventListener("click", dismiss);
    document.getElementById("pd-welcome-later")?.addEventListener("click", dismiss);
    document.getElementById("pd-welcome-cta")?.addEventListener("click", markSeen);
    document.getElementById("pd-welcome-login")?.addEventListener("click", markSeen);
    host.addEventListener("click", function (e) {
      if (e.target === host) dismiss();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && host.style.display === "flex") dismiss();
    });

    // Delay so visitors (esp. Snap lens traffic) can browse before the signup tease.
    if (document.documentElement.getAttribute("data-auth") === "in") return;
    setTimeout(show, 30000);
  })();
</script>

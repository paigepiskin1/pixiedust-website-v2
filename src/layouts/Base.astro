---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Full URL to a 1200×630 share image. Defaults to /og-default.png */
  ogImage?: string;
  /** "website" | "article" — defaults to "website" */
  ogType?: string;
  /** Pass true for admin/account/studio pages to suppress indexing */
  noindex?: boolean;
  /** Optional extra JSON-LD object (stringified) to inject alongside the base schema */
  jsonLd?: string;
}

const {
  title = "PixieDust",
  description = "Your pocket creative studio, in your browser.",
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const SITE = "https://pixiedustapp.com";
const canonicalURL = new URL(Astro.url.pathname, SITE).href;
const resolvedOgImage = ogImage ?? `${SITE}/og-default.png`;

// Base WebSite + WebApplication JSON-LD — always present on every page
const baseJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "PixieDust",
      url: SITE,
      logo: {
        "@type": "ImageObject",
        url: `${SITE}/favicon.svg`,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "PixieDust",
      description: "AI-powered creative studio — generate images and videos in seconds.",
      publisher: { "@id": `${SITE}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: `${SITE}/explore?q={search_term_string}` },
        "query-input": "required name=search_term_string",
      },
    },
    ...(jsonLd ? [JSON.parse(jsonLd)] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="PixieDust" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pixiedustapp" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Icons + theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#7c3aed" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />

    <!-- Restore persisted theme + sidebar state before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var el = document.documentElement;
          if (localStorage.getItem("pd-web-theme") === "light") el.setAttribute("data-theme", "light");
          if (localStorage.getItem("pd-web-sidebar") === "collapsed") el.setAttribute("data-sidebar", "collapsed");
          var qp = new URLSearchParams(location.search);
          // Capture an invite code (?ref=CODE) into a cookie so it survives the
          // sign-in redirect; the session endpoint reads it to grant referral credits.
          var ref = qp.get("ref");
          if (ref && /^[a-z0-9]{4,16}$/i.test(ref)) {
            document.cookie = "pd_ref=" + encodeURIComponent(ref) + ";path=/;max-age=" + 60 * 60 * 24 * 60 + ";samesite=lax";
          }
          // First-touch acquisition attribution: capture utm_* / ad-click ids /
          // external referrer once, persist 90d. The session endpoint stores it
          // on the user row when the account is first created.
          var attr = {};
          ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid", "fbclid", "ttclid"].forEach(function (k) {
            var v = qp.get(k);
            if (v) attr[k] = v.slice(0, 128);
          });
          var rf = document.referrer || "";
          var external = rf && rf.indexOf(location.host) === -1;
          var attrSet = document.cookie.split("; ").some(function (c) { return c.indexOf("pd_attr=") === 0; });
          if (!attrSet && (Object.keys(attr).length || external)) {
            if (external) attr.referrer = rf.slice(0, 256);
            attr.landing = location.pathname.slice(0, 128);
            document.cookie = "pd_attr=" + encodeURIComponent(JSON.stringify(attr)) + ";path=/;max-age=" + 60 * 60 * 24 * 90 + ";samesite=lax";
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Clicky analytics (site 101479986 — same property the admin dashboard reads) -->
    <script async data-id="101479986" src="https://static.getclicky.com/js" is:inline></script>
  </head>
  <body>
    <slot />
  </body>
</html>

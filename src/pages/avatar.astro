---
// Tattoo Studio — a bespoke try-on workspace. Upload a photo, pick a body area,
// choose (and combine) premade tattoo packs, and generate. Reuses the shared
// generation pipeline via the hidden `tattoo-studio` template + /api/generate.
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import FieldPanel from "../components/FieldPanel.astro";
import type { TemplateField } from "../lib/templates";
import { getTemplate } from "../lib/templates";
import { AREAS, TATTOO_PACKS, TATTOO_BASE_RULE } from "../lib/tattoo-packs";

const db = Astro.locals.runtime.env.DB;
let template = null;
try {
  template = await getTemplate(db, "tattoo-studio");
} catch { /* D1 unavailable — fall back to defaults below */ }
const creditCost = template?.creditCost ?? 10;
const credits = Astro.locals.user?.credits ?? 0;
const signedIn = !!Astro.locals.user;

const personField: TemplateField[] = [
  { key: "person", type: "file", label: "Your photo", required: true, accept: "image/*", help: "Upload a clear, close-up photo of the area you want inked" },
];

const config = {
  templateId: "tattoo-studio",
  creditCost,
  credits,
  signedIn,
  baseRule: TATTOO_BASE_RULE,
  packs: Object.fromEntries(TATTOO_PACKS.map((p) => [p.id, p.prompt])),
  labels: Object.fromEntries(TATTOO_PACKS.map((p) => [p.id, p.label])),
};
---

<AppShell title="Tattoo Studio — PixieDust" description="Try on tattoos before you commit. Upload a photo of your face, neck, arms, or torso and apply premade fine-line tattoo packs instantly with AI." credits={credits}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <div class="grid gap-6 lg:grid-cols-[300px_minmax(0,1.15fr)_minmax(0,1fr)] lg:[grid-auto-rows:1fr] lg:min-h-[calc(100vh-128px)]">

      <!-- LEFT: intro -->
      <aside class="lg:sticky lg:top-[88px] lg:self-start">
        <div class="mb-[7px] flex items-center gap-[7px]">
          <span class="inline-block shrink-0 rounded-full" style="width:5px;height:5px;background:var(--pd-lilac);box-shadow:0 0 10px color-mix(in srgb,var(--pd-lilac) 50%,transparent);"></span>
          <span class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:1.1px;">Tattoo try-on · fine-line</span>
        </div>
        <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;line-height:1.05;">Tattoo Studio</h1>
        <p class="mt-2 text-ink-3" style="font-size:13px;line-height:1.5;">
          See how ink looks on <em>you</em> before you commit. Upload a photo, pick an area, and combine premade packs.
        </p>
        <div class="mt-3 overflow-hidden rounded-[18px]" style="border:0.5px solid var(--pd-hairline);aspect-ratio:3/4;background:var(--pd-bg2);">
          {template?.previewImage && <img src={template.previewImage} alt="Tattoo Studio example" class="h-full w-full object-cover" />}
        </div>
        <div class="mt-3.5 rounded-2xl" style="padding:15px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div class="mb-2.5 font-mono uppercase" style="font-size:9px;color:var(--pd-ink3);letter-spacing:0.7px;">How it works</div>
          <ol class="flex flex-col gap-2.5" style="list-style:none;padding:0;margin:0;">
            {["Upload a clear, close-up photo of the area", "Pick a body area, then choose tattoo packs", "Combine as many packs as you like", "Generate — see yourself inked in seconds"].map((step, i) => (
              <li class="flex items-start gap-2.5">
                <span class="flex shrink-0 items-center justify-center rounded-full font-mono font-semibold" style="width:18px;height:18px;font-size:10px;background:color-mix(in srgb,var(--pd-lilac) 18%,transparent);color:var(--pd-lilac);margin-top:1px;">{i + 1}</span>
                <span class="text-ink-2" style="font-size:12px;line-height:1.4;">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- CENTER: inputs -->
      <section class="lg:sticky lg:top-[88px] lg:self-start">
        <div class="rounded-2xl" style="padding:20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div class="mb-3 font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.7px;">Your photo</div>
          <FieldPanel fields={personField} id="pd-tattoo-upload" />

          <!-- Body area -->
          <div class="mt-5">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Body area</span>
            <div id="pd-area-tabs" class="flex flex-wrap gap-1.5">
              {AREAS.map((a, i) => (
                <button type="button" class="pd-seg rounded-lg font-semibold" data-area={a.id} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{a.label}</button>
              ))}
            </div>
          </div>

          <!-- Pack gallery -->
          <div class="mt-4">
            <div class="mb-1.5 flex items-center justify-between">
              <span class="font-medium text-ink" style="font-size:12.5px;">Tattoo packs <span class="text-ink-3" style="font-weight:400;">· tap to combine</span></span>
              <button type="button" id="pd-clear-packs" class="font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.5px;background:none;border:none;cursor:pointer;">Clear</button>
            </div>
            <div id="pd-pack-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;">
              {TATTOO_PACKS.map((p) => (
                <button type="button" class="pd-pack-card" data-pack-id={p.id} data-area={p.area} data-active="false" style="display:flex;flex-direction:column;gap:0;padding:0;border-radius:12px;cursor:pointer;text-align:left;overflow:hidden;background:var(--pd-bg);border:1px solid var(--pd-hairline2);transition:border-color 120ms,transform 120ms;">
                  <div style="position:relative;width:100%;aspect-ratio:3/4;background:var(--pd-bg3);">
                    <img src={p.preview} alt={p.label} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
                    <span class="pd-pack-check" style="display:none;position:absolute;top:6px;right:6px;width:20px;height:20px;border-radius:50%;background:var(--pd-lilac);color:#0A0A0B;font-size:11px;font-weight:700;align-items:center;justify-content:center;">✓</span>
                  </div>
                  <div style="padding:7px 9px 9px;">
                    <div class="text-ink" style="font-size:12px;font-weight:600;line-height:1.2;">{p.label}</div>
                    <div class="text-ink-3" style="font-size:10.5px;line-height:1.3;margin-top:2px;">{p.blurb}</div>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <!-- Selected summary -->
          <div id="pd-selected-wrap" class="mt-4" style="display:none;">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Selected <span id="pd-selected-count" class="text-ink-3" style="font-weight:400;"></span></span>
            <div id="pd-selected-chips" class="flex flex-wrap gap-1.5"></div>
          </div>

          <!-- Outputs -->
          <div class="mt-4">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Outputs <span class="text-ink-3" style="font-weight:400;">· generated in parallel</span></span>
            <div class="flex flex-wrap gap-1.5" id="pd-qty">
              {[1, 2, 3, 4].map((n, i) => (
                <button type="button" class="pd-seg rounded-lg font-semibold" data-val={n} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{n}</button>
              ))}
            </div>
          </div>

          <div id="pd-gen-error" class="mt-3 hidden rounded-lg" style="padding:9px 12px;background:color-mix(in srgb, var(--pd-pink) 12%, transparent);border:0.5px solid color-mix(in srgb, var(--pd-pink) 40%, transparent);color:var(--pd-pink);font-size:12.5px;"></div>

          <button id="pd-generate" type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl font-bold" style="padding:13px 16px;background:var(--pd-lilac);color:#0A0A0B;font-size:14px;letter-spacing:-0.1px;cursor:pointer;">
            <span id="pd-gen-label">Generate · {creditCost} cr</span>
          </button>
          <div class="mt-2 text-center font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink4);letter-spacing:0.5px;">PixieDust · ~1 min</div>
        </div>
      </section>

      <!-- RIGHT: results -->
      <section class="flex">
        <div class="relative w-full overflow-y-auto rounded-[20px]" style="height:100%;min-height:480px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div id="pd-out-empty" class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
            <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full" style="background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-ink3)" stroke-width="1.4" stroke-linecap="round"><path d="M10 3v3M10 14v3M3 10h3M14 10h3M5 5l2 2M13 13l2 2M15 5l-2 2M5 15l2-2" /></svg>
            </div>
            <div class="text-ink-3" style="font-size:13px;">Your inked results appear here. Combine packs and run as many as you like.</div>
          </div>
          <div id="pd-jobs" class="grid gap-3" style="padding:14px;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));"></div>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="pd-tattoo-config" is:inline set:html={JSON.stringify(config)}></script>

  <style>
    .pd-seg { background: var(--pd-bg); color: var(--pd-ink2); border: 0.5px solid var(--pd-hairline2); }
    .pd-seg[data-active="true"] { background: var(--pd-ink); color: var(--pd-bg); border-color: transparent; }
    .pd-pack-card:hover { transform: translateY(-2px); border-color: var(--pd-hairline3); }
    .pd-pack-card[data-active="true"] { border-color: var(--pd-lilac); }
    .pd-pack-card[data-active="true"] .pd-pack-check { display: flex !important; }
    @keyframes pd-spin { to { transform: rotate(360deg); } }
  </style>

  <script>
    const cfg = JSON.parse(document.getElementById("pd-tattoo-config")!.textContent || "{}");
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    let credits: number = Number(cfg.credits) || 0;
    let activeJobs = 0;
    const selected: string[] = [];

    const panel = document.getElementById("pd-tattoo-upload") as HTMLElement;
    const genBtn = $("#pd-generate") as HTMLButtonElement;
    const genLabel = $("#pd-gen-label");
    const errEl = $("#pd-gen-error");
    const emptyEl = $("#pd-out-empty");
    const jobsEl = $("#pd-jobs");

    function quantity(): number {
      const a = document.querySelector<HTMLElement>('#pd-qty .pd-seg[data-active="true"]');
      return Number(a?.dataset.val) || 1;
    }
    function cost(): number { return (Number(cfg.creditCost) || 10) * quantity(); }

    function refreshButton() {
      const c = cost();
      if (!cfg.signedIn) { genLabel.textContent = "Sign in to generate"; return; }
      if (!selected.length) { genLabel.textContent = "Pick a tattoo pack"; genBtn.style.opacity = "0.6"; return; }
      genBtn.style.opacity = "1";
      if (credits < c) {
        genLabel.textContent = `Get more credits · need ${c} cr`;
        genBtn.style.background = "transparent"; genBtn.style.color = "var(--pd-ink)"; genBtn.style.border = "0.5px solid var(--pd-hairline2)";
      } else {
        genLabel.textContent = `Generate · ${c} cr`;
        genBtn.style.background = "var(--pd-lilac)"; genBtn.style.color = "#0A0A0B"; genBtn.style.border = "none";
      }
    }

    // ── Area tabs ──
    document.querySelectorAll<HTMLElement>("#pd-area-tabs .pd-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-area-tabs .pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        filterPacks(btn.dataset.area!);
      });
    });
    function filterPacks(area: string) {
      document.querySelectorAll<HTMLElement>(".pd-pack-card").forEach((c) => {
        c.style.display = c.dataset.area === area ? "flex" : "none";
      });
    }
    filterPacks(cfg.packs && Object.keys(cfg.packs).length ? (document.querySelector<HTMLElement>("#pd-area-tabs .pd-seg")!.dataset.area as string) : "face");

    // ── Pack selection (multi / combine) ──
    const packLabel: Record<string, string> = cfg.labels || {};
    document.querySelectorAll<HTMLElement>(".pd-pack-card").forEach((card) => {
      const id = card.dataset.packId!;
      card.addEventListener("click", () => {
        const i = selected.indexOf(id);
        if (i >= 0) { selected.splice(i, 1); card.dataset.active = "false"; }
        else { selected.push(id); card.dataset.active = "true"; }
        renderSelected();
        refreshButton();
      });
    });
    $("#pd-clear-packs").addEventListener("click", () => {
      selected.length = 0;
      document.querySelectorAll<HTMLElement>(".pd-pack-card").forEach((c) => (c.dataset.active = "false"));
      renderSelected(); refreshButton();
    });
    function renderSelected() {
      const wrap = $("#pd-selected-wrap");
      const chips = $("#pd-selected-chips");
      const count = $("#pd-selected-count");
      if (!selected.length) { wrap.style.display = "none"; return; }
      wrap.style.display = "block";
      count.textContent = `· ${selected.length}`;
      chips.innerHTML = "";
      selected.forEach((id) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.style.cssText = "display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:color-mix(in srgb,var(--pd-lilac) 12%,var(--pd-bg));border:0.5px solid color-mix(in srgb,var(--pd-lilac) 40%,transparent);color:var(--pd-ink);font-size:11.5px;cursor:pointer;";
        chip.innerHTML = `${packLabel[id]} <span style="opacity:0.6;font-size:11px;">✕</span>`;
        chip.addEventListener("click", () => {
          const i = selected.indexOf(id);
          if (i >= 0) selected.splice(i, 1);
          const c = document.querySelector<HTMLElement>(`.pd-pack-card[data-pack-id="${id}"]`);
          if (c) c.dataset.active = "false";
          renderSelected(); refreshButton();
        });
        chips.appendChild(chip);
      });
    }

    document.querySelectorAll<HTMLElement>("#pd-qty .pd-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-qty .pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        refreshButton();
      });
    });

    function buildPrompt(): string {
      const frags = selected.map((id) => cfg.packs[id]).filter(Boolean);
      if (!frags.length) return "";
      return `${cfg.baseRule} Tattoos to apply: ${frags.join("; ")}.`;
    }

    // ── Results / polling ──
    function friendlyError(raw: unknown): string {
      const e = String(raw ?? "").replace(/\s*\(refunded\)\s*$/i, "");
      if (/e005|flagged as sensitive|safety|moderation|content policy|nsfw|sensitive/i.test(e))
        return "The model's safety filter blocked this — try a different photo. You weren't charged.";
      if (/rate limit|slow down/i.test(e)) return "Too many requests. You weren't charged — try again in a minute.";
      if (/timeout|timed out/i.test(e)) return "This timed out. You weren't charged — try again.";
      return (e || "Generation failed") + " — you weren't charged.";
    }
    function showError(msg: string) { errEl.textContent = msg; errEl.classList.remove("hidden"); }

    function createTile(): HTMLElement {
      emptyEl.classList.add("hidden");
      const tile = document.createElement("div");
      tile.style.cssText = "position:relative;aspect-ratio:1/1.1;border-radius:14px;overflow:hidden;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);";
      tile.innerHTML =
        '<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:14px;text-align:center;">' +
        '<div style="width:30px;height:30px;border-radius:50%;border:3px solid var(--pd-hairline2);border-top-color:var(--pd-lilac);animation:pd-spin .8s linear infinite;"></div>' +
        '<div class="pd-job-stage font-mono uppercase" style="font-size:9.5px;letter-spacing:.7px;color:var(--pd-ink2);">Submitting…</div>' +
        '</div>';
      jobsEl.prepend(tile);
      return tile;
    }
    function tileStage(tile: HTMLElement, text: string) {
      const s = tile.querySelector<HTMLElement>(".pd-job-stage");
      if (s) s.textContent = text;
    }
    function tileFail(tile: HTMLElement, msg: string) {
      tile.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:14px;text-align:center;color:var(--pd-pink);font-size:11.5px;line-height:1.4;"></div>';
      (tile.firstElementChild as HTMLElement).textContent = msg;
    }
    function tileResult(tile: HTMLElement, outputs: string[], genId?: string) {
      tile.innerHTML = "";
      const url = outputs[0];
      if (!url) { tileFail(tile, "No output."); return; }
      const img = document.createElement("img");
      img.src = url;
      img.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;cursor:zoom-in;";
      img.addEventListener("click", () => openLb(url));
      tile.appendChild(img);
      const dl = document.createElement("a");
      dl.href = genId ? `/api/download?id=${encodeURIComponent(genId)}` : url;
      if (!genId) dl.setAttribute("download", "");
      dl.textContent = "↓"; dl.title = "Download";
      dl.style.cssText = "position:absolute;right:7px;bottom:7px;width:24px;height:24px;border-radius:6px;background:rgba(10,10,11,.7);backdrop-filter:blur(6px);color:#fff;font-size:14px;text-decoration:none;display:flex;align-items:center;justify-content:center;";
      tile.appendChild(dl);
    }

    // Minimal lightbox
    let lbEl: HTMLElement | null = null;
    function openLb(url: string) {
      if (!lbEl) {
        lbEl = document.createElement("div");
        lbEl.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.92);backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:center;cursor:zoom-out;";
        lbEl.addEventListener("click", () => { lbEl!.style.display = "none"; document.body.style.overflow = ""; });
        document.body.appendChild(lbEl);
      }
      lbEl.innerHTML = `<img src="${url}" style="max-width:94vw;max-height:90vh;border-radius:14px;object-fit:contain;" />`;
      lbEl.style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    async function poll(id: string, tile: HTMLElement): Promise<void> {
      const stages = ["Reading your photo", "Inking the design", "Refining", "Almost there"];
      let tick = 0;
      while (true) {
        await new Promise((r) => setTimeout(r, 2000));
        tick++;
        let data: any;
        try { data = await (await fetch(`/api/generate/status?id=${id}`)).json(); } catch { continue; }
        tileStage(tile, (stages[Math.min(tick, stages.length - 1)]) + "…");
        if (data.status === "completed") { tileResult(tile, data.outputs || [], id); return; }
        if (data.status === "failed") { credits += Number(cfg.creditCost) || 0; refreshButton(); tileFail(tile, friendlyError(data.error)); return; }
      }
    }

    async function launchJob(inputs: Record<string, unknown>) {
      const tile = createTile();
      activeJobs++;
      credits -= Number(cfg.creditCost) || 0;
      refreshButton();
      try {
        const res = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ templateId: cfg.templateId, inputs, quantity: 1 }),
        });
        const data = await res.json();
        if (!res.ok) {
          credits += Number(cfg.creditCost) || 0; refreshButton();
          if (data.needCredits) { tile.remove(); window.location.href = "/credits"; }
          else tileFail(tile, friendlyError(data.error || "Could not start generation."));
          return;
        }
        await poll(data.id, tile);
      } catch {
        credits += Number(cfg.creditCost) || 0; refreshButton();
        tileFail(tile, "Network error — try again.");
      } finally {
        activeJobs = Math.max(0, activeJobs - 1);
      }
    }

    async function generate() {
      if (!cfg.signedIn) { window.location.href = "/auth/sign-in?redirect=" + encodeURIComponent(location.pathname); return; }
      const fileUrls: Record<string, any> = (panel as any)?._pdFileUrls ?? {};
      const person = fileUrls.person;
      if (!person) { showError("Upload a photo first."); return; }
      if (Number((panel as any)?._pdUploading || 0) > 0) { showError("Hang on — your photo is still uploading."); return; }
      if (!selected.length) { showError("Pick at least one tattoo pack."); return; }
      const prompt = buildPrompt();
      const total = cost();
      if (credits < total) { window.location.href = "/credits"; return; }
      errEl.classList.add("hidden");
      const inputs = { person, prompt };
      const n = quantity();
      for (let i = 0; i < n; i++) launchJob(inputs);
    }

    genBtn.addEventListener("click", generate);
    refreshButton();
  </script>
</AppShell>

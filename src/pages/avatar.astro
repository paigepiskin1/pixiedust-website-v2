---
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import FilterableCatalog from "../components/catalog/FilterableCatalog.astro";
import { listTemplates, templateToCard } from "../lib/templates";

const db = Astro.locals.runtime.env.DB;
const items = (await listTemplates(db, { kind: "avatar" })).map(templateToCard);
---

<AppShell title="AI Tattoo Studio — PixieDust" description="Preview tattoo designs on your own body before you commit. 50+ styles — fine-line, traditional, blackwork, and more — rendered in seconds from a single photo." credits={Astro.locals.user?.credits ?? 47}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <PageHeader
      kicker="Preview before you ink · instant"
      title="Tattoo Studio"
      sub="Design and preview tattoos on your own skin — try any style, placement, or size before you commit. No stencils, no guesswork."
    />
    <FilterableCatalog items={items} aspect="1 / 1.3" />
  </div>
</AppShell>

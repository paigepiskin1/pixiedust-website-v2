import AppShell from "../../layouts/AppShell.astro";
import LegalLayout from "../../components/legal/LegalLayout.astro";
import { TERMS } from "../../lib/legal-terms";
---

<AppShell title="Terms of Service — PixyDust">
  <LegalLayout doc={TERMS} />
</AppShell>

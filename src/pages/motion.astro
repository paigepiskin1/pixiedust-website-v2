---
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import FilterableCatalog from "../components/catalog/FilterableCatalog.astro";
import { listTemplates, templateToCard } from "../lib/templates";
import { deriveCats } from "../lib/catalog";

const db = Astro.locals.runtime.env.DB;
const all = await listTemplates(db, { kind: "motion" });

// Motion Transfer is a single flagship tool — open the Kling studio directly
// instead of a catalog. Falls back to a catalog if more motion templates exist.
const flagship = all.find((t) => t.id === "motion-transfer") ?? (all.length === 1 ? all[0] : null);
if (flagship) return Astro.redirect(`/studio/${flagship.id}`);

const items = all.map(templateToCard);
const cats = deriveCats([], items);
---

<AppShell title="AI Motion Transfer — PixieDust" description="Animate any photo with AI motion. Bring portraits and images to life with realistic movement in seconds." credits={Astro.locals.user?.credits ?? 47}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <PageHeader kicker="Photo → motion · Kling" title="Motion Transfer" sub="Bring your photo to life with cinematic AI motion." />
    <FilterableCatalog items={items} categories={cats} aspect="9 / 14" />
  </div>
</AppShell>

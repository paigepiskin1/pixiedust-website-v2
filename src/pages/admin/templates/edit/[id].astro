---
export const prerender = false;
import AdminShell from "../../../../layouts/AdminShell.astro";
import FieldPanel from "../../../../components/FieldPanel.astro";
import { isAdmin } from "../../../../lib/admin";
import { getCategories } from "../../../../lib/categories";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const { id } = Astro.params;
const isNew = id === "new";
const db = Astro.locals.runtime.env.DB;
const categories = await getCategories(db);

interface Row {
  [k: string]: unknown;
}
let row: Row | null = null;
if (!isNew) {
  row = await db.prepare("SELECT * FROM templates WHERE id = ?").bind(id).first<Row>();
  if (!row) return Astro.redirect("/admin/templates");
}

const v = (k: string, d = "") => (row && row[k] != null ? String(row[k]) : d);
const DEF_INPUT = '{\n  "prompt": "{{prompt}}",\n  "num_outputs": 1\n}';
const DEF_FIELDS = '[\n  { "key": "prompt", "type": "textarea", "label": "Prompt", "required": true }\n]';

// Recent test results for this template — pick one as the frontend example.
interface ExampleRow { output_url: string; type: string }
let examples: ExampleRow[] = [];
if (!isNew) {
  const r = await db
    .prepare("SELECT output_url, type FROM generations WHERE template_id = ? AND status='completed' AND output_url IS NOT NULL ORDER BY created_at DESC LIMIT 8")
    .bind(id)
    .all<ExampleRow>();
  examples = r.results ?? [];
}
const KINDS = ["preset", "shoot", "cinema", "i2v", "fashion-video", "game-video", "motion", "beauty", "fashion", "avatar", "ad", "motion-upload"];
const TONES = ["teal", "lilac", "mint", "pink", "noir", "dusk", "ice", "amber"];
// Providers that route through SyncNode. Replicate uses "Fetch schema"; for
// byteplus (Ark / Dreamina·Seedance) enter the model id + input_json manually.
const PROVIDERS = ["replicate", "byteplus"];

const inp = "width:100%;padding:10px 12px;border-radius:10px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:13px;outline:none;";
const mono = inp + "font-family:var(--font-mono);font-size:12px;line-height:1.5;";
const lbl = "display:block;margin-bottom:5px;font-family:var(--font-mono);font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.7px;text-transform:uppercase;";
const card = "padding:20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-radius:16px;margin-bottom:16px;";
const h3 = "font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--pd-ink);letter-spacing:-0.3px;margin-bottom:14px;";
const codeS = "font-family:var(--font-mono);font-size:11.5px;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline);border-radius:4px;padding:1px 5px;color:var(--pd-ink);";
---

<AdminShell title={isNew ? "Admin · New template" : `Admin · ${v("title")}`} tab="templates">
  {/* Loads shared field panel JS globals (pdRenderFields, pdInitFieldPanel, pdCollectFieldValues) */}
  <FieldPanel fields={[]} />
  <div class="mb-5 flex items-center justify-between gap-4">
    <h1 class="font-display font-medium text-ink" style="font-size:28px;letter-spacing:-0.6px;">{isNew ? "New template" : v("title")}</h1>
    <div class="flex items-center gap-4">
      {!isNew && (
        <a id="pd-open-studio" href={`/studio/${v("id")}`} target="_blank" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);">Open in studio ↗ (test)</a>
      )}
      <a href="/admin/templates" class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.5px;">← All templates</a>
    </div>
  </div>

    <details open={isNew} style="margin-bottom:18px;border:0.5px solid color-mix(in srgb,var(--pd-lilac) 35%,var(--pd-hairline));border-radius:16px;background:color-mix(in srgb,var(--pd-lilac) 6%,var(--pd-bg2));overflow:hidden;">
      <summary style="cursor:pointer;padding:15px 18px;font-family:var(--font-display);font-size:15px;font-weight:600;color:var(--pd-ink);list-style:none;">🤖 Building with Claude (browser extension) — guide &amp; starter prompt</summary>
      <div style="padding:2px 20px 20px;font-size:13px;line-height:1.65;color:var(--pd-ink2);">
        <p style="margin:0 0 12px;color:var(--pd-ink3);">Instructions for an AI agent (Claude in Chrome) filling this form. Goal: create one template, then click <b>Save template</b>. The page does not redirect — a “Saved ✓” message confirms success.</p>

        <div style="margin:0 0 14px;border:0.5px solid var(--pd-hairline2);border-radius:12px;background:var(--pd-bg);overflow:hidden;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 12px;border-bottom:0.5px solid var(--pd-hairline);">
            <span style="font-family:var(--font-mono);font-size:9.5px;text-transform:uppercase;letter-spacing:0.7px;color:var(--pd-ink3);">Starter prompt — paste into the Claude extension</span>
            <button type="button" id="pd-copy-prompt" style="padding:4px 10px;border-radius:7px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;font-size:11px;font-weight:600;white-space:nowrap;">Copy</button>
          </div>
          <pre id="pd-ai-prompt" style="margin:0;padding:12px;white-space:pre-wrap;font-family:var(--font-mono);font-size:11.5px;line-height:1.55;color:var(--pd-ink2);">{`You are filling out PixieDust's "Add template" admin form to create ONE new AI template.

First, read the guide panel on this page ("Building with Claude") — it lists each field's format, the model palette (and each model's image-input key), how multi-step chains work, and what the helper buttons do.

The template I want: (describe it — what it produces, which Replicate/Fal model(s) it uses, and what the user uploads or types).

How to build it:
1. Single model → put the model id in "Model" and click "Fetch Replicate schema". Multi-step → use the "AI — build a multi-step chain" box and describe all the steps in one sentence.
2. Set Title, Slug/id, Kind, Type (the final output type), Category, and Credit cost (~5 per step).
3. Click "Scaffold fields from placeholders" if the fields look empty, and review each step's Model + inputs.
4. Click "Save template" and confirm you see "Saved ✓".`}</pre>
        </div>

        <p style="margin:14px 0 4px;font-weight:600;color:var(--pd-ink);">⚡ Fastest paths</p>
        <ul style="margin:0 0 4px;padding-left:18px;">
          <li><b>Single model</b> (one image/video model): type the model id (<code style={codeS}>owner/name</code>) into <b>Model</b> in the “Provider payload” card, then click <b>Fetch Replicate schema</b>. It auto-fills Model, input_json, fields_json and Type. Then set Title, Slug/id, Kind, Category, Credit cost → <b>Save</b>.</li>
          <li><b>Multi-step chain</b> (e.g. make an image, then animate it): in the <b>✨ AI — build a multi-step chain</b> box, describe every step in one sentence (“generate X, then animate it into a video”) and click <b>Build chain</b>. It fills steps, fields, models and Type. Review each step, click <b>Scaffold fields</b>, then <b>Save</b>.</li>
          <li><b>Manual chain</b>: click <b>+ Add step</b> per model (each new step’s image auto-wires to the previous step’s output), set each step’s <b>Model</b> and click <b>⤓ inputs</b> to pull its parameters, then <b>Scaffold fields</b>.</li>
        </ul>

        <p style="margin:14px 0 4px;font-weight:600;color:var(--pd-ink);">📋 Field reference</p>
        <ul style="margin:0;padding-left:18px;">
          <li><b>Slug / id</b>: lowercase, dashes, unique — e.g. <code style={codeS}>kodak-portra</code>.</li>
          <li><b>Type</b>: <code style={codeS}>image</code> or <code style={codeS}>video</code> = the FINAL output (for a chain, the last step’s output).</li>
          <li><b>Kind</b>: which tool/catalog it lives under — preset · shoot · cinema · i2v · fashion-video · game-video · motion · beauty · fashion · avatar · ad.</li>
          <li><b>Category</b>: choose from the dropdown; click <b>manage</b> to add a new one.</li>
          <li><b>Credit cost</b>: integer. Rule: <b>~5 credits per model/step</b> (≈5× our ~$0.02/gen cost). 1 step = 5, 2 steps = 10.</li>
          <li><b>input_json</b>: the model’s parameters. Put <code style={codeS}>{`{{key}}`}</code> where the USER supplies a value (<code style={codeS}>{`{{key*}}`}</code> = required); leave other params as fixed values.</li>
          <li><b>fields_json</b>: one entry per <code style={codeS}>{`{{key}}`}</code> → <code style={codeS}>{`{ key, type, label, required, help?, options?, default? }`}</code>. Types: text, textarea (prompts), number, select, file, toggle, url. For uploads use <code style={codeS}>file</code> with <code style={codeS}>accept:"image/*"</code> (or <code style={codeS}>video/*</code> / <code style={codeS}>audio/*</code>, or <code style={codeS}>image/*,video/*,audio/*</code> for Omni references); add <code style={codeS}>"multiple":true,"max":9</code> for several files. For a <code style={codeS}>select</code>, options are <code style={codeS}>{`[{value,label}]`}</code> — add <code style={codeS}>"image":"&lt;url&gt;"</code> per option to show preview cards. Use <b>Scaffold fields from placeholders</b> to auto-generate this from the {`{{...}}`} you used.</li>
          <li><b>Optional prompt with a baked-in default</b>: keep <code style={codeS}>{`{{prompt}}`}</code> in the step’s input, then in fields_json set <code style={codeS}>{`"required": false, "default": "your template prompt…"`}</code>. The studio pre-fills that text; if the user clears it, generate still sends the default.</li>
        </ul>

        <p style="margin:14px 0 4px;font-weight:600;color:var(--pd-ink);">🔗 How chains work (steps_json)</p>
        <ul style="margin:0;padding-left:18px;">
          <li>Ordered list; each step = <code style={codeS}>{`{ "id":"shortId", "model":"owner/name", "input": {…} }`}</code>.</li>
          <li>A step’s input may reference user fields as <code style={codeS}>{`{{key}}`}</code> and any earlier step’s output as <code style={codeS}>{`{{stepId.output}}`}</code> (a media URL). The LAST step’s output is the result.</li>
          <li>Don’t hardcode the motion prompt only inside step 2 and drop the field — keep <code style={codeS}>{`{{prompt}}`}</code> and put the template text in the field’s <code style={codeS}>default</code> so users can still override it.</li>
        </ul>

        <p style="margin:14px 0 4px;font-weight:600;color:var(--pd-ink);">🧩 Models to use (+ their image-input key)</p>
        <ul style="margin:0;padding-left:18px;">
          <li>Text→image, <i>no</i> image input: <code style={codeS}>black-forest-labs/flux-schnell</code>.</li>
          <li>Image edit (image input = <code style={codeS}>image_input</code> array): <code style={codeS}>google/nano-banana</code>, <code style={codeS}>google/nano-banana-pro</code>, <code style={codeS}>bytedance/seedream-4</code>.</li>
          <li><code style={codeS}>openai/gpt-image-2</code> (image input = <code style={codeS}>input_images</code> array).</li>
          <li>Image→video (image input = <code style={codeS}>image</code>): <code style={codeS}>bytedance/seedance-1-lite</code>, <code style={codeS}>bytedance/seedance-2.0-fast</code>, <code style={codeS}>google/veo-3</code>.</li>
          <li><b>Never feed an image into flux-schnell</b> (it’s text-only). When unsure of a model’s exact params, use its step’s <b>⤓ inputs</b> button.</li>
        </ul>

        <p style="margin:14px 0 0;color:var(--pd-ink3);"><b>Finish:</b> click <b>Save template</b> (bottom). Optionally open the studio to test. To add a preview image, run it once in the studio and use “Use as example”.</p>
      </div>
    </details>
  <script is:inline>
    (function () {
      var b = document.getElementById("pd-copy-prompt");
      if (!b) return;
      b.addEventListener("click", function () {
        var t = (document.getElementById("pd-ai-prompt") || {}).textContent || "";
        navigator.clipboard.writeText(t).then(function () {
          var o = b.textContent; b.textContent = "Copied ✓";
          setTimeout(function () { b.textContent = o; }, 1500);
        }).catch(function () {});
      });
    })();
  </script>

  <style>
    @media (max-width: 1100px) { #pd-editor-grid { grid-template-columns: 1fr !important; } }
  </style>
  <div id="pd-editor-grid" style="display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:24px;align-items:start;">
  <form id="pd-tpl-form">
    <input type="hidden" name="_isNew" value={String(isNew)} />

    <div style={card}>
      <div style={h3}>Basics</div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label>
          <span style={lbl}>Slug / id</span>
          <input name="id" value={v("id")} placeholder="preset-kodak-portra" style={inp} />
          {!isNew && <input type="hidden" name="_originalId" value={v("id")} />}
          {!isNew && <span style="display:block;margin-top:4px;font-size:10px;color:var(--pd-ink4);">Editing this renames the link (<span class="font-mono">/studio/…</span>) and moves its history &amp; hero references over.</span>}
        </label>
        <label><span style={lbl}>Title</span><input name="title" value={v("title")} style={inp} /></label>
        <label><span style={lbl}>Kind</span><select name="kind" style={inp}>{KINDS.map((k) => <option value={k} selected={v("kind", "preset") === k}>{k}</option>)}</select></label>
        <label><span style={lbl}>Type</span><select name="type" style={inp}><option value="image" selected={v("type", "image") === "image"}>image</option><option value="video" selected={v("type") === "video"}>video</option></select></label>
        <label>
          <span style={lbl}>Category <button type="button" id="pd-cat-manage" style="font-size:10px;color:var(--pd-lilac);background:none;border:none;cursor:pointer;padding:0;margin-left:6px;">manage</button></span>
          <select name="category" id="pd-cat-select" style={inp}>
            <option value="">— none —</option>
            {categories.map((c) => <option value={c} selected={v("category") === c}>{c}</option>)}
            {v("category") && !categories.includes(v("category")) && <option value={v("category")} selected>{v("category")} (custom)</option>}
          </select>
        </label>
        <label><span style={lbl}>Credit cost</span><input name="credit_cost" type="number" min="0" value={v("credit_cost", "2")} style={inp} /></label>
      </div>

      <!-- Manage categories (shared palette) -->
      <div id="pd-cat-panel" style="display:none;margin-top:12px;padding:12px;border:0.5px solid var(--pd-hairline2);border-radius:12px;background:var(--pd-bg);">
        <div class="mb-2 font-mono uppercase" style="font-size:9px;color:var(--pd-lilac);letter-spacing:0.7px;">Manage categories</div>
        <div id="pd-cat-chips" class="flex flex-wrap gap-2"></div>
        <div class="mt-2.5 flex items-center gap-2">
          <input id="pd-cat-new" placeholder="New category" style={inp + "flex:1;max-width:240px;"} />
          <button type="button" id="pd-cat-add" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11.5px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;">Add</button>
        </div>
        <span class="mt-1.5 block text-ink-4" style="font-size:10px;">Shared across all templates. Each catalog page only shows categories its own templates use.</span>
      </div>
      <script type="application/json" id="pd-cats-data" is:inline set:html={JSON.stringify(categories)}></script>
    </div>

    <div style={card}>
      <div class="flex items-center justify-between" style="margin-bottom:14px;">
        <div style={h3 + "margin:0;"}>Provider payload</div>
        <button type="button" id="pd-scaffold" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;">Scaffold fields from placeholders</button>
      </div>
      <!-- Import tools -->
      <div class="mb-3 rounded-xl" style="padding:14px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline);">
        <div class="mb-2 font-mono uppercase" style="font-size:9px;color:var(--pd-lilac);letter-spacing:0.7px;">Import — no manual mapping</div>
        <div class="flex flex-wrap items-center gap-2">
          <input id="pd-import-model" type="text" placeholder="owner/name (e.g. google/nano-banana)" style={inp + "flex:1;min-width:240px;"} />
          <button type="button" id="pd-import-btn" class="rounded-lg font-semibold" style="padding:9px 14px;font-size:12px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;">Fetch Replicate schema</button>
        </div>
        <div class="mt-2 flex flex-wrap items-start gap-2">
          <textarea id="pd-ai-raw" rows="2" placeholder="…or paste example params / describe it, then AI-convert" style={mono + "flex:1;min-width:240px;"}></textarea>
          <button type="button" id="pd-ai-btn" class="rounded-lg font-semibold" style="padding:9px 14px;font-size:12px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;">AI convert</button>
        </div>
        <div id="pd-import-msg" class="mt-2 hidden" style="font-size:11.5px;"></div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <label><span style={lbl}>Provider</span><select name="provider" style={inp}>{PROVIDERS.map((p) => <option value={p} selected={v("provider", "replicate") === p}>{p}</option>)}</select></label>
        <label><span style={lbl}>Model</span><input name="model" value={v("model")} placeholder="black-forest-labs/flux-schnell" style={inp} /></label>
      </div>
      <label class="mt-3 block"><span style={lbl}>input_json — provider params (use placeholders like prompt)</span><textarea name="input_json" rows="6" style={mono}>{v("input_json", DEF_INPUT)}</textarea></label>
      <label class="mt-3 block"><span style={lbl}>fields_json — user input definitions</span><textarea name="fields_json" rows="6" style={mono}>{v("fields_json", DEF_FIELDS)}</textarea></label>

      <!-- Reference images: preloaded into the template's file field by default -->
      <div class="mt-3">
        <span style={lbl}>Reference image(s) — preloaded into the file input for users</span>
        <div class="mt-1.5 flex flex-wrap items-center gap-2" id="pd-ref-thumbs"></div>
        <div class="mt-2 flex items-center gap-2">
          <label class="rounded-lg font-semibold" style="position:relative;padding:7px 12px;font-size:11.5px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;overflow:hidden;">
            <span id="pd-ref-upload-label">+ Upload reference</span>
            <input id="pd-ref-upload" type="file" accept="image/*,video/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
          </label>
          <span id="pd-ref-status" style="font-size:11px;color:var(--pd-ink3);"></span>
        </div>
        <span class="mt-1 block text-ink-4" style="font-size:10.5px;">Sets the <code>default</code> on the first file field in fields_json. Users see it pre-filled and can keep or replace it.</span>
      </div>
      <div class="mt-3">
        <div class="flex items-center justify-between" style="margin-bottom:6px;">
          <span style={lbl}>Chain steps — each step is its own model; its output feeds the next. Empty = single-step.</span>
          <button type="button" id="pd-add-step" class="rounded-lg font-semibold" style="padding:6px 11px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;white-space:nowrap;">+ Add step</button>
        </div>
        <!-- Structured per-step editor (built from steps_json by JS) -->
        <div id="pd-steps-editor" class="grid gap-2"></div>
        <details class="mt-2">
          <summary style="font-size:10.5px;color:var(--pd-ink3);cursor:pointer;">raw steps_json (advanced — auto-synced)</summary>
          <textarea name="steps_json" rows="5" style={mono + "margin-top:6px;"}>{v("steps_json")}</textarea>
        </details>
        <span class="mt-1 block text-ink-4" style="font-size:10.5px;">Step 2+ auto-references the prior step's image via <code>{`{{step1.output}}`}</code>. Set each step's model (e.g. <code>bytedance/seedance-2.0-fast</code>), then “Scaffold fields”.</span>
      </div>

      <!-- AI multi-step chain builder -->
      <div class="mt-3 rounded-xl" style="padding:14px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline);">
        <div class="mb-2 font-mono uppercase" style="font-size:9px;color:var(--pd-lilac);letter-spacing:0.7px;">✨ AI — build a multi-step chain</div>
        <div class="flex flex-wrap items-start gap-2">
          <textarea id="pd-chain-prompt" rows="2" placeholder="Describe the steps, e.g. 'stylize a selfie into an oil painting, then animate it into a 5s clip'" style={mono + "flex:1;min-width:240px;"}></textarea>
          <button type="button" id="pd-chain-btn" class="rounded-lg font-semibold" style="padding:9px 14px;font-size:12px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;white-space:nowrap;">Build chain</button>
        </div>
        <button type="button" id="pd-chain-example" style="margin-top:8px;font-size:10.5px;color:var(--pd-ink3);background:none;border:none;cursor:pointer;padding:0;text-decoration:underline;">try an example</button>
        <div id="pd-chain-msg" class="mt-2 hidden" style="font-size:11.5px;"></div>
        <span class="mt-1.5 block text-ink-4" style="font-size:10.5px;">Fills id, title, type, fields_json, steps_json + step 1 into the payload. Review, then "Open in studio" to test the chain.</span>
      </div>
    </div>

    {!isNew && (
      <div style={card}>
        <div style={h3 + "margin-bottom:6px;"}>Examples</div>
        <p class="mb-3 text-ink-3" style="font-size:12px;">Pick one of this template's test results to show as the example on the frontend. Run tests via "Open in studio".</p>
        {examples.length === 0 ? (
          <div class="text-ink-4" style="font-size:12px;">No results yet — open the studio and generate a few.</div>
        ) : (
          <div class="pd-examples-grid grid grid-cols-3 gap-2 sm:grid-cols-4">
            {examples.map((ex) => (
              <div class="relative overflow-hidden rounded-xl" style="aspect-ratio:1;background:var(--pd-bg);border:0.5px solid var(--pd-hairline);">
                {ex.type === "video" ? (
                  <video src={ex.output_url} muted loop playsinline preload="metadata" class="h-full w-full object-cover" />
                ) : (
                  <img src={ex.output_url} loading="lazy" alt="" class="h-full w-full object-cover" />
                )}
                <button type="button" class="pd-use-example absolute inset-x-0 bottom-0 font-mono uppercase" data-url={ex.output_url} data-type={ex.type} style="padding:5px;background:rgba(10,10,11,0.7);color:#fff;border:none;cursor:pointer;font-size:9px;letter-spacing:0.4px;">Use as example</button>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <div style={card}>
      <div style={h3}>Controls & display</div>
      <div class="grid gap-3 sm:grid-cols-3">
        <label><span style={lbl}>quality_json</span><input name="quality_json" value={v("quality_json", '{"std":1,"pro":1.5,"cinema":2.5}')} style={mono} /></label>
        <label><span style={lbl}>aspects_json</span><input name="aspects_json" value={v("aspects_json", '["1:1","16:9","9:16"]')} style={mono} /></label>
        <label><span style={lbl}>quantities_json</span><input name="quantities_json" value={v("quantities_json", "[1,2,4]")} style={mono} /></label>
        <label><span style={lbl}>price_per_second (video — credits/sec, optional)</span><input name="price_per_second" type="number" min="0" value={v("price_per_second")} placeholder="e.g. 2" style={inp} /></label>
        <label><span style={lbl}>durations_json (seconds picker)</span><input name="durations_json" value={v("durations_json")} placeholder="[5,10]" style={mono} /></label>
        <label><span style={lbl}>Engine</span><input name="engine" value={v("engine")} placeholder="Flux Schnell" style={inp} /></label>
        <label><span style={lbl}>ETA</span><input name="eta" value={v("eta")} placeholder="~10s" style={inp} /></label>
        <label><span style={lbl}>Tone</span><select name="tone" style={inp}>{TONES.map((t) => <option value={t} selected={v("tone", "lilac") === t}>{t}</option>)}</select></label>
        <label><span style={lbl}>Accent (css var)</span><input name="accent" value={v("accent", "var(--pd-lilac)")} style={inp} /></label>
        <label><span style={lbl}>Meta</span><input name="meta" value={v("meta")} placeholder="0:08 / 24 shots" style={inp} /></label>
        <label><span style={lbl}>tags_json</span><input name="tags_json" value={v("tags_json", "[]")} style={mono} /></label>
        <label class="sm:col-span-3"><span style={lbl}>Subtitle</span><input name="subtitle" value={v("subtitle")} style={inp} /></label>
        <label class="sm:col-span-3"><span style={lbl}>Description</span><textarea name="description" rows="2" style={inp}>{v("description")}</textarea></label>
        <label><span style={lbl}>Preview image URL</span><input name="preview_image" value={v("preview_image")} style={inp} /></label>
        <label><span style={lbl}>Preview video URL</span><input name="preview_video" value={v("preview_video")} style={inp} /></label>
        <label><span style={lbl}>Sort order</span><input name="sort_order" type="number" value={v("sort_order", "0")} style={inp} /></label>
      </div>
      <!-- Visibility status — single-select radio group -->
      <div class="mt-4">
        <div style={lbl + "margin-bottom:8px;"}>Visibility</div>
        <div class="flex flex-wrap gap-3" id="pd-visibility-group">
          {[
            { val: "normal",     label: "Live",       desc: "Shown to all users",        color: "var(--pd-mint)" },
            { val: "hidden",     label: "Hidden",     desc: "Not shown publicly",        color: "var(--pd-pink)" },
            { val: "admin_only", label: "Admin only", desc: "Only admins can access it", color: "var(--pd-lilac)" },
          ].map(({ val, label, desc, color }) => {
            const current =
              v("is_admin_only") === "1" ? "admin_only" :
              v("is_hidden") === "1"     ? "hidden" : "normal";
            return (
              <label style={`display:flex;align-items:center;gap:9px;padding:9px 14px;border-radius:11px;cursor:pointer;border:1.5px solid ${current === val ? color : "var(--pd-hairline)"};background:${current === val ? `color-mix(in srgb,${color} 10%,transparent)` : "var(--pd-bg)"};transition:border-color .15s,background .15s;`}>
                <input type="radio" name="pd_status" value={val} checked={current === val} style="accent-color:var(--pd-lilac);" />
                <span>
                  <span style={`display:block;font-size:13px;font-weight:600;color:${color};`}>{label}</span>
                  <span style="display:block;font-size:11px;color:var(--pd-ink3);margin-top:1px;">{desc}</span>
                </span>
              </label>
            );
          })}
        </div>

        {/* Featured is independent of visibility — promote in the catalog regardless. */}
        <label id="pd-featured-label" class="mt-3" style={`display:inline-flex;align-items:center;gap:9px;padding:9px 14px;border-radius:11px;cursor:pointer;border:1.5px solid ${v("is_featured") === "1" ? "var(--pd-amber)" : "var(--pd-hairline)"};background:${v("is_featured") === "1" ? "color-mix(in srgb,var(--pd-amber) 10%,transparent)" : "var(--pd-bg)"};transition:border-color .15s,background .15s;`}>
          <input type="checkbox" name="is_featured" id="pd-is-featured" checked={v("is_featured") === "1"} style="accent-color:var(--pd-amber);" />
          <span>
            <span style="display:block;font-size:13px;font-weight:600;color:var(--pd-amber);">★ Featured</span>
            <span style="display:block;font-size:11px;color:var(--pd-ink3);margin-top:1px;">Promote in the catalog (works with any visibility)</span>
          </span>
        </label>

        {/* Hidden fields written by JS before submit */}
        <input type="hidden" name="is_hidden"     id="pd-is-hidden" />
        <input type="hidden" name="is_admin_only" id="pd-is-admin-only" />
      </div>
    </div>

    <div id="pd-tpl-msg" class="mb-3 hidden rounded-lg" style="padding:9px 12px;font-size:12.5px;"></div>
    <div class="flex gap-2">
      <button type="submit" class="rounded-xl font-bold" style="padding:12px 22px;background:var(--pd-lilac);color:#0A0A0B;font-size:13.5px;cursor:pointer;">{isNew ? "Create template" : "Save changes"}</button>
      <a href="/admin/templates" class="rounded-xl font-semibold text-ink" style="padding:12px 22px;border:0.5px solid var(--pd-hairline2);font-size:13.5px;">Cancel</a>
    </div>
  </form>

  {/* ── Right column: sticky test panel ─────────────────────────────────── */}
  <div style="position:sticky;top:88px;">
    <div id="pd-test-panel" style={card + "border-color:var(--pd-lilac);opacity:0.95;margin-bottom:0;"}>
      <div class="flex items-center justify-between" style="margin-bottom:0;">
        <div style={h3 + "margin:0;"}>▶ Test generation</div>
        <button type="button" id="pd-test-toggle" class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.5px;background:none;border:none;cursor:pointer;">collapse ↑</button>
      </div>
      <p style="font-size:11.5px;color:var(--pd-ink3);margin:6px 0 14px;">Uses the current provider / model / input_json from the form — no save needed.</p>

      <div id="pd-test-fields" class="grid gap-3" style="margin-bottom:14px;">
        <!-- rendered dynamically from fields_json -->
        <div style="color:var(--pd-ink3);font-size:12px;">Fill in fields_json and they'll appear here.</div>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <button type="button" id="pd-test-run" class="rounded-xl font-bold" style="padding:10px 20px;background:var(--pd-lilac);color:#0A0A0B;font-size:13px;cursor:pointer;border:none;">Run test ▶</button>
        <span id="pd-test-status" style="font-size:12px;color:var(--pd-ink3);"></span>
      </div>

      <!-- Result area -->
      <div id="pd-test-result" class="mt-4 hidden">
        <div class="font-mono uppercase" style="font-size:9px;color:var(--pd-ink3);letter-spacing:0.7px;margin-bottom:8px;">Output</div>
        <div id="pd-test-media" style="border-radius:14px;overflow:hidden;background:var(--pd-bg3);"></div>
        <div class="mt-3 flex gap-2 flex-wrap">
          <button type="button" id="pd-test-use-preview" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;">Use as preview</button>
          <button type="button" id="pd-test-use-example" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);cursor:pointer;">Use as example</button>
          <a id="pd-test-open" href="#" target="_blank" class="rounded-lg font-semibold" style="padding:7px 12px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);">Open ↗</a>
        </div>
      </div>
    </div>
  </div>
  </div>{/* end #pd-editor-grid */}

  <script>
    const form = document.getElementById("pd-tpl-form") as HTMLFormElement;
    const msg = document.getElementById("pd-tpl-msg")!;
    const jsonFields = ["input_json", "fields_json", "steps_json", "quality_json", "aspects_json", "quantities_json", "durations_json", "tags_json"];

    function show(text: string, ok: boolean) {
      msg.classList.remove("hidden");
      msg.style.background = ok ? "color-mix(in srgb, var(--pd-mint) 12%, transparent)" : "color-mix(in srgb, var(--pd-pink) 12%, transparent)";
      msg.style.color = ok ? "var(--pd-mint)" : "var(--pd-pink)";
      msg.textContent = text;
    }

    // Scaffold fields[] from {{placeholders}} across input_json AND steps_json.
    // The [a-zA-Z0-9_]+ class excludes dotted refs like {{step1.output}} (those
    // are auto-filled from prior step outputs, not user inputs).
    document.getElementById("pd-scaffold")!.addEventListener("click", () => {
      const inputEl = form.elements.namedItem("input_json") as HTMLTextAreaElement;
      const stepsEl = form.elements.namedItem("steps_json") as HTMLTextAreaElement;
      const fieldsEl = form.elements.namedItem("fields_json") as HTMLTextAreaElement;
      const haystack = `${inputEl.value}\n${stepsEl?.value ?? ""}`;
      const matches = Array.from(haystack.matchAll(/\{\{([a-zA-Z0-9_]+)(\*?)\}\}/g));
      const seen = new Set<string>();
      const guess = (k: string) => (/(prompt|description|caption)/i.test(k) ? "textarea" : /(image|photo|file|img)/i.test(k) ? "file" : /(num|count|qty|strength|steps|scale)/i.test(k) ? "number" : "text");
      const fields = matches
        .filter((m) => !seen.has(m[1]) && seen.add(m[1]))
        .map((m) => ({ key: m[1], type: guess(m[1]), label: m[1].replace(/[_-]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()), required: m[2] === "*" }));
      fieldsEl.value = JSON.stringify(fields, null, 2);
      renderTestFields();
      show(`Scaffolded ${fields.length} field(s) from input + steps — review types/labels.`, true);
    });

    // Append a chained step: a new model whose image input is auto-wired to the
    // previous step's output (the canonical image→video handoff). Step 1 instead
    // pulls from a user field so there's something to feed the chain.
    document.getElementById("pd-add-step")!.addEventListener("click", () => {
      const stepsEl = form.elements.namedItem("steps_json") as HTMLTextAreaElement;
      let steps: any[] = [];
      const rawVal = stepsEl.value.trim();
      if (rawVal) {
        try { const p = JSON.parse(rawVal); if (Array.isArray(p)) steps = p; else throw 0; }
        catch { show("steps_json isn't valid JSON yet — fix it before adding a step.", false); return; }
      }
      const n = steps.length + 1;
      const prevId = steps.length ? (steps[steps.length - 1].id || `step${steps.length}`) : null;
      const step = prevId
        ? { id: `step${n}`, model: "", input: { prompt: "", image: `{{${prevId}.output}}` } }
        : { id: `step${n}`, model: "", input: { prompt: "{{prompt*}}", image_input: ["{{photo*}}"] } };
      steps.push(step);
      stepsEl.value = JSON.stringify(steps, null, 2);
      renderStepsEditor();
      show(prevId ? `Added step ${n}, wired to {{${prevId}.output}}. Set its model below, then “Scaffold fields”.` : `Added step 1. Set its model + inputs below, then “Scaffold fields”.`, true);
    });

    // ── Reference images: write the first file field's `default` in fields_json ──
    const refThumbs = document.getElementById("pd-ref-thumbs")!;
    const refUpload = document.getElementById("pd-ref-upload") as HTMLInputElement;
    const refStatus = document.getElementById("pd-ref-status")!;
    const refFieldsTA = () => form.elements.namedItem("fields_json") as HTMLTextAreaElement;
    const readFields = (): any[] => { try { const a = JSON.parse(refFieldsTA().value || "[]"); return Array.isArray(a) ? a : []; } catch { return []; } };
    const firstFileIdx = (f: any[]) => f.findIndex((x) => x && x.type === "file");
    function refUrls(): string[] {
      const f = readFields(); const i = firstFileIdx(f);
      if (i < 0) return [];
      const d = f[i].default;
      return Array.isArray(d) ? d : d ? [d] : [];
    }
    function setRefs(urls: string[]) {
      const f = readFields(); const i = firstFileIdx(f);
      if (i < 0) return;
      if (f[i].multiple) f[i].default = urls;
      else f[i].default = urls[0];
      if (f[i].default == null || (Array.isArray(f[i].default) && !f[i].default.length)) delete f[i].default;
      refFieldsTA().value = JSON.stringify(f, null, 2);
    }
    function renderRefThumbs() {
      const urls = refUrls();
      refThumbs.innerHTML = "";
      if (!urls.length) { refThumbs.innerHTML = '<span style="font-size:11px;color:var(--pd-ink4);">None — input starts empty.</span>'; return; }
      urls.forEach((u) => {
        const w = document.createElement("div");
        w.style.cssText = "position:relative;width:64px;height:64px;border-radius:9px;overflow:hidden;border:0.5px solid var(--pd-hairline);background:var(--pd-bg);";
        const isVid = /\.(mp4|webm|mov)(\?|$)/i.test(u);
        const el = isVid ? document.createElement("video") : document.createElement("img");
        el.src = u; el.setAttribute("style", "width:100%;height:100%;object-fit:cover;");
        if (isVid) { const vv = el as HTMLVideoElement; vv.muted = true; vv.loop = true; vv.autoplay = true; vv.playsInline = true; }
        const x = document.createElement("button"); x.type = "button"; x.textContent = "✕";
        x.style.cssText = "position:absolute;top:3px;right:3px;width:16px;height:16px;border-radius:50%;background:rgba(0,0,0,0.65);color:#fff;font-size:9px;border:none;cursor:pointer;line-height:1;";
        x.addEventListener("click", () => { setRefs(refUrls().filter((z) => z !== u)); renderRefThumbs(); });
        w.appendChild(el); w.appendChild(x);
        refThumbs.appendChild(w);
      });
    }
    refUpload.addEventListener("change", async () => {
      const file = refUpload.files?.[0]; if (!file) return;
      if (firstFileIdx(readFields()) < 0) { refStatus.textContent = "Add a file field first (use Scaffold)."; return; }
      refStatus.textContent = "Uploading…";
      const fd = new FormData(); fd.append("file", file);
      try {
        const r = await fetch("/api/upload", { method: "POST", body: fd });
        const d = await r.json();
        if (!r.ok) { refStatus.textContent = d.error || "Upload failed"; return; }
        const f = readFields(); const i = firstFileIdx(f);
        setRefs(f[i].multiple ? [...refUrls(), d.url] : [d.url]);
        renderRefThumbs();
        refStatus.textContent = "Added — Save to keep it.";
      } catch { refStatus.textContent = "Upload failed"; }
      refUpload.value = "";
    });
    renderRefThumbs();

    // ── Import helpers ──
    const importMsg = document.getElementById("pd-import-msg")!;
    const setField = (name: string, val: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (el && val != null) el.value = val;
    };
    function importStatus(text: string, ok: boolean) {
      importMsg.classList.remove("hidden");
      importMsg.style.color = ok ? "var(--pd-mint)" : "var(--pd-pink)";
      importMsg.textContent = text;
    }

    document.getElementById("pd-import-btn")!.addEventListener("click", async () => {
      const model = (document.getElementById("pd-import-model") as HTMLInputElement).value.trim();
      if (!model) return importStatus("Enter a model id (owner/name).", false);
      importStatus("Fetching schema from Replicate…", true);
      try {
        const res = await fetch("/api/admin/replicate-schema", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ model }) });
        const d = await res.json();
        if (!res.ok) return importStatus(d.error || "Import failed.", false);
        setField("model", d.model);
        setField("input_json", d.input_json);
        setField("fields_json", d.fields_json);
        (form.elements.namedItem("type") as HTMLSelectElement).value = d.type;
        const titleEl = form.elements.namedItem("title") as HTMLInputElement;
        if (!titleEl.value) titleEl.value = d.title;
        const idEl = form.elements.namedItem("id") as HTMLInputElement;
        if (!idEl.readOnly && !idEl.value) idEl.value = model.split(":")[0].split("/").pop()!.toLowerCase().replace(/[^a-z0-9]+/g, "-");
        importStatus(`Imported ${d.type} model — ${JSON.parse(d.fields_json).length} field(s) generated.`, true);
      } catch {
        importStatus("Network error.", false);
      }
    });

    // Use a test result as the frontend example
    document.querySelectorAll<HTMLElement>(".pd-use-example").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.dataset.url!;
        const type = btn.dataset.type!;
        const idEl = form.elements.namedItem("id") as HTMLInputElement;
        const res = await fetch("/api/admin/templates/set-preview", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: idEl.value, url, type }) });
        const d = await res.json();
        if (res.ok) {
          setField(d.field, url);
          importStatus(`Set as example (${d.field}).`, true);
          (window as any).pdToast?.("Example saved", { accent: "var(--pd-mint)" });
        } else importStatus(d.error || "Failed.", false);
      });
    });

    document.getElementById("pd-ai-btn")!.addEventListener("click", async () => {
      const raw = (document.getElementById("pd-ai-raw") as HTMLTextAreaElement).value.trim();
      if (!raw) return importStatus("Paste params or a description first.", false);
      importStatus("Asking Opus to convert…", true);
      try {
        const res = await fetch("/api/admin/ai-convert", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ raw }) });
        const d = await res.json();
        if (!res.ok) return importStatus(d.error || "AI convert failed.", false);
        setField("input_json", d.input_json);
        setField("fields_json", d.fields_json);
        renderTestFields(); // refresh the right-side test form
        importStatus("AI converted — review the generated input + fields.", true);
      } catch {
        importStatus("Network error.", false);
      }
    });

    // ── AI multi-step chain builder ──
    const chainMsg = document.getElementById("pd-chain-msg")!;
    function chainStatus(text: string, ok: boolean) {
      chainMsg.classList.remove("hidden");
      chainMsg.style.color = ok ? "var(--pd-mint)" : "var(--pd-pink)";
      chainMsg.textContent = text;
    }
    const chainPrompt = document.getElementById("pd-chain-prompt") as HTMLTextAreaElement;
    document.getElementById("pd-chain-example")!.addEventListener("click", () => {
      chainPrompt.value = "Turn a user's selfie into a stylized oil-painting portrait, then animate that portrait into a 5-second clip with subtle motion.";
      chainPrompt.focus();
    });
    document.getElementById("pd-chain-btn")!.addEventListener("click", async () => {
      const prompt = chainPrompt.value.trim();
      if (!prompt) return chainStatus("Describe the multi-step template first (or tap “try an example”).", false);
      chainStatus("Asking Opus to design the chain…", true);
      try {
        const res = await fetch("/api/admin/ai-chain", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ prompt }) });
        const d = await res.json();
        if (!res.ok) return chainStatus(d.error || "Chain build failed.", false);
        const isNewTemplate = !(form.elements.namedItem("id") as HTMLInputElement)?.readOnly;
        if (isNewTemplate && d.id) setField("id", d.id);
        setField("title", d.title);
        setField("kind", d.kind);
        setField("type", d.type);
        setField("subtitle", d.subtitle);
        setField("credit_cost", String(d.credit_cost));
        setField("tags_json", d.tags_json);
        setField("provider", "replicate");
        setField("model", d.model);
        setField("input_json", d.input_json);
        setField("fields_json", d.fields_json);
        setField("steps_json", d.steps_json);
        renderTestFields(); // refresh the right-side test form with the new fields
        renderStepsEditor(); // refresh the per-step editor rows
        chainStatus(`Built a ${d.stepCount}-step chain — adjust each step's model below; the test panel (right) updated too.`, true);
      } catch {
        chainStatus("Network error.", false);
      }
    });

    // ── Visibility radio — live border/bg update + encode to hidden fields ──
    function applyVisualToRadio(radio: HTMLInputElement) {
      const colors: Record<string, string> = {
        normal: "var(--pd-mint)", featured: "var(--pd-amber)",
        hidden: "var(--pd-pink)", admin_only: "var(--pd-lilac)",
      };
      document.querySelectorAll<HTMLLabelElement>("#pd-visibility-group label").forEach((lbl) => {
        const r = lbl.querySelector("input[type=radio]") as HTMLInputElement;
        const c = colors[r.value] ?? "var(--pd-mint)";
        const active = r.checked;
        lbl.style.borderColor = active ? c : "var(--pd-hairline)";
        lbl.style.background  = active ? `color-mix(in srgb,${c} 10%,transparent)` : "var(--pd-bg)";
      });
    }
    document.querySelectorAll<HTMLInputElement>('input[name="pd_status"]').forEach((r) => {
      r.addEventListener("change", () => applyVisualToRadio(r));
    });

    function encodeVisibility() {
      const status = (form.querySelector('input[name="pd_status"]:checked') as HTMLInputElement)?.value ?? "normal";
      (document.getElementById("pd-is-hidden")     as HTMLInputElement).value = status === "hidden"     ? "1" : "0";
      (document.getElementById("pd-is-admin-only") as HTMLInputElement).value = status === "admin_only" ? "1" : "0";
    }

    // Featured is an independent toggle (any visibility can be featured).
    const featuredCb = document.getElementById("pd-is-featured") as HTMLInputElement | null;
    const featuredLabel = document.getElementById("pd-featured-label") as HTMLElement | null;
    function syncFeatured() {
      if (!featuredCb || !featuredLabel) return;
      const on = featuredCb.checked;
      featuredLabel.style.borderColor = on ? "var(--pd-amber)" : "var(--pd-hairline)";
      featuredLabel.style.background = on ? "color-mix(in srgb,var(--pd-amber) 10%,transparent)" : "var(--pd-bg)";
    }
    featuredCb?.addEventListener("change", syncFeatured);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      encodeVisibility();
      const data: Record<string, unknown> = {};
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name || el.name === "_isNew" || el.name === "pd_status") continue;
        if (el.type === "radio") continue;
        if (el.type === "checkbox") data[el.name] = el.checked ? 1 : 0;
        else data[el.name] = el.value;
      }
      // validate JSON fields
      for (const f of jsonFields) {
        const raw = String(data[f] ?? "").trim();
        if (!raw) continue;
        try { JSON.parse(raw); } catch { return show(`${f} is not valid JSON.`, false); }
      }
      const res = await fetch("/api/admin/templates", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
      const out = await res.json();
      if (res.ok) {
        show("Saved ✓", true);
        // Stay on the page (no redirect). For a brand-new template, swap the URL
        // to its real edit page so further saves update it instead of recreating.
        // For a renamed slug, point the page at the new id and reset _originalId
        // so a follow-up save doesn't try to rename again.
        if (out.id && !location.pathname.endsWith(`/edit/${out.id}`)) {
          history.replaceState(null, "", `/admin/templates/edit/${out.id}`);
          const orig = form.elements.namedItem("_originalId") as HTMLInputElement | null;
          if (orig) orig.value = out.id;
          const openLink = document.getElementById("pd-open-studio") as HTMLAnchorElement | null;
          if (openLink) openLink.href = `/studio/${out.id}`;
        }
      } else show(out.error || "Save failed.", false);
    });

    // ── Inline test panel ────────────────────────────────────────────────────
    const testFields  = document.getElementById("pd-test-fields")!;
    const testStatus  = document.getElementById("pd-test-status")!;
    const testResult  = document.getElementById("pd-test-result")!;
    const testMedia   = document.getElementById("pd-test-media")!;
    const testOpen    = document.getElementById("pd-test-open") as HTMLAnchorElement;
    const testUseBtn  = document.getElementById("pd-test-use-preview")!;

    // File URLs for the test panel — managed by shared pdInitFieldPanel
    const testFileUrls: Record<string, any> = {};

    function renderTestFields() {
      const raw = (form.elements.namedItem("fields_json") as HTMLTextAreaElement)?.value ?? "";
      let fields: any[] = [];
      try { fields = JSON.parse(raw); } catch { /* invalid json */ }
      // Use shared renderer from FieldPanel component
      (window as any).pdRenderFields?.(testFields, fields);
      // Wire file upload handlers on newly generated elements
      (window as any).pdInitFieldPanel?.(testFields, testFileUrls);
    }

    // Re-render whenever fields_json changes (debounced)
    const fieldsTA = form.elements.namedItem("fields_json") as HTMLTextAreaElement;
    let renderTimer: ReturnType<typeof setTimeout>;
    fieldsTA?.addEventListener("input", () => { clearTimeout(renderTimer); renderTimer = setTimeout(renderTestFields, 400); });
    // Initial render — wait for FieldPanel script to load
    if ((window as any).pdRenderFields) {
      renderTestFields();
    } else {
      window.addEventListener("load", renderTestFields, { once: true });
    }

    // ── Structured per-step chain editor (model + id + input per step) ─────────
    const stepsEditor = document.getElementById("pd-steps-editor")!;
    const stepsTA2 = form.elements.namedItem("steps_json") as HTMLTextAreaElement;
    const escH = (s: any) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    function syncStepsToTextarea() {
      const rows = Array.from(stepsEditor.querySelectorAll(".pd-step-row"));
      if (!rows.length) { stepsTA2.value = ""; return; }
      let bad = false;
      const steps = rows.map((row) => {
        const id = (row.querySelector(".pd-step-id") as HTMLInputElement).value.trim();
        const model = (row.querySelector(".pd-step-model") as HTMLInputElement).value.trim();
        const inEl = row.querySelector(".pd-step-input") as HTMLTextAreaElement;
        let input: any = {};
        try { input = inEl.value.trim() ? JSON.parse(inEl.value) : {}; inEl.style.borderColor = "var(--pd-hairline2)"; }
        catch { bad = true; inEl.style.borderColor = "var(--pd-pink)"; }
        return { id, model, input };
      });
      if (bad) return; // don't overwrite steps_json with broken JSON
      stepsTA2.value = JSON.stringify(steps, null, 2);
    }

    function renderStepsEditor() {
      let steps: any[] | null = [];
      const raw = stepsTA2.value.trim();
      if (raw) { try { const p = JSON.parse(raw); steps = Array.isArray(p) ? p : []; } catch { steps = null; } }
      if (steps === null) { stepsEditor.innerHTML = `<div style="font-size:11px;color:var(--pd-pink);padding:6px;">Raw steps_json isn't valid JSON — open “raw steps_json (advanced)” to fix it.</div>`; return; }
      if (!steps.length) { stepsEditor.innerHTML = `<div style="font-size:11px;color:var(--pd-ink4);padding:6px;">Single-step template (no chain). Tap “+ Add step” to chain another model.</div>`; return; }
      const inpS = "width:100%;padding:7px 9px;border-radius:8px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12px;";
      const monoS = inpS + "font-family:'JetBrains Mono',monospace;font-size:11px;line-height:1.5;resize:vertical;";
      stepsEditor.innerHTML = steps.map((s, i) => {
        const prevId = i > 0 ? (steps![i - 1].id || `step${i}`) : null;
        return `
        <div class="pd-step-row" style="border:0.5px solid var(--pd-hairline2);border-radius:12px;padding:10px;background:var(--pd-bg);">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;">
            <span style="font-size:10px;font-family:monospace;color:var(--pd-lilac);letter-spacing:0.5px;">STEP ${i + 1}${prevId ? ` · input image = {{${escH(prevId)}.output}}` : ""}</span>
            <button type="button" class="pd-step-del" data-i="${i}" style="background:none;border:none;color:var(--pd-pink);cursor:pointer;font-size:11px;">remove ✕</button>
          </div>
          <div style="display:grid;grid-template-columns:96px 1fr auto;gap:6px;margin-bottom:7px;">
            <input class="pd-step-id" value="${escH(s.id ?? `step${i + 1}`)}" placeholder="id" style="${inpS}" />
            <input class="pd-step-model" value="${escH(s.model ?? "")}" placeholder="owner/name — e.g. bytedance/seedance-2.0-fast" style="${inpS}" />
            <button type="button" class="pd-step-schema" data-i="${i}" title="Fetch this model's inputs from Replicate" style="padding:7px 11px;border-radius:8px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;font-size:11px;font-weight:600;white-space:nowrap;">⤓ inputs</button>
          </div>
          <span style="font-size:9.5px;font-family:monospace;color:var(--pd-ink4);text-transform:uppercase;letter-spacing:0.4px;">input — provider params (use {{field}} for user inputs)</span>
          <textarea class="pd-step-input" rows="5" placeholder='{ "prompt": "{{prompt*}}" }' style="${monoS}margin-top:3px;">${escH(JSON.stringify(s.input ?? {}, null, 2))}</textarea>
        </div>`;
      }).join("");
      stepsEditor.querySelectorAll(".pd-step-del").forEach((b) =>
        b.addEventListener("click", () => {
          const i = Number((b as HTMLElement).dataset.i);
          let arr: any[] = [];
          try { arr = JSON.parse(stepsTA2.value || "[]"); } catch { arr = []; }
          arr.splice(i, 1);
          stepsTA2.value = arr.length ? JSON.stringify(arr, null, 2) : "";
          renderStepsEditor();
        })
      );
      stepsEditor.querySelectorAll(".pd-step-id,.pd-step-model,.pd-step-input").forEach((el) =>
        el.addEventListener("input", syncStepsToTextarea)
      );
      // Per-step "⤓ inputs": fetch the model's schema (like step 1) and fill this
      // step's input JSON. For step 2+, auto-wire its image input to the prior
      // step's output so the chain handoff is automatic.
      const IMG_KEYS = /^(image|image_input|image_url|image_uri|images|img|init_image|first_frame_image|start_image|subject_reference|reference_image)$/i;
      stepsEditor.querySelectorAll<HTMLButtonElement>(".pd-step-schema").forEach((b) =>
        b.addEventListener("click", async () => {
          const idx = Number(b.dataset.i);
          const rows = Array.from(stepsEditor.querySelectorAll(".pd-step-row"));
          const row = rows[idx];
          const model = (row.querySelector(".pd-step-model") as HTMLInputElement).value.trim();
          const inEl = row.querySelector(".pd-step-input") as HTMLTextAreaElement;
          if (!model) return show("Enter this step's model first.", false);
          const prevId = idx > 0 ? ((rows[idx - 1].querySelector(".pd-step-id") as HTMLInputElement).value.trim() || `step${idx}`) : null;
          const orig = b.textContent; b.textContent = "…"; b.disabled = true;
          try {
            const res = await fetch("/api/admin/replicate-schema", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ model }) });
            const d = await res.json();
            if (!res.ok) return show(d.error || "Schema fetch failed.", false);
            let input: any = {};
            try { input = JSON.parse(d.input_json); } catch { input = {}; }
            if (prevId) {
              for (const k of Object.keys(input)) {
                if (IMG_KEYS.test(k)) input[k] = Array.isArray(input[k]) ? [`{{${prevId}.output}}`] : `{{${prevId}.output}}`;
              }
            }
            inEl.value = JSON.stringify(input, null, 2);
            inEl.style.borderColor = "var(--pd-hairline2)";
            syncStepsToTextarea();
            show(`Loaded ${model} inputs into step ${idx + 1}${prevId ? ` (image wired to {{${prevId}.output}})` : ""}. Tap “Scaffold fields” to expose the user inputs.`, true);
          } catch { show("Network error fetching schema.", false); }
          finally { b.textContent = orig; b.disabled = false; }
        })
      );
    }

    // Re-parse the editor when the raw textarea is edited by hand.
    stepsTA2.addEventListener("change", renderStepsEditor);
    renderStepsEditor();

    // Collapse toggle
    let testExpanded = true;
    document.getElementById("pd-test-toggle")!.addEventListener("click", () => {
      testExpanded = !testExpanded;
      const body = document.getElementById("pd-test-panel")!;
      const btn  = document.getElementById("pd-test-toggle")!;
      // hide everything below the header
      Array.from(body.children).slice(2).forEach((el) => {
        (el as HTMLElement).style.display = testExpanded ? "" : "none";
      });
      btn.textContent = testExpanded ? "collapse ↑" : "expand ↓";
    });

    // Run test
    let testType: "image" | "video" = "image";
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    function setTestStatus(msg: string, color = "var(--pd-ink3)") {
      testStatus.textContent = msg;
      testStatus.style.color = color;
    }

    // ── Client-side chain-step resolver (mirrors resolveChainStep on server) ──
    function resolveStepInput(obj: unknown, user: Record<string, unknown>, outputs: Record<string, string>): unknown {
      const sub = (v: unknown): unknown => {
        if (typeof v === "string") {
          const exact = v.match(/^\{\{([\w.]+)\*?\}\}$/);
          if (exact) {
            const tok = exact[1];
            if (tok.includes(".")) return outputs[tok.split(".")[0]] ?? "";
            return user[tok] ?? "";
          }
          return v.replace(/\{\{([\w.]+)\*?\}\}/g, (_, tok: string) => {
            if (tok.includes(".")) return outputs[tok.split(".")[0]] ?? "";
            const u = user[tok];
            return u != null ? String(u) : "";
          });
        }
        if (Array.isArray(v)) return v.flatMap((item) => { const r = sub(item); return Array.isArray(r) ? r : [r]; });
        if (v && typeof v === "object") {
          const o: Record<string, unknown> = {};
          for (const [k, val] of Object.entries(v as Record<string, unknown>)) o[k] = sub(val);
          return o;
        }
        return v;
      };
      return sub(obj);
    }

    // ── Poll a single job until done, returns output URL or null on failure ──
    function pollJob(jobId: string, provider: string, label: string): Promise<string | null> {
      return new Promise((resolve) => {
        let elapsed = 0;
        const timer = setInterval(async () => {
          elapsed += 4;
          try {
            const pr = await fetch(`/api/admin/templates/test-status?jobId=${encodeURIComponent(jobId)}&provider=${encodeURIComponent(provider)}`);
            const pd = await pr.json();
            if (pd.status === "completed" && pd.output_url) {
              clearInterval(timer);
              setTestStatus(`${label} done in ~${elapsed}s ✓`, "var(--pd-mint)");
              resolve(pd.output_url);
            } else if (pd.status === "failed") {
              clearInterval(timer);
              setTestStatus(`${label} failed: ${pd.error || "unknown"}`, "var(--pd-pink)");
              resolve(null);
            } else {
              setTestStatus(`${label} running… ${elapsed}s`, "var(--pd-amber)");
            }
          } catch { setTestStatus(`${label} polling error — retrying…`, "var(--pd-amber)"); }
        }, 4000);
        // store so the cancel-on-rerun can clear it
        pollTimer = timer;
      });
    }

    document.getElementById("pd-test-run")!.addEventListener("click", async () => {
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
      testResult.classList.add("hidden");
      testMedia.innerHTML = "";

      const provider   = (form.elements.namedItem("provider") as HTMLSelectElement)?.value ?? "replicate";
      const model      = (form.elements.namedItem("model") as HTMLInputElement)?.value?.trim();
      const input_json = (form.elements.namedItem("input_json") as HTMLTextAreaElement)?.value?.trim();
      const stepsRaw   = (form.elements.namedItem("steps_json") as HTMLTextAreaElement)?.value?.trim();
      const tplType    = (form.elements.namedItem("type") as HTMLSelectElement)?.value ?? "image";
      testType = tplType as "image" | "video";

      const field_values: Record<string, any> = (window as any).pdCollectFieldValues?.(testFields, testFileUrls) ?? {};

      // The test panel only renders fields_json inputs, so supply aspect /
      // duration / quantity from the template config so {{aspect}}-style tokens
      // resolve (matches how real generation injects them).
      const firstOf = (name: string) => { try { const a = JSON.parse((form.elements.namedItem(name) as HTMLInputElement)?.value || "[]"); return Array.isArray(a) ? a[0] : undefined; } catch { return undefined; } };
      const allInput = `${input_json || ""} ${stepsRaw || ""}`;
      if (/\{\{aspect\b/.test(allInput) && field_values.aspect == null) { const a = firstOf("aspects_json"); if (a != null) field_values.aspect = a; }
      if (/\{\{duration\b/.test(allInput) && field_values.duration == null) { const d = firstOf("durations_json"); if (d != null) field_values.duration = d; }
      if (/\{\{quantity\b/.test(allInput) && field_values.quantity == null) field_values.quantity = 1;

      // Parse steps_json — if present and non-empty, run as a chain
      let steps: any[] | null = null;
      try { if (stepsRaw) steps = JSON.parse(stepsRaw); } catch { /* invalid JSON, fall through to single */ }

      if (steps && Array.isArray(steps) && steps.length > 0) {
        // ── Multi-step chain ───────────────────────────────────────────────
        const stepOutputs: Record<string, string> = {};
        let finalUrl: string | null = null;

        for (let i = 0; i < steps.length; i++) {
          const step = steps[i];
          const stepId = step.id || `step${i}`;
          const label  = steps.length === 1 ? "Running…" : `Step ${i + 1}/${steps.length}`;

          setTestStatus(`${label}: submitting…`, "var(--pd-lilac)");

          // Resolve this step's input with user field values + prior outputs
          const resolved = resolveStepInput(step.input ?? {}, field_values, stepOutputs);

          try {
            const r = await fetch("/api/admin/templates/test-run", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              // Send pre-resolved input as JSON string; no further substitution needed
              body: JSON.stringify({
                provider: step.provider ?? provider,
                model: step.model,
                input_json: JSON.stringify(resolved),
                field_values: {},
              }),
            });
            const d = await r.json();
            if (!r.ok) { setTestStatus(`${label}: ${d.error || "submit failed"}`, "var(--pd-pink)"); return; }

            const outUrl = await pollJob(d.jobId, d.provider, label);
            if (!outUrl) return; // error already shown

            stepOutputs[stepId] = outUrl;
            finalUrl = outUrl;
          } catch (e: any) {
            setTestStatus(e.message || "Network error.", "var(--pd-pink)");
            return;
          }
        }

        if (finalUrl) {
          setTestStatus(`All ${steps.length} step${steps.length > 1 ? "s" : ""} done ✓`, "var(--pd-mint)");
          showTestResult(finalUrl);
        }

      } else {
        // ── Single step ────────────────────────────────────────────────────
        if (!model) return setTestStatus("Set a model first.", "var(--pd-pink)");
        if (!input_json) return setTestStatus("Add input_json first.", "var(--pd-pink)");

        setTestStatus("Submitting…", "var(--pd-lilac)");
        try {
          const r = await fetch("/api/admin/templates/test-run", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ provider, model, input_json, field_values }),
          });
          const d = await r.json();
          if (!r.ok) return setTestStatus(d.error || "Submit failed.", "var(--pd-pink)");
          const outUrl = await pollJob(d.jobId, d.provider, "Running…");
          if (outUrl) showTestResult(outUrl);
        } catch (e: any) {
          setTestStatus(e.message || "Network error.", "var(--pd-pink)");
        }
      }
    });

    function showTestResult(url: string) {
      testOpen.href = url;
      testResult.classList.remove("hidden");
      const isVideo = testType === "video" || /\.(mp4|webm|mov)(\?|$)/i.test(url);
      if (isVideo) {
        testMedia.innerHTML = `<video src="${url}" controls autoplay muted loop playsinline style="width:100%;border-radius:14px;display:block;max-height:400px;object-fit:contain;"></video>`;
      } else {
        testMedia.innerHTML = `<img src="${url}" alt="test result" style="width:100%;border-radius:14px;display:block;max-height:400px;object-fit:contain;" />`;
      }
      // Store url for "use as preview" button
      testUseBtn.dataset.url  = url;
      testUseBtn.dataset.type = isVideo ? "video" : "image";
    }

    testUseBtn.addEventListener("click", async () => {
      const url  = testUseBtn.dataset.url ?? "";
      const type = testUseBtn.dataset.type ?? "image";
      const idEl = form.elements.namedItem("id") as HTMLInputElement;
      const id   = idEl?.value?.trim();
      if (!url) return;
      if (id) {
        // Template already exists — persist to DB
        const r = await fetch("/api/admin/templates/set-preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, url, type }),
        });
        const d = await r.json();
        if (r.ok) {
          setField(d.field, url);
          setTestStatus("Set as preview ✓", "var(--pd-mint)");
          (window as any).pdToast?.("Preview saved", { accent: "var(--pd-mint)" });
        } else setTestStatus(d.error || "Failed.", "var(--pd-pink)");
      } else {
        // New template — just fill the form field
        const col = type === "video" ? "preview_video" : "preview_image";
        setField(col, url);
        setTestStatus("Preview URL filled in form ✓", "var(--pd-mint)");
      }
    });

    // Use as example — insert into generations table so it appears in the Examples section
    const testUseExampleBtn = document.getElementById("pd-test-use-example")!;
    testUseExampleBtn.addEventListener("click", async () => {
      const url  = testUseBtn.dataset.url ?? "";
      const type = testUseBtn.dataset.type ?? "image";
      const idEl = form.elements.namedItem("id") as HTMLInputElement;
      const template_id = idEl?.value?.trim();
      if (!url) return;
      if (!template_id) {
        setTestStatus("Save the template first before setting an example.", "var(--pd-amber)");
        return;
      }
      const provider = (form.elements.namedItem("provider") as HTMLSelectElement)?.value ?? "replicate";
      const model    = (form.elements.namedItem("model") as HTMLInputElement)?.value?.trim() ?? "";
      testUseExampleBtn.style.opacity = "0.5";
      const r = await fetch("/api/admin/templates/save-example", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ template_id, url, type, provider, model }),
      });
      testUseExampleBtn.style.opacity = "1";
      const d = await r.json();
      if (r.ok) {
        setTestStatus("Saved as example ✓", "var(--pd-mint)");
        (window as any).pdToast?.("Example saved — reload to see it in the grid", { accent: "var(--pd-mint)" });
        // Dynamically add to examples grid so admin sees it immediately
        const grid = document.querySelector(".pd-examples-grid") as HTMLElement | null;
        if (grid) {
          const el = document.createElement("div");
          el.className = "relative overflow-hidden rounded-xl";
          el.style.cssText = "aspect-ratio:1;background:var(--pd-bg);border:0.5px solid var(--pd-hairline);";
          const isVid = type === "video";
          el.innerHTML = isVid
            ? `<video src="${url}" muted loop playsinline preload="metadata" class="h-full w-full object-cover"></video>`
            : `<img src="${url}" loading="lazy" alt="" class="h-full w-full object-cover" />`;
          const useBtn = document.createElement("button");
          useBtn.type = "button";
          useBtn.className = "pd-use-example absolute inset-x-0 bottom-0 font-mono uppercase";
          useBtn.dataset.url = url;
          useBtn.dataset.type = type;
          useBtn.style.cssText = "padding:5px;background:rgba(10,10,11,0.7);color:#fff;border:none;cursor:pointer;font-size:9px;letter-spacing:0.4px;";
          useBtn.textContent = "Use as example";
          useBtn.addEventListener("click", async () => {
            const res = await fetch("/api/admin/templates/set-preview", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: template_id, url, type }) });
            const dd = await res.json();
            if (res.ok) { setField(dd.field, url); (window as any).pdToast?.("Example saved", { accent: "var(--pd-mint)" }); }
          });
          el.appendChild(useBtn);
          grid.prepend(el);
        }
      } else setTestStatus(d.error || "Failed.", "var(--pd-pink)");
    });
  </script>

  <!-- Category picker: manage (add/remove) the shared category palette -->
  <script is:inline>
    (function () {
      var sel = document.getElementById("pd-cat-select");
      var panel = document.getElementById("pd-cat-panel");
      var chips = document.getElementById("pd-cat-chips");
      var manageBtn = document.getElementById("pd-cat-manage");
      var addBtn = document.getElementById("pd-cat-add");
      var newInput = document.getElementById("pd-cat-new");
      if (!sel || !panel || !chips) return;
      var cats = [];
      try { cats = JSON.parse(document.getElementById("pd-cats-data").textContent || "[]"); } catch (e) {}
      function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
      function api(body) {
        return fetch("/api/admin/categories", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }).then(function (r) { return r.json(); });
      }
      function hasOption(v) { return Array.prototype.some.call(sel.options, function (o) { return o.value === v; }); }
      function renderChips() {
        chips.innerHTML = cats.map(function (c) {
          return '<span style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);font-size:11.5px;color:var(--pd-ink2);">' +
            esc(c) + '<button type="button" data-cat="' + esc(c) + '" class="pd-cat-rm" title="Remove" style="background:none;border:none;color:var(--pd-pink);cursor:pointer;font-size:11px;line-height:1;padding:0;">✕</button></span>';
        }).join("") || '<span style="font-size:11px;color:var(--pd-ink4);">No categories yet.</span>';
        Array.prototype.forEach.call(chips.querySelectorAll(".pd-cat-rm"), function (b) {
          b.addEventListener("click", function () {
            var name = b.getAttribute("data-cat");
            api({ action: "remove", name: name }).then(function (d) {
              if (!d.ok) return;
              cats = d.categories || [];
              // Drop the option unless it's the current saved value (keep so it isn't silently changed).
              Array.prototype.slice.call(sel.options).forEach(function (o) {
                if (o.value === name && sel.value !== name) o.remove();
              });
              renderChips();
            });
          });
        });
      }
      manageBtn && manageBtn.addEventListener("click", function () {
        var open = panel.style.display !== "none";
        panel.style.display = open ? "none" : "block";
        if (!open) renderChips();
      });
      function addCat() {
        var name = (newInput.value || "").trim();
        if (!name) return;
        api({ action: "add", name: name }).then(function (d) {
          if (!d.ok) return;
          cats = d.categories || [];
          var match = cats.filter(function (c) { return c.toLowerCase() === name.toLowerCase(); })[0] || name;
          if (!hasOption(match)) { var o = document.createElement("option"); o.value = match; o.textContent = match; sel.appendChild(o); }
          sel.value = match;
          newInput.value = "";
          renderChips();
        });
      }
      addBtn && addBtn.addEventListener("click", addCat);
      newInput && newInput.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); addCat(); } });
    })();
  </script>
</AdminShell>

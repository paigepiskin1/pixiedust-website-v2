---
export const prerender = false;
import AdminShell from "../../layouts/AdminShell.astro";
import { isAdmin } from "../../lib/admin";
import { QUICK_TOOLS } from "../../lib/content";
import { getToolCards } from "../../lib/tool-cards";
import { getHeroPicks } from "../../lib/hero";
import { getTemplate, listTemplates } from "../../lib/templates";
import { listAdminMedia } from "../../lib/admin-media";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const media = await getToolCards(db);
const library = await listAdminMedia(db, 200);
const card = "background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-radius:16px;overflow:hidden;";

// Curated homepage hero (#pd-hero) picks — resolve each to a display row
// (aligned to index so remove/move work), plus a template list for the picker.
const picks = await getHeroPicks(db);
const pickViews = await Promise.all(
  picks.map(async (p) => {
    if (p.kind === "template") {
      const t = await getTemplate(db, p.id);
      return { kind: "template" as const, label: t?.title ?? `(missing) ${p.id}`, sub: t?.category ?? p.id, thumb: t?.previewVideo || t?.previewImage || null, type: t?.previewVideo ? "video" : "image" };
    }
    return { kind: "custom" as const, label: p.title, sub: p.kicker ?? p.href, thumb: p.url, type: p.mediaType };
  })
);
const allTemplates = (await listTemplates(db, { includeHidden: true, isAdmin: true })).map((t) => ({ id: t.id, title: t.title }));

// When nothing is curated the home hero auto-fills from the newest video
// templates (mirrors index.astro). Surface those slides here so they can be
// removed too — removing one seeds a custom list (everything shown minus it).
let autoView: { id: string; label: string; sub: string; thumb: string | null; type: string }[] = [];
if (picks.length === 0) {
  const videoPool = await listTemplates(db, { kinds: ["i2v", "video", "motion", "cinema"], limit: 40 });
  autoView = videoPool
    .filter((t) => t.previewVideo)
    .slice(0, 5)
    .map((t) => ({ id: t.id, label: t.title, sub: t.category || t.kind || "Featured", thumb: t.previewVideo || t.previewImage || null, type: t.previewVideo ? "video" : "image" }));
}
---

<AdminShell title="Admin · Homepage" tab="tools">
  <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.7px;">Homepage</h1>
  <p class="mt-1 text-ink-3" style="font-size:13.5px;">Everything that shows on the home page — the big rotating hero and the “Start a project” tool cards. Plus a media library for CDN links.</p>

  <!-- ── Uploaded media library ───────────────────────────────────────────── -->
  <div style="margin-top:26px;">
    <h2 class="font-display font-medium text-ink" style="font-size:22px;letter-spacing:-0.5px;">Uploaded media</h2>
    <p class="mt-1 text-ink-3" style="font-size:13px;">Upload images or videos to Bunny CDN, then copy the public URL for templates, heroes, or docs.</p>

    <div class="mt-4" style={card + "padding:16px;"}>
      <div class="flex flex-wrap items-center gap-3">
        <label class="rounded-lg font-semibold" style="position:relative;padding:9px 14px;font-size:12.5px;background:var(--pd-lilac);color:#0A0A0B;cursor:pointer;overflow:hidden;">
          <span id="pd-lib-up-label">Upload files</span>
          <input id="pd-lib-files" type="file" accept="image/*,video/*" multiple style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
        </label>
        <span id="pd-lib-status" style="font-size:12px;color:var(--pd-ink3);"></span>
      </div>
      <div class="mt-2 text-ink-4" style="font-size:10.5px;">PNG, JPG, WebP, GIF, MP4, MOV, WebM · up to 110MB each · multiple files ok</div>
    </div>

    <div id="pd-lib-grid" class="mt-5 flex flex-wrap gap-3">
      {library.length === 0 && (
        <div id="pd-lib-empty" class="text-ink-4" style="font-size:12.5px;">No uploads yet — drop a file above to get a link.</div>
      )}
      {library.map((item) => (
        <div class="pd-lib-item" data-id={item.id} data-url={item.url} style={card + "width:220px;"}>
          <div style="position:relative;height:120px;background:var(--pd-bg3);overflow:hidden;">
            {item.kind === "video" ? (
              <video src={item.url} muted loop playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <img src={item.url} alt={item.filename || "upload"} style="width:100%;height:100%;object-fit:cover;" />
            )}
            <span style="position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8px;letter-spacing:0.4px;text-transform:uppercase;">{item.kind}</span>
          </div>
          <div style="padding:10px 12px;">
            <div class="truncate font-semibold text-ink" style="font-size:12px;" title={item.filename || item.url}>{item.filename || "Untitled"}</div>
            <div class="mt-1 truncate font-mono" style="font-size:9.5px;color:var(--pd-ink4);" title={item.url}>{item.url}</div>
            <div class="mt-2.5 flex items-center gap-1.5">
              <button type="button" class="pd-lib-copy rounded-lg font-semibold" style="padding:5px 9px;font-size:11px;background:var(--pd-ink);color:var(--pd-bg);border:none;cursor:pointer;">Copy link</button>
              <a href={item.url} target="_blank" rel="noopener" class="rounded-lg font-mono uppercase" style="padding:5px 8px;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-ink3);border:0.5px solid var(--pd-hairline2);text-decoration:none;">Open</a>
              <button type="button" class="pd-lib-del font-mono uppercase" style="margin-left:auto;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-pink);background:none;border:none;cursor:pointer;">Remove</button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ── Homepage hero (#pd-hero) ─────────────────────────────────────────── -->
  <div style="margin-top:40px;padding-top:28px;border-top:0.5px solid var(--pd-hairline);">
    <h2 class="font-display font-medium text-ink" style="font-size:22px;letter-spacing:-0.5px;">Homepage hero</h2>
    <p class="mt-1 text-ink-3" style="font-size:13px;">The big rotating hero at the top of the home page (<span class="font-mono">#pd-hero</span>). Pick existing templates or add custom slides. Empty = automatic (top video templates).</p>

    {pickViews.length === 0 && autoView.length > 0 && (
      <p class="mt-3 text-ink-4" style="font-size:11.5px;">Currently auto-filled from your newest video templates. Remove any below to switch to a custom list, or add your own above.</p>
    )}

    <!-- Current picks -->
    <div id="pd-hero-list" class="mt-5 flex flex-wrap gap-3">
      {pickViews.length === 0 && autoView.length === 0 && (
        <div class="text-ink-4" style="font-size:12.5px;">No slides yet — add a template or custom slide above.</div>
      )}
      {pickViews.length === 0 && autoView.map((pv) => (
        <div class="pd-hero-auto" data-id={pv.id} style={card + "width:190px;"}>
          <div style="position:relative;height:110px;background:var(--pd-bg3);overflow:hidden;">
            {pv.thumb ? (pv.type === "video" ? (
              <video src={pv.thumb} muted loop playsinline autoplay preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <img src={pv.thumb} alt={pv.label} style="width:100%;height:100%;object-fit:cover;" />
            )) : (
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--pd-ink4);">★</div>
            )}
            <span style={`position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8px;letter-spacing:0.4px;text-transform:uppercase;`}>auto</span>
          </div>
          <div style="padding:9px 11px;">
            <div class="truncate font-semibold text-ink" style="font-size:12.5px;">{pv.label}</div>
            <div class="truncate font-mono" style="font-size:9.5px;color:var(--pd-ink4);">{pv.sub}</div>
            <div class="mt-2 flex items-center gap-1.5">
              <button type="button" class="pd-hero-auto-del font-mono uppercase" style="margin-left:auto;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-pink);background:none;border:none;cursor:pointer;">remove</button>
            </div>
          </div>
        </div>
      ))}
      {pickViews.map((pv, i) => (
        <div class="pd-hero-item" data-i={i} style={card + "width:190px;"}>
          <div style="position:relative;height:110px;background:var(--pd-bg3);overflow:hidden;">
            {pv.thumb ? (pv.type === "video" ? (
              <video src={pv.thumb} muted loop playsinline autoplay preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <img src={pv.thumb} alt={pv.label} style="width:100%;height:100%;object-fit:cover;" />
            )) : (
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--pd-ink4);">★</div>
            )}
            <span style={`position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8px;letter-spacing:0.4px;text-transform:uppercase;`}>{pv.kind}</span>
          </div>
          <div style="padding:9px 11px;">
            <div class="truncate font-semibold text-ink" style="font-size:12.5px;">{pv.label}</div>
            <div class="truncate font-mono" style="font-size:9.5px;color:var(--pd-ink4);">{pv.sub}</div>
            <div class="mt-2 flex items-center gap-1.5">
              <button type="button" class="pd-hero-move font-mono" data-dir="-1" title="Move left" style="font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);border-radius:6px;color:var(--pd-ink2);cursor:pointer;padding:2px 7px;">←</button>
              <button type="button" class="pd-hero-move font-mono" data-dir="1" title="Move right" style="font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);border-radius:6px;color:var(--pd-ink2);cursor:pointer;padding:2px 7px;">→</button>
              <button type="button" class="pd-hero-del font-mono uppercase" style="margin-left:auto;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-pink);background:none;border:none;cursor:pointer;">remove</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Add controls -->
    <div class="mt-6 grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr));">
      <div style={card + "padding:16px;"}>
        <div class="font-semibold text-ink" style="font-size:13px;">Pick an existing template</div>
        <div class="mt-3 flex items-center gap-2">
          <select id="pd-hero-tpl" style="flex:1;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;">
            {allTemplates.map((t) => <option value={t.id}>{t.title}</option>)}
          </select>
          <button type="button" id="pd-hero-add-tpl" class="rounded-lg font-semibold" style="padding:8px 14px;font-size:12px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;">Add</button>
        </div>
        <div class="mt-2 text-ink-4" style="font-size:10px;">Pulls its media, kicker and credit cost live from the template.</div>
      </div>

      <div style={card + "padding:16px;"}>
        <div class="font-semibold text-ink" style="font-size:13px;">Add a custom slide</div>
        <input id="pd-hero-title" placeholder="Title *" style="margin-top:10px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <input id="pd-hero-kicker" placeholder="Kicker / eyebrow (optional)" style="margin-top:7px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <input id="pd-hero-href" placeholder="Link (e.g. /studio/my-template)" style="margin-top:7px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <input id="pd-hero-cr" type="number" min="0" placeholder="Credits (optional)" style="margin-top:7px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <div class="mt-2.5 flex items-center gap-2">
          <label class="rounded-lg font-semibold" style="position:relative;padding:7px 12px;font-size:11.5px;background:var(--pd-lilac);color:#0A0A0B;cursor:pointer;overflow:hidden;">
            <span id="pd-hero-up-label">Upload media + add</span>
            <input id="pd-hero-file" type="file" accept="image/*,video/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
          </label>
          <span id="pd-hero-status" style="font-size:10.5px;color:var(--pd-ink3);"></span>
        </div>
        <div class="mt-1 text-ink-4" style="font-size:10px;">Title required. Upload triggers the add once the file finishes.</div>
      </div>
    </div>
  </div>

  <!-- ── Home cards ───────────────────────────────────────────────────────── -->
  <div style="margin-top:40px;padding-top:28px;border-top:0.5px solid var(--pd-hairline);">
    <h2 class="font-display font-medium text-ink" style="font-size:22px;letter-spacing:-0.5px;">Home cards</h2>
    <p class="mt-1 text-ink-3" style="font-size:13px;">Set a background image or video for each “Start a project” tool card. Leave empty to use the default gradient.</p>
  </div>

  <div class="mt-6 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr));">
    {QUICK_TOOLS.map((t) => {
      const m = media[t.href];
      return (
        <div class="pd-tool" data-href={t.href} style={card}>
          <div class="pd-tool-preview" style="position:relative;height:150px;background:var(--pd-bg3);overflow:hidden;">
            {m?.type === "video" ? (
              <video class="pd-tool-media" src={m.url} muted loop playsinline autoplay preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : m?.url ? (
              <img class="pd-tool-media" src={m.url} alt={t.name} style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <div class="pd-tool-media" style={`width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:26px;color:${t.accent};background:color-mix(in srgb,${t.accent} 14%, var(--pd-bg3));`}>{t.glyph}</div>
            )}
            <span class="pd-tool-badge" style="position:absolute;top:8px;left:8px;padding:2px 7px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8.5px;letter-spacing:0.5px;text-transform:uppercase;">{m ? m.type : "default"}</span>
          </div>
          <div style="padding:12px 14px;">
            <div class="font-semibold text-ink" style="font-size:13.5px;">{t.name}</div>
            <div class="font-mono" style="font-size:10px;color:var(--pd-ink4);">{t.href}</div>
            <div class="mt-2.5 flex items-center gap-2">
              <label class="pd-tool-upload rounded-lg font-semibold" style="position:relative;padding:7px 12px;font-size:11.5px;background:var(--pd-lilac);color:#0A0A0B;cursor:pointer;overflow:hidden;">
                <span class="pd-tool-label">Upload</span>
                <input type="file" accept="image/*,video/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
              </label>
              <button type="button" class="pd-tool-clear font-mono uppercase" style={`font-size:10px;letter-spacing:0.5px;color:var(--pd-pink);background:none;border:none;cursor:pointer;${m ? "" : "visibility:hidden;"}`}>Remove</button>
              <span class="pd-tool-status" style="font-size:10.5px;color:var(--pd-ink3);"></span>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <script>
    // ── Uploaded media library ──
    const libGrid = document.getElementById("pd-lib-grid")!;
    const libStatus = document.getElementById("pd-lib-status")!;
    const libToast = (m: string, a?: string) => (window as any).pdToast?.(m, a ? { accent: a } : undefined);
    const libCard = "background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-radius:16px;overflow:hidden;width:220px;";

    function escAttr(s: string) {
      return s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
    }
    function escHtml(s: string) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function wireLibItem(el: HTMLElement) {
      const url = el.dataset.url || "";
      el.querySelector(".pd-lib-copy")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          libToast("Link copied.", "var(--pd-mint)");
        } catch {
          prompt("Copy this URL:", url);
        }
      });
      el.querySelector(".pd-lib-del")?.addEventListener("click", async () => {
        const id = el.dataset.id;
        if (!id) return;
        const ok = await (window as any).pdConfirm?.("Remove this media from the library? (CDN file is not deleted.)");
        if (ok === false) return;
        const r = await fetch("/api/admin/media", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, delete: true }),
        });
        if (!r.ok) { libToast("Could not remove.", "var(--pd-pink)"); return; }
        el.remove();
        if (!libGrid.querySelector(".pd-lib-item")) {
          const empty = document.createElement("div");
          empty.id = "pd-lib-empty";
          empty.className = "text-ink-4";
          empty.style.cssText = "font-size:12.5px;";
          empty.textContent = "No uploads yet — drop a file above to get a link.";
          libGrid.appendChild(empty);
        }
        libToast("Removed from library.", "var(--pd-pink)");
      });
    }

    function prependLibItem(item: { id: string; url: string; kind: string; filename?: string | null }) {
      document.getElementById("pd-lib-empty")?.remove();
      const name = item.filename || "Untitled";
      const wrap = document.createElement("div");
      wrap.className = "pd-lib-item";
      wrap.dataset.id = item.id;
      wrap.dataset.url = item.url;
      wrap.setAttribute("style", libCard);
      const media = item.kind === "video"
        ? `<video src="${escAttr(item.url)}" muted loop playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover;"></video>`
        : `<img src="${escAttr(item.url)}" alt="${escAttr(name)}" style="width:100%;height:100%;object-fit:cover;" />`;
      wrap.innerHTML =
        `<div style="position:relative;height:120px;background:var(--pd-bg3);overflow:hidden;">${media}` +
        `<span style="position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8px;letter-spacing:0.4px;text-transform:uppercase;">${escHtml(item.kind)}</span></div>` +
        `<div style="padding:10px 12px;">` +
        `<div class="truncate font-semibold text-ink" style="font-size:12px;" title="${escAttr(name)}">${escHtml(name)}</div>` +
        `<div class="mt-1 truncate font-mono" style="font-size:9.5px;color:var(--pd-ink4);" title="${escAttr(item.url)}">${escHtml(item.url)}</div>` +
        `<div class="mt-2.5 flex items-center gap-1.5">` +
        `<button type="button" class="pd-lib-copy rounded-lg font-semibold" style="padding:5px 9px;font-size:11px;background:var(--pd-ink);color:var(--pd-bg);border:none;cursor:pointer;">Copy link</button>` +
        `<a href="${escAttr(item.url)}" target="_blank" rel="noopener" class="rounded-lg font-mono uppercase" style="padding:5px 8px;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-ink3);border:0.5px solid var(--pd-hairline2);text-decoration:none;">Open</a>` +
        `<button type="button" class="pd-lib-del font-mono uppercase" style="margin-left:auto;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-pink);background:none;border:none;cursor:pointer;">Remove</button>` +
        `</div></div>`;
      libGrid.prepend(wrap);
      wireLibItem(wrap);
    }

    document.querySelectorAll<HTMLElement>(".pd-lib-item").forEach(wireLibItem);

    document.getElementById("pd-lib-files")?.addEventListener("change", async (ev) => {
      const input = ev.target as HTMLInputElement;
      const files = Array.from(input.files || []);
      if (!files.length) return;
      const label = document.getElementById("pd-lib-up-label")!;
      label.textContent = "Uploading…";
      libStatus.textContent = "";
      let ok = 0;
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        libStatus.textContent = `Uploading ${i + 1}/${files.length}: ${file.name}`;
        const fd = new FormData();
        fd.append("file", file);
        try {
          const up = await fetch("/api/upload", { method: "POST", body: fd });
          const upd = await up.json();
          if (!up.ok) { libToast(upd.error || `Failed: ${file.name}`, "var(--pd-pink)"); continue; }
          const res = await fetch("/api/admin/media", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url: upd.url, kind: upd.kind, filename: file.name, bytes: file.size }),
          });
          const data = await res.json();
          if (!res.ok || !data.item) { libToast(data.error || "Save failed", "var(--pd-pink)"); continue; }
          prependLibItem(data.item);
          ok++;
        } catch {
          libToast(`Upload failed: ${file.name}`, "var(--pd-pink)");
        }
      }
      label.textContent = "Upload files";
      libStatus.textContent = ok ? `${ok} uploaded.` : "";
      if (ok) libToast(ok === 1 ? "Uploaded — copy the link below." : `${ok} files uploaded.`, "var(--pd-mint)");
      input.value = "";
    });

    document.querySelectorAll<HTMLElement>(".pd-tool").forEach((cardEl) => {
      const href = cardEl.dataset.href!;
      const input = cardEl.querySelector<HTMLInputElement>('input[type="file"]')!;
      const status = cardEl.querySelector<HTMLElement>(".pd-tool-status")!;
      const clearBtn = cardEl.querySelector<HTMLButtonElement>(".pd-tool-clear")!;
      const preview = cardEl.querySelector<HTMLElement>(".pd-tool-preview")!;
      const badge = cardEl.querySelector<HTMLElement>(".pd-tool-badge")!;
      const toast = (m: string, accent?: string) => (window as any).pdToast?.(m, accent ? { accent } : undefined);

      function renderMedia(url: string, type: string) {
        const old = preview.querySelector(".pd-tool-media");
        const el = type === "video" ? document.createElement("video") : document.createElement("img");
        el.className = "pd-tool-media";
        (el as HTMLMediaElement | HTMLImageElement).setAttribute("src", url);
        el.setAttribute("style", "width:100%;height:100%;object-fit:cover;");
        if (type === "video") { const v = el as HTMLVideoElement; v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true; }
        old?.replaceWith(el);
        badge.textContent = type;
        clearBtn.style.visibility = "visible";
      }

      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;
        status.textContent = "Uploading…";
        const fd = new FormData(); fd.append("file", file);
        try {
          const up = await fetch("/api/upload", { method: "POST", body: fd });
          const upd = await up.json();
          if (!up.ok) { status.textContent = upd.error || "Upload failed"; return; }
          const res = await fetch("/api/admin/tool-cards", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ href, url: upd.url, type: upd.kind }) });
          if (res.ok) { renderMedia(upd.url, upd.kind); status.textContent = ""; toast("Saved.", "var(--pd-mint)"); }
          else status.textContent = "Save failed";
        } catch { status.textContent = "Upload failed"; }
        input.value = "";
      });

      clearBtn.addEventListener("click", async () => {
        const res = await fetch("/api/admin/tool-cards", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ href, clear: true }) });
        if (res.ok) { toast("Reverted to default.", "var(--pd-pink)"); setTimeout(() => location.reload(), 500); }
        else toast("Failed.", "var(--pd-pink)");
      });
    });

    // ── Homepage hero management ──
    const tApi = (body: any) => fetch("/api/admin/hero", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const tToast = (m: string, a?: string) => (window as any).pdToast?.(m, a ? { accent: a } : undefined);
    const tReload = () => setTimeout(() => location.reload(), 350);

    document.getElementById("pd-hero-add-tpl")?.addEventListener("click", async () => {
      const id = (document.getElementById("pd-hero-tpl") as HTMLSelectElement)?.value;
      if (!id) return;
      const r = await tApi({ action: "add_template", id });
      if (r.ok) { tToast("Added to the hero.", "var(--pd-mint)"); tReload(); }
      else { const d = await r.json(); tToast(d.error || "Failed", "var(--pd-pink)"); }
    });

    // Removing an auto-filled slide: materialize the auto list minus this one
    // into a custom (template) list, so from then on the hero is curated.
    const autoItems = Array.from(document.querySelectorAll<HTMLElement>(".pd-hero-auto"));
    const autoIds = autoItems.map((el) => el.dataset.id!).filter(Boolean);
    autoItems.forEach((item) => {
      item.querySelector(".pd-hero-auto-del")?.addEventListener("click", async () => {
        const id = item.dataset.id;
        const r = await tApi({ action: "set_templates", ids: autoIds.filter((x) => x !== id) });
        if (r.ok) { tToast("Removed.", "var(--pd-pink)"); tReload(); } else tToast("Failed", "var(--pd-pink)");
      });
    });

    document.querySelectorAll<HTMLElement>(".pd-hero-item").forEach((item) => {
      const i = Number(item.dataset.i);
      item.querySelector(".pd-hero-del")?.addEventListener("click", async () => {
        const r = await tApi({ action: "remove", index: i });
        if (r.ok) { tToast("Removed.", "var(--pd-pink)"); tReload(); } else tToast("Failed", "var(--pd-pink)");
      });
      item.querySelectorAll<HTMLElement>(".pd-hero-move").forEach((b) =>
        b.addEventListener("click", async () => {
          const r = await tApi({ action: "move", index: i, dir: Number(b.dataset.dir) });
          if (r.ok) tReload(); else tToast("Failed", "var(--pd-pink)");
        })
      );
    });

    const tFile = document.getElementById("pd-hero-file") as HTMLInputElement | null;
    tFile?.addEventListener("change", async () => {
      const file = tFile.files?.[0];
      if (!file) return;
      const status = document.getElementById("pd-hero-status")!;
      const title = (document.getElementById("pd-hero-title") as HTMLInputElement).value.trim();
      if (!title) { status.textContent = "Enter a title first."; tFile.value = ""; return; }
      status.textContent = "Uploading…";
      const fd = new FormData(); fd.append("file", file);
      try {
        const up = await fetch("/api/upload", { method: "POST", body: fd });
        const upd = await up.json();
        if (!up.ok) { status.textContent = upd.error || "Upload failed"; tFile.value = ""; return; }
        const kicker = (document.getElementById("pd-hero-kicker") as HTMLInputElement).value.trim();
        const href = (document.getElementById("pd-hero-href") as HTMLInputElement).value.trim();
        const crRaw = (document.getElementById("pd-hero-cr") as HTMLInputElement).value.trim();
        const cr = crRaw === "" ? undefined : Number(crRaw);
        const r = await tApi({ action: "add_custom", title, kicker, href, cr, url: upd.url, mediaType: upd.kind });
        if (r.ok) { status.textContent = ""; tToast("Custom slide added.", "var(--pd-mint)"); tReload(); }
        else { const d = await r.json(); status.textContent = d.error || "Save failed"; }
      } catch { status.textContent = "Upload failed"; }
      tFile.value = "";
    });
  </script>
</AdminShell>

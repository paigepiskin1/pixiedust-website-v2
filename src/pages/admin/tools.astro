---
export const prerender = false;
import AdminShell from "../../layouts/AdminShell.astro";
import { isAdmin } from "../../lib/admin";
import { QUICK_TOOLS } from "../../lib/content";
import { getToolCards } from "../../lib/tool-cards";
import { getTrendingPicks } from "../../lib/trending";
import { getTemplate, listTemplates } from "../../lib/templates";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const media = await getToolCards(db);
const card = "background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-radius:16px;overflow:hidden;";

// Curated "Trending this week" picks — resolve each to a display row (aligned to
// index so remove/move work), plus a template list for the picker dropdown.
const picks = await getTrendingPicks(db);
const pickViews = await Promise.all(
  picks.map(async (p) => {
    if (p.kind === "template") {
      const t = await getTemplate(db, p.id);
      return { kind: "template" as const, label: t?.title ?? `(missing) ${p.id}`, sub: t?.category ?? p.id, thumb: t?.previewVideo || t?.previewImage || null, type: t?.previewVideo ? "video" : "image", href: t ? `/studio/${t.id}` : "#" };
    }
    return { kind: "custom" as const, label: p.title, sub: p.sub ?? p.href, thumb: p.url, type: p.mediaType, href: p.href };
  })
);
const allTemplates = (await listTemplates(db, { includeHidden: true, isAdmin: true })).map((t) => ({ id: t.id, title: t.title }));
---

<AdminShell title="Admin · Home cards" tab="tools">
  <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.7px;">Home cards</h1>
  <p class="mt-1 text-ink-3" style="font-size:13.5px;">Set a background image or video for each "Start a project" tool card. Leave empty to use the default gradient.</p>

  <div class="mt-6 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr));">
    {QUICK_TOOLS.map((t) => {
      const m = media[t.href];
      return (
        <div class="pd-tool" data-href={t.href} style={card}>
          <div class="pd-tool-preview" style="position:relative;height:150px;background:var(--pd-bg3);overflow:hidden;">
            {m?.type === "video" ? (
              <video class="pd-tool-media" src={m.url} muted loop playsinline autoplay preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : m?.url ? (
              <img class="pd-tool-media" src={m.url} alt={t.name} style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <div class="pd-tool-media" style={`width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:26px;color:${t.accent};background:color-mix(in srgb,${t.accent} 14%, var(--pd-bg3));`}>{t.glyph}</div>
            )}
            <span class="pd-tool-badge" style="position:absolute;top:8px;left:8px;padding:2px 7px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8.5px;letter-spacing:0.5px;text-transform:uppercase;">{m ? m.type : "default"}</span>
          </div>
          <div style="padding:12px 14px;">
            <div class="font-semibold text-ink" style="font-size:13.5px;">{t.name}</div>
            <div class="font-mono" style="font-size:10px;color:var(--pd-ink4);">{t.href}</div>
            <div class="mt-2.5 flex items-center gap-2">
              <label class="pd-tool-upload rounded-lg font-semibold" style="position:relative;padding:7px 12px;font-size:11.5px;background:var(--pd-lilac);color:#0A0A0B;cursor:pointer;overflow:hidden;">
                <span class="pd-tool-label">Upload</span>
                <input type="file" accept="image/*,video/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
              </label>
              <button type="button" class="pd-tool-clear font-mono uppercase" style={`font-size:10px;letter-spacing:0.5px;color:var(--pd-pink);background:none;border:none;cursor:pointer;${m ? "" : "visibility:hidden;"}`}>Remove</button>
              <span class="pd-tool-status" style="font-size:10.5px;color:var(--pd-ink3);"></span>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- ── Trending this week (home rail) ───────────────────────────────────── -->
  <div style="margin-top:40px;padding-top:28px;border-top:0.5px solid var(--pd-hairline);">
    <h2 class="font-display font-medium text-ink" style="font-size:22px;letter-spacing:-0.5px;">Trending this week</h2>
    <p class="mt-1 text-ink-3" style="font-size:13px;">The home “Trending this week” rail. Pick existing templates or add custom cards. Empty = automatic (featured + video templates).</p>

    <!-- Current picks -->
    <div id="pd-trend-list" class="mt-5 flex flex-wrap gap-3">
      {pickViews.length === 0 ? (
        <div class="text-ink-4" style="font-size:12.5px;">No picks yet — the rail auto-fills from featured templates.</div>
      ) : pickViews.map((pv, i) => (
        <div class="pd-trend-item" data-i={i} style={card + "width:190px;"}>
          <div style="position:relative;height:110px;background:var(--pd-bg3);overflow:hidden;">
            {pv.thumb ? (pv.type === "video" ? (
              <video src={pv.thumb} muted loop playsinline autoplay preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
            ) : (
              <img src={pv.thumb} alt={pv.label} style="width:100%;height:100%;object-fit:cover;" />
            )) : (
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--pd-ink4);">★</div>
            )}
            <span style={`position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,.6);color:#fff;font-size:8px;letter-spacing:0.4px;text-transform:uppercase;`}>{pv.kind}</span>
          </div>
          <div style="padding:9px 11px;">
            <div class="truncate font-semibold text-ink" style="font-size:12.5px;">{pv.label}</div>
            <div class="truncate font-mono" style="font-size:9.5px;color:var(--pd-ink4);">{pv.sub}</div>
            <div class="mt-2 flex items-center gap-1.5">
              <button type="button" class="pd-trend-move font-mono" data-dir="-1" title="Move left" style="font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);border-radius:6px;color:var(--pd-ink2);cursor:pointer;padding:2px 7px;">←</button>
              <button type="button" class="pd-trend-move font-mono" data-dir="1" title="Move right" style="font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);border-radius:6px;color:var(--pd-ink2);cursor:pointer;padding:2px 7px;">→</button>
              <button type="button" class="pd-trend-del font-mono uppercase" style="margin-left:auto;font-size:9.5px;letter-spacing:0.4px;color:var(--pd-pink);background:none;border:none;cursor:pointer;">remove</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Add controls -->
    <div class="mt-6 grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr));">
      <div style={card + "padding:16px;"}>
        <div class="font-semibold text-ink" style="font-size:13px;">Pick an existing template</div>
        <div class="mt-3 flex items-center gap-2">
          <select id="pd-trend-tpl" style="flex:1;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;">
            {allTemplates.map((t) => <option value={t.id}>{t.title}</option>)}
          </select>
          <button type="button" id="pd-trend-add-tpl" class="rounded-lg font-semibold" style="padding:8px 14px;font-size:12px;background:var(--pd-lilac);color:#0A0A0B;border:none;cursor:pointer;">Add</button>
        </div>
      </div>

      <div style={card + "padding:16px;"}>
        <div class="font-semibold text-ink" style="font-size:13px;">Add a custom card</div>
        <input id="pd-trend-title" placeholder="Title *" style="margin-top:10px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <input id="pd-trend-sub" placeholder="Subtitle (optional)" style="margin-top:7px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <input id="pd-trend-href" placeholder="Link (e.g. /studio/my-template)" style="margin-top:7px;width:100%;padding:8px 10px;border-radius:9px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;" />
        <div class="mt-2.5 flex items-center gap-2">
          <label class="rounded-lg font-semibold" style="position:relative;padding:7px 12px;font-size:11.5px;background:var(--pd-lilac);color:#0A0A0B;cursor:pointer;overflow:hidden;">
            <span id="pd-trend-up-label">Upload media + add</span>
            <input id="pd-trend-file" type="file" accept="image/*,video/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
          </label>
          <span id="pd-trend-status" style="font-size:10.5px;color:var(--pd-ink3);"></span>
        </div>
        <div class="mt-1 text-ink-4" style="font-size:10px;">Title required. Upload triggers the add once the file finishes.</div>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>(".pd-tool").forEach((cardEl) => {
      const href = cardEl.dataset.href!;
      const input = cardEl.querySelector<HTMLInputElement>('input[type="file"]')!;
      const status = cardEl.querySelector<HTMLElement>(".pd-tool-status")!;
      const clearBtn = cardEl.querySelector<HTMLButtonElement>(".pd-tool-clear")!;
      const preview = cardEl.querySelector<HTMLElement>(".pd-tool-preview")!;
      const badge = cardEl.querySelector<HTMLElement>(".pd-tool-badge")!;
      const toast = (m: string, accent?: string) => (window as any).pdToast?.(m, accent ? { accent } : undefined);

      function renderMedia(url: string, type: string) {
        const old = preview.querySelector(".pd-tool-media");
        const el = type === "video" ? document.createElement("video") : document.createElement("img");
        el.className = "pd-tool-media";
        (el as HTMLMediaElement | HTMLImageElement).setAttribute("src", url);
        el.setAttribute("style", "width:100%;height:100%;object-fit:cover;");
        if (type === "video") { const v = el as HTMLVideoElement; v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true; }
        old?.replaceWith(el);
        badge.textContent = type;
        clearBtn.style.visibility = "visible";
      }

      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;
        status.textContent = "Uploading…";
        const fd = new FormData(); fd.append("file", file);
        try {
          const up = await fetch("/api/upload", { method: "POST", body: fd });
          const upd = await up.json();
          if (!up.ok) { status.textContent = upd.error || "Upload failed"; return; }
          const res = await fetch("/api/admin/tool-cards", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ href, url: upd.url, type: upd.kind }) });
          if (res.ok) { renderMedia(upd.url, upd.kind); status.textContent = ""; toast("Saved.", "var(--pd-mint)"); }
          else status.textContent = "Save failed";
        } catch { status.textContent = "Upload failed"; }
        input.value = "";
      });

      clearBtn.addEventListener("click", async () => {
        const res = await fetch("/api/admin/tool-cards", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ href, clear: true }) });
        if (res.ok) { toast("Reverted to default.", "var(--pd-pink)"); setTimeout(() => location.reload(), 500); }
        else toast("Failed.", "var(--pd-pink)");
      });
    });

    // ── Trending picks management ──
    const tApi = (body: any) => fetch("/api/admin/trending", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const tToast = (m: string, a?: string) => (window as any).pdToast?.(m, a ? { accent: a } : undefined);
    const tReload = () => setTimeout(() => location.reload(), 350);

    document.getElementById("pd-trend-add-tpl")?.addEventListener("click", async () => {
      const id = (document.getElementById("pd-trend-tpl") as HTMLSelectElement)?.value;
      if (!id) return;
      const r = await tApi({ action: "add_template", id });
      if (r.ok) { tToast("Added to trending.", "var(--pd-mint)"); tReload(); }
      else { const d = await r.json(); tToast(d.error || "Failed", "var(--pd-pink)"); }
    });

    document.querySelectorAll<HTMLElement>(".pd-trend-item").forEach((item) => {
      const i = Number(item.dataset.i);
      item.querySelector(".pd-trend-del")?.addEventListener("click", async () => {
        const r = await tApi({ action: "remove", index: i });
        if (r.ok) { tToast("Removed.", "var(--pd-pink)"); tReload(); } else tToast("Failed", "var(--pd-pink)");
      });
      item.querySelectorAll<HTMLElement>(".pd-trend-move").forEach((b) =>
        b.addEventListener("click", async () => {
          const r = await tApi({ action: "move", index: i, dir: Number(b.dataset.dir) });
          if (r.ok) tReload(); else tToast("Failed", "var(--pd-pink)");
        })
      );
    });

    const tFile = document.getElementById("pd-trend-file") as HTMLInputElement | null;
    tFile?.addEventListener("change", async () => {
      const file = tFile.files?.[0];
      if (!file) return;
      const status = document.getElementById("pd-trend-status")!;
      const title = (document.getElementById("pd-trend-title") as HTMLInputElement).value.trim();
      if (!title) { status.textContent = "Enter a title first."; tFile.value = ""; return; }
      status.textContent = "Uploading…";
      const fd = new FormData(); fd.append("file", file);
      try {
        const up = await fetch("/api/upload", { method: "POST", body: fd });
        const upd = await up.json();
        if (!up.ok) { status.textContent = upd.error || "Upload failed"; tFile.value = ""; return; }
        const sub = (document.getElementById("pd-trend-sub") as HTMLInputElement).value.trim();
        const href = (document.getElementById("pd-trend-href") as HTMLInputElement).value.trim();
        const r = await tApi({ action: "add_custom", title, sub, href, url: upd.url, mediaType: upd.kind });
        if (r.ok) { status.textContent = ""; tToast("Custom card added.", "var(--pd-mint)"); tReload(); }
        else { const d = await r.json(); status.textContent = d.error || "Save failed"; }
      } catch { status.textContent = "Upload failed"; }
      tFile.value = "";
    });
  </script>
</AdminShell>

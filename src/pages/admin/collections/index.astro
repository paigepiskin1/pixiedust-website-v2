---
export const prerender = false;
import AdminShell from "../../../layouts/AdminShell.astro";
import { isAdmin } from "../../../lib/admin";
import { adminListCollections, adminListItems, isScheduled, displayDate } from "../../../lib/collections";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const collections = await adminListCollections(db);
const items = await adminListItems(db);

const byCol = new Map<string, typeof items>();
for (const i of items) {
  if (!byCol.has(i.collection_id)) byCol.set(i.collection_id, []);
  byCol.get(i.collection_id)!.push(i);
}

const stateOf = (i: (typeof items)[number]) =>
  isScheduled(i) ? "scheduled" : i.status === "published" ? "published" : "draft";
const pill = (s: string) =>
  s === "published"
    ? "color:var(--pd-mint);border:0.5px solid color-mix(in srgb,var(--pd-mint) 40%,transparent);"
    : s === "scheduled"
      ? "color:var(--pd-amber);border:0.5px solid color-mix(in srgb,var(--pd-amber) 40%,transparent);"
      : "color:var(--pd-ink3);border:0.5px solid var(--pd-hairline2);";
---

<AdminShell title="Sections — PixyDust Admin" tab="collections">
  <div class="mx-auto w-full" style="max-width:1100px;padding:28px;">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="mb-[7px] flex items-center gap-[7px]">
          <span style="width:5px;height:5px;border-radius:999px;background:var(--pd-pink);display:inline-block;"></span>
          <span class="font-mono uppercase" style="font-size:10.5px;color:var(--pd-ink3);letter-spacing:1.2px;">Content sections</span>
        </div>
        <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;">Sections</h1>
        <p class="mt-1 text-ink-3" style="font-size:13px;">
          {collections.length} sections · {items.length} items. Each has its own index page and one page per item.
        </p>
      </div>
      <button type="button" id="pd-new-section" class="rounded-xl font-bold"
        style="padding:9px 16px;font-size:13px;background:var(--pd-ink);color:var(--pd-bg);border:0;cursor:pointer;">New section</button>
    </div>

    {collections.map((c) => {
      const list = byCol.get(c.id) ?? [];
      const live = list.filter((i) => stateOf(i) === "published").length;
      return (
        <section class="mb-4 overflow-hidden rounded-2xl" style="background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <header class="flex flex-wrap items-center gap-3" style="padding:14px 16px;border-bottom:0.5px solid var(--pd-hairline);">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-display font-semibold text-ink" style="font-size:15px;letter-spacing:-0.3px;">{c.title}</span>
                <span class="font-mono uppercase" style={`font-size:9px;letter-spacing:1px;border-radius:999px;padding:2px 7px;${pill(c.status)}`}>{c.status}</span>
                {c.in_footer === 1 && (
                  <span class="font-mono uppercase" style="font-size:9px;letter-spacing:1px;color:var(--pd-ink4);">in footer</span>
                )}
              </div>
              <div class="mt-0.5 font-mono text-ink-4" style="font-size:10.5px;">
                /{c.slug} · {c.index_template} index, {c.item_template} pages · {live} live of {list.length}
              </div>
            </div>
            <a href={`/admin/collections/${c.id}`} class="rounded-lg text-ink-2"
              style="padding:6px 11px;font-size:11.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);text-decoration:none;">Settings</a>
            <button type="button" class="pd-new-item rounded-lg font-semibold text-ink" data-id={c.id}
              style="padding:6px 11px;font-size:11.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">+ Item</button>
          </header>

          {list.length === 0 ? (
            <div class="text-ink-4" style="padding:14px 16px;font-size:12px;">
              Nothing here yet — add the first {c.noun.replace(/s$/, "")}.
            </div>
          ) : (
            <ul class="pd-sortable" style="list-style:none;margin:0;padding:0;">
              {list.map((i) => (
                <li class="flex flex-wrap items-center gap-3" data-id={i.id}
                  style="padding:11px 16px;border-top:0.5px solid var(--pd-hairline);">
                  <span class="pd-grip" title="Drag to reorder" style="cursor:grab;color:var(--pd-ink4);font-size:12px;user-select:none;">⠿</span>
                  <a href={`/admin/collections/edit/${i.id}`} class="min-w-0 flex-1" style="text-decoration:none;">
                    <div class="text-ink" style="font-size:13px;line-height:1.3;">{i.title}</div>
                    <div class="mt-0.5 font-mono text-ink-4" style="font-size:10px;">
                      /{c.slug}/{i.slug}
                      {i.external_url && <span style="color:var(--pd-lilac);"> · links out</span>}
                      {i.published_at && <span> · {displayDate(i.published_at)}</span>}
                    </div>
                  </a>
                  {i.featured === 1 && <span class="font-mono uppercase" style="font-size:9px;letter-spacing:0.8px;color:var(--pd-lilac);">featured</span>}
                  <span class="font-mono uppercase" style={`font-size:9px;letter-spacing:1px;border-radius:999px;padding:2px 7px;${pill(stateOf(i))}`}>{stateOf(i)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}
  </div>

  <style is:global>
    .pd-sortable li.pd-dragging { opacity: 0.45; }
    .pd-sortable li.pd-over { border-top: 2px solid var(--pd-lilac); }
  </style>

  <script>
    const toast = (m: string) => (window as any).pdToast?.(m);
    const post = async (payload: any) => {
      const res = await fetch("/api/admin/collections", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      });
      const j = await res.json().catch(() => ({}));
      if (!j.ok) toast(j.error || "Request failed.");
      return j;
    };

    document.getElementById("pd-new-section")?.addEventListener("click", async () => {
      const title = prompt("Section name (e.g. Workflow Guides)");
      if (!title) return;
      const j = await post({ action: "create-collection", title });
      if (j.ok) location.href = `/admin/collections/${j.id}`;
    });

    document.querySelectorAll<HTMLButtonElement>(".pd-new-item").forEach((b) => {
      b.addEventListener("click", async () => {
        const title = prompt("Title");
        if (!title) return;
        const j = await post({ action: "create-item", collectionId: b.dataset.id, title });
        if (j.ok) location.href = `/admin/collections/edit/${j.id}`;
      });
    });

    // Drag to reorder within a section. Order drives the public index page, so
    // it saves immediately rather than behind a separate button.
    document.querySelectorAll<HTMLUListElement>(".pd-sortable").forEach((list) => {
      let dragging: HTMLLIElement | null = null;
      list.querySelectorAll<HTMLLIElement>("li").forEach((li) => {
        li.querySelector<HTMLElement>(".pd-grip")?.addEventListener("mousedown", () => (li.draggable = true));
        li.addEventListener("dragstart", () => { dragging = li; li.classList.add("pd-dragging"); });
        li.addEventListener("dragend", async () => {
          li.classList.remove("pd-dragging");
          li.draggable = false;
          list.querySelectorAll("li").forEach((x) => x.classList.remove("pd-over"));
          dragging = null;
          const order = [...list.querySelectorAll<HTMLLIElement>("li")].map((x) => Number(x.dataset.id));
          const j = await post({ action: "reorder", kind: "item", order });
          if (j.ok) toast("Order saved.");
        });
        li.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (!dragging || dragging === li) return;
          const r = li.getBoundingClientRect();
          li.classList.add("pd-over");
          list.insertBefore(dragging, (e as DragEvent).clientY > r.top + r.height / 2 ? li.nextSibling : li);
        });
        li.addEventListener("dragleave", () => li.classList.remove("pd-over"));
      });
    });
  </script>
</AdminShell>

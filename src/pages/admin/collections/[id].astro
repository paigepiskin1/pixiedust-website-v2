---
export const prerender = false;
import AdminShell from "../../../layouts/AdminShell.astro";
import { isAdmin } from "../../../lib/admin";
import { adminGetCollection, adminListItems, INDEX_TEMPLATES, ITEM_TEMPLATES } from "../../../lib/collections";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const id = Astro.params.id!;
const c = await adminGetCollection(db, id);
if (!c) return Astro.redirect("/admin/collections");

const items = await adminListItems(db, id);

const INDEX_HELP: Record<string, string> = {
  grid: "Cards in a responsive grid. Good for visual sections.",
  list: "Compact rows with a summary. Good for long reference lists.",
  gallery: "Image-first, larger media. Good for showcase sections.",
};
const ITEM_HELP: Record<string, string> = {
  article: "Hero image, rich body. The blog-style page.",
  gallery: "Media-first page with the body beneath.",
  steps: "Numbered walkthrough layout for tutorials and guides.",
  link: "No detail page — cards link straight to the external URL.",
};
---

<AdminShell title={`${c.title} — Sections — PixyDust Admin`} tab="collections">
  <script type="application/json" id="pd-col-data" set:html={JSON.stringify({ id: c.id, itemCount: items.length })} />

  <div class="mx-auto w-full" style="max-width:760px;padding:28px 28px 80px;">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <a href="/admin/collections" class="text-ink-3" style="font-size:12px;text-decoration:none;">← Sections</a>
      <span id="pd-save-state" class="text-ink-4" style="font-size:11.5px;"></span>
      <div class="ml-auto flex items-center gap-2">
        <a id="pd-view" href={`/${c.slug}`} target="_blank" rel="noopener" class="rounded-xl text-ink-2"
          style="padding:8px 13px;font-size:12.5px;border:0.5px solid var(--pd-hairline2);text-decoration:none;">View ↗</a>
        <button type="button" id="pd-save" class="rounded-xl font-bold"
          style="padding:8px 16px;font-size:12.5px;background:var(--pd-ink);color:var(--pd-bg);border:0;cursor:pointer;">Save</button>
      </div>
    </div>

    <section class="rounded-2xl" style="padding:20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
      <label class="block text-ink-3" style="font-size:11px;">Section name</label>
      <input id="pd-title" type="text" value={c.title} class="mt-1 w-full rounded-lg text-ink"
        style="padding:9px 11px;font-size:14px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />

      <label class="mt-3 block text-ink-3" style="font-size:11px;">URL</label>
      <input id="pd-slug" type="text" value={c.slug} class="mt-1 w-full rounded-lg font-mono text-ink-2"
        style="padding:9px 11px;font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />
      <div id="pd-url" class="mt-1 font-mono text-ink-4" style="font-size:10.5px;"></div>
      {items.length > 0 && (
        <p class="mt-1" style="font-size:10.5px;color:var(--pd-amber);line-height:1.4;">
          Changing this moves all {items.length} item URLs under the new path. Existing links will break.
        </p>
      )}

      <label class="mt-3 block text-ink-3" style="font-size:11px;">Description</label>
      <textarea id="pd-blurb" rows="2" class="mt-1 w-full rounded-lg text-ink-2"
        style="padding:9px 11px;font-size:13px;line-height:1.5;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;resize:vertical;">{c.blurb}</textarea>

      <div class="mt-4 grid gap-3" style="grid-template-columns:1fr 1fr;">
        <div>
          <label class="block text-ink-3" style="font-size:11px;">Index page layout</label>
          <select id="pd-index-template" class="mt-1 w-full rounded-lg text-ink"
            style="padding:8px 10px;font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;">
            {INDEX_TEMPLATES.map((t) => <option value={t} selected={t === c.index_template}>{t}</option>)}
          </select>
          <p id="pd-index-help" class="mt-1 text-ink-4" style="font-size:10.5px;line-height:1.4;"></p>
        </div>
        <div>
          <label class="block text-ink-3" style="font-size:11px;">Item page layout</label>
          <select id="pd-item-template" class="mt-1 w-full rounded-lg text-ink"
            style="padding:8px 10px;font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;">
            {ITEM_TEMPLATES.map((t) => <option value={t} selected={t === c.item_template}>{t}</option>)}
          </select>
          <p id="pd-item-help" class="mt-1 text-ink-4" style="font-size:10.5px;line-height:1.4;"></p>
        </div>
      </div>

      <div class="mt-4 grid gap-3" style="grid-template-columns:1fr 1fr;">
        <div>
          <label class="block text-ink-3" style="font-size:11px;">Noun for counts</label>
          <input id="pd-noun" type="text" value={c.noun} placeholder="effects"
            class="mt-1 w-full rounded-lg text-ink-2"
            style="padding:8px 10px;font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />
          <p class="mt-1 text-ink-4" style="font-size:10.5px;">Shown as “12 {c.noun}”.</p>
        </div>
        <div>
          <label class="block text-ink-3" style="font-size:11px;">Status</label>
          <select id="pd-status" class="mt-1 w-full rounded-lg text-ink"
            style="padding:8px 10px;font-size:12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;">
            <option value="published" selected={c.status === "published"}>published</option>
            <option value="draft" selected={c.status === "draft"}>draft — hidden from the site</option>
          </select>
        </div>
      </div>

      <label class="mt-4 flex items-center gap-2 text-ink-2" style="font-size:12px;cursor:pointer;">
        <input id="pd-footer" type="checkbox" checked={c.in_footer === 1} />
        Link from the site footer
      </label>

      <button type="button" id="pd-delete" class="mt-5 w-full rounded-lg"
        style="padding:8px;font-size:11.5px;border:0.5px solid color-mix(in srgb,var(--pd-pink) 40%,transparent);background:transparent;color:var(--pd-pink);cursor:pointer;">
        Delete section
      </button>
    </section>
  </div>

  <script>
    const data = JSON.parse(document.getElementById("pd-col-data")!.textContent || "{}");
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const toast = (m: string) => (window as any).pdToast?.(m);
    const stateEl = $("pd-save-state");

    const INDEX_HELP: Record<string, string> = {
      grid: "Cards in a responsive grid. Good for visual sections.",
      list: "Compact rows with a summary. Good for long reference lists.",
      gallery: "Image-first, larger media. Good for showcase sections.",
    };
    const ITEM_HELP: Record<string, string> = {
      article: "Hero image, rich body. The blog-style page.",
      gallery: "Media-first page with the body beneath.",
      steps: "Numbered walkthrough layout for tutorials and guides.",
      link: "No detail page — cards link straight to the external URL.",
    };

    const slugEl = $<HTMLInputElement>("pd-slug");
    const idxEl = $<HTMLSelectElement>("pd-index-template");
    const itmEl = $<HTMLSelectElement>("pd-item-template");

    const renderHelp = () => {
      $("pd-index-help").textContent = INDEX_HELP[idxEl.value] || "";
      $("pd-item-help").textContent = ITEM_HELP[itmEl.value] || "";
      $("pd-url").textContent = `pixydust.com/${slugEl.value || "…"}`;
    };
    [idxEl, itmEl].forEach((el) => el.addEventListener("change", renderHelp));
    slugEl.addEventListener("input", renderHelp);
    renderHelp();

    $("pd-save").addEventListener("click", async () => {
      stateEl.textContent = "Saving…";
      const res = await fetch("/api/admin/collections", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "save-collection",
          collectionId: data.id,
          slug: slugEl.value,
          title: $<HTMLInputElement>("pd-title").value,
          blurb: $<HTMLTextAreaElement>("pd-blurb").value,
          indexTemplate: idxEl.value,
          itemTemplate: itmEl.value,
          noun: $<HTMLInputElement>("pd-noun").value,
          status: $<HTMLSelectElement>("pd-status").value,
          inFooter: $<HTMLInputElement>("pd-footer").checked,
        }),
      });
      const j = await res.json().catch(() => ({}));
      if (!j.ok) { stateEl.textContent = "Save failed"; toast(j.error || "Could not save."); return; }
      slugEl.value = j.slug;
      $<HTMLAnchorElement>("pd-view").href = `/${j.slug}`;
      stateEl.textContent = `Saved ${new Date().toLocaleTimeString()}`;
      renderHelp();
    });

    $("pd-delete").addEventListener("click", async () => {
      if (data.itemCount > 0) {
        toast(`Delete the ${data.itemCount} item(s) first — removing the section would 404 their URLs.`);
        return;
      }
      if (!confirm("Delete this section permanently?")) return;
      const res = await fetch("/api/admin/collections", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "delete-collection", collectionId: data.id }),
      });
      const j = await res.json().catch(() => ({}));
      if (j.ok) location.href = "/admin/collections";
      else toast(j.error || "Could not delete.");
    });
  </script>
</AdminShell>

---
export const prerender = false;
import AdminShell from "../../../../layouts/AdminShell.astro";
import { isAdmin } from "../../../../lib/admin";
import { isoDate } from "../../../../lib/blog";
import { adminGetItem, adminListCollections, adminGetCollection, tagsOf, metaOf } from "../../../../lib/collections";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const id = Number(Astro.params.id);
const item = Number.isFinite(id) ? await adminGetItem(db, id) : null;
if (!item) return Astro.redirect("/admin/collections");

const collection = await adminGetCollection(db, item.collection_id);
const collections = await adminListCollections(db);

const initial = {
  id: item.id,
  collectionId: item.collection_id,
  slug: item.slug,
  title: item.title,
  summary: item.summary ?? "",
  heroUrl: item.hero_url ?? "",
  heroAlt: item.hero_alt ?? "",
  externalUrl: item.external_url ?? "",
  meta: metaOf(item),
  tags: tagsOf(item),
  status: item.status,
  featured: item.featured === 1,
  publishedAt: isoDate(item.published_at) ?? "",
  collectionSlug: collection?.slug ?? "",
  itemTemplate: collection?.item_template ?? "article",
  slugs: Object.fromEntries(collections.map((c) => [c.id, c.slug])),
};
---

<AdminShell title={`${item.title} — PixyDust Admin`} tab="collections">
  <script type="application/json" id="pd-item-data" set:html={JSON.stringify(initial)} />

  <div class="mx-auto w-full" style="max-width:1180px;padding:24px 28px 80px;">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <a href="/admin/collections" class="text-ink-3" style="font-size:12px;text-decoration:none;">← Sections</a>
      <span id="pd-save-state" class="text-ink-4" style="font-size:11.5px;"></span>
      <div class="ml-auto flex items-center gap-2">
        <a id="pd-view" href={`/${initial.collectionSlug}/${item.slug}`} target="_blank" rel="noopener"
          class="rounded-xl text-ink-2" style="padding:8px 13px;font-size:12.5px;border:0.5px solid var(--pd-hairline2);text-decoration:none;">View ↗</a>
        <button type="button" id="pd-save" class="rounded-xl font-semibold text-ink"
          style="padding:8px 14px;font-size:12.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg2);cursor:pointer;">Save</button>
        <button type="button" id="pd-publish" class="rounded-xl font-bold"
          style="padding:8px 16px;font-size:12.5px;background:var(--pd-ink);color:var(--pd-bg);border:0;cursor:pointer;">Publish</button>
      </div>
    </div>

    <div class="grid gap-6" style="grid-template-columns:minmax(0,1fr) 310px;">
      <div>
        <input id="pd-title" type="text" value={item.title} placeholder="Title"
          class="w-full rounded-xl font-display font-medium text-ink"
          style="padding:12px 14px;font-size:24px;letter-spacing:-0.6px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);outline:none;" />

        <div class="mt-2 flex items-center gap-2">
          <span class="font-mono text-ink-4" style="font-size:11px;" id="pd-url-prefix"></span>
          <input id="pd-slug" type="text" value={item.slug}
            class="flex-1 rounded-lg font-mono text-ink-2"
            style="padding:6px 9px;font-size:11.5px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);outline:none;" />
        </div>

        <div id="pd-toolbar" class="mt-5 flex flex-wrap items-center gap-1 rounded-xl"
          style="padding:7px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <button type="button" data-cmd="formatBlock" data-arg="h2">H2</button>
          <button type="button" data-cmd="formatBlock" data-arg="h3">H3</button>
          <button type="button" data-cmd="formatBlock" data-arg="p">¶</button>
          <span class="pd-sep"></span>
          <button type="button" data-cmd="bold"><b>B</b></button>
          <button type="button" data-cmd="italic"><i>I</i></button>
          <button type="button" data-cmd="createLink">Link</button>
          <span class="pd-sep"></span>
          <button type="button" data-cmd="insertUnorderedList">• List</button>
          <button type="button" data-cmd="insertOrderedList">1. List</button>
          <button type="button" data-cmd="formatBlock" data-arg="blockquote">Quote</button>
          <span class="pd-sep"></span>
          <button type="button" id="pd-img-btn">🖼 Image</button>
          <span class="ml-auto text-ink-4" style="font-size:11px;padding-right:6px;" id="pd-wordcount"></span>
        </div>

        <div id="pd-editor" contenteditable="true" spellcheck="true" class="pd-prose mt-3 rounded-xl"
          style="min-height:420px;padding:22px 24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);outline:none;"
          set:html={item.content_html || "<p></p>"} />

        <p class="mt-2 text-ink-4" style="font-size:11.5px;">
          Paste or drag images straight in — they upload to the CDN automatically.
        </p>
        <input type="file" id="pd-file" accept="image/*" multiple hidden />
      </div>

      <div class="flex flex-col gap-3">
        <section class="rounded-2xl" style="padding:16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <label class="block text-ink-3" style="font-size:11px;">Section</label>
          <select id="pd-collection" class="mt-1 w-full rounded-lg text-ink"
            style="padding:7px 9px;font-size:11.5px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;">
            {collections.map((c) => <option value={c.id} selected={c.id === item.collection_id}>{c.title}</option>)}
          </select>

          <label class="mt-3 block text-ink-3" style="font-size:11px;">Summary — card copy and meta description</label>
          <textarea id="pd-summary" rows="3" placeholder="One or two sentences."
            class="mt-1 w-full rounded-lg text-ink-2"
            style="padding:8px 10px;font-size:12px;line-height:1.5;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;resize:vertical;">{initial.summary}</textarea>

          <label class="mt-3 block text-ink-3" style="font-size:11px;">External link (optional)</label>
          <input id="pd-external" type="url" value={initial.externalUrl} placeholder="https://publisher.com/article"
            class="mt-1 w-full rounded-lg text-ink-2"
            style="padding:7px 9px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />
          <p class="mt-1 text-ink-4" style="font-size:10.5px;line-height:1.4;">
            Set this and the card links straight out — no page of ours is rendered. For press coverage.
          </p>
        </section>

        <section class="rounded-2xl" style="padding:16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <label class="block text-ink-3" style="font-size:11px;">Cover image</label>
          <div id="pd-thumb-wrap" class="mt-2 overflow-hidden rounded-lg"
            style="aspect-ratio:16/9;background:var(--pd-bg3);display:flex;align-items:center;justify-content:center;"></div>
          <div class="mt-2 flex gap-1.5">
            <button type="button" id="pd-thumb-upload" class="flex-1 rounded-lg font-semibold text-ink"
              style="padding:6px;font-size:11px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">Upload</button>
            <button type="button" id="pd-thumb-from-body" class="flex-1 rounded-lg font-semibold text-ink"
              style="padding:6px;font-size:11px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">From body</button>
            <button type="button" id="pd-thumb-clear" class="rounded-lg text-ink-3"
              style="padding:6px 9px;font-size:11px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">×</button>
          </div>
          <input id="pd-thumb-alt" type="text" value={initial.heroAlt} placeholder="Alt text"
            class="mt-2 w-full rounded-lg text-ink-2"
            style="padding:6px 9px;font-size:11px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />
          <input type="file" id="pd-thumb-file" accept="image/*" hidden />
        </section>

        <section class="rounded-2xl" style="padding:16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <label class="block text-ink-3" style="font-size:11px;">Tags (comma separated)</label>
          <input id="pd-tags" type="text" value={initial.tags.join(", ")} placeholder="AR, beauty"
            class="mt-1 w-full rounded-lg text-ink-2"
            style="padding:7px 9px;font-size:11.5px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;" />

          <!-- Free-form key/value pairs, so a template can grow new fields
               (brand, platform, year, credits) without a migration. -->
          <div class="mt-3 flex items-center justify-between">
            <label class="block text-ink-3" style="font-size:11px;">Details</label>
            <button type="button" id="pd-meta-add" class="rounded-md text-ink-3"
              style="padding:3px 7px;font-size:10px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">+ Add</button>
          </div>
          <div id="pd-meta-list" class="mt-1.5 flex flex-col gap-1.5"></div>
          <p class="mt-1 text-ink-4" style="font-size:10.5px;line-height:1.4;">
            e.g. Brand → Netflix, Platform → Instagram, Year → 2023.
          </p>
        </section>

        <section class="rounded-2xl" style="padding:16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <label class="flex items-center gap-2 text-ink-2" style="font-size:11.5px;cursor:pointer;">
            <input id="pd-featured" type="checkbox" checked={initial.featured} />
            Feature at the top of the section
          </label>

          <div class="mt-3 flex items-center justify-between">
            <span class="text-ink-3" style="font-size:11px;">Status</span>
            <span id="pd-status-pill" class="font-mono uppercase"
              style="font-size:9.5px;letter-spacing:1px;border-radius:999px;padding:3px 9px;"></span>
          </div>

          <label class="mt-3 block text-ink-3" style="font-size:11px;">Publish date &amp; time</label>
          <input id="pd-published-at" type="datetime-local" class="mt-1 w-full rounded-lg text-ink"
            style="padding:7px 9px;font-size:11.5px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);outline:none;color-scheme:dark;" />
          <div class="mt-1 flex items-center justify-between gap-2">
            <span id="pd-schedule-hint" class="text-ink-4" style="font-size:10.5px;line-height:1.35;"></span>
            <button type="button" id="pd-now" class="shrink-0 rounded-md text-ink-3"
              style="padding:3px 7px;font-size:10px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">Now</button>
          </div>

          <button type="button" id="pd-unpublish" class="mt-3 w-full rounded-lg text-ink-3"
            style="padding:7px;font-size:11.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">Revert to draft</button>
          <button type="button" id="pd-delete" class="mt-2 w-full rounded-lg"
            style="padding:7px;font-size:11.5px;border:0.5px solid color-mix(in srgb,var(--pd-pink) 40%,transparent);background:transparent;color:var(--pd-pink);cursor:pointer;">Delete</button>
        </section>
      </div>
    </div>
  </div>

  <style is:global>
    #pd-toolbar button {
      background: var(--pd-bg); color: var(--pd-ink2); border: 0.5px solid var(--pd-hairline2);
      border-radius: 7px; padding: 5px 9px; font-size: 11.5px; cursor: pointer; line-height: 1;
    }
    #pd-toolbar button:hover { color: var(--pd-ink); border-color: var(--pd-lilac); }
    #pd-toolbar .pd-sep { width: 1px; height: 16px; background: var(--pd-hairline2); margin: 0 3px; }
    #pd-editor:empty::before { content: "Write it…"; color: var(--pd-ink-4, #666); }
    #pd-editor { font-size: 15.5px; line-height: 1.72; color: var(--pd-ink2); }
    #pd-editor > * + * { margin-top: 1.15em; }
    #pd-editor h2 { font-size: 24px; font-weight: 600; color: var(--pd-ink); margin-top: 1.9em; }
    #pd-editor h3 { font-size: 18.5px; font-weight: 600; color: var(--pd-ink); margin-top: 1.6em; }
    #pd-editor a { color: var(--pd-lilac); }
    #pd-editor ul { list-style: disc; padding-left: 1.3em; }
    #pd-editor ol { list-style: decimal; padding-left: 1.3em; }
    #pd-editor blockquote { border-left: 2px solid var(--pd-lilac); padding-left: 1em; font-style: italic; }
    #pd-editor img { max-width: 100%; border-radius: 12px; }
    #pd-editor.pd-drop { border-color: var(--pd-lilac); }
    .pd-meta-row { display: flex; align-items: center; gap: 4px; }
    .pd-meta-row input {
      background: var(--pd-bg); border: 0.5px solid var(--pd-hairline2); border-radius: 7px;
      padding: 5px 8px; font-size: 11px; color: var(--pd-ink2); outline: none; min-width: 0;
    }
  </style>

  <script>
    const data = JSON.parse(document.getElementById("pd-item-data")!.textContent || "{}");
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const toast = (m: string) => (window as any).pdToast?.(m);

    const editor = $<HTMLDivElement>("pd-editor");
    const titleEl = $<HTMLInputElement>("pd-title");
    const slugEl = $<HTMLInputElement>("pd-slug");
    const summaryEl = $<HTMLTextAreaElement>("pd-summary");
    const collectionEl = $<HTMLSelectElement>("pd-collection");
    const externalEl = $<HTMLInputElement>("pd-external");
    const tagsEl = $<HTMLInputElement>("pd-tags");
    const altEl = $<HTMLInputElement>("pd-thumb-alt");
    const featuredEl = $<HTMLInputElement>("pd-featured");
    const publishedAtEl = $<HTMLInputElement>("pd-published-at");
    const stateEl = $("pd-save-state");

    let heroUrl: string = data.heroUrl || "";
    let status: string = data.status || "draft";
    let dirty = false;
    const markDirty = () => { dirty = true; stateEl.textContent = "Unsaved changes"; };

    // ── slug + url ────────────────────────────────────────────────────────
    const slugify = (s: string) =>
      (s || "").toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 80);
    let slugTouched = data.slug !== slugify(data.title);
    const renderUrl = () => {
      $("pd-url-prefix").textContent = `/${data.slugs[collectionEl.value] || "…"}/`;
    };
    titleEl.addEventListener("input", () => {
      if (!slugTouched) slugEl.value = slugify(titleEl.value);
      markDirty(); renderWordcount();
    });
    slugEl.addEventListener("input", () => { slugTouched = true; markDirty(); });
    collectionEl.addEventListener("change", () => { markDirty(); renderUrl(); });
    [summaryEl, externalEl, tagsEl, altEl, featuredEl].forEach((el) => el.addEventListener("input", markDirty));

    const renderWordcount = () => {
      const words = (editor.innerText || "").trim().split(/\s+/).filter(Boolean).length;
      $("pd-wordcount").textContent = `${words} words`;
    };
    editor.addEventListener("input", () => { markDirty(); renderWordcount(); });

    // ── toolbar ───────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>("#pd-toolbar button[data-cmd]").forEach((b) => {
      b.addEventListener("mousedown", (e) => e.preventDefault());
      b.addEventListener("click", () => {
        const cmd = b.dataset.cmd!;
        if (cmd === "createLink") {
          const url = prompt("Link URL");
          if (url) document.execCommand("createLink", false, url);
        } else if (cmd === "formatBlock") document.execCommand("formatBlock", false, b.dataset.arg!);
        else document.execCommand(cmd, false);
        editor.focus(); markDirty();
      });
    });

    // ── images ────────────────────────────────────────────────────────────
    async function uploadImage(file: File): Promise<string | null> {
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const j = await res.json();
        if (j.url) return j.url as string;
        toast(j.error || "Upload failed.");
      } catch { toast("Upload failed."); }
      return null;
    }
    async function handleFiles(files: FileList | File[]) {
      for (const f of Array.from(files)) {
        if (!f.type.startsWith("image/")) continue;
        stateEl.textContent = "Uploading…";
        const url = await uploadImage(f);
        if (url) {
          editor.focus();
          document.execCommand("insertHTML", false, `<img src="${url}" alt="" loading="lazy" /><p></p>`);
          markDirty();
        }
      }
      stateEl.textContent = "Unsaved changes";
    }
    $("pd-img-btn").addEventListener("click", () => $<HTMLInputElement>("pd-file").click());
    $<HTMLInputElement>("pd-file").addEventListener("change", (e) => {
      const f = (e.target as HTMLInputElement).files;
      if (f?.length) handleFiles(f);
      (e.target as HTMLInputElement).value = "";
    });
    editor.addEventListener("paste", (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      const imgs = items ? Array.from(items).filter((i) => i.type.startsWith("image/")) : [];
      if (imgs.length) {
        e.preventDefault();
        handleFiles(imgs.map((i) => i.getAsFile()).filter(Boolean) as File[]);
        return;
      }
      // Strip pasted markup so Word/Docs styling never reaches the page.
      const html = e.clipboardData?.getData("text/html");
      if (html) {
        e.preventDefault();
        document.execCommand("insertHTML", false,
          html.replace(/<(script|style|meta|link)\b[^>]*>[\s\S]*?<\/\1>/gi, "")
              .replace(/\sstyle="[^"]*"/gi, "").replace(/\sclass="[^"]*"/gi, "")
              .replace(/<!--[\s\S]*?-->/g, ""));
        markDirty();
      }
    });
    editor.addEventListener("dragover", (e) => { e.preventDefault(); editor.classList.add("pd-drop"); });
    editor.addEventListener("dragleave", () => editor.classList.remove("pd-drop"));
    editor.addEventListener("drop", (e: DragEvent) => {
      editor.classList.remove("pd-drop");
      if (e.dataTransfer?.files?.length) { e.preventDefault(); handleFiles(e.dataTransfer.files); }
    });

    function firstImageInBody(): string {
      return editor.querySelector("img")?.getAttribute("src") || "";
    }
    function renderThumb() {
      const wrap = $("pd-thumb-wrap");
      const effective = heroUrl || firstImageInBody();
      wrap.innerHTML = "";
      if (effective) {
        const img = document.createElement("img");
        img.src = effective;
        img.style.cssText = "width:100%;height:100%;object-fit:cover;";
        wrap.appendChild(img);
      } else {
        wrap.innerHTML = '<span class="text-ink-4" style="font-size:11px;">No image</span>';
      }
    }
    $("pd-thumb-upload").addEventListener("click", () => $<HTMLInputElement>("pd-thumb-file").click());
    $<HTMLInputElement>("pd-thumb-file").addEventListener("change", async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      (e.target as HTMLInputElement).value = "";
      if (!f) return;
      stateEl.textContent = "Uploading…";
      const url = await uploadImage(f);
      if (url) { heroUrl = url; renderThumb(); markDirty(); }
      stateEl.textContent = "Unsaved changes";
    });
    $("pd-thumb-from-body").addEventListener("click", () => {
      const src = firstImageInBody();
      if (!src) return toast("No image in the body yet.");
      heroUrl = src; renderThumb(); markDirty();
    });
    $("pd-thumb-clear").addEventListener("click", () => { heroUrl = ""; renderThumb(); markDirty(); });

    // ── details (meta) ────────────────────────────────────────────────────
    const metaList = $("pd-meta-list");
    function addMetaRow(k = "", v = "") {
      const row = document.createElement("div");
      row.className = "pd-meta-row";
      const kEl = document.createElement("input");
      kEl.placeholder = "Label"; kEl.value = k; kEl.style.flex = "0 0 38%";
      const vEl = document.createElement("input");
      vEl.placeholder = "Value"; vEl.value = v; vEl.style.flex = "1";
      const rm = document.createElement("button");
      rm.type = "button"; rm.textContent = "×";
      rm.style.cssText = "background:none;border:0;color:var(--pd-pink);cursor:pointer;font-size:13px;padding:0 2px;";
      rm.addEventListener("click", () => { row.remove(); markDirty(); });
      [kEl, vEl].forEach((el) => el.addEventListener("input", markDirty));
      row.append(kEl, vEl, rm);
      metaList.appendChild(row);
    }
    Object.entries(data.meta || {}).forEach(([k, v]) => addMetaRow(k, String(v)));
    $("pd-meta-add").addEventListener("click", () => { addMetaRow(); markDirty(); });
    const collectMeta = () => {
      const out: Record<string, string> = {};
      metaList.querySelectorAll<HTMLDivElement>(".pd-meta-row").forEach((r) => {
        const [k, v] = [...r.querySelectorAll("input")].map((i) => (i as HTMLInputElement).value.trim());
        if (k && v) out[k] = v;
      });
      return out;
    };

    // ── scheduling ────────────────────────────────────────────────────────
    const toLocalInput = (iso: string) => {
      if (!iso) return "";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      const p = (n: number) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    };
    const fromLocalInput = (v: string) => (v ? new Date(v).toISOString() : "");
    publishedAtEl.value = toLocalInput(data.publishedAt || "");
    const scheduledFor = () => {
      const v = publishedAtEl.value;
      if (!v) return null;
      const t = new Date(v).getTime();
      return Number.isNaN(t) || t <= Date.now() ? null : new Date(v);
    };
    function renderSchedule() {
      const when = scheduledFor();
      const hint = $("pd-schedule-hint");
      if (when) {
        const mins = Math.round((when.getTime() - Date.now()) / 60000);
        hint.textContent = `Goes live in ${mins < 60 ? mins + " min" : mins < 1440 ? Math.round(mins / 60) + " h" : Math.round(mins / 1440) + " d"}`;
        hint.style.color = "var(--pd-amber)";
      } else {
        hint.textContent = publishedAtEl.value ? "In the past — live now" : "Stamped when you publish";
        hint.style.color = "";
      }
    }
    publishedAtEl.addEventListener("input", () => { markDirty(); renderSchedule(); renderStatus(); });
    $("pd-now").addEventListener("click", () => {
      publishedAtEl.value = toLocalInput(new Date().toISOString());
      markDirty(); renderSchedule(); renderStatus();
    });

    function renderStatus() {
      const pill = $("pd-status-pill");
      const pending = status === "published" && !!scheduledFor();
      pill.textContent = pending ? "scheduled" : status;
      pill.style.cssText = pill.style.cssText.replace(/color:[^;]+;|border:[^;]+;/g, "");
      pill.style.cssText += pending
        ? "color:var(--pd-amber);border:0.5px solid color-mix(in srgb,var(--pd-amber) 40%,transparent);"
        : status === "published"
          ? "color:var(--pd-mint);border:0.5px solid color-mix(in srgb,var(--pd-mint) 40%,transparent);"
          : "color:var(--pd-ink3);border:0.5px solid var(--pd-hairline2);";
      $("pd-unpublish").style.display = status === "published" ? "" : "none";
      $<HTMLButtonElement>("pd-publish").textContent = status === "published" ? "Update" : "Publish";
    }

    // ── save ──────────────────────────────────────────────────────────────
    async function save(nextStatus?: string) {
      stateEl.textContent = "Saving…";
      try {
        const res = await fetch("/api/admin/collections", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "save-item",
            id: data.id,
            collectionId: collectionEl.value,
            slug: slugEl.value,
            title: titleEl.value,
            summary: summaryEl.value,
            contentHtml: editor.innerHTML,
            heroUrl,
            heroAlt: altEl.value,
            externalUrl: externalEl.value,
            meta: collectMeta(),
            tags: tagsEl.value.split(",").map((t) => t.trim()).filter(Boolean),
            featured: featuredEl.checked,
            status: nextStatus ?? status,
            publishedAt: fromLocalInput(publishedAtEl.value),
          }),
        });
        const j = await res.json().catch(() => ({}));
        if (!j.ok) { stateEl.textContent = "Save failed"; toast(j.error || "Could not save."); return false; }
        status = j.status;
        slugEl.value = j.slug;
        if (j.publishedAt !== undefined) {
          publishedAtEl.value = toLocalInput(j.publishedAt ? String(j.publishedAt).replace(" ", "T") + "Z" : "");
        }
        $<HTMLAnchorElement>("pd-view").href = `/${data.slugs[j.collectionId]}/${j.slug}`;
        dirty = false;
        stateEl.textContent = `Saved ${new Date().toLocaleTimeString()}`;
        renderStatus(); renderSchedule();
        return true;
      } catch {
        stateEl.textContent = "Save failed";
        toast("Network error.");
        return false;
      }
    }

    $("pd-save").addEventListener("click", () => save());
    $("pd-publish").addEventListener("click", async () => {
      if (await save("published")) {
        toast(scheduledFor() ? "Scheduled — hidden until its date." : "Published — live on the site.");
      }
    });
    $("pd-unpublish").addEventListener("click", async () => {
      if (await save("draft")) toast("Reverted to draft.");
    });
    $("pd-delete").addEventListener("click", async () => {
      if (!confirm("Delete permanently? This cannot be undone.")) return;
      const res = await fetch("/api/admin/collections", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "delete-item", id: data.id }),
      });
      const j = await res.json().catch(() => ({}));
      if (j.ok) location.href = "/admin/collections";
      else toast(j.error || "Could not delete.");
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "s") { e.preventDefault(); save(); }
    });
    window.addEventListener("beforeunload", (e) => { if (dirty) { e.preventDefault(); e.returnValue = ""; } });

    renderUrl(); renderThumb(); renderSchedule(); renderStatus(); renderWordcount();
  </script>
</AdminShell>

---
export const prerender = false;
import AdminShell from "../../../layouts/AdminShell.astro";
import { isAdmin } from "../../../lib/admin";
import { adminListCategories, adminListArticles, HELP_ICONS, articleHref } from "../../../lib/help-db";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const categories = await adminListCategories(db);
const articles = await adminListArticles(db);

const byCat = new Map<string, typeof articles>();
for (const a of articles) {
  if (!byCat.has(a.category_id)) byCat.set(a.category_id, []);
  byCat.get(a.category_id)!.push(a);
}

const publishedArticles = articles.filter((a) => a.status === "published").length;
const draftArticles = articles.length - publishedArticles;
---

<AdminShell title="Help Center — PixyDust Admin" tab="help">
  <script type="application/json" id="pd-help-data" set:html={JSON.stringify({ icons: HELP_ICONS })} />

  <div class="mx-auto w-full" style="max-width:1100px;padding:28px;">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="mb-[7px] flex items-center gap-[7px]">
          <span style="width:5px;height:5px;border-radius:999px;background:var(--pd-teal);display:inline-block;"></span>
          <span class="font-mono uppercase" style="font-size:10.5px;color:var(--pd-ink3);letter-spacing:1.2px;">Help Center</span>
        </div>
        <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;">Support content</h1>
        <p class="mt-1 text-ink-3" style="font-size:13px;">
          {categories.length} categories · {publishedArticles} published
          {draftArticles > 0 && <span style="color:var(--pd-amber);"> · {draftArticles} draft</span>}
          · live at <a href="/support" style="color:var(--pd-lilac);">/support</a>
        </p>
      </div>
      <button type="button" id="pd-new-category" class="rounded-xl font-bold"
        style="padding:9px 16px;font-size:13px;background:var(--pd-ink);color:var(--pd-bg);border:0;cursor:pointer;">New category</button>
    </div>

    {categories.length === 0 && (
      <div class="rounded-2xl text-ink-3" style="padding:28px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:13px;">
        No categories yet. Create one to start building the Help Center.
      </div>
    )}

    {categories.map((c) => {
      const list = byCat.get(c.id) ?? [];
      return (
        <section class="mb-4 overflow-hidden rounded-2xl" style="background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <header class="flex flex-wrap items-center gap-3" style="padding:14px 16px;border-bottom:0.5px solid var(--pd-hairline);">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-display font-semibold text-ink" style="font-size:15px;letter-spacing:-0.3px;">{c.title}</span>
                <span class="font-mono uppercase"
                  style={`font-size:9px;letter-spacing:1px;border-radius:999px;padding:2px 7px;${
                    c.status === "published"
                      ? "color:var(--pd-mint);border:0.5px solid color-mix(in srgb,var(--pd-mint) 40%,transparent);"
                      : "color:var(--pd-amber);border:0.5px solid color-mix(in srgb,var(--pd-amber) 40%,transparent);"
                  }`}>{c.status}</span>
              </div>
              <div class="mt-0.5 font-mono text-ink-4" style="font-size:10.5px;">/support/{c.id} · {list.length} article{list.length === 1 ? "" : "s"}</div>
            </div>
            <button type="button" class="pd-edit-cat rounded-lg text-ink-2" data-id={c.id}
              data-title={c.title} data-icon={c.icon} data-blurb={c.blurb} data-status={c.status}
              style="padding:6px 11px;font-size:11.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">Edit</button>
            <button type="button" class="pd-new-article rounded-lg font-semibold text-ink" data-id={c.id}
              style="padding:6px 11px;font-size:11.5px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg);cursor:pointer;">+ Article</button>
          </header>

          {list.length === 0 ? (
            <div class="text-ink-4" style="padding:14px 16px;font-size:12px;">No articles yet.</div>
          ) : (
            <ul class="pd-sortable" data-cat={c.id} style="list-style:none;margin:0;padding:0;">
              {list.map((a) => (
                <li class="flex flex-wrap items-center gap-3" data-id={a.id}
                  style="padding:11px 16px;border-top:0.5px solid var(--pd-hairline);">
                  <span class="pd-grip" title="Drag to reorder"
                    style="cursor:grab;color:var(--pd-ink4);font-size:12px;user-select:none;">⠿</span>
                  <a href={`/admin/help/edit/${a.id}`} class="min-w-0 flex-1" style="text-decoration:none;">
                    <div class="text-ink" style="font-size:13px;line-height:1.3;">{a.title}</div>
                    <div class="mt-0.5 font-mono text-ink-4" style="font-size:10px;">/{a.slug}</div>
                  </a>
                  {a.popular === 1 && (
                    <span class="font-mono uppercase" style="font-size:9px;letter-spacing:0.8px;color:var(--pd-lilac);">popular</span>
                  )}
                  <span class="font-mono uppercase"
                    style={`font-size:9px;letter-spacing:1px;border-radius:999px;padding:2px 7px;${
                      a.status === "published"
                        ? "color:var(--pd-mint);border:0.5px solid color-mix(in srgb,var(--pd-mint) 40%,transparent);"
                        : "color:var(--pd-amber);border:0.5px solid color-mix(in srgb,var(--pd-amber) 40%,transparent);"
                    }`}>{a.status}</span>
                  <a href={articleHref(a.category_id, a.slug)} target="_blank" rel="noopener"
                    class="text-ink-3" style="font-size:11px;text-decoration:none;">View ↗</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}
  </div>

  <style is:global>
    .pd-sortable li.pd-dragging { opacity: 0.45; }
    .pd-sortable li.pd-over { border-top: 2px solid var(--pd-lilac); }
  </style>

  <script>
    const toast = (m: string) => (window as any).pdToast?.(m);
    const post = async (payload: any) => {
      const res = await fetch("/api/admin/help", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      });
      const j = await res.json().catch(() => ({}));
      if (!j.ok) toast(j.error || "Request failed.");
      return j;
    };

    const icons = JSON.parse(document.getElementById("pd-help-data")!.textContent || "{}").icons || [];

    document.getElementById("pd-new-category")?.addEventListener("click", async () => {
      const title = prompt("Category name (e.g. Getting Started)");
      if (!title) return;
      const j = await post({ action: "create-category", title, icon: "book" });
      if (j.ok) location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>(".pd-edit-cat").forEach((b) => {
      b.addEventListener("click", async () => {
        const id = b.dataset.id!;
        const title = prompt("Category name", b.dataset.title || "");
        if (title === null) return;
        const icon = prompt(`Icon — one of: ${icons.join(", ")}`, b.dataset.icon || "book");
        if (icon === null) return;
        const blurb = prompt("Short description", b.dataset.blurb || "");
        if (blurb === null) return;
        const status = confirm("OK = published, Cancel = draft") ? "published" : "draft";
        const j = await post({ action: "save-category", categoryId: id, title, icon, blurb, status });
        if (j.ok) location.reload();
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".pd-new-article").forEach((b) => {
      b.addEventListener("click", async () => {
        const title = prompt("Article title");
        if (!title) return;
        const j = await post({ action: "create-article", categoryId: b.dataset.id, title });
        if (j.ok) location.href = `/admin/help/edit/${j.id}`;
      });
    });

    // Drag to reorder within a category. Order is what readers see, so it is
    // saved immediately rather than behind a separate Save button.
    document.querySelectorAll<HTMLUListElement>(".pd-sortable").forEach((list) => {
      let dragging: HTMLLIElement | null = null;
      list.querySelectorAll<HTMLLIElement>("li").forEach((li) => {
        const grip = li.querySelector<HTMLElement>(".pd-grip");
        grip?.addEventListener("mousedown", () => (li.draggable = true));
        li.addEventListener("dragstart", () => { dragging = li; li.classList.add("pd-dragging"); });
        li.addEventListener("dragend", async () => {
          li.classList.remove("pd-dragging");
          li.draggable = false;
          list.querySelectorAll("li").forEach((x) => x.classList.remove("pd-over"));
          dragging = null;
          const order = [...list.querySelectorAll<HTMLLIElement>("li")].map((x) => Number(x.dataset.id));
          const j = await post({ action: "reorder", kind: "article", order });
          if (j.ok) toast("Order saved.");
        });
        li.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (!dragging || dragging === li) return;
          const r = li.getBoundingClientRect();
          const after = (e as DragEvent).clientY > r.top + r.height / 2;
          li.classList.add("pd-over");
          list.insertBefore(dragging, after ? li.nextSibling : li);
        });
        li.addEventListener("dragleave", () => li.classList.remove("pd-over"));
      });
    });
  </script>
</AdminShell>

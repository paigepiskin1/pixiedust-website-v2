---
// Items — every piece of content, whatever section it is filed under. Blog is
// one section among several; the section decides an item's URL root.
export const prerender = false;
import AdminShell from "../../../layouts/AdminShell.astro";
import { isAdmin } from "../../../lib/admin";
import { listAll, thumbnailFor, displayDate, isScheduled } from "../../../lib/blog";
import { adminListAll } from "../../../lib/sections";

if (!isAdmin(Astro.locals)) return Astro.redirect("/");

const db = Astro.locals.runtime.env.DB;
const [posts, all] = await Promise.all([listAll(db), adminListAll(db)]);

const sections = all.filter((s) => !s.parent_id);
const byId = new Map(all.map((s) => [s.id, s]));
const sectionFilter = Astro.url.searchParams.get("section") || "";
const statusFilter = Astro.url.searchParams.get("status") || "";

const stateOf = (p: (typeof posts)[number]) =>
  isScheduled(p) ? "scheduled" : p.status === "published" ? "published" : "draft";

const rows = posts
  .map((p) => {
    const sectionId = p.section || "blog";
    const section = byId.get(sectionId);
    const sub = p.category ? byId.get(p.category) : undefined;
    const state = stateOf(p);
    return {
      id: p.id,
      title: p.title,
      sectionId,
      sectionTitle: section?.title ?? sectionId,
      subTitle: sub && sub.parent_id === sectionId ? sub.title : null,
      path: `/${section?.slug ?? "blog"}/${p.slug}`,
      state,
      image: thumbnailFor(p),
      date:
        state === "scheduled"
          ? `Goes live ${displayDate(p.published_at)}`
          : p.published_at
            ? displayDate(p.published_at)
            : `Updated ${displayDate(p.updated_at)}`,
    };
  })
  .filter((r) => (!sectionFilter || r.sectionId === sectionFilter) && (!statusFilter || r.state === statusFilter));

// Counts for the filter chips are over all items, not the filtered view, so
// the chips keep telling you where things are while a filter is applied.
const countBySection = new Map<string, number>();
for (const p of posts) countBySection.set(p.section || "blog", (countBySection.get(p.section || "blog") ?? 0) + 1);
const states = posts.map(stateOf);
const counts = {
  published: states.filter((s) => s === "published").length,
  scheduled: states.filter((s) => s === "scheduled").length,
  draft: states.filter((s) => s === "draft").length,
};

const link = (params: Record<string, string>) => {
  const q = new URLSearchParams({ ...(sectionFilter ? { section: sectionFilter } : {}), ...(statusFilter ? { status: statusFilter } : {}), ...params });
  for (const [k, v] of [...q.entries()]) if (!v) q.delete(k);
  const qs = q.toString();
  return qs ? `/admin/items?${qs}` : "/admin/items";
};
const activeSection = sections.find((s) => s.id === sectionFilter);
const pill = (s: string) =>
  s === "published"
    ? "color:var(--pd-mint);border:0.5px solid color-mix(in srgb,var(--pd-mint) 40%,transparent);"
    : s === "scheduled"
      ? "color:var(--pd-amber);border:0.5px solid color-mix(in srgb,var(--pd-amber) 40%,transparent);"
      : "color:var(--pd-ink3);border:0.5px solid var(--pd-hairline2);";
---

<AdminShell title="Items — PixyDust Admin" tab="items">
  <script type="application/json" id="pd-items-data"
    set:html={JSON.stringify({ section: sectionFilter || "blog", sections: sections.map((s) => ({ id: s.id, title: s.title })) })} />

  <div class="mx-auto w-full" style="max-width:1180px;padding:28px;">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="font-display font-semibold text-ink" style="font-size:26px;letter-spacing:-0.6px;">Items</h1>
        <p class="mt-1 text-ink-3" style="font-size:13px;">
          {posts.length} items across {sections.length} sections · {counts.published} live
          {counts.scheduled > 0 && <span style="color:var(--pd-amber);"> · {counts.scheduled} scheduled</span>}
          {counts.draft > 0 && <span> · {counts.draft} draft</span>}
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/admin/sections" class="rounded-xl text-ink-2"
          style="padding:10px 14px;font-size:12.5px;border:0.5px solid var(--pd-hairline2);text-decoration:none;">Item Sections</a>
        <button type="button" id="pd-new-item" class="rounded-xl font-bold"
          style="padding:11px 18px;background:var(--pd-lilac);color:#0A0A0B;font-size:13px;border:none;cursor:pointer;">
          New item{activeSection ? ` in ${activeSection.title}` : ""}
        </button>
      </div>
    </div>

    <!-- Section filter -->
    <nav class="mt-5 flex flex-wrap gap-1.5" aria-label="Filter by section">
      <a href={link({ section: "" })} class={`pd-af ${sectionFilter ? "" : "is-on"}`}>All <span>{posts.length}</span></a>
      {sections.map((s) => (
        <a href={link({ section: s.id })} class={`pd-af ${sectionFilter === s.id ? "is-on" : ""}`}>
          {s.title} <span>{countBySection.get(s.id) ?? 0}</span>
        </a>
      ))}
    </nav>
    <nav class="mt-2 flex flex-wrap gap-1.5" aria-label="Filter by status">
      <a href={link({ status: "" })} class={`pd-af pd-af-sm ${statusFilter ? "" : "is-on"}`}>Any status</a>
      <a href={link({ status: "published" })} class={`pd-af pd-af-sm ${statusFilter === "published" ? "is-on" : ""}`}>Live <span>{counts.published}</span></a>
      <a href={link({ status: "scheduled" })} class={`pd-af pd-af-sm ${statusFilter === "scheduled" ? "is-on" : ""}`}>Scheduled <span>{counts.scheduled}</span></a>
      <a href={link({ status: "draft" })} class={`pd-af pd-af-sm ${statusFilter === "draft" ? "is-on" : ""}`}>Draft <span>{counts.draft}</span></a>
    </nav>

    {rows.length === 0 && (
      <div class="mt-6 rounded-2xl text-center text-ink-3"
        style="padding:56px 24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:13.5px;">
        No items here yet. Hit <strong class="text-ink">New item</strong> to add the first one.
      </div>
    )}

    <div class="mt-5 flex flex-col gap-2">
      {rows.map((r) => (
        <a href={`/admin/items/edit/${r.id}`} class="flex items-center gap-4 rounded-xl"
          style="padding:12px 14px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);text-decoration:none;">
          {r.image ? (
            <img src={r.image} alt="" width="88" height="50" loading="lazy"
              style="width:88px;height:50px;object-fit:cover;border-radius:8px;background:var(--pd-bg3);flex:none;" />
          ) : (
            <div style="width:88px;height:50px;border-radius:8px;flex:none;background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));" />
          )}
          <div style="min-width:0;flex:1;">
            <div class="font-semibold text-ink" style="font-size:14px;letter-spacing:-0.2px;">{r.title}</div>
            <div class="mt-0.5 truncate text-ink-4" style="font-size:11.5px;">{r.path} · {r.date}</div>
          </div>
          <span class="hidden shrink-0 text-ink-3 sm:inline" style="font-size:11.5px;">
            {r.sectionTitle}{r.subTitle && <span class="text-ink-4"> › {r.subTitle}</span>}
          </span>
          <span class="font-mono uppercase"
            style={`flex:none;font-size:9.5px;letter-spacing:1px;border-radius:999px;padding:3px 9px;${pill(r.state)}`}>{r.state}</span>
        </a>
      ))}
    </div>
  </div>

  <style is:global>
    .pd-af {
      display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px;
      font-size: 12px; font-weight: 600; text-decoration: none; color: var(--pd-ink2);
      background: var(--pd-bg2); border: 0.5px solid var(--pd-hairline2);
    }
    .pd-af span { font-family: var(--font-mono); font-size: 10px; font-weight: 500; color: var(--pd-ink4); }
    .pd-af:hover { color: var(--pd-ink); border-color: var(--pd-hairline3); }
    .pd-af.is-on { color: var(--pd-bg); background: var(--pd-ink); border-color: var(--pd-ink); }
    .pd-af.is-on span { color: var(--pd-bg); opacity: 0.6; }
    .pd-af-sm { padding: 4px 10px; font-size: 11px; }
  </style>

  <script>
    const data = JSON.parse(document.getElementById("pd-items-data")!.textContent || "{}");
    document.getElementById("pd-new-item")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Creating…";
      try {
        // New items start in the section being viewed (Blog by default); the
        // editor can move them to any other section.
        const res = await fetch("/api/admin/blog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "create", title: "Untitled item", section: data.section }),
        });
        const j = await res.json();
        if (j.id) window.location.href = `/admin/items/edit/${j.id}`;
        else {
          btn.disabled = false;
          btn.textContent = label;
          (window as any).pdToast?.(j.error || "Could not create item.");
        }
      } catch {
        btn.disabled = false;
        btn.textContent = label;
        (window as any).pdToast?.("Network error.");
      }
    });
  </script>
</AdminShell>

---
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import HomeHero from "../components/home/HomeHero.astro";
import RailHead from "../components/ui/RailHead.astro";
import QuickLaunch from "../components/home/QuickLaunch.astro";
import CardRail from "../components/home/CardRail.astro";
import FeatureBanner from "../components/home/FeatureBanner.astro";
import Reveal from "../components/motion/Reveal.tsx";
import { getTemplate, listTemplates, templateToRail } from "../lib/templates";
import { getToolCards } from "../lib/tool-cards";
import { getHeroPicks, resolveHeroSlides } from "../lib/hero";

const db = Astro.locals.runtime.env.DB;

// Pinned "Trending this week" order (homepage rail). Keep in sync with product.
const TRENDING_PIN = [
  "change-hair-color-grid",
  "tumblr-aesthetic",
  "subway-platform-copy-2-copy-copy",
  "old-korean-baseball-trend",
  "i2v-petals-bloom",
  "byteplus-seedance-fast-i2v",
] as const;

const [trending, presets, beauty, videoPool, toolMedia, pinnedRaw] = await Promise.all([
  listTemplates(db, { featured: true, limit: 16 }),
  listTemplates(db, { kind: "preset", limit: 8 }),
  listTemplates(db, { kind: "beauty", limit: 8 }),
  listTemplates(db, { kinds: ["i2v", "video", "motion", "cinema"], limit: 40 }),
  getToolCards(db),
  Promise.all(TRENDING_PIN.map((id) => getTemplate(db, id))),
]);

// Surface templates that actually have a generated preview video first for the
// auto hero (when no curated hero picks are set).
const videoTemplates = videoPool.filter((t) => t.previewVideo);

const pinnedTrending = pinnedRaw.filter(
  (t): t is NonNullable<typeof t> => !!t && !t.isHidden && !t.isAdminOnly
);
// Trending rail = pinned order first, then other featured fills.
const trendingMerged = [...pinnedTrending, ...trending].filter(
  (t, i, arr) => arr.findIndex((x) => x.id === t.id) === i
).slice(0, 8);
const trendingCards = trendingMerged.map(templateToRail);
const presetCards = presets.map(templateToRail);
const beautyCards = beauty.map(templateToRail);

// Hero slides: admin-curated picks (from /admin/tools) take over when present;
// otherwise auto-fill from the video-preview templates so the hero plays actual
// generated motion. Falls back to curated gradient slides inside HomeHero.
import type { HeroSlide } from "../lib/content";
const curatedHero = await resolveHeroSlides(db, await getHeroPicks(db));
const heroSlides: HeroSlide[] = curatedHero.length
  ? curatedHero
  : videoTemplates.slice(0, 5).map((t) => ({
      tone: "lilac",
      kicker: t.category || t.kind || "Featured",
      title: t.title,
      hot: "Trending",
      dur: t.eta || "video",
      cta: "Try template",
      cr: t.creditCost ?? 0,
      href: `/studio/${t.id}`,
      previewImage: t.previewImage ?? undefined,
      previewVideo: t.previewVideo ?? undefined,
    }));
---

<AppShell
  title="PixieDust — AI Image & Video Generator"
  description="Turn your ideas into stunning AI-generated images and videos in seconds. 150+ templates, no design skills needed. Try free."
  ogType="website"
  credits={Astro.locals.user?.credits ?? 47}
>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <HomeHero slides={heroSlides} />

    <section class="mb-9">
      <RailHead title="Start a project" sub="Pick a tool" accent="var(--pd-teal)" />
      <QuickLaunch media={toolMedia} />
    </section>

    <section class="mb-9">
      <RailHead title="Trending this week" sub="Most-used · mixed" accent="var(--pd-pink)" seeAllHref="/trending" />
      <CardRail items={trendingCards} />
    </section>

    <section class="mb-9">
      <RailHead title="Main character energy" sub="Cinematic · Movie Studio" accent="var(--pd-mint)" />
      <Reveal client:visible>
        <FeatureBanner
          tone="dusk"
          kicker="Featured · Movie Studio"
          title={"Put yourself in\nthe action scene."}
          sub="4 presets · 8 cr each · Kling Pro"
          ctaLabel="Open Movie Studio"
          accent="var(--pd-mint)"
          href="/video"
          height={260}
        />
      </Reveal>
    </section>

    <section class="mb-9">
      <RailHead title="Presets" sub="Film · era · creative · pro" accent="var(--pd-amber)" seeAllHref="/presets" />
      <CardRail items={presetCards} height={260} width={180} />
    </section>

    <Reveal client:visible>
      <section class="mb-9 grid grid-cols-1 gap-3.5 md:grid-cols-2">
        <FeatureBanner
          tone="pink"
          kicker="New tool"
          title={"Fashion\nTry-on"}
          sub="Upload · wear · save"
          ctaLabel="Open"
          accent="var(--pd-pink)"
          href="/fashion"
          height={220}
        />
        <FeatureBanner
          tone="teal"
          kicker="Photoshoots"
          title={"Editorial Noir\n24 frames."}
          sub="$4.99 · 30 cr"
          ctaLabel="Run pack"
          accent="var(--pd-teal)"
          href="/shoots"
          height={220}
        />
      </section>
    </Reveal>

    <section>
      <RailHead title="Beauty Studio" sub="Try a look · 1 cr each" accent="var(--pd-mint)" seeAllHref="/beauty" />
      <CardRail items={beautyCards} height={220} width={170} />
    </section>
  </div>
</AppShell>

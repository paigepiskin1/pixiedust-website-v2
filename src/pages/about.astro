---
// SSR (not prerendered) so this path routes through the worker — prerendered
// pages land in _routes.json "exclude", which bypassed the old-domain 301.
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import PageHeader from "../components/ui/PageHeader.astro";

// Save the headshot to /public at this path. Until it exists the <img> fails
// to load and hands off to the monogram beside it, so the page never shows a
// broken-image icon.
const HEADSHOT = "/paige-piskin.jpg";

// Reach figures. Four cards on one row from 640px up; 2×2 only on phones.
const stats = [
  { value: "300+", label: "Augmented-reality experiences created" },
  { value: "3M+", label: "Followers across social communities operated by PixyDust" },
  { value: "3B+", label: "Views generated by the original Pixie Dust AR experience" },
  { value: "400B+", label: "Combined views generated by PixieDust AR experiences" },
];

const brands = ["Netflix", "Warner", "Samsung", "L'Oréal", "NYX Cosmetics", "Urban Decay", "Bratz", "Coldplay", "Coachella"];

const capabilities = [
  { name: "AI Video", desc: "Generate and transform video using advanced AI models and creative workflows.", color: "var(--pd-lilac)" },
  { name: "AI Images", desc: "Create, edit, restyle, and experiment with images and visual concepts.", color: "var(--pd-teal)" },
  { name: "AI Photoshoots", desc: "Create themed shoots and visual concepts from your own images.", color: "var(--pd-pink)" },
  { name: "Creative Presets", desc: "Explore aesthetics, camera looks, film styles, color treatments, and visual transformations.", color: "var(--pd-amber)" },
  { name: "Fashion & Beauty", desc: "Experiment with clothing, hairstyles, makeup, tattoos, and other digital transformations.", color: "var(--pd-mint)" },
  { name: "AI Audio", desc: "Bring audio capabilities into the creative process.", color: "var(--pd-teal)" },
  { name: "Augmented Reality", desc: "Build on the technology and interactive experiences at the foundation of PixyDust.", color: "var(--pd-lilac)" },
  { name: "AI Agents & Emerging Tools", desc: "Explore new ways AI can assist with increasingly sophisticated creative workflows.", color: "var(--pd-pink)" },
];

const audiences: [string, string][] = [
  ["Creators", "developing social content, videos, images, characters, concepts, and new forms of entertainment."],
  ["Marketers", "exploring campaigns, advertisements, social creative, product concepts, and branded content."],
  ["Entrepreneurs", "turning ideas into visual assets without building a traditional production team for every concept."],
  ["Agencies", "experimenting with more creative directions and producing work across multiple clients and formats."],
  ["Businesses & enterprise teams", "exploring how generative AI can become part of their creative and production workflows."],
];

// Press coverage. Shown as publication + domain rather than the raw URL.
const press = [
  { name: "i-D", domain: "i-d.co", url: "https://i-d.co/article/paige-piskin-instagram-filter-interview-grimes-elon-musk-baby-lil-icey-eyes/" },
  { name: "Forbes", domain: "forbes.com", url: "https://www.forbes.com/sites/charliefink/2024/06/22/mobile-ar-mr-surge-at-awe-2024/" },
  { name: "TechCrunch", domain: "techcrunch.com", url: "https://techcrunch.com/2023/08/01/snapchat-is-launching-a-new-rewards-program-for-ar-lens-creators/" },
  { name: "Meta", domain: "ai.meta.com", url: "https://ai.meta.com/blog/movie-gen-video-sound-generation-blumhouse/" },
];

const glance: [string, string][] = [
  ["Brand", "PixyDust"],
  ["Former brand name", "PixieDust"],
  ["Common spelling variation", "Pixy Dust"],
  ["Original breakout AR experience", "Pixie Dust"],
  ["Website", "pixydust.com"],
  ["General inquiries", "hello@pixydust.com"],
];

// Handles match the sameAs set in Base.astro — keep the two in step.
const socials = [
  { name: "Instagram", handle: "@PixyDustAI", url: "https://www.instagram.com/PixyDustAI" },
  { name: "TikTok", handle: "@PixyDustAI", url: "https://www.tiktok.com/@PixyDustAI" },
  { name: "YouTube", handle: "@PixyDustAI", url: "https://www.youtube.com/@PixyDustAI" },
  { name: "X", handle: "@PixyDustAI", url: "https://x.com/PixyDustAI" },
  { name: "Facebook", handle: "PixyDustAI", url: "https://www.facebook.com/PixyDustAI" },
  { name: "LinkedIn", handle: "PixyDustAI", url: "https://www.linkedin.com/company/PixyDustAI" },
  { name: "Pinterest", handle: "PixyDustAI", url: "https://www.pinterest.com/PixyDustAI" },
];

const SITE = "https://pixydust.com";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${SITE}/about#aboutpage`,
  url: `${SITE}/about`,
  name: "About PixyDust",
  description:
    "PixyDust is an all-in-one AI creative platform. From an AR filter with 3 billion views to a unified platform for AI video, images, audio and augmented reality.",
  about: { "@id": `${SITE}/#organization` },
  mainEntity: {
    "@type": "Person",
    name: "Paige Piskin",
    jobTitle: "Co-Founder, PixyDust",
    worksFor: { "@id": `${SITE}/#organization` },
    description:
      "AI and augmented-reality creator, creative director, and digital artist whose work explores the intersection of technology, visual storytelling, beauty, fashion, and immersive media.",
  },
});

// Shared section styles, mirroring /brand.
const card = "border-radius:16px;border:0.5px solid var(--pd-hairline);background:var(--pd-bg2);";
const prose = "font-size:15px;line-height:1.65;max-width:68ch;";
const h2 = "font-size:24px;letter-spacing:-0.6px;";
const chip =
  "display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:999px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg2);color:var(--pd-ink2);font-size:12.5px;letter-spacing:-0.1px;text-decoration:none;";
const rule = "margin:52px 0;border:0;border-top:0.5px solid var(--pd-hairline);";
const ArrowIcon =
  '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6h7M6.5 3l3 3-3 3"/></svg>';
---

<AppShell
  title="About PixyDust — from AR filters to an AI creative platform"
  description="PixyDust is an all-in-one AI creative platform for video, images, audio and augmented reality. Our story: from a single AR filter with 3 billion views to 400 billion+ combined views."
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px 28px 88px;">
    <PageHeader kicker="About" title="About PixyDust" sub="Imagine. Create. Magnify." />

    <p class="text-ink-2" style={prose}>
      PixyDust is an all-in-one AI creative platform built to make powerful creative technology easier to access, explore, and use.
    </p>
    <p class="mt-4 text-ink-2" style={prose}>
      From AI video and image generation to audio, augmented reality, creative tools, and emerging AI workflows, PixyDust brings powerful
      models and technologies together in one place so creators can spend less time switching between tools and more time creating.
    </p>
    <p class="mt-5 font-display font-medium text-ink" style="font-size:19px;letter-spacing:-0.4px;line-height:1.4;max-width:60ch;">
      Our goal is simple: shorten the distance between imagination and creation.
    </p>
    <p class="mt-4 text-ink-2" style={prose}>
      Whether you're a creator developing your next video, a marketer exploring campaign concepts, an agency producing content for clients,
      or a business experimenting with new forms of digital media, PixyDust gives you more ways to turn an idea into something you can see,
      hear, share, and build upon.
    </p>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>The Evolution of PixyDust</h2>
      <p class="mt-4 text-ink-2" style={prose}>PixyDust didn't begin with generative AI. Its roots are in augmented reality.</p>
      <p class="mt-4 text-ink-2" style={prose}>
        It began in January 2019 with the Pixie Dust AR filter, an interactive augmented-reality experience that generated more than
        3 billion views across Instagram, Snapchat, and TikTok.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        What started as a single breakout AR experience grew into something much larger. Building on that success, the PixieDust brand
        expanded into a growing library of interactive AR experiences designed to transform the way people express themselves through
        digital media. That library eventually grew to more than 100 augmented-reality experiences, collectively generating more than
        400 billion views across social platforms. That evolution continued in February 2025 with the launch of PixieDust Creator Studio
        for iOS, expanding the brand from individual AR experiences into a broader creative platform that gave users new tools to create
        and interact with digital content.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        As artificial intelligence began transforming image, video, audio, and digital production, the same idea that inspired the original
        AR experience became even more powerful: give people creative technology that allows them to do things that previously required
        specialized software, technical expertise, large production teams, or significant budgets. PixieDust evolved into PixyDust — a
        broader creative platform built for the next generation of digital creation.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        The idea behind the name reaches further back. &ldquo;Pixy&rdquo; is a historical spelling of &ldquo;pixie,&rdquo; rooted in
        centuries-old folklore surrounding magical beings associated with enchantment and transformation. Over time, &ldquo;pixy dust&rdquo;
        and the more common &ldquo;pixie dust&rdquo; came to evoke a touch of magic capable of making something extraordinary possible. That
        idea remains at the heart of PixyDust today: giving people powerful creative technology that can transform an idea into something
        they can see, hear, experience, and share.
      </p>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>From Augmented Reality to Artificial Intelligence</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        AR taught us something important: people don't just want to consume digital experiences. They want to participate in them.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        They want to transform themselves, experiment with identities and aesthetics, step into new worlds, tell stories, and share those
        experiences with other people.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>Generative AI dramatically expands what's possible.</p>
      <p class="mt-4 text-ink-2" style={prose}>
        An idea can become an image. An image can become a video. A prompt can become a visual concept. A photograph can become an entirely
        new environment. Audio can add another layer to the story. AI models can make creative capabilities that once belonged primarily to
        specialized professionals accessible to almost anyone.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        PixyDust brings those possibilities together. Our evolution from AR to AI isn't a departure from where we started. It's a
        continuation of the same mission: using emerging technology to expand what people can create.
      </p>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>More Than 400 Billion Views</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        Before evolving into today's PixyDust platform, the PixieDust AR ecosystem reached audiences at enormous scale.
      </p>

      <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          stats.map((s) => (
            <div style={`${card}padding:20px 18px;`}>
              <div class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-1.2px;line-height:1;">
                {s.value}
              </div>
              <div class="mt-2.5 text-ink-3" style="font-size:12px;line-height:1.45;">
                {s.label}
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-7 text-ink-2" style={prose}>
        The creative work that helped shape PixyDust includes AR experiences developed for leading brands across entertainment, technology,
        beauty, fashion, music, and culture, including L'Oréal, Bratz, Walmart, and others, with PixyDust co-founder Paige Piskin leading
        creative development on many of those projects.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>Those experiences provided something more valuable than reach alone.</p>
      <p class="mt-4 text-ink-2" style={prose}>
        They gave us years of insight into how people interact with creative technology: what makes someone stop, experiment, create,
        personalize, share, and come back to try something new. That experience continues to influence how we build PixyDust today.
      </p>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>Selected Brand Work</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        PixyDust's creative roots include augmented-reality projects and experiences developed for leading brands across entertainment,
        technology, beauty, fashion, music, and culture.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {brands.map((b) => <span style={chip}>{b}</span>)}
      </div>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>One Creative Platform. More Ways to Create.</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        Today, PixyDust brings AI models and creative tools for video, images, audio, augmented reality, and more into a unified creative
        platform.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        Users can explore ideas, generate new content, transform existing media, experiment with different creative directions, and move
        between models and workflows without constantly switching platforms.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>PixyDust includes creative experiences and tools spanning areas such as:</p>

      <div class="mt-6 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr));">
        {
          capabilities.map((c) => (
            <div style={`${card}padding:18px;`}>
              <div class="flex items-center gap-2">
                <span style={`width:5px;height:5px;border-radius:999px;background:${c.color};flex:none;`} />
                <span class="font-display font-medium text-ink" style="font-size:14.5px;letter-spacing:-0.2px;">
                  {c.name}
                </span>
              </div>
              <p class="mt-2 text-ink-3" style="font-size:12.5px;line-height:1.5;">
                {c.desc}
              </p>
            </div>
          ))
        }
      </div>

      <p class="mt-7 text-ink-2" style={prose}>We aren't building PixyDust around a single AI model or a single type of content.</p>
      <p class="mt-3 font-display font-medium text-ink" style="font-size:19px;letter-spacing:-0.4px;">We're building it around creation.</p>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>Built for Creators — and Everyone Who Creates</h2>
      <p class="mt-4 text-ink-2" style={prose}>Creativity isn't limited to people with "creator" in their job title.</p>

      <div class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          audiences.map(([who, what]) => (
            <p class="text-ink-2" style="font-size:14px;line-height:1.55;">
              <span class="font-display font-medium text-ink">{who}</span>
              <span class="text-ink-3"> — {what}</span>
            </p>
          ))
        }
      </div>

      <p class="mt-6 text-ink-2" style={prose}>And for anyone with an idea who wants a faster way to bring it to life.</p>
      <p class="mt-3 font-display font-medium text-ink" style="font-size:19px;letter-spacing:-0.4px;line-height:1.4;max-width:58ch;">
        You shouldn't need to be an AI expert to turn an idea into something extraordinary.
      </p>
    </section>

    <hr style={rule} />

    <section class="grid gap-9 lg:grid-cols-2">
      <div>
        <h2 class="font-display font-medium text-ink" style={h2}>Our Mission</h2>
        <p class="mt-4 font-display font-medium text-ink" style="font-size:18px;letter-spacing:-0.35px;line-height:1.4;">
          Make extraordinary creative technology accessible to everyone.
        </p>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">
          Every major shift in creative technology has expanded who gets to create. Digital cameras changed photography. Social platforms
          changed distribution. Smartphones put production tools in billions of pockets. Augmented reality turned audiences into
          participants. Artificial intelligence is creating the next transformation.
        </p>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">
          We believe the next generation of creative tools should make people more creative — not less. AI should reduce technical barriers,
          accelerate experimentation, and give people more ways to express ideas that might otherwise never leave their imagination.
        </p>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">PixyDust exists to help make that possible.</p>
      </div>
      <div>
        <h2 class="font-display font-medium text-ink" style={h2}>Our Vision</h2>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">
          We envision a future where the interface between an idea and its creation becomes increasingly simple.
        </p>
        <p class="mt-4 font-display font-medium text-ink" style="font-size:18px;letter-spacing:-0.35px;line-height:1.5;">
          You imagine something.<br />PixyDust helps you create it.
        </p>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">
          That could be an image, a video, a sound, an interactive experience, a campaign, a character, a virtual world — or a form of media
          that doesn't exist yet. As AI models and creative technologies continue to evolve, PixyDust will continue bringing those
          capabilities into an environment designed around what matters most: the idea.
        </p>
      </div>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>Our Story Is a Creator Story</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        PixyDust was built from firsthand experience with the evolution of digital creativity.
      </p>

      <div class="mt-7 flex flex-col gap-6 sm:flex-row sm:items-start">
        <img
          src={HEADSHOT}
          alt="Paige Piskin, Co-Founder of PixyDust"
          width="132"
          height="132"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          style="width:132px;height:132px;flex:none;border-radius:20px;object-fit:cover;object-position:center top;border:0.5px solid var(--pd-hairline2);"
        />
        <div
          class="items-center justify-center font-display font-medium"
          style="display:none;width:132px;height:132px;flex:none;border-radius:20px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg3);color:var(--pd-ink4);font-size:34px;letter-spacing:-1px;"
          aria-hidden="true"
        >
          PP
        </div>
        <div>
          <div class="font-display font-medium text-ink" style="font-size:18px;letter-spacing:-0.4px;">Paige Piskin</div>
          <div class="mt-0.5 font-mono uppercase" style="font-size:10.5px;color:var(--pd-ink3);letter-spacing:1.2px;">
            Co-Founder, PixyDust
          </div>
          <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;max-width:62ch;">
            Paige Piskin is an AI and augmented-reality creator, creative director, and digital artist with an audience of more than
            2 million followers across social platforms. Her work explores the intersection of technology, visual storytelling, beauty,
            fashion, and immersive media.
          </p>
        </div>
      </div>

      <p class="mt-6 text-ink-2" style={prose}>
        Paige began creating augmented-reality experiences in 2019 and has since led the creation of hundreds of AR experiences reaching
        audiences around the world. Her work has generated hundreds of billions of views and has been used and shared by some of the
        world's most recognizable artists, creators, and public figures.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        Her AR work has included projects and experiences involving Netflix, Warner, Samsung, L'Oréal, NYX Cosmetics, Urban Decay, Bratz,
        Coldplay, Coachella, and others, spanning virtual beauty and fashion, interactive entertainment, music, and large-scale social AR
        experiences. Some of Paige's most widely used AR experiences have generated millions of user-created videos, giving her firsthand
        experience with how emerging creative technology can move from an idea into a tool used by audiences at global scale.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        Paige's work at the intersection of creativity and emerging technology has been featured by i-D, Forbes, TechCrunch, and Meta,
        spanning her early viral AR work through more recent developments in generative AI.
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        {
          press.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" style={chip}>
              <span class="text-ink">{p.name}</span>
              <span class="font-mono" style="font-size:10.5px;color:var(--pd-ink4);letter-spacing:0.3px;">
                {p.domain}
              </span>
            </a>
          ))
        }
      </div>

      <p class="mt-6 text-ink-2" style={prose}>
        That experience helped shape the creative philosophy behind PixyDust: powerful technology works best when it gives people more ways
        to express their own ideas.
      </p>
    </section>

    <hr style={rule} />

    <section>
      <h2 class="font-display font-medium text-ink" style={h2}>A Team Built Around Creativity and Technology</h2>
      <p class="mt-4 text-ink-2" style={prose}>
        Behind PixyDust is a team working across creative technology, artificial intelligence, augmented reality, product development,
        software, digital media, and creator-focused experiences.
      </p>
      <p class="mt-4 text-ink-2" style={prose}>
        Together, we're building tools designed to make emerging creative technologies easier to use, explore, and turn into something
        meaningful.
      </p>
    </section>

    <hr style={rule} />

    <section class="grid gap-9 lg:grid-cols-2">
      <div>
        <h2 class="font-display font-medium text-ink" style={h2}>PixyDust at a Glance</h2>
        <dl class="mt-5" style={`${card}padding:4px 18px;`}>
          {
            glance.map(([k, v], i) => (
              <div
                class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5"
                style={`padding:12px 0;${i ? "border-top:0.5px solid var(--pd-hairline);" : ""}`}
              >
                <dt class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink4);letter-spacing:0.7px;">
                  {k}
                </dt>
                <dd class="text-ink-2" style="font-size:13px;">
                  {v}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div>
        <h2 class="font-display font-medium text-ink" style={h2}>Connect With PixyDust</h2>
        <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;">
          Follow PixyDust for new creative tools, AI models, tutorials, product updates, and more.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" style={chip}>
                <span class="text-ink">{s.name}</span>
                <span class="font-mono" style="font-size:10.5px;color:var(--pd-ink4);letter-spacing:0.3px;">
                  {s.handle}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <hr style={rule} />

    <section style={`${card}padding:36px 32px;`}>
      <div class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.9px;">Imagine. Create. Magnify.</div>
      <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;max-width:64ch;">
        PixyDust began by helping people transform the world around them through augmented reality. Today, we're building toward something
        much bigger: a creative platform where the world's most powerful emerging technologies become tools for human imagination.
      </p>
      <p class="mt-4 text-ink-2" style="font-size:14.5px;line-height:1.6;max-width:64ch;">
        Whatever you imagine next, we want to make it easier to create.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center gap-1.5 rounded-full font-semibold"
        style="padding:10px 18px;background:var(--pd-ink);color:var(--pd-bg);font-size:13px;letter-spacing:-0.1px;text-decoration:none;"
      >
        Start creating
        <Fragment set:html={ArrowIcon} />
      </a>
    </section>
  </div>
</AppShell>

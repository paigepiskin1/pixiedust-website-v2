<style>
  /* Monochrome wall: strip each mark's own colour so nine logos from nine
     different palettes read as one set, then lift to full strength on hover. */
  .pd-brand img {
    filter: grayscale(1) brightness(1.9) contrast(0.85);
    opacity: 0.62;
    transition:
      opacity 0.18s ease,
      filter 0.18s ease;
  }
  .pd-brand:hover img {
    filter: grayscale(1) brightness(2.2) contrast(0.9);
    opacity: 1;
  }
  /* Light theme: the same marks need darkening, not brightening. Dark is the
     default and sets no attribute, so this must key off [data-theme="light"]
     only — a :not([data-theme="dark"]) form would also match in dark mode and
     render every logo near-invisible against the dark card. */
  :root[data-theme="light"] .pd-brand img {
    filter: grayscale(1) brightness(0.35) contrast(1.1);
    opacity: 0.7;
  }
  :root[data-theme="light"] .pd-brand:hover img {
    filter: grayscale(1) brightness(0.15) contrast(1.2);
    opacity: 1;
  }

  .pd-toc.is-active {
    color: var(--pd-ink) !important;
    font-weight: 600;
  }
  .pd-toc.is-active .pd-toc-bar {
    opacity: 1;
  }
  .pd-toc.is-active .font-mono {
    color: var(--pd-lilac) !important;
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".pd-toc"));
  if (links.length) {
    const ids = links.map((l) => l.dataset.id!);
    const setActive = () => {
      const y = window.scrollY + 140;
      let cur = ids[0];
      for (const id of ids) {
        const el = document.getElementById("about-" + id);
        if (el && el.offsetTop <= y) cur = id;
      }
      links.forEach((l) => l.classList.toggle("is-active", l.dataset.id === cur));
    };
    window.addEventListener("scroll", setActive, { passive: true });
    links.forEach((l) =>
      l.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById("about-" + l.dataset.id)?.scrollIntoView({ block: "start", behavior: "smooth" });
      })
    );
    setActive();
  }
</script>

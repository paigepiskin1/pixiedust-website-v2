---
// SSR (not prerendered) so this path routes through the worker — prerendered
// pages land in _routes.json "exclude", which bypassed the old-domain 301.
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import PageHeader from "../components/ui/PageHeader.astro";

// Save the headshot to /public at this path. Until it exists the <img> fails
// to load and hands off to the monogram beside it, so the page never shows a
// broken-image icon. Not lazy-loaded: at this size, above the fold, lazy
// loading saves nothing and stops the onerror fallback from firing.
const HEADSHOT = "/paige-piskin.jpg";

// Drives both the sticky table of contents and the section headers, so the two
// can never drift apart.
const toc = [
  { id: "evolution", label: "Evolution" },
  { id: "ar-to-ai", label: "AR to AI" },
  { id: "reach", label: "Reach" },
  { id: "brand-work", label: "Brand work" },
  { id: "platform", label: "The platform" },
  { id: "who", label: "Who it's for" },
  { id: "mission", label: "Mission & vision" },
  { id: "founder", label: "Founder" },
  { id: "team", label: "Team" },
  { id: "glance", label: "At a glance" },
  { id: "connect", label: "Connect" },
];

// Reach figures. Four cards on one row from 640px up; 2×2 only on phones.
const stats = [
  { value: "300+", label: "Augmented-reality experiences created" },
  { value: "3M+", label: "Followers across social communities operated by PixyDust" },
  { value: "3B+", label: "Views generated by the original Pixie Dust AR experience" },
  { value: "400B+", label: "Combined views generated by PixieDust AR experiences" },
];

// Brand work. Drop an SVG (or PNG) at the `logo` path and that tile renders the
// mark instead of the name — no code change needed, and a brand with no asset
// yet still shows as a wordmark tile rather than a gap. `w` is an optical width
// in px: a Netflix wordmark and the Bratz mark need different sizes to read as
// evenly weighted, so it is tuned per logo rather than set globally.
const brands: { name: string; logo?: string; w?: number }[] = [
  { name: "Netflix", logo: "/brands/netflix.svg", w: 84 },
  { name: "Warner", logo: "/brands/warner.svg", w: 74 },
  { name: "Samsung", logo: "/brands/samsung.svg", w: 92 },
  { name: "L'Oréal", logo: "/brands/loreal.svg", w: 86 },
  { name: "NYX Cosmetics", logo: "/brands/nyx.svg", w: 70 },
  { name: "Urban Decay", logo: "/brands/urban-decay.svg", w: 90 },
  { name: "Bratz", logo: "/brands/bratz.svg", w: 64 },
  { name: "Coldplay", logo: "/brands/coldplay.svg", w: 80 },
  { name: "Coachella", logo: "/brands/coachella.svg", w: 88 },
];

const capabilities = [
  { name: "AI Video", desc: "Generate and transform video using advanced AI models and creative workflows.", color: "var(--pd-lilac)" },
  { name: "AI Images", desc: "Create, edit, restyle, and experiment with images and visual concepts.", color: "var(--pd-teal)" },
  { name: "AI Photoshoots", desc: "Create themed shoots and visual concepts from your own images.", color: "var(--pd-pink)" },
  { name: "Creative Presets", desc: "Explore aesthetics, camera looks, film styles, color treatments, and visual transformations.", color: "var(--pd-amber)" },
  { name: "Fashion & Beauty", desc: "Experiment with clothing, hairstyles, makeup, tattoos, and other digital transformations.", color: "var(--pd-mint)" },
  { name: "AI Audio", desc: "Bring audio capabilities into the creative process.", color: "var(--pd-teal)" },
  { name: "Augmented Reality", desc: "Build on the technology and interactive experiences at the foundation of PixyDust.", color: "var(--pd-lilac)" },
  { name: "AI Agents & Emerging Tools", desc: "Explore new ways AI can assist with increasingly sophisticated creative workflows.", color: "var(--pd-pink)" },
];

const audiences: [string, string][] = [
  ["Creators", "developing social content, videos, images, characters, concepts, and new forms of entertainment."],
  ["Marketers", "exploring campaigns, advertisements, social creative, product concepts, and branded content."],
  ["Entrepreneurs", "turning ideas into visual assets without building a traditional production team for every concept."],
  ["Agencies", "experimenting with more creative directions and producing work across multiple clients and formats."],
  ["Businesses & enterprise teams", "exploring how generative AI can become part of their creative and production workflows."],
];

// Press coverage. Shown as publication + domain rather than the raw URL.
const press = [
  { name: "i-D", domain: "i-d.co", url: "https://i-d.co/article/paige-piskin-instagram-filter-interview-grimes-elon-musk-baby-lil-icey-eyes/" },
  { name: "Forbes", domain: "forbes.com", url: "https://www.forbes.com/sites/charliefink/2024/06/22/mobile-ar-mr-surge-at-awe-2024/" },
  { name: "TechCrunch", domain: "techcrunch.com", url: "https://techcrunch.com/2023/08/01/snapchat-is-launching-a-new-rewards-program-for-ar-lens-creators/" },
  { name: "Meta", domain: "ai.meta.com", url: "https://ai.meta.com/blog/movie-gen-video-sound-generation-blumhouse/" },
];

const glance: [string, string][] = [
  ["Brand", "PixyDust"],
  ["Former brand name", "PixieDust"],
  ["Common spelling variation", "Pixy Dust"],
  ["Original breakout AR experience", "Pixie Dust"],
  ["Website", "pixydust.com"],
  ["General inquiries", "hello@pixydust.com"],
];

// Handles match the sameAs set in Base.astro — keep the two in step.
const socials = [
  { name: "Instagram", handle: "@PixyDustAI", url: "https://www.instagram.com/PixyDustAI" },
  { name: "TikTok", handle: "@PixyDustAI", url: "https://www.tiktok.com/@PixyDustAI" },
  { name: "YouTube", handle: "@PixyDustAI", url: "https://www.youtube.com/@PixyDustAI" },
  { name: "X", handle: "@PixyDustAI", url: "https://x.com/PixyDustAI" },
  { name: "Facebook", handle: "PixyDustAI", url: "https://www.facebook.com/PixyDustAI" },
  { name: "LinkedIn", handle: "PixyDustAI", url: "https://www.linkedin.com/company/PixyDustAI" },
  { name: "Pinterest", handle: "PixyDustAI", url: "https://www.pinterest.com/PixyDustAI" },
];

const SITE = "https://pixydust.com";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${SITE}/about#aboutpage`,
  url: `${SITE}/about`,
  name: "About PixyDust",
  description:
    "PixyDust is an all-in-one AI creative platform. From an AR filter with 3 billion views to a unified platform for AI video, images, audio and augmented reality.",
  about: { "@id": `${SITE}/#organization` },
  mainEntity: {
    "@type": "Person",
    name: "Paige Piskin",
    jobTitle: "Co-Founder, PixyDust",
    worksFor: { "@id": `${SITE}/#organization` },
    description:
      "AI and augmented-reality creator, creative director, and digital artist whose work explores the intersection of technology, visual storytelling, beauty, fashion, and immersive media.",
  },
});

const pad2 = (n: number) => String(n + 1).padStart(2, "0");

// Shared styles, mirroring /brand and the legal pages.
const card = "border-radius:16px;border:0.5px solid var(--pd-hairline);background:var(--pd-bg2);";
const body = "font-size:14.5px;line-height:1.7;letter-spacing:-0.05px;max-width:72ch;";
const chip =
  "display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:999px;border:0.5px solid var(--pd-hairline2);background:var(--pd-bg2);color:var(--pd-ink2);font-size:12.5px;letter-spacing:-0.1px;text-decoration:none;";
const GRADIENT = "linear-gradient(115deg,#7C3AED,#EC4899)";
const ArrowIcon =
  '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6h7M6.5 3l3 3-3 3"/></svg>';
---

<AppShell
  title="About PixyDust — from AR filters to an AI creative platform"
  description="PixyDust is an all-in-one AI creative platform for video, images, audio and augmented reality. Our story: from a single AR filter with 3 billion views to 400 billion+ combined views."
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px 28px 80px;">
    <PageHeader kicker="About" title="About PixyDust" sub="Imagine. Create. Magnify." />

    <!-- Lead: intro prose alongside the mission line, so the top of the page
         carries weight instead of one narrow column against empty space. -->
    <div class="mb-9 grid items-stretch gap-5 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div style={`${card}padding:26px 28px;`}>
        <p class="text-ink-2" style="font-size:15.5px;line-height:1.65;letter-spacing:-0.1px;">
          PixyDust is an all-in-one AI creative platform built to make powerful creative technology easier to access, explore, and use.
        </p>
        <p class="mt-4 text-ink-3" style="font-size:14.5px;line-height:1.65;">
          From AI video and image generation to audio, augmented reality, creative tools, and emerging AI workflows, PixyDust brings
          powerful models and technologies together in one place so creators can spend less time switching between tools and more time
          creating.
        </p>
        <p class="mt-4 text-ink-3" style="font-size:14.5px;line-height:1.65;">
          Whether you're a creator developing your next video, a marketer exploring campaign concepts, an agency producing content for
          clients, or a business experimenting with new forms of digital media, PixyDust gives you more ways to turn an idea into something
          you can see, hear, share, and build upon.
        </p>
      </div>

      <aside
        class="flex flex-col justify-between overflow-hidden"
        style={`border-radius:16px;padding:26px 28px;background:${GRADIENT};`}
      >
        <div class="font-mono uppercase" style="font-size:10px;color:rgba(255,255,255,0.72);letter-spacing:1.2px;">Our goal</div>
        <div class="font-display font-medium" style="font-size:25px;letter-spacing:-0.8px;line-height:1.25;color:#fff;margin-top:14px;">
          Shorten the distance between imagination and creation.
        </div>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5">
          {
            ["Video", "Images", "Audio", "AR"].map((t) => (
              <span class="font-mono uppercase" style="font-size:10px;color:rgba(255,255,255,0.8);letter-spacing:1px;">
                {t}
              </span>
            ))
          }
        </div>
      </aside>
    </div>

    <div class="grid items-start gap-9 lg:grid-cols-[220px_minmax(0,1fr)]">
      <!-- TOC -->
      <aside class="sticky hidden lg:block" style="top:88px;">
        <div class="mb-0.5 font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.7px;padding:8px 12px;">
          Contents
        </div>
        {
          toc.map((s, i) => (
            <a
              href={`#about-${s.id}`}
              class="pd-toc relative mb-px flex w-full items-center gap-2.5 rounded-lg text-left font-medium"
              data-id={s.id}
              style="padding:8px 12px;font-size:12.5px;letter-spacing:-0.05px;color:var(--pd-ink3);text-decoration:none;"
            >
              <span class="pd-toc-bar absolute left-0 top-2 bottom-2 w-[2.5px] rounded-[2px] opacity-0" style="background:var(--pd-lilac);" />
              <span class="font-mono" style="font-size:10px;letter-spacing:0.4px;min-width:18px;color:var(--pd-ink4);">{pad2(i)}</span>
              <span>{s.label}</span>
            </a>
          ))
        }
      </aside>

      <article style="padding-bottom:24px;">
        <!-- 01 Evolution -->
        <section id="about-evolution" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 01</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              The Evolution of PixyDust
            </h2>
          </div>
          <div class="flex flex-col gap-3.5">
            <p class="text-ink-2" style={body}>PixyDust didn't begin with generative AI. Its roots are in augmented reality.</p>
            <p class="text-ink-2" style={body}>
              It began in January 2019 with the Pixie Dust AR filter, an interactive augmented-reality experience that generated more than
              3 billion views across Instagram, Snapchat, and TikTok.
            </p>
            <p class="text-ink-2" style={body}>
              What started as a single breakout AR experience grew into something much larger. Building on that success, the PixieDust brand
              expanded into a growing library of interactive AR experiences designed to transform the way people express themselves through
              digital media. That library eventually grew to more than 100 augmented-reality experiences, collectively generating more than
              400 billion views across social platforms. That evolution continued in February 2025 with the launch of PixieDust Creator
              Studio for iOS, expanding the brand from individual AR experiences into a broader creative platform that gave users new tools
              to create and interact with digital content.
            </p>
            <p class="text-ink-2" style={body}>
              As artificial intelligence began transforming image, video, audio, and digital production, the same idea that inspired the
              original AR experience became even more powerful: give people creative technology that allows them to do things that
              previously required specialized software, technical expertise, large production teams, or significant budgets. PixieDust
              evolved into PixyDust — a broader creative platform built for the next generation of digital creation.
            </p>
            <div
              class="mt-1 rounded-xl"
              style="padding:16px 18px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-left:2px solid var(--pd-lilac);max-width:72ch;"
            >
              <div class="mb-1.5 font-mono font-semibold uppercase" style="font-size:9.5px;color:var(--pd-lilac);letter-spacing:0.8px;">
                Where the name comes from
              </div>
              <div class="text-ink-2" style="font-size:13.5px;line-height:1.65;letter-spacing:-0.05px;">
                &ldquo;Pixy&rdquo; is a historical spelling of &ldquo;pixie,&rdquo; rooted in centuries-old folklore surrounding magical
                beings associated with enchantment and transformation. Over time, &ldquo;pixy dust&rdquo; and the more common &ldquo;pixie
                dust&rdquo; came to evoke a touch of magic capable of making something extraordinary possible. That idea remains at the heart
                of PixyDust today: giving people powerful creative technology that can transform an idea into something they can see, hear,
                experience, and share.
              </div>
            </div>
          </div>
        </section>

        <!-- 02 AR to AI -->
        <section id="about-ar-to-ai" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 02</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              From Augmented Reality to Artificial Intelligence
            </h2>
          </div>
          <div class="flex flex-col gap-3.5">
            <p class="text-ink-2" style={body}>
              AR taught us something important: people don't just want to consume digital experiences. They want to participate in them.
            </p>
            <p class="text-ink-2" style={body}>
              They want to transform themselves, experiment with identities and aesthetics, step into new worlds, tell stories, and share
              those experiences with other people.
            </p>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              [
                ["An idea", "becomes an image"],
                ["An image", "becomes a video"],
                ["A photograph", "becomes a new environment"],
                ["Audio", "adds another layer"],
              ].map(([from, to]) => (
                <div style={`${card}padding:18px 20px;position:relative;overflow:hidden;`}>
                  <div style={`position:absolute;top:0;bottom:0;left:0;width:2px;background:${GRADIENT};`} />
                  <div class="font-display font-medium text-ink" style="font-size:14.5px;letter-spacing:-0.2px;">
                    {from}
                  </div>
                  <div class="mt-1 text-ink-3" style="font-size:12.5px;line-height:1.45;">
                    {to}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="mt-5 flex flex-col gap-3.5">
            <p class="text-ink-2" style={body}>
              AI models can make creative capabilities that once belonged primarily to specialized professionals accessible to almost anyone.
            </p>
            <p class="text-ink-2" style={body}>
              PixyDust brings those possibilities together. Our evolution from AR to AI isn't a departure from where we started. It's a
              continuation of the same mission: using emerging technology to expand what people can create.
            </p>
          </div>
        </section>

        <!-- 03 Reach -->
        <section id="about-reach" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 03</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              More Than 400 Billion Views
            </h2>
          </div>
          <p class="text-ink-2" style={body}>
            Before evolving into today's PixyDust platform, the PixieDust AR ecosystem reached audiences at enormous scale.
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              stats.map((s) => (
                <div style={`${card}padding:22px 20px;position:relative;overflow:hidden;`}>
                  <div style={`position:absolute;top:0;bottom:0;left:0;width:2px;background:${GRADIENT};`} />
                  <div class="font-display font-medium text-ink" style="font-size:32px;letter-spacing:-1.4px;line-height:1;">
                    {s.value}
                  </div>
                  <div class="mt-2.5 text-ink-3" style="font-size:12px;line-height:1.45;">
                    {s.label}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="mt-6 flex flex-col gap-3.5">
            <p class="text-ink-2" style={body}>
              The creative work that helped shape PixyDust includes AR experiences developed for leading brands across entertainment,
              technology, beauty, fashion, music, and culture, including L'Oréal, Bratz, Walmart, and others, with PixyDust co-founder Paige
              Piskin leading creative development on many of those projects.
            </p>
            <p class="text-ink-2" style={body}>
              Those experiences provided something more valuable than reach alone. They gave us years of insight into how people interact
              with creative technology: what makes someone stop, experiment, create, personalize, share, and come back to try something new.
              That experience continues to influence how we build PixyDust today.
            </p>
          </div>
        </section>

        <!-- 04 Brand work -->
        <section id="about-brand-work" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 04</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              Selected Brand Work
            </h2>
          </div>
          <p class="text-ink-2" style={body}>
            PixyDust's creative roots include augmented-reality projects and experiences developed for leading brands across entertainment,
            technology, beauty, fashion, music, and culture.
          </p>
          <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {
              brands.map((b) => (
                <div
                  class="pd-brand flex items-center justify-center"
                  style={`${card}height:76px;padding:14px;position:relative;overflow:hidden;`}
                >
                  <div style={`position:absolute;top:0;bottom:0;left:0;width:2px;background:${GRADIENT};`} />
                  {b.logo && (
                    <img
                      src={b.logo}
                      alt={b.name}
                      onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
                      style={`display:block;width:${b.w ?? 80}px;max-width:100%;height:auto;max-height:34px;object-fit:contain;`}
                    />
                  )}
                  {/* Shown until the asset exists — a named tile, never a gap. */}
                  <span
                    class="font-display font-medium text-ink-2"
                    style={`display:${b.logo ? "none" : "block"};font-size:13px;letter-spacing:-0.2px;text-align:center;`}
                  >
                    {b.name}
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <!-- 05 Platform -->
        <section id="about-platform" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 05</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              One Creative Platform. More Ways to Create.
            </h2>
          </div>
          <div class="flex flex-col gap-3.5">
            <p class="text-ink-2" style={body}>
              Today, PixyDust brings AI models and creative tools for video, images, audio, augmented reality, and more into a unified
              creative platform.
            </p>
            <p class="text-ink-2" style={body}>
              Users can explore ideas, generate new content, transform existing media, experiment with different creative directions, and
              move between models and workflows without constantly switching platforms.
            </p>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
            {
              capabilities.map((c) => (
                <div style={`${card}padding:18px 20px;position:relative;overflow:hidden;`}>
                  <div style={`position:absolute;top:0;bottom:0;left:0;width:2px;background:${GRADIENT};`} />
                  <div class="flex items-center gap-2">
                    <span style={`width:5px;height:5px;border-radius:999px;background:${c.color};flex:none;`} />
                    <span class="font-display font-medium text-ink" style="font-size:14.5px;letter-spacing:-0.2px;">
                      {c.name}
                    </span>
                  </div>
                  <p class="mt-2 text-ink-3" style="font-size:12.5px;line-height:1.5;">
                    {c.desc}
                  </p>
                </div>
              ))
            }
          </div>

          <p class="mt-6 text-ink-2" style={body}>
            We aren't building PixyDust around a single AI model or a single type of content.
            <span class="font-display font-medium text-ink"> We're building it around creation.</span>
          </p>
        </section>

        <!-- 06 Who it's for -->
        <section id="about-who" style="margin-bottom:56px;scroll-margin-top:100px;">
          <div class="mb-3.5 flex items-baseline gap-3.5">
            <span class="font-mono font-semibold" style="font-size:11px;color:var(--pd-lilac);letter-spacing:0.7px;">§ 06</span>
            <h2 class="font-display font-medium text-ink" style="font-size:26px;letter-spacing:-0.6px;line-height:1.15;">
              Built for Creators — and Everyone Who Creates
            </h2>
          </div>
          <p class="text-ink-2" style={body}>Creativity isn't limited to people with "creator" in their job title.</p>

          <div class="mt-5 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(290px,1fr));">
            {
              audiences.map(([who, what]) => (
                <div style={`${card}padding:16px 18px;`}>
                  <div class="font-display font-medium text-ink" style="font-size:14px;letter-spacing:-0.2px;">
                    {who}
                  </div>
                  <div class="mt-1 text-ink-3" style="font-size:12.5px;line-height:1.5;">
                    {what}
                  </div>
                </div>
              ))
            }
          </div>

          <p class="mt-6 text-ink-2" style={body}>And for anyone with an idea who wants a faster way to bring it to life.</p>
          <p class="mt-2 font-display font-medium text-ink" style="font-size:19px;letter-spacing:-0.4px;line-height:1.4;max-width:58ch;">
            You shouldn't need to be an AI expert to turn an idea into something extraordinary.
          </p>
        </section>

        <!-- 07 Mission & vision -->
        <section id="about-mission" style="margin-bottom:56px;scroll-margin-top:100px;">

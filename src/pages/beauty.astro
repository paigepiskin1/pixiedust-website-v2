---
// Beauty Studio — makeup try-on. Pick a preset look or upload a reference to
// copy its makeup; choose who to edit in multi-person photos. Same tiered model
// approach as the Tattoo/Hair studios (Fast=nano-banana-pro, High=gpt-image-2).
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import FieldPanel from "../components/FieldPanel.astro";
import type { TemplateField } from "../lib/templates";
import { getTemplate } from "../lib/templates";
import { MAKEUP_LOOKS, MAKEUP_TARGETS, BEAUTY_BASE_RULE, BEAUTY_RETOUCH_RULE } from "../lib/beauty-packs";

const db = Astro.locals.runtime.env.DB;

const TIER_DEFS = [
  { id: "fast", templateId: "beauty-studio-fast", label: "Fast", sub: "Lower res · ~30s", defCost: 3 },
  { id: "hi", templateId: "beauty-studio-hi", label: "High res", sub: "Best detail · ~2 min", defCost: 5 },
];
const tierTemplates = await Promise.all(TIER_DEFS.map((t) => getTemplate(db, t.templateId).catch(() => null)));
const tiers = TIER_DEFS.map((t, i) => ({ id: t.id, templateId: t.templateId, label: t.label, sub: t.sub, creditCost: tierTemplates[i]?.creditCost ?? t.defCost }));
const defaultTierIdx = 0;
const template = tierTemplates[defaultTierIdx];
const defaultCost = tiers[defaultTierIdx].creditCost;
const credits = Astro.locals.user?.credits ?? 0;
const signedIn = !!Astro.locals.user;

const personField: TemplateField[] = [
  { key: "person", type: "file", label: "Your photo", required: true, accept: "image/*", help: "Upload a clear, front-facing photo of the face" },
];
const refField: TemplateField[] = [
  { key: "reference", type: "file", label: "Makeup reference", accept: "image/*", help: "Upload a photo of the makeup look you want to copy" },
];

const config = {
  tiers,
  defaultTier: tiers[defaultTierIdx].id,
  credits,
  signedIn,
  baseRule: BEAUTY_BASE_RULE,
  retouchRule: BEAUTY_RETOUCH_RULE,
  looks: Object.fromEntries(MAKEUP_LOOKS.map((l) => [l.id, { prompt: l.prompt, label: l.label }])),
  targets: MAKEUP_TARGETS,
};
---

<AppShell title="Beauty Studio — PixieDust" description="Try on makeup looks with AI. Upload a photo, pick a look or copy makeup from a reference photo — our AI applies it to just the face." credits={credits}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <div class="grid gap-6 lg:grid-cols-[300px_minmax(0,1.15fr)_minmax(0,1fr)] lg:[grid-auto-rows:1fr] lg:min-h-[calc(100vh-128px)]">

      <!-- LEFT -->
      <aside class="lg:sticky lg:top-[88px] lg:self-start">
        <div class="mb-[7px] flex items-center gap-[7px]">
          <span class="inline-block shrink-0 rounded-full" style="width:5px;height:5px;background:var(--pd-mint);box-shadow:0 0 10px color-mix(in srgb,var(--pd-mint) 50%,transparent);"></span>
          <span class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:1.1px;">Makeup try-on · face only</span>
        </div>
        <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;line-height:1.05;">Beauty Studio</h1>
        <p class="mt-2 text-ink-3" style="font-size:13px;line-height:1.5;">
          Try on any makeup look. Pick a preset, or upload a look and we isolate just the makeup and apply it to you.
        </p>
        <div class="mt-3 overflow-hidden rounded-[18px]" style="border:0.5px solid var(--pd-hairline);aspect-ratio:3/4;background:var(--pd-bg2);">
          {template?.previewImage && <img src={template.previewImage} alt="Beauty Studio example" class="h-full w-full object-cover" />}
        </div>
        <div class="mt-3.5 rounded-2xl" style="padding:15px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div class="mb-2.5 font-mono uppercase" style="font-size:9px;color:var(--pd-ink3);letter-spacing:0.7px;">How it works</div>
          <ol class="flex flex-col gap-2.5" style="list-style:none;padding:0;margin:0;">
            {["Upload a clear, front-facing photo", "Pick a look — or upload makeup to copy", "Choose who to glam if there's more than one person", "Generate — makeup applied, your face unchanged"].map((step, i) => (
              <li class="flex items-start gap-2.5">
                <span class="flex shrink-0 items-center justify-center rounded-full font-mono font-semibold" style="width:18px;height:18px;font-size:10px;background:color-mix(in srgb,var(--pd-mint) 18%,transparent);color:var(--pd-mint);margin-top:1px;">{i + 1}</span>
                <span class="text-ink-2" style="font-size:12px;line-height:1.4;">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- CENTER -->
      <section class="lg:sticky lg:top-[88px] lg:self-start">
        <div class="rounded-2xl" style="padding:20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div class="mb-3 font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.7px;">Your photo</div>
          <FieldPanel fields={personField} id="pd-beauty-person" />

          <!-- Who to edit -->
          <div class="mt-4">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Who to glam <span class="text-ink-3" style="font-weight:400;">· for photos with more than one person</span></span>
            <div id="pd-target" class="flex flex-wrap gap-1.5">
              {MAKEUP_TARGETS.map((t, i) => (
                <button type="button" class="pd-seg rounded-lg font-semibold" data-target={t.id} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{t.label}</button>
              ))}
            </div>
            <input id="pd-target-text" type="text" placeholder="e.g. the woman on the right in the red top" class="mt-1.5 w-full rounded-xl text-ink outline-none" style="display:none;padding:10px 12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:12.5px;" />
          </div>

          <!-- Mode -->
          <div class="mt-4">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Makeup source</span>
            <div id="pd-mode-tabs" class="flex flex-wrap gap-1.5">
              <button type="button" class="pd-seg rounded-lg font-semibold" data-mode="looks" data-active="true" style="padding:7px 14px;font-size:12px;cursor:pointer;">Makeup looks</button>
              <button type="button" class="pd-seg rounded-lg font-semibold" data-mode="reference" data-active="false" style="padding:7px 14px;font-size:12px;cursor:pointer;">Reference photo</button>
            </div>
          </div>

          <!-- Looks gallery -->
          <div id="pd-look-wrap" class="mt-4">
            <div class="mb-1.5 flex items-center justify-between">
              <span class="font-medium text-ink" style="font-size:12.5px;">Choose a look</span>
              <button type="button" id="pd-clear-look" class="font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.5px;background:none;border:none;cursor:pointer;">Clear</button>
            </div>
            <div id="pd-look-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;">
              {MAKEUP_LOOKS.map((l) => (
                <button type="button" class="pd-look-card" data-look-id={l.id} data-active="false" style="display:flex;flex-direction:column;gap:0;padding:0;border-radius:12px;cursor:pointer;text-align:left;overflow:hidden;background:var(--pd-bg);border:1px solid var(--pd-hairline2);transition:border-color 120ms,transform 120ms;">
                  <div style="position:relative;width:100%;aspect-ratio:3/4;background:var(--pd-bg3);">
                    <img src={l.preview} alt={l.label} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
                    <span class="pd-look-check" style="display:none;position:absolute;top:6px;right:6px;width:20px;height:20px;border-radius:50%;background:var(--pd-mint);color:#0A0A0B;font-size:11px;font-weight:700;align-items:center;justify-content:center;">✓</span>
                  </div>
                  <div style="padding:7px 9px 9px;">
                    <div class="text-ink" style="font-size:12px;font-weight:600;line-height:1.2;">{l.label}</div>
                    <div class="text-ink-3" style="font-size:10.5px;line-height:1.3;margin-top:2px;">{l.blurb}</div>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <!-- Reference upload -->
          <div id="pd-ref-wrap" class="mt-4" style="display:none;">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Makeup reference</span>
            <FieldPanel fields={refField} id="pd-beauty-ref" />
            <span class="mt-1 block text-ink-4" style="font-size:11px;">We analyze the photo, isolate just the makeup, and apply it to you — not the other person's face.</span>
          </div>

          <!-- Quality tier -->
          <div class="mt-4">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Quality</span>
            <div id="pd-tier" class="grid gap-1.5" style="grid-template-columns:repeat(2,1fr);">
              {tiers.map((tr) => (
                <button type="button" class="pd-tier-btn rounded-xl text-left" data-tier={tr.id} data-cost={tr.creditCost} data-template={tr.templateId} data-active={tr.id === config.defaultTier ? "true" : "false"} style="padding:9px 10px;cursor:pointer;">
                  <span class="block font-semibold text-ink" style="font-size:12px;">{tr.label}</span>
                  <span class="block text-ink-3" style="font-size:10px;line-height:1.3;margin-top:2px;">{tr.sub}</span>
                  <span class="block font-mono" style="font-size:10px;margin-top:3px;color:var(--pd-mint);">{tr.creditCost} cr</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Outputs -->
          <div class="mt-4">
            <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Outputs <span class="text-ink-3" style="font-weight:400;">· generated in parallel</span></span>
            <div class="flex flex-wrap gap-1.5" id="pd-qty">
              {[1, 2, 3, 4].map((n, i) => (
                <button type="button" class="pd-seg rounded-lg font-semibold" data-val={n} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{n}</button>
              ))}
            </div>
          </div>

          <div id="pd-gen-error" class="mt-3 hidden rounded-lg" style="padding:9px 12px;background:color-mix(in srgb, var(--pd-pink) 12%, transparent);border:0.5px solid color-mix(in srgb, var(--pd-pink) 40%, transparent);color:var(--pd-pink);font-size:12.5px;"></div>

          <button id="pd-generate" type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl font-bold" style="padding:13px 16px;background:var(--pd-mint);color:#0A0A0B;font-size:14px;letter-spacing:-0.1px;cursor:pointer;">
            <span id="pd-gen-label">Generate · {defaultCost} cr</span>
          </button>
          <div class="mt-2 text-center font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink4);letter-spacing:0.5px;">PixieDust · ~1–2 min</div>
        </div>
      </section>

      <!-- RIGHT -->
      <section class="flex">
        <div class="relative w-full overflow-y-auto rounded-[20px]" style="height:100%;min-height:480px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div id="pd-out-empty" class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
            <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full" style="background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-ink3)" stroke-width="1.4" stroke-linecap="round"><path d="M10 3v3M10 14v3M3 10h3M14 10h3M5 5l2 2M13 13l2 2M15 5l-2 2M5 15l2-2" /></svg>
            </div>
            <div class="text-ink-3" style="font-size:13px;">Your makeup looks appear here. Run as many as you like.</div>
          </div>
          <div id="pd-jobs" class="grid gap-3" style="padding:14px;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));"></div>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="pd-beauty-config" is:inline set:html={JSON.stringify(config)}></script>

  <style>
    .pd-seg { background: var(--pd-bg); color: var(--pd-ink2); border: 0.5px solid var(--pd-hairline2); }
    .pd-seg[data-active="true"] { background: var(--pd-ink); color: var(--pd-bg); border-color: transparent; }
    .pd-look-card:hover { transform: translateY(-2px); border-color: var(--pd-hairline3); }
    .pd-look-card[data-active="true"] { border-color: var(--pd-mint); box-shadow: 0 0 0 1.5px var(--pd-mint); }
    .pd-look-card[data-active="true"] .pd-look-check { display: flex !important; }
    .pd-tier-btn { background: var(--pd-bg); border: 1px solid var(--pd-hairline2); transition: border-color 120ms, background 120ms; }
    .pd-tier-btn[data-active="true"] { border-color: var(--pd-mint); background: color-mix(in srgb,var(--pd-mint) 8%,var(--pd-bg)); }
    @keyframes pd-spin { to { transform: rotate(360deg); } }
  </style>

  <script>
    const cfg = JSON.parse(document.getElementById("pd-beauty-config")!.textContent || "{}");
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    let credits: number = Number(cfg.credits) || 0;
    let activeJobs = 0;
    let mode = "looks";
    let target = "main";
    let selectedLook: string | null = null;
    let tier: any = (cfg.tiers || []).find((t: any) => t.id === cfg.defaultTier) || (cfg.tiers || [])[0] || { templateId: "beauty-studio-fast", creditCost: 3 };

    const personPanel = document.getElementById("pd-beauty-person") as HTMLElement;
    const refPanel = document.getElementById("pd-beauty-ref") as HTMLElement;
    const targetText = $("#pd-target-text") as HTMLInputElement;
    const genBtn = $("#pd-generate") as HTMLButtonElement;
    const genLabel = $("#pd-gen-label");
    const errEl = $("#pd-gen-error");
    const emptyEl = $("#pd-out-empty");
    const jobsEl = $("#pd-jobs");

    const jobSnapshots = new Map<string, { inputs: Record<string, unknown>; meta: Record<string, unknown> }>();

    function setMode(next: string) {
      mode = next;
      document.querySelectorAll<HTMLElement>("#pd-mode-tabs .pd-seg").forEach((b) => b.setAttribute("data-active", String(b.dataset.mode === next)));
      const isRef = next === "reference";
      $("#pd-look-wrap").style.display = isRef ? "none" : "block";
      $("#pd-ref-wrap").style.display = isRef ? "block" : "none";
    }

    function applyStudioInputs(inputs: Record<string, unknown>, meta?: Record<string, unknown>) {
      const images = Array.isArray(inputs.images) ? inputs.images.map(String) : inputs.person ? [String(inputs.person)] : [];
      if (images[0]) {
        (window as any).pdPrefillFieldPanel?.(personPanel, { person: images[0] }, (personPanel as any)._pdFileUrls);
      }
      if (meta?.mode === "reference" || images.length > 1) {
        setMode("reference");
        if (images[1]) {
          (window as any).pdPrefillFieldPanel?.(refPanel, { reference: images[1] }, (refPanel as any)._pdFileUrls);
        }
        selectedLook = null;
        document.querySelectorAll<HTMLElement>(".pd-look-card").forEach((c) => (c.dataset.active = "false"));
      } else if (meta?.selectedLook) {
        setMode("looks");
        selectedLook = String(meta.selectedLook);
        document.querySelectorAll<HTMLElement>(".pd-look-card").forEach((c) => (c.dataset.active = String(c.dataset.lookId === selectedLook)));
      }
      if (meta?.target) {
        target = String(meta.target);
        document.querySelectorAll<HTMLElement>("#pd-target .pd-seg").forEach((b) => b.setAttribute("data-active", String(b.dataset.target === target)));
        targetText.style.display = target === "describe" ? "block" : "none";
        if (meta.targetText) targetText.value = String(meta.targetText);
      }
      refreshButton();
      personPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      (window as any).pdToast?.("Photo and references loaded — edit and generate when ready", { accent: "var(--pd-mint)" });
    }

    function quantity(): number {
      const a = document.querySelector<HTMLElement>('#pd-qty .pd-seg[data-active="true"]');
      return Number(a?.dataset.val) || 1;
    }
    function unitCost(): number { return Number(tier?.creditCost) || 3; }
    function cost(): number { return unitCost() * quantity(); }
    function personUrl(): string | undefined { return ((personPanel as any)?._pdFileUrls || {}).person; }
    function refUrl(): string | undefined { return ((refPanel as any)?._pdFileUrls || {}).reference; }
    function hasSelection(): boolean {
      return mode === "reference" ? !!refUrl() : !!selectedLook;
    }

    function refreshButton() {
      const c = cost();
      if (!cfg.signedIn) { genLabel.textContent = "Sign in to generate"; return; }
      if (!hasSelection()) { genLabel.textContent = mode === "reference" ? "Upload a reference" : "Pick a look"; genBtn.style.opacity = "0.6"; return; }
      genBtn.style.opacity = "1";
      if (credits < c) {
        genLabel.textContent = `Get more credits · need ${c} cr`;
        genBtn.style.background = "transparent"; genBtn.style.color = "var(--pd-ink)"; genBtn.style.border = "0.5px solid var(--pd-hairline2)";
      } else {
        genLabel.textContent = `Generate · ${c} cr`;
        genBtn.style.background = "var(--pd-mint)"; genBtn.style.color = "#0A0A0B"; genBtn.style.border = "none";
      }
    }

    // Who-to-edit
    document.querySelectorAll<HTMLElement>("#pd-target .pd-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-target .pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        target = btn.dataset.target!;
        targetText.style.display = target === "describe" ? "block" : "none";
      });
    });

    // Mode tabs
    document.querySelectorAll<HTMLElement>("#pd-mode-tabs .pd-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-mode-tabs .pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        mode = btn.dataset.mode!;
        const isRef = mode === "reference";
        $("#pd-look-wrap").style.display = isRef ? "none" : "block";
        $("#pd-ref-wrap").style.display = isRef ? "block" : "none";
        refreshButton();
      });
    });

    // Look selection (single)
    document.querySelectorAll<HTMLElement>(".pd-look-card").forEach((card) => {
      card.addEventListener("click", () => {
        const id = card.dataset.lookId!;
        if (selectedLook === id) { selectedLook = null; card.dataset.active = "false"; }
        else {
          selectedLook = id;
          document.querySelectorAll<HTMLElement>(".pd-look-card").forEach((c) => (c.dataset.active = String(c === card)));
        }
        refreshButton();
      });
    });
    $("#pd-clear-look").addEventListener("click", () => {
      selectedLook = null;
      document.querySelectorAll<HTMLElement>(".pd-look-card").forEach((c) => (c.dataset.active = "false"));
      refreshButton();
    });

    // Tier + outputs
    document.querySelectorAll<HTMLElement>("#pd-tier .pd-tier-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-tier .pd-tier-btn").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        tier = (cfg.tiers || []).find((t: any) => t.id === btn.dataset.tier) || tier;
        refreshButton();
      });
    });
    document.querySelectorAll<HTMLElement>("#pd-qty .pd-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>("#pd-qty .pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
        refreshButton();
      });
    });

    function targetPhrase(): string {
      const t = (cfg.targets || []).find((x: any) => x.id === target);
      if (target === "describe") return (targetText.value || "").trim() || "the main person";
      return (t && t.phrase) || "the main person";
    }
    function buildPrompt(): string {
      const who = targetPhrase();
      let action = "";
      // Retouch look gently reshapes features → uses a rule that allows it.
      if (mode !== "reference" && selectedLook === "subtle-retouch" && cfg.looks[selectedLook]) {
        return `${cfg.retouchRule} Apply ${cfg.looks[selectedLook].prompt} to ${who}. Keep it subtle and believable.`;
      }
      if (mode === "reference" && refUrl()) {
        action = `Look at the makeup worn by the person in the second reference image. Analyze and isolate ONLY their makeup — eyeshadow, eyeliner, lashes, brows, blush, contour, highlight, and lip color/finish — and recreate that same makeup look on ${who} in the first image. Do NOT copy the reference person's face, identity, skin tone, or features — transfer only the makeup, adapted naturally to the subject's own face and skin tone.`;
      } else if (selectedLook && cfg.looks[selectedLook]) {
        action = `Apply ${cfg.looks[selectedLook].prompt} to ${who}.`;
      } else return "";
      return `${cfg.baseRule} ${action}`;
    }

    // Results / polling
    function friendlyError(raw: unknown): string {
      const e = String(raw ?? "").replace(/\s*\(refunded\)\s*$/i, "");
      if (/e005|flagged as sensitive|safety|moderation|content policy|nsfw|sensitive/i.test(e))
        return "The model's safety filter blocked this — try a different photo. You weren't charged.";
      if (/rate limit|slow down/i.test(e)) return "Too many requests. You weren't charged — try again in a minute.";
      if (/timeout|timed out/i.test(e)) return "This timed out. You weren't charged — try again.";
      return (e || "Generation failed") + " — you weren't charged.";
    }
    function showError(msg: string) { errEl.textContent = msg; errEl.classList.remove("hidden"); }

    function createTile(): HTMLElement {
      emptyEl.classList.add("hidden");
      const tile = document.createElement("div");
      tile.style.cssText = "position:relative;aspect-ratio:1/1.1;border-radius:14px;overflow:hidden;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);";
      tile.innerHTML =
        '<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:14px;text-align:center;">' +
        '<div style="width:30px;height:30px;border-radius:50%;border:3px solid var(--pd-hairline2);border-top-color:var(--pd-mint);animation:pd-spin .8s linear infinite;"></div>' +
        '<div class="pd-job-stage font-mono uppercase" style="font-size:9.5px;letter-spacing:.7px;color:var(--pd-ink2);">Submitting…</div>' +
        '</div>';
      jobsEl.prepend(tile);
      return tile;
    }
    function tileStage(tile: HTMLElement, text: string) { const s = tile.querySelector<HTMLElement>(".pd-job-stage"); if (s) s.textContent = text; }
    function tileFail(tile: HTMLElement, msg: string) {
      tile.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:14px;text-align:center;color:var(--pd-pink);font-size:11.5px;line-height:1.4;"></div>';
      (tile.firstElementChild as HTMLElement).textContent = msg;
    }
    function tileResult(tile: HTMLElement, outputs: string[], genId?: string) {
      tile.innerHTML = "";
      const url = outputs[0];
      if (!url) { tileFail(tile, "No output."); return; }
      const img = document.createElement("img");
      img.src = url;
      img.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;cursor:zoom-in;";
      img.addEventListener("click", () => openLb(url, genId));
      tile.appendChild(img);
      const snap = genId ? jobSnapshots.get(genId) : null;
      if (snap) {
        const reuseBtn = document.createElement("button");
        reuseBtn.type = "button";
        reuseBtn.title = "Reuse prompt & references";
        reuseBtn.innerHTML = `<svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 2.5H8v5.5M8.5 2.5 5 6M5 8.5H2.5V3"/></svg>`;
        reuseBtn.style.cssText = "position:absolute;top:7px;left:7px;width:24px;height:24px;border-radius:6px;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:1;";
        reuseBtn.addEventListener("click", (e) => { e.stopPropagation(); applyStudioInputs(snap.inputs, snap.meta); });
        tile.appendChild(reuseBtn);
      }
      const dl = document.createElement("a");
      dl.href = genId ? `/api/download?id=${encodeURIComponent(genId)}` : url;
      if (!genId) dl.setAttribute("download", "");
      dl.textContent = "↓"; dl.title = "Download";
      dl.style.cssText = "position:absolute;right:7px;bottom:7px;width:24px;height:24px;border-radius:6px;background:rgba(10,10,11,.7);backdrop-filter:blur(6px);color:#fff;font-size:14px;text-decoration:none;display:flex;align-items:center;justify-content:center;";
      tile.appendChild(dl);
    }
    let lbEl: HTMLElement | null = null;
    function openLb(url: string, genId?: string) {
      if (!lbEl) {
        lbEl = document.createElement("div");
        lbEl.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(5,5,8,.82);backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:center;padding:24px;cursor:zoom-out;";
        lbEl.addEventListener("click", () => { lbEl!.style.display = "none"; document.body.style.overflow = ""; });
        document.body.appendChild(lbEl);
      }
      const snap = genId ? jobSnapshots.get(genId) : null;
      const inputs = (snap?.inputs || {}) as Record<string, unknown>;
      const prompt = typeof inputs.prompt === "string" ? inputs.prompt : "";
      const refs: string[] = [];
      const addRef = (u: unknown) => { if (typeof u === "string" && /^https?:\/\//.test(u) && !refs.includes(u)) refs.push(u); };
      if (Array.isArray(inputs.images)) inputs.images.forEach(addRef);
      addRef(inputs.person);

      const card = document.createElement("div");
      card.id = "pd-lb-card";
      card.style.cssText = "cursor:default;display:grid;width:100%;max-width:980px;max-height:calc(100vh - 48px);overflow:hidden;border-radius:24px;background:var(--pd-raised);border:0.5px solid var(--pd-hairline2);grid-template-columns:minmax(0,1.3fr) minmax(260px,0.85fr);";
      card.addEventListener("click", (e) => e.stopPropagation());

      const media = document.createElement("div");
      media.style.cssText = "background:#0a0a0b;display:flex;align-items:center;justify-content:center;min-height:240px;";
      const img = document.createElement("img");
      img.src = url;
      img.style.cssText = "max-width:100%;max-height:calc(100vh - 96px);object-fit:contain;";
      media.appendChild(img);

      const side = document.createElement("div");
      side.style.cssText = "display:flex;flex-direction:column;min-height:0;overflow:hidden;";
      side.innerHTML = `<div style="padding:12px 16px;border-bottom:0.5px solid var(--pd-hairline);display:flex;justify-content:space-between;align-items:center;"><div style="font-size:14px;font-weight:600;color:var(--pd-ink);">Generation details</div><button type="button" data-lb-x style="width:28px;height:28px;border-radius:50%;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);color:var(--pd-ink2);cursor:pointer;">✕</button></div>`;
      const body = document.createElement("div");
      body.style.cssText = "padding:14px 16px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px;";
      if (refs.length) {
        const w = document.createElement("div");
        w.innerHTML = `<div style="font-family:ui-monospace,monospace;font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.7px;text-transform:uppercase;margin-bottom:8px;">References</div>`;
        const row = document.createElement("div");
        row.style.cssText = "display:flex;flex-wrap:wrap;gap:8px;";
        refs.forEach((u) => {
          const a = document.createElement("a");
          a.href = u; a.target = "_blank"; a.rel = "noopener";
          a.style.cssText = "display:block;width:64px;height:64px;border-radius:10px;overflow:hidden;border:0.5px solid var(--pd-hairline);";
          a.innerHTML = `<img src="${u}" alt="" style="width:100%;height:100%;object-fit:cover;"/>`;
          row.appendChild(a);
        });
        w.appendChild(row);
        body.appendChild(w);
      }
      if (prompt) {
        const w = document.createElement("div");
        w.innerHTML = `<div style="font-family:ui-monospace,monospace;font-size:9.5px;color:var(--pd-ink3);letter-spacing:0.7px;text-transform:uppercase;margin-bottom:8px;">Prompt</div>`;
        const box = document.createElement("div");
        box.textContent = prompt;
        box.style.cssText = "padding:11px 12px;border-radius:12px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:12.5px;line-height:1.5;color:var(--pd-ink2);white-space:pre-wrap;max-height:160px;overflow:auto;";
        w.appendChild(box);
        body.appendChild(w);
      } else if (!refs.length) {
        const empty = document.createElement("div");
        empty.style.cssText = "font-size:12px;color:var(--pd-ink4);";
        empty.textContent = "No prompt or references saved for this result.";
        body.appendChild(empty);
      }
      const foot = document.createElement("div");
      foot.style.cssText = "padding:12px 16px 16px;border-top:0.5px solid var(--pd-hairline);display:flex;flex-direction:column;gap:8px;";
      if (genId) {
        const reuse = document.createElement("button");
        reuse.type = "button";
        reuse.textContent = "Reuse in new generation";
        reuse.style.cssText = "width:100%;padding:11px 14px;border-radius:12px;background:var(--pd-mint);color:#0A0A0B;font-size:13px;font-weight:700;border:none;cursor:pointer;";
        reuse.addEventListener("click", () => {
          if (snap) applyStudioInputs(snap.inputs, snap.meta);
          else (window as any).pdLoadReuseInputs?.(genId, { onLoaded: (d: any) => applyStudioInputs(d.inputs ?? {}) });
          lbEl!.style.display = "none";
          document.body.style.overflow = "";
        });
        foot.appendChild(reuse);
      }
      const dl = document.createElement("a");
      dl.href = genId ? `/api/download?id=${encodeURIComponent(genId)}` : url;
      if (!genId) dl.setAttribute("download", "");
      dl.textContent = "↓ Download";
      dl.style.cssText = "display:flex;align-items:center;justify-content:center;padding:10px 14px;border-radius:12px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);color:var(--pd-ink);font-size:12.5px;font-weight:600;text-decoration:none;";
      foot.appendChild(dl);

      side.appendChild(body);
      side.appendChild(foot);
      card.appendChild(media);
      card.appendChild(side);
      lbEl.innerHTML = "";
      lbEl.appendChild(card);
      side.querySelector("[data-lb-x]")?.addEventListener("click", (e) => { e.stopPropagation(); lbEl!.style.display = "none"; document.body.style.overflow = ""; });
      lbEl.style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    async function poll(id: string, tile: HTMLElement, per: number): Promise<void> {
      const stages = ["Reading your photo", "Applying the makeup", "Blending", "Almost there"];
      let tick = 0;
      while (true) {
        await new Promise((r) => setTimeout(r, 2000));
        tick++;
        let data: any;
        try { data = await (await fetch(`/api/generate/status?id=${id}`)).json(); } catch { continue; }
        tileStage(tile, (stages[Math.min(tick, stages.length - 1)]) + "…");
        if (data.status === "completed") { tileResult(tile, data.outputs || [], id); return; }
        if (data.status === "failed") { credits += per; refreshButton(); tileFail(tile, friendlyError(data.error)); return; }
      }
    }

    async function launchJob(inputs: Record<string, unknown>, per: number, templateId: string) {
      const tile = createTile();
      const snap = {
        inputs: { ...inputs },
        meta: { mode, selectedLook, target, targetText: targetText.value },
      };
      activeJobs++;
      credits -= per;
      refreshButton();
      try {
        const res = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ templateId, inputs, quantity: 1 }),
        });
        const data = await res.json();
        if (!res.ok) {
          credits += per; refreshButton();
          if (data.needCredits) { tile.remove(); window.location.href = "/credits"; }
          else tileFail(tile, friendlyError(data.error || "Could not start generation."));
          return;
        }
        jobSnapshots.set(data.id, snap);
        await poll(data.id, tile, per);
      } catch {
        credits += per; refreshButton();
        tileFail(tile, "Network error — try again.");
      } finally {
        activeJobs = Math.max(0, activeJobs - 1);
      }
    }

    async function generate() {
      if (!cfg.signedIn) { window.location.href = "/auth/sign-in?redirect=" + encodeURIComponent(location.pathname); return; }
      const person = personUrl();
      if (!person) { showError("Upload a photo first."); return; }
      if (Number((personPanel as any)?._pdUploading || 0) > 0 || Number((refPanel as any)?._pdUploading || 0) > 0) { showError("Hang on — a photo is still uploading."); return; }
      if (!hasSelection()) { showError(mode === "reference" ? "Upload a makeup reference." : "Pick a makeup look."); return; }
      const prompt = buildPrompt();
      if (!prompt) { showError("Pick a look or reference."); return; }
      const images: string[] = [person];
      if (mode === "reference" && refUrl()) images.push(refUrl()!);
      const total = cost();
      if (credits < total) { window.location.href = "/credits"; return; }
      errEl.classList.add("hidden");
      const inputs = { images, prompt };
      const n = quantity();
      const per = unitCost();
      const templateId = tier.templateId;
      for (let i = 0; i < n; i++) launchJob(inputs, per, templateId);
    }

    genBtn.addEventListener("click", generate);
    refreshButton();

    const reuseId = new URLSearchParams(location.search).get("reuse");
    if (reuseId) {
      (window as any).pdLoadReuseInputs?.(reuseId, {
        onLoaded: (data: { inputs: Record<string, unknown> }) => {
          applyStudioInputs(data.inputs ?? {});
          history.replaceState({}, "", location.pathname);
        },
      }).catch(() => {});
    }
  </script>
</AppShell>

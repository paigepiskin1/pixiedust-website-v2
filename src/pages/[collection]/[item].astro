---
// An item's page: /<section>/<item>. Every section shares this page; the
// section's item_template picks the variant, and "default" is the Blog
// article. Items are one content type edited in one editor — only the section
// they are filed under changes their URL root.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import { getSectionBySlug, sectionsById, itemHref, listSubcategories, subKey } from "../../lib/sections";
import {
  getPublishedBySlug, relatedPosts, thumbnailFor, firstImageIn, excerptFor, displayDate, isoDate,
  readingMinutes, tagsOf, BLOG_AUTHOR_FALLBACK,
} from "../../lib/blog";

const SITE = "https://pixydust.com";
const db = Astro.locals.runtime.env.DB;
const { collection: sectionSlug, item: itemSlug } = Astro.params;

const section = sectionSlug ? await getSectionBySlug(db, sectionSlug) : null;
if (!section) return Astro.rewrite("/404");

const post = itemSlug ? await getPublishedBySlug(db, itemSlug).catch(() => null) : null;
// Drafts, scheduled-for-later and unknown slugs get the real 404 — a soft 404
// that renders an empty shell gets indexed as a page and dilutes the site.
if (!post) return Astro.rewrite("/404");

// Item slugs are unique across sections, so a request under the wrong section
// is unambiguous: send it to the one canonical URL rather than serving the
// same article at two. This is also what keeps old /blog/<slug> links working
// for an item that has since been moved to another section.
const sections = await sectionsById(db);
const home = itemHref(sections, post);
if (home !== `/${section.slug}/${post.slug}`) return Astro.redirect(home, 301);

const subs = await listSubcategories(db, section.id);
const sub = post.category ? subs.find((s) => s.id === post.category) ?? null : null;

const image = thumbnailFor(post);
const description = excerptFor(post);
const published = isoDate(post.published_at);
const modified = isoDate(post.updated_at) || published;
const author = post.author || BLOG_AUTHOR_FALLBACK;
const tags = tagsOf(post);
const minutes = readingMinutes(post.content_html);
const url = `${SITE}${home}`;
const related = await relatedPosts(db, post, 3).catch(() => []);

// Don't print the same picture twice. The editor's "From body" button sets the
// thumbnail to the first image in the article, so thumbnail === first body
// image is the normal outcome of the normal workflow. When they match, the
// body keeps its copy — it sits where the author put it — and the header
// image is dropped.
const sameImage = (a: string | null, b: string | null) =>
  !!a && !!b && a.split(/[?#]/)[0] === b.split(/[?#]/)[0];
const heroImage = sameImage(image, firstImageIn(post.content_html)) ? null : image;

const isBlog = section.id === "blog";
const layout = section.item_template; // default | steps | gallery

const jsonLd = JSON.stringify([
  {
    "@type": isBlog ? "BlogPosting" : "Article",
    "@id": `${url}#article`,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    headline: post.title.slice(0, 110), // Google truncates headline beyond ~110
    description,
    ...(image ? { image: [image] } : {}),
    datePublished: published,
    dateModified: modified,
    author: { "@type": "Organization", name: author, url: SITE },
    publisher: { "@id": `${SITE}/#organization` },
    isPartOf: { "@id": `${SITE}/${section.slug}#${isBlog ? "blog" : "collection"}` },
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
    wordCount: post.content_html ? post.content_html.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length : 0,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE },
      { "@type": "ListItem", position: 2, name: section.title, item: `${SITE}/${section.slug}` },
      ...(sub ? [{ "@type": "ListItem", position: 3, name: sub.title, item: `${SITE}/${section.slug}?category=${subKey(sub)}` }] : []),
      { "@type": "ListItem", position: sub ? 4 : 3, name: post.title, item: url },
    ],
  },
]);
---

<AppShell
  title={`${post.title} — PixyDust`}
  description={description}
  ogImage={image ?? undefined}
  ogType="article"
  jsonLd={jsonLd}
  canonical={url}
  credits={Astro.locals.user?.credits ?? 47}
>
  <Fragment slot="head">
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <div class="mx-auto w-full" style="max-width:760px;padding:28px 24px 64px;">
    <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-ink-4" style="font-size:11.5px;">
      <a href="/" style="color:inherit;text-decoration:none;">Home</a>
      <span>/</span>
      <a href={`/${section.slug}`} style="color:inherit;text-decoration:none;">{section.title}</a>
      {sub && (
        <>
          <span>/</span>
          <a href={`/${section.slug}?category=${subKey(sub)}`} style="color:inherit;text-decoration:none;">{sub.title}</a>
        </>
      )}
    </nav>

    <article>
      <header>
        {tags.length > 0 && (
          <div class="mb-3 flex flex-wrap gap-1.5">
            {tags.map((t) => (
              <span class="font-mono uppercase"
                style="font-size:9.5px;letter-spacing:1px;color:var(--pd-lilac);border:0.5px solid color-mix(in srgb,var(--pd-lilac) 38%,transparent);border-radius:999px;padding:3px 9px;">{t}</span>
            ))}
          </div>
        )}

        <h1 class="font-display font-semibold text-ink" style="font-size:clamp(28px,5vw,42px);letter-spacing:-1px;line-height:1.12;">
          {post.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-ink-3" style="font-size:12.5px;">
          <span>{author}</span>
          <span>·</span>
          {published && <time datetime={published}>{displayDate(post.published_at)}</time>}
          <span>·</span>
          <span>{minutes} min read</span>
        </div>
      </header>

      {heroImage && (
        <img src={heroImage} alt={post.thumbnail_alt || post.title} width="1200" height={layout === "gallery" ? "900" : "675"}
          decoding="async" class="mt-7 rounded-2xl"
          style={`display:block;width:100%;aspect-ratio:${layout === "gallery" ? "4/3" : "16/9"};object-fit:cover;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline);`} />
      )}

      <div class={`pd-prose mt-8 ${layout === "steps" ? "pd-steps" : ""}`} set:html={post.content_html} />
    </article>

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-4 font-display font-semibold text-ink" style="font-size:18px;letter-spacing:-0.3px;">Related articles</h2>
        <div class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));">
          {related.map((r) => {
            const rImg = thumbnailFor(r);
            return (
              <a href={itemHref(sections, r)} class="overflow-hidden rounded-xl"
                style="display:block;text-decoration:none;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
                {rImg ? (
                  <img src={rImg} alt={r.title} width="400" height="225" loading="lazy" decoding="async"
                    style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--pd-bg3);" />
                ) : (
                  <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));" />
                )}
                <div style="padding:12px 13px 14px;">
                  <div class="font-semibold text-ink" style="font-size:13px;line-height:1.3;">{r.title}</div>
                  <div class="mt-1 text-ink-4" style="font-size:11px;">{displayDate(r.published_at)}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</AppShell>

<style is:global>
  /* Item body. The editor emits plain semantic HTML, so style it here rather
     than having the editor write inline styles into stored content. */
  .pd-prose { font-size: 15.5px; line-height: 1.72; color: var(--pd-ink2); }
  .pd-prose > * + * { margin-top: 1.15em; }
  .pd-prose h2 { font-size: 24px; font-weight: 600; letter-spacing: -0.5px; color: var(--pd-ink); margin-top: 1.9em; line-height: 1.25; }
  .pd-prose h3 { font-size: 18.5px; font-weight: 600; letter-spacing: -0.3px; color: var(--pd-ink); margin-top: 1.6em; line-height: 1.3; }
  .pd-prose a { color: var(--pd-lilac); text-underline-offset: 2px; }
  .pd-prose strong { color: var(--pd-ink); font-weight: 600; }
  .pd-prose ul, .pd-prose ol { padding-left: 1.3em; }
  .pd-prose ul { list-style: disc; }
  .pd-prose ol { list-style: decimal; }
  .pd-prose li + li { margin-top: 0.4em; }
  /* width:100% is the default for an image the author never resized. An inline
     style="width:NN%" set in the editor overrides it on specificity, and
     max-width keeps that honest on narrow screens. */
  .pd-prose img, .pd-prose video {
    display: block; width: 100%; max-width: 100%; height: auto; border-radius: 14px;
    border: 0.5px solid var(--pd-hairline); margin: 1.8em 0;
  }
  .pd-prose figure { margin: 1.8em 0; }
  .pd-prose figcaption { font-size: 12px; color: var(--pd-ink-4, var(--pd-ink3)); text-align: center; margin-top: 0.6em; }
  .pd-prose blockquote { border-left: 2px solid var(--pd-lilac); padding-left: 1em; color: var(--pd-ink2); font-style: italic; }
  .pd-prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88em;
    background: var(--pd-bg2); border: 0.5px solid var(--pd-hairline); border-radius: 5px; padding: 1px 5px;
  }
  .pd-prose pre { background: var(--pd-bg2); border: 0.5px solid var(--pd-hairline); border-radius: 12px; padding: 14px 16px; overflow-x: auto; }
  .pd-prose pre code { background: none; border: 0; padding: 0; }
  .pd-prose hr { border: 0; border-top: 0.5px solid var(--pd-hairline); margin: 2.4em 0; }
  .pd-prose table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .pd-prose th, .pd-prose td { border: 0.5px solid var(--pd-hairline); padding: 8px 10px; text-align: left; }

  /* "steps" template: a numbered list reads as a walkthrough. */
  .pd-steps ol { list-style: none; padding-left: 0; counter-reset: pd-step; }
  .pd-steps ol > li { counter-increment: pd-step; position: relative; padding-left: 42px; margin-top: 1.1em; }
  .pd-steps ol > li::before {
    content: counter(pd-step); position: absolute; left: 0; top: -1px;
    width: 28px; height: 28px; border-radius: 999px; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: #fff;
    background: linear-gradient(115deg, #7C3AED, #EC4899);
  }
</style>

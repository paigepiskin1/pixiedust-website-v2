---
// A collection item's detail page.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import {
  getCollection, getItem, siblingItems, imageFor, summaryFor, tagsOf, metaOf,
  itemHref, displayDate, isoDate, textOf,
} from "../../lib/collections";

const SITE = "https://pixydust.com";
const db = Astro.locals.runtime.env.DB;
const { collection: colSlug, item: itemSlug } = Astro.params;

const collection = colSlug ? await getCollection(db, colSlug) : null;
if (!collection) return new Response(null, { status: 404 });

const item = itemSlug ? await getItem(db, collection.id, itemSlug) : null;
if (!item) return new Response(null, { status: 404 });

// An external item has no page of ours — send the reader to the publisher
// rather than rendering a stub that duplicates their article.
const external = (item.external_url || "").trim();
if (external) return Astro.redirect(external, 302);

const image = imageFor(item);
const summary = summaryFor(item);
const tags = tagsOf(item);
const meta = metaOf(item);
const related = await siblingItems(db, collection.id, item, 3);
const words = textOf(item.content_html).split(/\s+/).filter(Boolean).length;
const isSteps = collection.item_template === "steps";
const isGallery = collection.item_template === "gallery";

const jsonLd = JSON.stringify({
  "@type": "Article",
  "@id": `${SITE}${itemHref(collection, item)}#article`,
  headline: item.title,
  description: summary,
  url: `${SITE}${itemHref(collection, item)}`,
  datePublished: isoDate(item.published_at),
  dateModified: isoDate(item.updated_at) ?? isoDate(item.published_at),
  ...(image ? { image } : {}),
  publisher: { "@id": `${SITE}/#organization` },
  isPartOf: { "@type": "CollectionPage", name: collection.title, url: `${SITE}/${collection.slug}` },
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
});
---

<AppShell
  title={`${item.title} — ${collection.title} — PixyDust`}
  description={summary}
  ogImage={image ?? undefined}
  ogType="article"
  jsonLd={jsonLd}
  canonical={`${SITE}${itemHref(collection, item)}`}
  credits={Astro.locals.user?.credits ?? 47}
>
  <article class="mx-auto w-full" style="max-width:820px;padding:28px 28px 80px;">
    <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-ink-4" style="font-size:11.5px;">
      <a href={`/${collection.slug}`} style="color:var(--pd-lilac);text-decoration:none;">{collection.title}</a>
      <span>/</span>
      <span>{item.title}</span>
    </nav>

    <h1 class="font-display font-medium text-ink" style="font-size:36px;letter-spacing:-1px;line-height:1.1;">
      {item.title}
    </h1>

    {summary && <p class="mt-3 text-ink-2" style="font-size:16px;line-height:1.6;">{summary}</p>}

    <div class="mt-4 flex flex-wrap items-center gap-2.5 text-ink-4" style="font-size:11.5px;">
      {item.published_at && <time datetime={isoDate(item.published_at)!}>{displayDate(item.published_at)}</time>}
      {words > 0 && (<><span>·</span><span>{Math.max(1, Math.round(words / 225))} min read</span></>)}
      {tags.map((t) => (
        <span class="font-mono uppercase"
          style="font-size:9.5px;letter-spacing:1px;color:var(--pd-lilac);border:0.5px solid color-mix(in srgb,var(--pd-lilac) 38%,transparent);border-radius:999px;padding:2px 8px;">{t}</span>
      ))}
    </div>

    {/* Details table — whatever fields this template needed, without a schema
        change per template. */}
    {Object.keys(meta).length > 0 && (
      <dl class="mt-5 grid gap-x-6 gap-y-0 rounded-xl sm:grid-cols-2"
        style="padding:4px 16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
        {Object.entries(meta).map(([k, v]) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4" style="padding:10px 0;">
            <dt class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink4);letter-spacing:0.7px;">{k}</dt>
            <dd class="text-ink-2" style="font-size:12.5px;">{v}</dd>
          </div>
        ))}
      </dl>
    )}

    {image && (
      <img src={image} alt={item.hero_alt || item.title} width="1200" height={isGallery ? "900" : "675"}
        decoding="async"
        style={`display:block;width:100%;aspect-ratio:${isGallery ? "4/3" : "16/9"};object-fit:cover;border-radius:16px;margin-top:22px;border:0.5px solid var(--pd-hairline);`} />
    )}

    <div class={`pd-prose mt-8 ${isSteps ? "pd-steps" : ""}`} set:html={item.content_html} />

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-4 font-display font-semibold text-ink" style="font-size:18px;letter-spacing:-0.3px;">
          More from {collection.title}
        </h2>
        <div class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));">
          {related.map((r) => {
            const rImg = imageFor(r);
            return (
              <a href={itemHref(collection, r)} class="overflow-hidden rounded-xl"
                style="display:block;text-decoration:none;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
                {rImg ? (
                  <img src={rImg} alt={r.title} width="400" height="225" loading="lazy" decoding="async"
                    style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--pd-bg3);" />
                ) : (
                  <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));" />
                )}
                <div style="padding:12px 13px 14px;">
                  <div class="font-semibold text-ink" style="font-size:13px;line-height:1.3;">{r.title}</div>
                  {r.published_at && (
                    <div class="mt-1 text-ink-4" style="font-size:11px;">{displayDate(r.published_at)}</div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</AppShell>

<style is:global>
  .pd-prose { font-size: 16px; line-height: 1.75; color: var(--pd-ink2); }
  .pd-prose > * + * { margin-top: 1.2em; }
  .pd-prose h2 { font-size: 25px; font-weight: 600; letter-spacing: -0.5px; color: var(--pd-ink); margin-top: 1.9em; }
  .pd-prose h3 { font-size: 19px; font-weight: 600; color: var(--pd-ink); margin-top: 1.6em; }
  .pd-prose a { color: var(--pd-lilac); }
  .pd-prose ul { list-style: disc; padding-left: 1.35em; }
  .pd-prose ol { list-style: decimal; padding-left: 1.35em; }
  .pd-prose li + li { margin-top: 0.4em; }
  .pd-prose img, .pd-prose video {
    display: block; width: 100%; max-width: 100%; height: auto; border-radius: 14px;
    border: 0.5px solid var(--pd-hairline); margin: 1.8em 0;
  }
  .pd-prose blockquote {
    border-left: 2px solid var(--pd-lilac); padding-left: 1em; color: var(--pd-ink2); font-style: italic;
  }
  .pd-prose pre {
    background: var(--pd-bg3); border-radius: 10px; padding: 14px 16px; overflow-x: auto; font-size: 13.5px;
  }

  /* steps template: numbered ordered lists read as a walkthrough rather than
     as a plain list. */
  .pd-steps ol { list-style: none; padding-left: 0; counter-reset: pd-step; }
  .pd-steps ol > li {
    counter-increment: pd-step; position: relative; padding-left: 42px; margin-top: 1.1em;
  }
  .pd-steps ol > li::before {
    content: counter(pd-step);
    position: absolute; left: 0; top: -1px;
    width: 28px; height: 28px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: #fff;
    background: linear-gradient(115deg, #7C3AED, #EC4899);
  }
</style>

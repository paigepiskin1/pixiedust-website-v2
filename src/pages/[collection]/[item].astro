---
// A post inside a section. Sections are categories whose posts are addressed
// as /<section>/<slug> rather than /blog/<slug> — see url_mode. The post
// itself is an ordinary blog post, so there is one content type and one
// editor; only the permalink differs.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import { getCollection } from "../../lib/collections";
import {
  getPublishedBySlug, relatedPosts, thumbnailFor, excerptFor, tagsOf,
  displayDate, isoDate, readingMinutes, firstImageIn, BLOG_AUTHOR_FALLBACK,
} from "../../lib/blog";

const SITE = "https://pixydust.com";
const db = Astro.locals.runtime.env.DB;
const { collection: colSlug, item: itemSlug } = Astro.params;

const collection = colSlug ? await getCollection(db, colSlug) : null;
if (!collection) return new Response(null, { status: 404 });

const post = itemSlug ? await getPublishedBySlug(db, itemSlug) : null;
if (!post) return new Response(null, { status: 404 });

// The post must actually belong to this section, or /ar-effects/<any-slug>
// would serve a post that lives elsewhere — two URLs for one piece of content.
if (post.category !== collection.id) return new Response(null, { status: 404 });
if (collection.url_mode !== "section") return Astro.redirect(`/blog/${post.slug}`, 301);

const canonical = `${SITE}/${collection.slug}/${post.slug}`;
const image = thumbnailFor(post);
const description = excerptFor(post);
const tags = tagsOf(post);
const minutes = readingMinutes(post.content_html);
const author = post.author || BLOG_AUTHOR_FALLBACK;
const related = await relatedPosts(db, post, 3);

// Avoid printing the lead image twice when the thumbnail is also the first
// image in the body — the editor's "From body" button produces exactly that.
const bare = (u: string | null) => (u || "").split(/[?#]/)[0];
const heroImage = bare(image) && bare(image) === bare(firstImageIn(post.content_html)) ? null : image;

const sectionCats = await (async () => {
  const { sectionCategories } = await import("../../lib/collections");
  return sectionCategories(db);
})();
const hrefFor = (p: { category: string | null; slug: string }) => {
  const c = p.category ? sectionCats.get(p.category) : undefined;
  return c ? `/${c.slug}/${p.slug}` : `/blog/${p.slug}`;
};

const jsonLd = JSON.stringify({
  "@type": "Article",
  "@id": `${canonical}#article`,
  headline: post.title,
  description,
  url: canonical,
  datePublished: isoDate(post.published_at),
  dateModified: isoDate(post.updated_at) ?? isoDate(post.published_at),
  ...(image ? { image } : {}),
  author: { "@type": "Organization", name: author },
  publisher: { "@id": `${SITE}/#organization` },
  isPartOf: { "@type": "CollectionPage", name: collection.title, url: `${SITE}/${collection.slug}` },
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
});
---

<AppShell
  title={`${post.title} — ${collection.title} — PixyDust`}
  description={description}
  ogImage={image ?? undefined}
  ogType="article"
  jsonLd={jsonLd}
  canonical={canonical}
  credits={Astro.locals.user?.credits ?? 47}
>
  <article class="mx-auto w-full" style="max-width:820px;padding:28px 28px 80px;">
    <nav class="mb-4 flex flex-wrap items-center gap-1.5 text-ink-4" style="font-size:11.5px;">
      <a href={`/${collection.slug}`} style="color:var(--pd-lilac);text-decoration:none;">{collection.title}</a>
      <span>/</span>
      <span>{post.title}</span>
    </nav>

    <h1 class="font-display font-medium text-ink" style="font-size:36px;letter-spacing:-1px;line-height:1.1;">
      {post.title}
    </h1>

    {description && <p class="mt-3 text-ink-2" style="font-size:16px;line-height:1.6;">{description}</p>}

    <div class="mt-4 flex flex-wrap items-center gap-2.5 text-ink-4" style="font-size:11.5px;">
      {post.published_at && <time datetime={isoDate(post.published_at)!}>{displayDate(post.published_at)}</time>}
      <span>·</span><span>{minutes} min read</span>
      {tags.map((t) => (
        <span class="font-mono uppercase"
          style="font-size:9.5px;letter-spacing:1px;color:var(--pd-lilac);border:0.5px solid color-mix(in srgb,var(--pd-lilac) 38%,transparent);border-radius:999px;padding:2px 8px;">{t}</span>
      ))}
    </div>

    {heroImage && (
      <img src={heroImage} alt={post.thumbnail_alt || post.title} width="1200" height="675" decoding="async"
        style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px;margin-top:22px;border:0.5px solid var(--pd-hairline);" />
    )}

    <div class="pd-prose mt-8" set:html={post.content_html} />

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-4 font-display font-semibold text-ink" style="font-size:18px;letter-spacing:-0.3px;">Related articles</h2>
        <div class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));">
          {related.map((r) => {
            const rImg = thumbnailFor(r);
            return (
              <a href={hrefFor(r)} class="overflow-hidden rounded-xl"
                style="display:block;text-decoration:none;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
                {rImg ? (
                  <img src={rImg} alt={r.title} width="400" height="225" loading="lazy" decoding="async"
                    style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--pd-bg3);" />
                ) : (
                  <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));" />
                )}
                <div style="padding:12px 13px 14px;">
                  <div class="font-semibold text-ink" style="font-size:13px;line-height:1.3;">{r.title}</div>
                  <div class="mt-1 text-ink-4" style="font-size:11px;">{displayDate(r.published_at)}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</AppShell>

<style is:global>
  .pd-prose { font-size: 16px; line-height: 1.75; color: var(--pd-ink2); }
  .pd-prose > * + * { margin-top: 1.2em; }
  .pd-prose h2 { font-size: 25px; font-weight: 600; letter-spacing: -0.5px; color: var(--pd-ink); margin-top: 1.9em; }
  .pd-prose h3 { font-size: 19px; font-weight: 600; color: var(--pd-ink); margin-top: 1.6em; }
  .pd-prose a { color: var(--pd-lilac); }
  .pd-prose ul { list-style: disc; padding-left: 1.35em; }
  .pd-prose ol { list-style: decimal; padding-left: 1.35em; }
  .pd-prose li + li { margin-top: 0.4em; }
  .pd-prose img, .pd-prose video {
    display: block; width: 100%; max-width: 100%; height: auto; border-radius: 14px;
    border: 0.5px solid var(--pd-hairline); margin: 1.8em 0;
  }
  .pd-prose blockquote {
    border-left: 2px solid var(--pd-lilac); padding-left: 1em; color: var(--pd-ink2); font-style: italic;
  }
  .pd-prose pre { background: var(--pd-bg3); border-radius: 10px; padding: 14px 16px; overflow-x: auto; font-size: 13.5px; }
</style>

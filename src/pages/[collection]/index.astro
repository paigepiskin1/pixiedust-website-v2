---
// A collection's index page. Dynamic, so it only ever catches paths that are
// not already a real route — Astro gives static files priority, so /about,
// /blog, /support and the rest keep winning.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { getCollection } from "../../lib/collections";
import { listPublishedPageByCategory, thumbnailFor, excerptFor, displayDate, isoDate, tagsOf } from "../../lib/blog";

const SITE = "https://pixydust.com";
const db = Astro.locals.runtime.env.DB;
const slug = Astro.params.collection!;

const collection = await getCollection(db, slug);
// Not one of ours: fall through to the real 404 rather than rendering an empty
// section for any arbitrary path.
if (!collection) return new Response(null, { status: 404 });

// A category page lists blog posts in that category. The six agreed sections
// address their posts as /<section>/<slug>; see url_mode.
const PER_PAGE = 12;
const requested = Number(Astro.url.searchParams.get("page") ?? "1");
const paged = await listPublishedPageByCategory(db, collection.id, Number.isFinite(requested) ? requested : 1, PER_PAGE);

const base = `/${collection.slug}`;
const canonicalPath = paged.page === 1 ? base : `${base}?page=${paged.page}`;
const rawPage = Astro.url.searchParams.get("page");
if (rawPage !== null && Astro.url.pathname + Astro.url.search !== canonicalPath) {
  return Astro.redirect(canonicalPath, 302);
}
const pageUrl = (n: number) => (n <= 1 ? `${SITE}${base}` : `${SITE}${base}?page=${n}`);

const prefix = collection.url_mode === "section" ? `/${collection.slug}` : "/blog";
const cards = paged.items.map((i) => ({
  title: i.title,
  href: `${prefix}/${i.slug}`,
  external: false,
  image: thumbnailFor(i),
  summary: excerptFor(i, 120),
  tags: tagsOf(i).slice(0, 2),
  date: displayDate(i.published_at),
  iso: isoDate(i.published_at),
  featured: false,
}));

const jsonLd = JSON.stringify({
  "@type": "CollectionPage",
  "@id": `${SITE}${base}#collection`,
  url: pageUrl(paged.page),
  name: collection.title,
  description: collection.blurb,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: paged.total,
    itemListElement: cards.map((c, n) => ({
      "@type": "ListItem",
      position: (paged.page - 1) * PER_PAGE + n + 1,
      url: c.external ? c.href : `${SITE}${c.href}`,
      name: c.title,
    })),
  },
});

const isGallery = collection.index_template === "gallery";
const isList = collection.index_template === "list";
---

<AppShell
  title={paged.page > 1 ? `${collection.title} — page ${paged.page} of ${paged.pages} — PixyDust` : `${collection.title} — PixyDust`}
  description={collection.blurb || `${collection.title} from PixyDust.`}
  ogImage={cards[0]?.image ?? undefined}
  jsonLd={jsonLd}
  canonical={pageUrl(paged.page)}
  prevUrl={paged.page > 1 ? pageUrl(paged.page - 1) : undefined}
  nextUrl={paged.page < paged.pages ? pageUrl(paged.page + 1) : undefined}
  credits={Astro.locals.user?.credits ?? 47}
>
  <div class="mx-auto w-full" style="max-width:1180px;padding:28px;">
    <PageHeader kicker={`PixyDust · ${collection.title}`} title={collection.title} sub={collection.blurb} />

    {cards.length === 0 ? (
      <div class="rounded-2xl text-center text-ink-3"
        style="padding:48px 24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:13.5px;">
        Nothing here yet — check back soon.
      </div>
    ) : isList ? (
      <div class="flex flex-col gap-2">
        {cards.map((c, i) => (
          <a href={c.href} class="pd-reveal flex items-center gap-4 rounded-xl"
            style={`--i:${i};padding:14px 16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);text-decoration:none;`}
            {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
            {c.image && (
              <img src={c.image} alt="" width="96" height="54" loading="lazy" decoding="async"
                style="flex:none;width:96px;aspect-ratio:16/9;object-fit:cover;border-radius:8px;background:var(--pd-bg3);" />
            )}
            <div class="min-w-0 flex-1">
              <div class="font-display font-semibold text-ink" style="font-size:15px;letter-spacing:-0.25px;line-height:1.3;">
                {c.title}{c.external && <span class="text-ink-4" style="font-weight:400;"> ↗</span>}
              </div>
              <p class="mt-1 text-ink-3" style="font-size:12.5px;line-height:1.5;">{c.summary}</p>
            </div>
            {c.iso && <time datetime={c.iso} class="shrink-0 text-ink-4" style="font-size:11px;">{c.date}</time>}
          </a>
        ))}
      </div>
    ) : (
      <div class="grid gap-5" style={`grid-template-columns:repeat(auto-fill,minmax(${isGallery ? "340px" : "300px"},1fr));`}>
        {cards.map((c, i) => (
          <article class="pd-reveal flex flex-col overflow-hidden rounded-2xl"
            style={`--i:${i};background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);`}>
            <a href={c.href} style="text-decoration:none;display:block;"
              {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
              {c.image ? (
                <img src={c.image} alt={c.title} width="600" height="338" loading="lazy" decoding="async"
                  style={`display:block;width:100%;aspect-ratio:${isGallery ? "4/3" : "16/9"};object-fit:cover;background:var(--pd-bg3);`} />
              ) : (
                <div style={`width:100%;aspect-ratio:${isGallery ? "4/3" : "16/9"};background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));`} />
              )}
            </a>
            <div class="flex flex-1 flex-col" style="padding:16px 17px 18px;">
              {c.tags.length > 0 && (
                <div class="mb-2 flex flex-wrap gap-1.5">
                  {c.tags.map((t) => (
                    <span class="font-mono uppercase"
                      style="font-size:9.5px;letter-spacing:1px;color:var(--pd-lilac);border:0.5px solid color-mix(in srgb,var(--pd-lilac) 38%,transparent);border-radius:999px;padding:2px 8px;">{t}</span>
                  ))}
                </div>
              )}
              <h2 class="font-display font-semibold text-ink" style="font-size:16px;letter-spacing:-0.3px;line-height:1.25;">
                <a href={c.href} style="color:inherit;text-decoration:none;"
                  {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
                  {c.title}{c.external && <span class="text-ink-4" style="font-weight:400;"> ↗</span>}
                </a>
              </h2>
              <p class="mt-2 flex-1 text-ink-2" style="font-size:12.5px;line-height:1.55;">{c.summary}</p>
              {c.iso && <time datetime={c.iso} class="mt-3 text-ink-4" style="font-size:11px;">{c.date}</time>}
            </div>
          </article>
        ))}
      </div>
    )}

    <Pagination page={paged.page} pages={paged.pages} total={paged.total} perPage={paged.perPage}
      base={base} noun={collection.noun} />
  </div>
</AppShell>

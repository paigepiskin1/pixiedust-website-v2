---
// A section's index page — /blog, /made-with-pixydust, /ar-effects … — listing
// the items filed under it. Every section shares this page; the section's
// index_template picks the layout, and "default" is the Blog grid.
//
// Dynamic, so it only catches paths that are not already real routes: Astro
// serves static pages first, so /about, /support and the rest keep winning.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { getSectionBySlug, listSubcategories, subKey } from "../../lib/sections";
import {
  listPublishedPageBySection, thumbnailFor, excerptFor, displayDate, isoDate, readingMinutes, tagsOf,
} from "../../lib/blog";

const SITE = "https://pixydust.com";
const db = Astro.locals.runtime.env.DB;

const section = await getSectionBySlug(db, Astro.params.collection!);
// Not a section: render the real 404 page, not an empty listing for an
// arbitrary path.
if (!section) return Astro.rewrite("/404");

const subs = await listSubcategories(db, section.id);
const wantedKey = Astro.url.searchParams.get("category");
const activeSub = wantedKey ? subs.find((s) => subKey(s) === wantedKey) ?? null : null;

const PER_PAGE = 12;
const requested = Number(Astro.url.searchParams.get("page") ?? "1");
const paged = await listPublishedPageBySection(
  db, section.id, Number.isFinite(requested) ? requested : 1, PER_PAGE, activeSub?.id ?? null
);

// One URL per listing. Anything that isn't the canonical form — ?page=1,
// ?page=abc, an out-of-range page, an unknown ?category= — redirects to it.
const base = `/${section.slug}`;
const pagePath = (n: number) => {
  const q = new URLSearchParams();
  if (activeSub) q.set("category", subKey(activeSub));
  if (n > 1) q.set("page", String(n));
  const qs = q.toString();
  return qs ? `${base}?${qs}` : base;
};
const canonicalPath = pagePath(paged.page);
const touched = Astro.url.searchParams.has("page") || Astro.url.searchParams.has("category");
if (touched && Astro.url.pathname + Astro.url.search !== canonicalPath) {
  return Astro.redirect(canonicalPath, 302);
}
const pageUrl = (n: number) => `${SITE}${pagePath(n)}`;

const cards = paged.items.map((p) => ({
  title: p.title,
  href: `${base}/${p.slug}`,
  image: thumbnailFor(p),
  excerpt: excerptFor(p),
  tags: tagsOf(p).slice(0, 2),
  date: displayDate(p.published_at),
  iso: isoDate(p.published_at),
  minutes: readingMinutes(p.content_html),
}));

const isBlog = section.id === "blog";
const heading = activeSub ? `${section.title} · ${activeSub.title}` : section.title;
const pageTitle = `${heading}${paged.page > 1 ? ` — page ${paged.page} of ${paged.pages}` : ""} — PixyDust`;

// Blog keeps its Blog schema; every other section is a CollectionPage. Both
// carry the items on this page in order, so they can be discovered without
// crawling every card.
const jsonLd = JSON.stringify({
  "@type": isBlog ? "Blog" : "CollectionPage",
  "@id": `${SITE}${base}#${isBlog ? "blog" : "collection"}`,
  url: pageUrl(paged.page),
  name: isBlog ? "PixyDust Blog" : section.title,
  description: section.blurb,
  publisher: { "@id": `${SITE}/#organization` },
  [isBlog ? "blogPost" : "hasPart"]: cards.map((c) => ({
    "@type": isBlog ? "BlogPosting" : "Article",
    headline: c.title,
    url: `${SITE}${c.href}`,
    datePublished: c.iso,
    ...(c.image ? { image: c.image } : {}),
  })),
});

const layout = section.index_template; // default | list | gallery
---

<AppShell
  title={pageTitle}
  description={section.blurb || `${section.title} from PixyDust.`}
  ogImage={cards[0]?.image ?? undefined}
  jsonLd={jsonLd}
  canonical={pageUrl(paged.page)}
  prevUrl={paged.page > 1 ? pageUrl(paged.page - 1) : undefined}
  nextUrl={paged.page < paged.pages ? pageUrl(paged.page + 1) : undefined}
  credits={Astro.locals.user?.credits ?? 47}
>
  <div class="mx-auto w-full" style="max-width:1180px;padding:28px;">
    <PageHeader kicker={`PixyDust · ${section.title}`} title={heading} sub={activeSub?.blurb || section.blurb} />

    {subs.length > 0 && (
      <nav class="pd-subnav mb-6 flex flex-wrap gap-2" aria-label={`${section.title} categories`}>
        <a href={base} class={`pd-chip ${activeSub ? "" : "is-on"}`}>All</a>
        {subs.map((s) => (
          <a href={`${base}?category=${subKey(s)}`} class={`pd-chip ${activeSub?.id === s.id ? "is-on" : ""}`}>{s.title}</a>
        ))}
      </nav>
    )}

    {cards.length === 0 ? (
      <div class="rounded-2xl text-center text-ink-3"
        style="padding:56px 24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:13.5px;">
        Nothing here yet — check back soon.
      </div>
    ) : layout === "list" ? (
      <div class="flex flex-col gap-2">
        {cards.map((c, i) => (
          <a href={c.href} class="pd-reveal flex items-center gap-4 rounded-xl"
            style={`--i:${i};padding:14px 16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);text-decoration:none;`}>
            {c.image && (
              <img src={c.image} alt="" width="112" height="63" loading="lazy" decoding="async"
                style="flex:none;width:112px;aspect-ratio:16/9;object-fit:cover;border-radius:8px;background:var(--pd-bg3);" />
            )}
            <div class="min-w-0 flex-1">
              <div class="font-display font-semibold text-ink" style="font-size:15px;letter-spacing:-0.25px;line-height:1.3;">{c.title}</div>
              <p class="mt-1 text-ink-3" style="font-size:12.5px;line-height:1.5;">{c.excerpt}</p>
            </div>
            {c.iso && <time datetime={c.iso} class="shrink-0 text-ink-4" style="font-size:11px;">{c.date}</time>}
          </a>
        ))}
      </div>
    ) : (
      <div class="grid gap-5"
        style={`grid-template-columns:repeat(auto-fill,minmax(${layout === "gallery" ? "340px" : "300px"},1fr));`}>
        {cards.map((c, i) => (
          <article class="pd-reveal flex flex-col overflow-hidden rounded-2xl"
            style={`--i:${i};background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);`}>
            <a href={c.href} style="text-decoration:none;display:block;">
              {c.image ? (
                <img src={c.image} alt={c.title} width="600" height="338" loading={i < 3 ? "eager" : "lazy"} decoding="async"
                  style={`display:block;width:100%;aspect-ratio:${layout === "gallery" ? "4/3" : "16/9"};object-fit:cover;background:var(--pd-bg3);`} />
              ) : (
                <div style={`width:100%;aspect-ratio:${layout === "gallery" ? "4/3" : "16/9"};background:linear-gradient(135deg,color-mix(in srgb,var(--pd-lilac) 26%,transparent),var(--pd-bg3));`} />
              )}
            </a>
            <div class="flex flex-1 flex-col" style="padding:18px 18px 20px;">
              {c.tags.length > 0 && (
                <div class="mb-2 flex flex-wrap gap-1.5">
                  {c.tags.map((t) => (
                    <span class="font-mono uppercase"
                      style="font-size:9.5px;letter-spacing:1px;color:var(--pd-lilac);border:0.5px solid color-mix(in srgb,var(--pd-lilac) 38%,transparent);border-radius:999px;padding:2px 8px;">{t}</span>
                  ))}
                </div>
              )}
              <h2 class="font-display font-semibold text-ink" style="font-size:17px;letter-spacing:-0.3px;line-height:1.25;">
                <a href={c.href} style="color:inherit;text-decoration:none;">{c.title}</a>
              </h2>
              <p class="mt-2 flex-1 text-ink-2" style="font-size:13px;line-height:1.55;">{c.excerpt}</p>
              <div class="mt-3 flex items-center gap-2 text-ink-4" style="font-size:11.5px;">
                {c.iso && <time datetime={c.iso}>{c.date}</time>}
                <span>·</span>
                <span>{c.minutes} min read</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <Pagination page={paged.page} pages={paged.pages} total={paged.total} perPage={paged.perPage}
      base={activeSub ? `${base}?category=${subKey(activeSub)}` : base} noun={section.noun} />
  </div>
</AppShell>

<style is:global>
  .pd-chip {
    display: inline-flex; align-items: center; padding: 6px 13px; border-radius: 999px;
    font-size: 12px; font-weight: 600; letter-spacing: -0.1px; text-decoration: none;
    color: var(--pd-ink2); background: var(--pd-bg2); border: 0.5px solid var(--pd-hairline2);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pd-chip:hover { color: var(--pd-ink); border-color: var(--pd-hairline3); transform: translateY(-1px); }
  .pd-chip.is-on { color: #fff; border-color: transparent; background: linear-gradient(115deg, #7C3AED, #EC4899); }
  @media (prefers-reduced-motion: reduce) { .pd-chip:hover { transform: none; } }
</style>

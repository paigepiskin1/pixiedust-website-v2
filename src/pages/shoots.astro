---
export const prerender = false;
import AppShell from "../layouts/AppShell.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import FeatureBanner from "../components/home/FeatureBanner.astro";
import FilterableCatalog from "../components/catalog/FilterableCatalog.astro";
import { listTemplates, templateToCard } from "../lib/templates";
import { SHOOT_CATS, deriveCats } from "../lib/catalog";

const db = Astro.locals.runtime.env.DB;
const items = (await listTemplates(db, { kind: "shoot" })).map(templateToCard);
const cats = deriveCats(SHOOT_CATS, items);
---

<AppShell title="AI Photoshoots — PixieDust" description="Studio-quality AI photoshoots without a camera. 100+ styles: fashion editorial, professional headshots, lifestyle and more." credits={Astro.locals.user?.credits ?? 47}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <PageHeader
      kicker="Themed packs · 12–30 frames"
      title="AI Photoshoots"
      sub="Pick a vibe. We generate a full shoot of you — no model training, no setup."
    />
    <div class="mb-7">
      <FeatureBanner
        tone="lilac"
        kicker="Tattoo Studio · Preview first"
        title={"See the ink.\nBefore the needle."}
        sub="Style · placement · size · color"
        ctaLabel="Open Tattoo Studio"
        accent="var(--pd-lilac)"
        href="/avatar"
        height={240}
      />
    </div>
    <FilterableCatalog items={items} categories={cats} aspect="1 / 1.3" />
  </div>
</AppShell>

---
export const prerender = false;
import AppShell from "../../../layouts/AppShell.astro";
import HelpIcon from "../../../components/help/HelpIcon.astro";
import { getArticle, articleHref, HELP_SUPPORT_EMAIL } from "../../../lib/help";

const user = Astro.locals.user;
const { category: categoryId, slug } = Astro.params;
const found = categoryId && slug ? getArticle(categoryId, slug) : null;
if (!found) return Astro.redirect("/support");
const { category, article } = found;
const related = category.articles.filter((a) => a.slug !== article.slug).slice(0, 4);
---

<AppShell
  title={`${article.title} — Help Center — PixyDust`}
  description={article.summary}
  credits={user?.credits ?? 47}
>
  <div class="mx-auto w-full" style="max-width:760px;padding:28px;">
    <!-- Breadcrumb -->
    <nav class="mb-5 flex flex-wrap items-center gap-1.5 font-mono uppercase" style="font-size:10px;color:var(--pd-ink4);letter-spacing:0.6px;">
      <a href="/support" class="pd-crumb">Help Center</a>
      <span><HelpIcon name="chevron" size={11} /></span>
      <a href={`/support/${category.id}`} class="pd-crumb">{category.title}</a>
      <span><HelpIcon name="chevron" size={11} /></span>
      <span style="color:var(--pd-ink2);">{article.title}</span>
    </nav>

    <article>
      <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;line-height:1.1;">{article.title}</h1>
      <p class="mt-2.5 text-ink-3" style="font-size:15px;line-height:1.5;">{article.summary}</p>

      <div class="mt-7 flex flex-col gap-4" style="padding-bottom:8px;">
        {
          article.body.map((node) =>
            typeof node === "string" ? (
              <p class="text-ink-2" style="font-size:14.5px;line-height:1.7;letter-spacing:-0.05px;">{node}</p>
            ) : "h" in node ? (
              <h2 class="mt-2 font-display font-semibold text-ink" style="font-size:17px;letter-spacing:-0.3px;">{node.h}</h2>
            ) : "list" in node ? (
              <ul class="flex list-none flex-col gap-2 p-0">
                {node.list.map((li) => (
                  <li class="flex items-start gap-[11px] text-ink-2" style="font-size:14.5px;line-height:1.55;letter-spacing:-0.05px;">
                    <span class="mt-[9px] size-[5px] shrink-0 rounded-full" style="background:var(--pd-lilac);" />
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            ) : "steps" in node ? (
              <ol class="flex list-none flex-col gap-2.5 p-0">
                {node.steps.map((st, i) => (
                  <li class="flex items-start gap-3 text-ink-2" style="font-size:14.5px;line-height:1.5;letter-spacing:-0.05px;">
                    <span
                      class="mt-px inline-flex size-[22px] shrink-0 items-center justify-center rounded-full font-mono font-semibold"
                      style="background:color-mix(in srgb, var(--pd-lilac) 16%, transparent);color:var(--pd-lilac);font-size:11px;"
                    >
                      {i + 1}
                    </span>
                    <span style="padding-top:1px;">{st}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="rounded-xl" style="padding:14px 16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-left:2px solid var(--pd-lilac);">
                <div class="mb-1 font-mono font-semibold uppercase" style="font-size:9.5px;color:var(--pd-lilac);letter-spacing:0.8px;">Good to know</div>
                <div class="text-ink-2" style="font-size:13.5px;line-height:1.6;letter-spacing:-0.05px;">{node.note}</div>
              </div>
            )
          )
        }
      </div>

      <!-- Was this helpful -->
      <div
        id="help-feedback"
        class="mt-8 flex flex-wrap items-center gap-3 rounded-2xl"
        style="padding:16px 20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);"
      >
        <span class="text-ink-2" style="font-size:13.5px;font-weight:500;">Was this helpful?</span>
        <div class="flex items-center gap-2">
          <button type="button" class="pd-vote rounded-[9px] font-semibold text-ink" data-vote="yes" style="padding:7px 14px;background:transparent;border:0.5px solid var(--pd-hairline2);cursor:pointer;font-size:12.5px;">Yes</button>
          <button type="button" class="pd-vote rounded-[9px] font-semibold text-ink" data-vote="no" style="padding:7px 14px;background:transparent;border:0.5px solid var(--pd-hairline2);cursor:pointer;font-size:12.5px;">No</button>
        </div>
        <span id="help-vote-thanks" class="hidden text-ink-3" style="font-size:12.5px;">Thanks for the feedback!</span>
      </div>
    </article>

    {
      related.length > 0 && (
        <div class="mt-9">
          <div class="mb-3 font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.8px;">More in {category.title}</div>
          <div class="flex flex-col gap-2">
            {related.map((a) => (
              <a
                href={articleHref(category.id, a.slug)}
                class="pd-help-row group flex items-center gap-3 rounded-xl"
                style="padding:13px 16px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);"
              >
                <span class="shrink-0 text-ink-3"><HelpIcon name="book" size={15} /></span>
                <span class="min-w-0 flex-1 truncate font-medium text-ink" style="font-size:13.5px;letter-spacing:-0.1px;">{a.title}</span>
                <span class="shrink-0 text-ink-4 transition-transform group-hover:translate-x-0.5"><HelpIcon name="chevron" size={13} /></span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <div
      class="mt-9 flex flex-wrap items-center justify-between gap-4 rounded-2xl"
      style="padding:20px 22px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);"
    >
      <div class="text-ink-3" style="font-size:13px;line-height:1.5;">Still stuck? Reach the team directly.</div>
      <div class="flex items-center gap-2.5">
        <a href="/feedback" class="rounded-[10px] font-semibold text-ink" style="padding:9px 15px;background:transparent;border:0.5px solid var(--pd-hairline2);font-size:12.5px;">Send feedback</a>
        <a href={`mailto:${HELP_SUPPORT_EMAIL}`} class="rounded-[10px] font-bold" style="padding:9px 15px;background:var(--pd-lilac);color:#0A0A0B;font-size:12.5px;">Contact support</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const wrap = document.getElementById("help-feedback");
      if (!wrap) return;
      const thanks = document.getElementById("help-vote-thanks");
      wrap.querySelectorAll(".pd-vote").forEach((btn) => {
        btn.addEventListener("click", () => {
          wrap.querySelectorAll(".pd-vote").forEach((b) => {
            b.style.opacity = "0.5";
            b.disabled = true;
          });
          btn.style.opacity = "1";
          btn.style.borderColor = "var(--pd-lilac)";
          btn.style.color = "var(--pd-lilac)";
          if (thanks) thanks.classList.remove("hidden");
        });
      });
    })();
  </script>

  <style>
    .pd-help-row:hover { background: var(--pd-bg3) !important; border-color: var(--pd-hairline2) !important; }
    .pd-crumb:hover { color: var(--pd-ink2); }
  </style>
</AppShell>

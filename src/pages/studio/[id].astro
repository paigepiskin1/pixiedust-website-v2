---
// The 3-column generation workspace, wired to /api/generate + SyncNode.
export const prerender = false;
import AppShell from "../../layouts/AppShell.astro";
import Pill from "../../components/ui/Pill.astro";
import Media from "../../components/ui/Media.astro";
import CreditChip from "../../components/ui/CreditChip.astro";
import FieldPanel from "../../components/FieldPanel.astro";
import { getTemplate, allFields, computeCost, listTemplates } from "../../lib/templates";

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;
const template = id ? await getTemplate(db, id) : null;
if (!template) return new Response(null, { status: 302, headers: { Location: "/" } });

// Other templates the user can jump to without leaving the studio.
const switchList = await listTemplates(db, { isAdmin: false });

const fields = allFields(template);
const accent = template.accent ?? "var(--pd-lilac)";

// Optional rich studio content stored in the template's `meta` JSON:
//   { "kicker": "Outfit try-on", "howItWorks": ["Upload your photos", ...] }
// When present, the left column uses a Beauty-style intro (title + sub above
// the preview, plus a numbered How it works panel).
let howItWorks: string[] = [];
let studioKicker = "";
try {
  const m = template.meta ? JSON.parse(template.meta) : null;
  if (m && Array.isArray(m.howItWorks)) howItWorks = m.howItWorks.filter((s: unknown) => typeof s === "string").slice(0, 6);
  if (m && typeof m.kicker === "string") studioKicker = m.kicker.trim();
} catch { /* meta isn't JSON — ignore */ }
const studioIntro = howItWorks.length > 0 || !!studioKicker;
const introSub = template.description || template.subtitle || "";
const credits = Astro.locals.user?.credits ?? 0;
const signedIn = !!Astro.locals.user;

// GPT-Image models (openai/gpt-image-2, gpt-image-1.5, …) on Replicate are
// noticeably slower than the other providers, so warn the user up front.
const usesSlowModel =
  /gpt-image/i.test(template.model) ||
  (template.steps ?? []).some((s) => /gpt-image/i.test(s.model ?? ""));
const baseCost = computeCost(template, { quantity: template.quantities?.[0] ?? 1, duration: template.durations?.[0] });
const qualityKeys = template.quality ? Object.keys(template.quality) : [];
const qualityLabels: Record<string, string> = { std: "Standard", pro: "Pro", cinema: "Cinema" };
// Default to the base tier (multiplier 1) so the standard option is preselected
// regardless of key order; fall back to the first key.
const defaultQualityKey = qualityKeys.find((k) => template.quality![k] === 1) ?? qualityKeys[0];

// Small proportional preview box (max 18px) for an "W:H" aspect ratio.
function aspectBox(a: string): { w: number; h: number } {
  const [w, h] = a.split(":").map(Number);
  const max = 18;
  if (!w || !h) return { w: max, h: max };
  return w >= h ? { w: max, h: Math.max(6, Math.round((max * h) / w)) } : { w: Math.max(6, Math.round((max * w) / h)), h: max };
}

function formatAccept(accept: string | undefined): string {
  if (!accept) return "";
  return accept.split(",").map(s => {
    s = s.trim();
    if (s.startsWith("image/")) return s.slice(6).toUpperCase();
    if (s.startsWith("video/")) return s.slice(6).toUpperCase();
    if (s.startsWith(".")) return s.slice(1).toUpperCase();
    return s;
  }).slice(0, 5).join(", ");
}

const config = {
  id: template.id,
  type: template.type,
  creditCost: template.creditCost,
  pricePerSecond: template.pricePerSecond,
  durations: template.durations,
  quality: template.quality,
  credits,
  signedIn,
};
---

<AppShell title={`${template.title} — PixieDust`} credits={credits}>
  <div class="mx-auto w-full" style="max-width:1480px;padding:28px;">
    <div class="grid gap-6 lg:grid-cols-[300px_minmax(0,1fr)_minmax(0,1fr)] lg:[grid-auto-rows:1fr] lg:min-h-[calc(100vh-128px)]">
      <!-- LEFT: template card -->
      <aside class="lg:sticky lg:top-[88px] lg:self-start">
        <!-- Switch template (opens gallery modal) -->
        <button type="button" id="pd-switch-btn" class="mb-3 flex w-full items-center justify-between gap-2 rounded-xl text-ink" style="padding:10px 13px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline2);cursor:pointer;font-size:13px;">
          <span class="flex min-w-0 items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
            <span class="truncate">Switch template</span>
          </span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5 6 7.5l3-3"/></svg>
        </button>

        {studioIntro ? (
          <>
            {(studioKicker || template.kind) && (
              <div class="mb-[7px] flex items-center gap-[7px]">
                <span class="inline-block shrink-0 rounded-full" style={`width:5px;height:5px;background:${accent === "var(--pd-lilac)" ? "var(--pd-mint)" : accent};box-shadow:0 0 10px color-mix(in srgb,${accent === "var(--pd-lilac)" ? "var(--pd-mint)" : accent} 50%,transparent);`}></span>
                <span class="font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:1.1px;">{studioKicker || template.kind}</span>
              </div>
            )}
            <h1 class="font-display font-medium text-ink" style="font-size:30px;letter-spacing:-0.8px;line-height:1.05;">{template.title}</h1>
            {introSub && (
              <p class="mt-2 text-ink-3" style="font-size:13px;line-height:1.5;">{introSub}</p>
            )}
            <div class="mt-3 overflow-hidden rounded-[18px]" style="border:0.5px solid var(--pd-hairline);aspect-ratio:3/4;background:var(--pd-bg2);">
              {
                template.previewVideo ? (
                  <video src={template.previewVideo} muted loop autoplay playsinline class="h-full w-full object-cover" />
                ) : template.previewImage ? (
                  <img src={template.previewImage} alt={template.title} class="h-full w-full object-cover" />
                ) : (
                  <Media tone={template.tone} angle={130} label={template.title} sub={template.kind ?? undefined} />
                )
              }
            </div>
            {howItWorks.length > 0 && (
              <div class="mt-3.5 rounded-2xl" style="padding:15px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
                <div class="mb-2.5 font-mono uppercase" style="font-size:9px;color:var(--pd-ink3);letter-spacing:0.7px;">How it works</div>
                <ol class="flex flex-col gap-2.5" style="list-style:none;padding:0;margin:0;">
                  {howItWorks.map((step, i) => (
                    <li class="flex items-start gap-2.5">
                      <span class="flex shrink-0 items-center justify-center rounded-full font-mono font-semibold" style="width:18px;height:18px;font-size:10px;background:color-mix(in srgb,var(--pd-mint) 18%,transparent);color:var(--pd-mint);margin-top:1px;">{i + 1}</span>
                      <span class="text-ink-2" style="font-size:12px;line-height:1.4;">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </>
        ) : (
          <>
            <div class="overflow-hidden rounded-[20px]" style="border:0.5px solid var(--pd-hairline);aspect-ratio:4/3;background:var(--pd-bg2);">
              {
                template.previewVideo ? (
                  <video src={template.previewVideo} muted loop autoplay playsinline class="h-full w-full object-cover" />
                ) : template.previewImage ? (
                  <img src={template.previewImage} alt={template.title} class="h-full w-full object-cover" />
                ) : (
                  <Media tone={template.tone} angle={130} label={template.title} sub={template.kind ?? undefined} />
                )
              }
            </div>
            <div class="mt-2.5 flex items-center gap-2">
              <Pill color={accent} label={template.kind} />
              {template.type === "video" && <Pill color="var(--pd-pink)" label="Video" />}
            </div>
            <h1 class="mt-1.5 font-display font-medium text-ink" style="font-size:18px;letter-spacing:-0.4px;line-height:1.15;">{template.title}</h1>
            {template.subtitle && <div class="mt-1 text-ink-3" style="font-size:11.5px;line-height:1.4;">{template.subtitle}</div>}
            {template.description && (
              <p class="mt-1.5 text-ink-3" style="font-size:11.5px;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{template.description}</p>
            )}
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {[["ETA", template.eta], ["Cost", `${template.creditCost} cr`], ["Type", template.type]].filter(([, v]) => v).map(([k, v]) => (
                <span class="rounded-md font-mono" style="padding:4px 8px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);font-size:10px;color:var(--pd-ink2);">
                  <span style="color:var(--pd-ink4);">{k}</span> {v}
                </span>
              ))}
            </div>
          </>
        )}
      </aside>

      <!-- CENTER: inputs -->
      <section class="lg:sticky lg:top-[88px] lg:self-start">
        <div class="rounded-2xl" style="padding:20px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div class="mb-3 font-mono uppercase" style="font-size:10px;color:var(--pd-ink3);letter-spacing:0.7px;">Your inputs</div>

          {usesSlowModel && (
            <div class="mb-3.5 flex items-start gap-2 rounded-lg" style="padding:9px 11px;background:color-mix(in srgb, var(--pd-amber) 11%, transparent);border:0.5px solid color-mix(in srgb, var(--pd-amber) 34%, transparent);">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--pd-amber)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px;"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5v4"/><circle cx="8" cy="11" r="0.4" fill="var(--pd-amber)"/></svg>
              <span class="text-ink-2" style="font-size:11.5px;line-height:1.45;">Heads up — this template runs on a higher-quality model that takes a little longer than usual. Hang tight after you hit Generate.</span>
            </div>
          )}

          <FieldPanel fields={fields} id="pd-field-panel" />

          <div class="mt-4 flex flex-col gap-4">
            {template.aspects && template.aspects.length > 0 && (
              <div>
                <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Aspect ratio</span>
                <div class="flex flex-wrap gap-1.5" data-controls="aspect">
                  {template.aspects.map((a, i) => {
                    const isMatch = a === "match" || a === "match_input_image";
                    const b = aspectBox(a);
                    return (
                      <button type="button" class="pd-seg inline-flex items-center gap-1.5 rounded-lg font-mono" data-val={a} data-active={i === 0 ? "true" : "false"} style="padding:6px 11px;font-size:11px;cursor:pointer;">
                        {isMatch ? (
                          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.7;"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="6" cy="7" r="1.1"/><path d="M3 12l3.5-3 2.5 2 2-1.5L13 12"/></svg>
                        ) : (
                          <span style={`display:inline-block;width:${b.w}px;height:${b.h}px;border:1.5px solid currentColor;border-radius:2px;opacity:0.65;`}></span>
                        )}
                        <span>{isMatch ? "Match original" : a}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            {template.durations && template.durations.length > 0 && (
              <div>
                <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Duration{template.pricePerSecond ? ` · ${template.pricePerSecond} cr/sec` : ""}</span>
                <div class="flex flex-wrap gap-1.5" data-controls="duration">
                  {template.durations.map((d, i) => (
                    <button type="button" class="pd-seg rounded-lg font-semibold" data-val={d} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{d}s</button>
                  ))}
                </div>
              </div>
            )}

            {qualityKeys.length > 1 && (
              <div>
                <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Quality</span>
                <div class="flex flex-wrap gap-1.5" data-controls="quality">
                  {qualityKeys.map((q) => (
                    <button type="button" class="pd-seg rounded-lg font-semibold" data-val={q} data-mult={template.quality![q]} data-active={q === defaultQualityKey ? "true" : "false"} style="padding:7px 12px;font-size:11.5px;cursor:pointer;">
                      {qualityLabels[q] ?? q}
                      {template.quality![q] !== 1 && <span style="opacity:0.55;font-weight:400;margin-left:4px;">×{template.quality![q]}</span>}
                    </button>
                  ))}
                </div>
                <span class="mt-1 block text-ink-4" style="font-size:10.5px;">Higher quality adds detail and costs more credits.</span>
              </div>
            )}

            <div>
              <span class="mb-1.5 block font-medium text-ink" style="font-size:12.5px;">Outputs <span class="text-ink-3" style="font-weight:400;">· generated in parallel</span></span>
              <div class="flex flex-wrap gap-1.5" data-controls="quantity">
                {(template.quantities && template.quantities.length > 1 ? template.quantities : template.type === "video" ? [1, 2] : [1, 2, 3, 4]).map((n, i) => (
                  <button type="button" class="pd-seg rounded-lg font-semibold" data-val={n} data-active={i === 0 ? "true" : "false"} style="padding:7px 14px;font-size:12px;cursor:pointer;">{n}</button>
                ))}
              </div>
            </div>
          </div>
          </div>

          <div id="pd-gen-error" class="mt-3 hidden rounded-lg" style="padding:9px 12px;background:color-mix(in srgb, var(--pd-pink) 12%, transparent);border:0.5px solid color-mix(in srgb, var(--pd-pink) 40%, transparent);color:var(--pd-pink);font-size:12.5px;"></div>

          <button id="pd-generate" type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl font-bold" style="padding:13px 16px;background:var(--pd-lilac);color:#0A0A0B;font-size:14px;letter-spacing:-0.1px;cursor:pointer;">
            <span id="pd-gen-label">Generate · {baseCost} cr</span>
          </button>
          <div class="mt-2 text-center font-mono uppercase" style="font-size:9.5px;color:var(--pd-ink4);letter-spacing:0.5px;">
            PixieDust · {template.eta ?? "async"}
          </div>
      </section>

      <!-- RIGHT: output canvas — async jobs feed (each Generate adds a tile).
           Stretches to the column height (default grid stretch) so it never
           leaves an empty gap next to the taller left/center columns. -->
      <section class="flex">
        <div id="pd-output" class="relative w-full overflow-y-auto rounded-[20px]" style="height:100%;min-height:480px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);">
          <div id="pd-out-empty" class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
            <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full" style="background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-ink3)" stroke-width="1.4" stroke-linecap="round"><path d="M10 3v3M10 14v3M3 10h3M14 10h3M5 5l2 2M13 13l2 2M15 5l-2 2M5 15l2-2" /></svg>
            </div>
            <div class="text-ink-3" style="font-size:13px;">Your results appear here. Run as many as you like — they generate in parallel.</div>
          </div>
          <!-- Job tiles get prepended here; newest first. -->
          <div id="pd-jobs" class="grid gap-3" style="padding:14px;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));"></div>
        </div>
      </section>
    </div>
  </div>

  <!-- Switch-template gallery modal -->
  <div id="pd-switch-modal" style="display:none;position:fixed;inset:0;z-index:9998;align-items:flex-start;justify-content:center;background:rgba(0,0,0,0.6);backdrop-filter:blur(8px);padding:5vh 20px;">
    <div class="flex w-full flex-col" style="max-width:1000px;max-height:88vh;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);border-radius:18px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,0.5);">
      <div class="flex items-center gap-3" style="padding:15px 18px;border-bottom:0.5px solid var(--pd-hairline);">
        <span class="font-display font-medium text-ink" style="font-size:16px;white-space:nowrap;">Switch template</span>
        <input id="pd-switch-search" type="text" placeholder="Search templates…" autocomplete="off" class="min-w-0 flex-1 rounded-lg text-ink outline-none" style="padding:9px 12px;background:var(--pd-bg);border:0.5px solid var(--pd-hairline2);font-size:13px;" />
        <button id="pd-switch-close" type="button" class="flex size-8 shrink-0 items-center justify-center rounded-full text-ink-2" style="background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);cursor:pointer;font-size:13px;" aria-label="Close">✕</button>
      </div>
      <div id="pd-switch-grid" style="overflow-y:auto;padding:16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;">
        {switchList.map((t) => (
          <a href={`/studio/${t.id}`} class="pd-sw-card" data-name={`${t.title} ${t.category ?? ""} ${t.kind} ${t.tags.join(" ")}`.toLowerCase()} data-current={t.id === template.id ? "true" : "false"} style="text-decoration:none;color:var(--pd-ink);border-radius:14px;border:0.5px solid var(--pd-hairline);background:var(--pd-bg);display:flex;flex-direction:column;">
            <div style="position:relative;height:150px;background:var(--pd-bg3);overflow:hidden;border-radius:14px 14px 0 0;flex:none;">
              {t.previewVideo ? (
                <video class="pd-autoplay" src={t.previewVideo} poster={t.previewImage ?? undefined} muted loop autoplay playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover;" />
              ) : t.previewImage ? (
                <img src={t.previewImage} alt={t.title} loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
              ) : (
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--pd-ink4);">{t.title.slice(0, 1).toUpperCase()}</div>
              )}
              {t.type === "video" && <span style="position:absolute;top:6px;left:6px;padding:2px 6px;border-radius:5px;background:rgba(0,0,0,0.6);color:#fff;font-size:8.5px;letter-spacing:0.5px;">VIDEO</span>}
              {t.id === template.id && <span style="position:absolute;top:6px;right:6px;padding:2px 6px;border-radius:5px;background:var(--pd-lilac);color:#0A0A0B;font-size:8.5px;font-weight:700;letter-spacing:0.5px;">CURRENT</span>}
            </div>
            <div class="truncate" style="padding:8px 10px;font-size:12px;font-weight:500;">{t.title}</div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <script type="application/json" id="pd-config" is:inline set:html={JSON.stringify(config)}></script>

  <style>
    .pd-seg { background: var(--pd-bg); color: var(--pd-ink-2, var(--pd-ink2)); border: 0.5px solid var(--pd-hairline2); }
    .pd-seg[data-active="true"] { background: var(--pd-ink); color: var(--pd-bg); border-color: transparent; }
    @keyframes pd-spin { to { transform: rotate(360deg); } }
    #pd-switch-btn:hover { border-color: var(--pd-hairline3); }
    .pd-sw-card { transition: transform 0.12s, border-color 0.12s; }
    .pd-sw-card:hover { transform: translateY(-2px); border-color: var(--pd-hairline3); }
    .pd-sw-card[data-current="true"] { outline: 2px solid var(--pd-lilac); outline-offset: -1px; }
  </style>

  <script>
    const cfg = JSON.parse(document.getElementById("pd-config")!.textContent || "{}");
    const root = document;
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;

    let credits: number = Number(cfg.credits) || 0;
    // How many jobs are currently in flight (submitted + still polling). Drives
    // the "you already have N running — queue more?" confirm before re-charging.
    let activeJobs = 0;

    // Bunny Optimizer serves an optimized image by default; `?format=source`
    // fetches the original, full-quality file for downloads.
    function sourceUrl(u: string): string {
      if (!u || !/\.b-cdn\.net\//.test(u)) return u;
      return u + (u.includes("?") ? "&" : "?") + "format=source";
    }

    function controlValue(group: string): string | null {
      const wrap = root.querySelector(`[data-controls="${group}"]`);
      if (!wrap) return null;
      const active = wrap.querySelector<HTMLElement>('.pd-seg[data-active="true"]');
      return active?.dataset.val ?? null;
    }
    function qualityMult(): number {
      const q = controlValue("quality");
      if (q && cfg.quality && cfg.quality[q]) return Number(cfg.quality[q]);
      return 1;
    }
    function quantity(): number {
      return Number(controlValue("quantity")) || 1;
    }
    function duration(): number {
      return Number(controlValue("duration")) || (cfg.durations && cfg.durations[0]) || 0;
    }
    function unitCost(): number {
      const base = cfg.pricePerSecond && duration() ? Number(cfg.pricePerSecond) * duration() : Number(cfg.creditCost);
      return Math.ceil(base * qualityMult());
    }
    function cost(): number {
      // Total for the button: one charge per parallel output.
      return unitCost() * quantity();
    }

    const genBtn = $("#pd-generate") as HTMLButtonElement;
    const genLabel = $("#pd-gen-label");
    function refreshButton() {
      const c = cost();
      if (!cfg.signedIn) {
        genLabel.textContent = "Sign in to generate";
        return;
      }
      if (credits < c) {
        genLabel.textContent = `Get more credits · need ${c} cr`;
        genBtn.style.background = "transparent";
        genBtn.style.color = "var(--pd-ink)";
        genBtn.style.border = "0.5px solid var(--pd-hairline2)";
      } else {
        genLabel.textContent = `Generate · ${c} cr`;
        genBtn.style.background = "var(--pd-lilac)";
        genBtn.style.color = "#0A0A0B";
        genBtn.style.border = "none";
      }
    }

    // segmented controls
    root.querySelectorAll<HTMLElement>("[data-controls]").forEach((wrap) => {
      wrap.querySelectorAll<HTMLElement>(".pd-seg").forEach((btn) => {
        btn.addEventListener("click", () => {
          wrap.querySelectorAll<HTMLElement>(".pd-seg").forEach((b) => b.setAttribute("data-active", String(b === btn)));
          refreshButton();
        });
      });
    });

    // File URLs populated by FieldPanel's shared upload logic (pdInitFieldPanel).
    // Wait for FieldPanel to auto-init (it runs on DOMContentLoaded via its own script).
    const fieldPanel = document.getElementById("pd-field-panel") as HTMLElement;
    const fileUrls: Record<string, string | string[]> = (fieldPanel as any)?._pdFileUrls ?? {};

    function collectInputs(): Record<string, unknown> {
      return (window as any).pdCollectFieldValues?.(fieldPanel, fileUrls) ?? {};
    }

    const errEl = $("#pd-gen-error");
    const emptyEl = $("#pd-out-empty");
    const jobsEl = $("#pd-jobs");
    const isVideo = cfg.type === "video";

    function showError(msg: string) {
      errEl.textContent = msg;
      errEl.classList.remove("hidden");
    }

    // Humanize provider errors and make clear the user wasn't charged. Most
    // failures (e.g. the model's safety filter) aren't the user's fault.
    function friendlyError(raw: unknown): string {
      const e = String(raw ?? "").replace(/\s*\(refunded\)\s*$/i, "");
      if (/e005|flagged as sensitive|safety|moderation|content policy|nsfw|sensitive/i.test(e))
        return "The model's safety filter blocked this — it often triggers on real faces or sensitive content. You weren't charged; try a different photo or prompt.";
      if (/rate limit|slow down/i.test(e)) return "Too many requests right now. You weren't charged — try again in a minute.";
      if (/timeout|timed out/i.test(e)) return "This took too long and timed out. You weren't charged — try again.";
      if (/not enough credits/i.test(e)) return "Not enough credits.";
      return (e || "Generation failed") + " — you weren't charged.";
    }

    // ── Lightbox ──
    let lbEl: HTMLElement | null = null;
    let lbList: string[] = [];
    let lbCur = 0;
    let lbIsVideo = false;

    function buildLb() {
      if (lbEl) return;
      lbEl = document.createElement("div");
      lbEl.style.cssText = "display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.92);backdrop-filter:blur(16px);align-items:center;justify-content:center;cursor:zoom-out;";
      lbEl.innerHTML =
        '<div id="pd-lb-wrap" style="position:relative;cursor:default;display:flex;align-items:center;justify-content:center;">' +
          '<div id="pd-lb-media" style="display:flex;align-items:center;justify-content:center;"></div>' +
        '</div>' +
        '<div id="pd-lb-dl" style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);"></div>' +
        '<button id="pd-lb-close" style="position:fixed;top:14px;right:14px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.12);backdrop-filter:blur(4px);border:0.5px solid rgba(255,255,255,.18);color:#fff;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;" aria-label="Close">✕</button>' +
        '<button id="pd-lb-prev" style="position:fixed;left:14px;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.12);backdrop-filter:blur(4px);border:0.5px solid rgba(255,255,255,.18);color:#fff;font-size:22px;cursor:pointer;display:none;align-items:center;justify-content:center;">‹</button>' +
        '<button id="pd-lb-next" style="position:fixed;right:14px;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.12);backdrop-filter:blur(4px);border:0.5px solid rgba(255,255,255,.18);color:#fff;font-size:22px;cursor:pointer;display:none;align-items:center;justify-content:center;">›</button>';
      document.body.appendChild(lbEl);

      document.getElementById("pd-lb-wrap")!.addEventListener("click", e => e.stopPropagation());
      lbEl.addEventListener("click", closeLb);
      document.getElementById("pd-lb-close")!.addEventListener("click", closeLb);
      document.getElementById("pd-lb-prev")!.addEventListener("click", e => { e.stopPropagation(); lbGo(lbCur - 1); });
      document.getElementById("pd-lb-next")!.addEventListener("click", e => { e.stopPropagation(); lbGo(lbCur + 1); });
      document.addEventListener("keydown", e => {
        if (!lbEl || lbEl.style.display !== "flex") return;
        if (e.key === "Escape") closeLb();
        if (e.key === "ArrowLeft") lbGo(lbCur - 1);
        if (e.key === "ArrowRight") lbGo(lbCur + 1);
      });
    }

    function lbGo(idx: number) {
      buildLb();
      lbCur = Math.max(0, Math.min(idx, lbList.length - 1));
      const url = lbList[lbCur];
      const mediaEl = document.getElementById("pd-lb-media")!;
      const dlEl = document.getElementById("pd-lb-dl")!;
      const prevBtn = document.getElementById("pd-lb-prev") as HTMLButtonElement;
      const nextBtn = document.getElementById("pd-lb-next") as HTMLButtonElement;

      // Pause any previous video
      mediaEl.querySelector("video")?.pause();
      mediaEl.innerHTML = "";

      if (lbIsVideo) {
        const v = document.createElement("video");
        v.src = url; v.controls = true; v.autoplay = true; v.playsInline = true; v.loop = true;
        v.style.cssText = "max-width:min(94vw,1080px);max-height:86vh;border-radius:14px;display:block;";
        mediaEl.appendChild(v);
      } else {
        const img = document.createElement("img");
        img.src = url;
        img.style.cssText = "max-width:min(94vw,1200px);max-height:86vh;border-radius:14px;display:block;object-fit:contain;";
        mediaEl.appendChild(img);
      }

      dlEl.innerHTML = "";
      const a = document.createElement("a");
      a.href = sourceUrl(url); a.download = "";
      a.textContent = "↓ Download";
      a.style.cssText = "padding:8px 18px;border-radius:10px;background:rgba(255,255,255,.13);backdrop-filter:blur(6px);border:0.5px solid rgba(255,255,255,.2);color:#fff;font-size:12.5px;text-decoration:none;display:inline-block;";
      dlEl.appendChild(a);

      prevBtn.style.display = lbList.length > 1 ? "flex" : "none";
      nextBtn.style.display = lbList.length > 1 ? "flex" : "none";
      (prevBtn as HTMLElement).style.opacity = lbCur > 0 ? "1" : "0.3";
      (nextBtn as HTMLElement).style.opacity = lbCur < lbList.length - 1 ? "1" : "0.3";

      lbEl!.style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    function openLb(urls: string[], startIdx = 0, video = false) {
      lbList = urls; lbIsVideo = video;
      lbGo(startIdx);
    }

    function closeLb() {
      if (lbEl) { lbEl.style.display = "none"; lbEl.querySelector("video")?.pause(); }
      document.body.style.overflow = "";
    }

    // Each Generate click spawns an independent job tile that polls on its own,
    // so users can queue many generations in parallel (async). The button is
    // never disabled.
    function createTile(): HTMLElement {
      emptyEl.classList.add("hidden");
      const tile = document.createElement("div");
      tile.className = "pd-job";
      tile.style.cssText = "position:relative;aspect-ratio:1/1.1;border-radius:14px;overflow:hidden;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);";
      tile.innerHTML =
        '<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:14px;text-align:center;">' +
        '<div style="width:30px;height:30px;border-radius:50%;border:3px solid var(--pd-hairline2);border-top-color:var(--pd-lilac);animation:pd-spin .8s linear infinite;"></div>' +
        '<div class="pd-job-stage font-mono uppercase" style="font-size:9.5px;letter-spacing:.7px;color:var(--pd-ink2);">Submitting…</div>' +
        '<div style="height:4px;width:80%;background:var(--pd-hairline2);border-radius:999px;overflow:hidden;"><div class="pd-job-bar" style="height:100%;width:8%;background:var(--pd-lilac);transition:width .5s;"></div></div>' +
        "</div>";
      jobsEl.prepend(tile);
      return tile;
    }

    function tileStage(tile: HTMLElement, text: string, pct: number) {
      const s = tile.querySelector<HTMLElement>(".pd-job-stage");
      if (s) s.textContent = text;
      const b = tile.querySelector<HTMLElement>(".pd-job-bar");
      if (b) b.style.width = pct + "%";
    }

    function tileFail(tile: HTMLElement, msg: string) {
      tile.innerHTML =
        '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:14px;text-align:center;color:var(--pd-pink);font-size:11.5px;line-height:1.4;"></div>';
      (tile.firstElementChild as HTMLElement).textContent = msg;
    }

    function tileResult(tile: HTMLElement, outputs: string[], genId?: string) {
      tile.innerHTML = "";
      tile.style.cursor = "zoom-in";
      const wrap = document.createElement("div");
      wrap.style.cssText = `display:grid;gap:4px;width:100%;height:100%;grid-template-columns:repeat(${outputs.length > 1 ? 2 : 1},1fr);`;
      outputs.forEach((url, i) => {
        const cell = document.createElement("div");
        cell.style.cssText = "position:relative;overflow:hidden;cursor:zoom-in;";
        const el = isVideo ? document.createElement("video") : document.createElement("img");
        el.src = url;
        if (isVideo) {
          const v = el as HTMLVideoElement;
          v.playsInline = true;
          v.muted = true;
          v.loop = true;
          v.autoplay = true;
        }
        el.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;";
        cell.appendChild(el);
        cell.addEventListener("click", () => openLb(outputs, i, isVideo));
        wrap.appendChild(cell);
      });
      tile.appendChild(wrap);

      // Expand icon (top-right)
      const expandBtn = document.createElement("button");
      expandBtn.type = "button";
      expandBtn.title = "View fullscreen";
      expandBtn.innerHTML = `<svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M7 1h3v3M10 1 6.5 4.5M4 10H1V7M1 10l3.5-3.5"/></svg>`;
      expandBtn.style.cssText = "position:absolute;top:7px;right:7px;width:24px;height:24px;border-radius:6px;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:1;";
      expandBtn.addEventListener("click", e => { e.stopPropagation(); openLb(outputs, 0, isVideo); });
      tile.appendChild(expandBtn);

      // Download (uses protected endpoint when genId available, else direct CDN)
      if (outputs[0]) {
        const dl = document.createElement("a");
        dl.href = genId ? `/api/download?id=${encodeURIComponent(genId)}` : sourceUrl(outputs[0]);
        if (!genId) dl.setAttribute("download", "");
        dl.title = "Download";
        dl.textContent = "↓";
        dl.style.cssText = "position:absolute;right:7px;bottom:7px;width:24px;height:24px;border-radius:6px;background:rgba(10,10,11,.7);backdrop-filter:blur(6px);color:#fff;font-size:14px;text-decoration:none;display:flex;align-items:center;justify-content:center;z-index:1;";
        tile.appendChild(dl);
      }
    }

    async function poll(id: string, tile: HTMLElement): Promise<void> {
      const stages = ["Reading your inputs", "Running the model", "Refining", "Almost there"];
      let tick = 0;
      while (true) {
        await new Promise((r) => setTimeout(r, 2000));
        tick++;
        let data: any;
        try {
          data = await (await fetch(`/api/generate/status?id=${id}`)).json();
        } catch {
          continue; // transient; keep polling
        }
        if (data.steps > 1 && data.step) tileStage(tile, `Step ${data.step}/${data.steps}…`, Math.min(12 + tick * 10, 92));
        else tileStage(tile, stages[Math.min(tick, stages.length - 1)] + "…", Math.min(12 + tick * 14, 92));
        if (data.status === "completed") {
          tileResult(tile, data.outputs || [], id);
          return;
        }
        if (data.status === "failed") {
          credits += cost(); // refunded
          refreshButton();
          tileFail(tile, friendlyError(data.error));
          return;
        }
      }
    }

    // One independent job per output (each charged the unit cost), so any
    // template can produce several in parallel.
    async function launchJob(inputs: Record<string, unknown>, per: number) {
      const tile = createTile();
      activeJobs++;
      credits -= per; // optimistic debit
      refreshButton();
      try {
        const res = await fetch("/api/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            templateId: cfg.id,
            inputs,
            quality: controlValue("quality") || undefined,
            quantity: 1,
            aspect: controlValue("aspect") || undefined,
            duration: duration() || undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          credits += per;
          refreshButton();
          if (data.needCredits) {
            tile.remove();
            (window as any).pdToast?.("You're out of credits — taking you to top up…", { accent: "var(--pd-amber)" });
            window.location.href = "/credits";
          } else {
            tileFail(tile, friendlyError(data.error || "Could not start generation."));
          }
          return;
        }
        await poll(data.id, tile);
      } catch (err) {
        credits += per;
        refreshButton();
        tileFail(tile, "Network error — try again.");
      } finally {
        activeJobs = Math.max(0, activeJobs - 1);
      }
    }

    // Lightweight sign-in prompt shown when a logged-out visitor tries to generate.
    let signInModalEl: HTMLElement | null = null;
    function showSignInModal() {
      const redirect = "/auth/sign-in?redirect=" + encodeURIComponent(location.pathname);
      if (!signInModalEl) {
        signInModalEl = document.createElement("div");
        signInModalEl.style.cssText = "position:fixed;inset:0;z-index:9998;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);";
        signInModalEl.innerHTML =
          '<div role="dialog" aria-modal="true" style="width:100%;max-width:360px;border-radius:18px;padding:26px 24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.4);">' +
            '<div style="margin:0 auto 14px;width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--pd-bg3);border:0.5px solid var(--pd-hairline2);">' +
              '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--pd-lilac)" stroke-width="1.5" stroke-linecap="round"><path d="M10 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M4 16.5a6 6 0 0 1 12 0"/></svg>' +
            '</div>' +
            '<div style="font-size:17px;font-weight:600;letter-spacing:-0.3px;color:var(--pd-ink);">Sign in to generate</div>' +
            '<div style="margin-top:6px;font-size:13px;line-height:1.5;color:var(--pd-ink3);">Create a free account or sign in to start generating with this template.</div>' +
            '<a id="pd-signin-go" href="' + redirect + '" style="margin-top:18px;display:flex;align-items:center;justify-content:center;padding:12px 16px;border-radius:12px;background:var(--pd-lilac);color:#0A0A0B;font-size:14px;font-weight:700;text-decoration:none;letter-spacing:-0.1px;">Sign in</a>' +
            '<button id="pd-signin-cancel" type="button" style="margin-top:10px;width:100%;padding:10px;border-radius:12px;background:transparent;border:0.5px solid var(--pd-hairline2);color:var(--pd-ink2);font-size:13px;cursor:pointer;">Not now</button>' +
          '</div>';
        document.body.appendChild(signInModalEl);
        signInModalEl.addEventListener("click", (e) => { if (e.target === signInModalEl) hideSignInModal(); });
        signInModalEl.querySelector<HTMLElement>("#pd-signin-cancel")!.addEventListener("click", hideSignInModal);
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") hideSignInModal(); });
      } else {
        signInModalEl.querySelector<HTMLAnchorElement>("#pd-signin-go")!.href = redirect;
      }
      signInModalEl.style.display = "flex";
      document.body.style.overflow = "hidden";
    }
    function hideSignInModal() {
      if (signInModalEl) signInModalEl.style.display = "none";
      document.body.style.overflow = "";
    }

    // Confirm dialog shown before queueing another batch on top of running jobs,
    // so a click (or accidental double-click) never silently re-charges. Resolves
    // true = queue, false = cancel.
    let confirmEl: HTMLElement | null = null;
    let confirmResolve: ((v: boolean) => void) | null = null;
    function confirmQueue(running: number, adding: number, costCr: number): Promise<boolean> {
      return new Promise((resolve) => {
        confirmResolve = resolve;
        const settle = (val: boolean) => {
          if (confirmEl) confirmEl.style.display = "none";
          document.body.style.overflow = "";
          const r = confirmResolve; confirmResolve = null; if (r) r(val);
        };
        if (!confirmEl) {
          confirmEl = document.createElement("div");
          confirmEl.style.cssText = "position:fixed;inset:0;z-index:9998;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);";
          confirmEl.innerHTML =
            '<div role="dialog" aria-modal="true" style="width:100%;max-width:360px;border-radius:18px;padding:24px;background:var(--pd-bg2);border:0.5px solid var(--pd-hairline);text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.4);">' +
              '<div style="font-size:17px;font-weight:600;letter-spacing:-0.3px;color:var(--pd-ink);">Queue more generations?</div>' +
              '<div id="pd-confirm-sub" style="margin-top:6px;font-size:13px;line-height:1.5;color:var(--pd-ink3);"></div>' +
              '<button id="pd-confirm-go" type="button" style="margin-top:18px;width:100%;padding:12px 16px;border-radius:12px;background:var(--pd-lilac);color:#0A0A0B;font-size:14px;font-weight:700;border:none;cursor:pointer;">Queue</button>' +
              '<button id="pd-confirm-cancel" type="button" style="margin-top:10px;width:100%;padding:10px;border-radius:12px;background:transparent;border:0.5px solid var(--pd-hairline2);color:var(--pd-ink2);font-size:13px;cursor:pointer;">Cancel</button>' +
            '</div>';
          document.body.appendChild(confirmEl);
          confirmEl.addEventListener("click", (e) => { if (e.target === confirmEl) settle(false); });
          confirmEl.querySelector<HTMLElement>("#pd-confirm-cancel")!.addEventListener("click", () => settle(false));
          confirmEl.querySelector<HTMLElement>("#pd-confirm-go")!.addEventListener("click", () => settle(true));
          document.addEventListener("keydown", (e) => { if (e.key === "Escape" && confirmEl && confirmEl.style.display === "flex") settle(false); });
        }
        confirmEl.querySelector<HTMLElement>("#pd-confirm-sub")!.textContent =
          `You already have ${running} generation${running > 1 ? "s" : ""} running. Queue ${adding} more for ${costCr} cr?`;
        confirmEl.style.display = "flex";
        document.body.style.overflow = "hidden";
      });
    }

    async function generate() {
      if (!cfg.signedIn) {
        showSignInModal();
        return;
      }
      const uploading = Number((fieldPanel as any)?._pdUploading || 0);
      if (uploading > 0) {
        showError("Hang on — a file is still uploading.");
        return;
      }
      const total = cost();
      if (credits < total) {
        window.location.href = "/credits";
        return;
      }
      // Already have jobs in flight → confirm (and show the extra cost) before
      // queueing another batch, rather than silently charging again.
      if (activeJobs > 0) {
        const ok = await confirmQueue(activeJobs, quantity(), total);
        if (!ok) return;
      }
      errEl.classList.add("hidden");
      const n = quantity();
      const per = unitCost();
      const inputs = collectInputs(); // snapshot once for all parallel jobs
      for (let i = 0; i < n; i++) launchJob(inputs, per);
    }

    genBtn.addEventListener("click", generate);
    refreshButton();
  </script>

  <script is:inline>
    // Switch-template gallery modal: open/close, search-filter, Escape close.
    (function () {
      var btn = document.getElementById("pd-switch-btn");
      var modal = document.getElementById("pd-switch-modal");
      var search = document.getElementById("pd-switch-search");
      var closeBtn = document.getElementById("pd-switch-close");
      if (!btn || !modal) return;
      function open() {
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
        if (search) { search.value = ""; search.focus(); }
        modal.querySelectorAll(".pd-sw-card").forEach(function (c) { c.style.display = "flex"; });
        // Kick the preview videos to life now that the modal is visible (the
        // global IntersectionObserver also manages them, but nudge on open).
        modal.querySelectorAll("video").forEach(function (v) {
          v.muted = true;
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        });
        var cur = modal.querySelector('[data-current="true"]');
        if (cur) cur.scrollIntoView({ block: "center" });
      }
      function close() { modal.style.display = "none"; document.body.style.overflow = ""; }
      btn.addEventListener("click", open);
      if (closeBtn) closeBtn.addEventListener("click", close);
      modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && modal.style.display !== "none") close(); });
      if (search) search.addEventListener("input", function () {
        var q = search.value.trim().toLowerCase();
        modal.querySelectorAll(".pd-sw-card").forEach(function (c) {
          c.style.display = !q || c.getAttribute("data-name").indexOf(q) !== -1 ? "flex" : "none";
        });
      });
    })();
  </script>
</AppShell>
